@model RentACar.Application.DTOs.AuditLogViewModel
@using RentACar.Core.Entities

@{
    ViewData["Title"] = "Audit Log Report";
}

<!-- Custom Styles -->
<link rel="stylesheet" href="~/css/AuditLog.css" asp-append-version="true" />

<div class="audit-log-page layout-container flex h-full grow flex-col bg-background-dark min-h-screen">
    <div class="flex flex-1 justify-center py-6 px-4 md:px-8">
        <div class="layout-content-container flex flex-col w-full max-w-[1400px] flex-1">
<!-- Page Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 p-4 mb-4">
    <div class="flex flex-col gap-2">
        <h1 class="text-white text-3xl md:text-4xl font-extrabold leading-tight tracking-tight"><span class="text-gold text-3xl">Audit Logs </span> Report</h1>
        <p class="text-white/60 text-base font-normal">Track system changes, user activities, and administrative actions.</p>
    </div>
    <!-- Export Button -->
    <button type="submit" form="filterForm" asp-action="ExportAuditLog" class="flex shrink-0 cursor-pointer items-center justify-center gap-2 rounded-lg h-10 px-6 bg-gold hover:bg-gold-hover text-background-dark text-sm font-bold leading-normal tracking-wide transition-colors" formnovalidate>
        <span class="material-symbols-outlined text-[20px]">download</span>
        <span class="truncate">Export Report</span>
    </button>
</div>

            <!-- Filters Area -->
            <form method="get" asp-action="AuditLog" class="flex flex-wrap items-center gap-x-4 gap-y-3 p-4 mb-6 bg-surface-dark rounded-xl shadow-lg relative z-50" id="filterForm">
                <input type="hidden" name="page" value="1" />
                
                <!-- Search Box -->
                <div class="relative group w-full md:w-64">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-gold transition-colors">search</span>
                    <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search..." 
                           class="w-full h-10 pl-11 pr-4 rounded-lg bg-surface-dark-lighter text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-gold/50 transition-all border-transparent" />
                </div>

                <!-- Date Range Filter -->
                <div class="flex items-center gap-2 shrink-0">
                    <div class="relative group">
                        <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="h-10 px-3 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors border-transparent w-36">
                    </div>
                    <span class="text-gray-500 shrink-0">-</span>
                    <div class="relative group">
                        <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="h-10 px-3 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors border-transparent w-36">
                    </div>
                </div>

                <!-- Action Type Filter -->
                <div class="relative group shrink-0">
                    <select name="actionType" class="appearance-none h-10 pl-4 pr-8 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors cursor-pointer border-transparent min-w-[130px]">
                        <option value="" class="bg-surface-dark-lighter text-white">All Actions</option>
                        @foreach (var action in Model.AvailableActions)
                        {
                            <!option value="@action" class="bg-surface-dark-lighter text-white" @(Model.ActionType == action ? "selected" : "")>@action</!option>
                        }
                    </select>
                </div>

                <!-- Entity Filter -->
                <div class="relative group shrink-0">
                    <select name="entity" class="appearance-none h-10 pl-4 pr-8 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors cursor-pointer border-transparent min-w-[130px]">
                        <option value="" class="bg-surface-dark-lighter text-white">All Entities</option>
                        @foreach (var entity in Model.AvailableEntities)
                        {
                            <!option value="@entity" class="bg-surface-dark-lighter text-white" @(Model.EntityName == entity ? "selected" : "")>@entity</!option>
                        }
                    </select>
                </div>

                 <!-- Status Filter -->
                <div class="relative group shrink-0">
                    <select name="status" class="appearance-none h-10 pl-4 pr-8 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors cursor-pointer border-transparent min-w-[120px]">
                        <option value="" class="bg-surface-dark-lighter text-white">All Statuses</option>
                        <!option value="Success" class="bg-surface-dark-lighter text-white" @(Model.Status == "Success" ? "selected" : "")>Success</!option>
                        <!option value="Failed" class="bg-surface-dark-lighter text-white" @(Model.Status == "Failed" ? "selected" : "")>Failed</!option>
                    </select>
                </div>

                <!-- Buttons Group -->
                <div class="flex items-center gap-3 ml-auto shrink-0">
                    <button type="submit" class="h-10 px-5 rounded-lg bg-gold text-background-dark font-bold text-sm hover:bg-gold-hover transition-colors">Apply</button>
                    <a asp-action="AuditLog" class="h-10 px-4 flex items-center justify-center rounded-lg border border-gold/10 text-white/70 hover:text-white hover:bg-white/5 transition-colors text-sm">Reset</a>
                </div>
            </form>

            <!-- Table Container -->
            <div id="audit-log-table-container">
                <!-- Loading State (Initial) -->
                <div class="flex justify-center items-center p-12">
                    <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-gold"></div>
                </div>
            </div>

        </div>
    </div>
<!-- Details Modal -->
<div id="audit-details-modal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/80 backdrop-blur-md transition-opacity" onclick="closeAuditModal()"></div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <!-- Modal Panel -->
            <div class="relative transform overflow-hidden rounded-2xl bg-[#0a0a0a] text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-3xl">
                
                <!-- Header -->
                <div class="bg-gradient-to-r from-[#0a0a0a] via-[#111] to-[#0a0a0a] px-3 py-2 flex justify-between items-center border-b border-white/5">
                    <div>
                        <h3 class="text-xl font-bold text-white tracking-tight" id="modal-title">Log Details</h3>
                        <p class="mt-1 text-sm text-gold/60 font-mono">ID: <span id="modal-log-id"></span></p>
                    </div>
                    <button type="button"
        onclick="closeAuditModal()"
        style="
            all: unset !important;
            cursor: pointer !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 36px !important;
            height: 36px !important;
            border-radius: 9999px !important;
            color: white !important;
            ;
        "
        
        aria-label="Close modal">
    <span class="material-symbols-outlined"
          style="
              font-size: 20px !important;
              line-height: 1 !important;
          ">
        close
    </span>
</button>

                </div>

                <!-- Body -->
                <div class="px-6 py-6 space-y-6 max-h-[75vh] overflow-y-auto custom-scrollbar bg-[#0a0a0a]">
                    
                    <!-- Basic Info Grid -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-white/[0.02] p-4 rounded-xl">
                            <span class="text-[10px] text-white/40 uppercase tracking-widest block mb-2">Action</span>
                            <span id="modal-action" class="text-gold font-bold text-sm"></span>
                        </div>
                        <div class="bg-white/[0.02] p-4 rounded-xl">
                            <span class="text-[10px] text-white/40 uppercase tracking-widest block mb-2">Entity</span>
                            <span id="modal-entity" class="text-white font-medium text-sm"></span>
                        </div>
                        <div class="bg-white/[0.02] p-4 rounded-xl">
                             <span class="text-[10px] text-white/40 uppercase tracking-widest block mb-2">Target ID</span>
                             <span id="modal-target-id" class="text-white/70 font-mono text-xs"></span>
                        </div>
                         <div class="bg-white/[0.02] p-4 rounded-xl">
                             <span class="text-[10px] text-white/40 uppercase tracking-widest block mb-2">Outcome</span>
                             <span id="modal-outcome" class="text-white font-medium text-sm"></span>
                        </div>
                    </div>

                        <!-- Changes Comparison -->
                        <div id="modal-changes-section" class="hidden col-span-1 md:col-span-2">
                             <h4 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                                <span class="material-symbols-outlined text-gold text-[20px]">compare_arrows</span>
                                Changes
                            </h4>
                            
                            <div class="rounded-xl bg-surface-dark overflow-hidden shadow-lg ">
                                <div class="overflow-x-auto custom-scrollbar">
                                    <table class="w-full text-left border-collapse border-gold text-sm">
                                        <thead>
                                            <tr class="bg-surface-dark-lighter border-b border-white/5">
                                                <th class="py-3 px-4 font-bold text-white w-1/3">Attribute</th>
                                                <th class="py-3 px-4 font-bold text-red-400 w-1/3">
                                                    <div class="flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-[16px]">remove_circle</span> Old Value
                                                    </div>
                                                </th>
                                                <th class="py-3 px-4 font-bold text-emerald-400 w-1/3">
                                                    <div class="flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-[16px]">add_circle</span> New Value
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="modal-changes-tbody" class="divide-y divide-white/5 bg-surface-dark">
                                            <!-- Rows populated by JS -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    
                    <!-- Details (Full JSON) -->
                     <div id="modal-details-section" class="hidden mt-6">
                        <h4 class="text-sm font-bold text-gold mb-3 flex items-center gap-2 uppercase tracking-wide">
                             <span class="w-1.5 h-1.5 rounded-full bg-gold"></span> Additional Details
                        </h4>
                        <pre id="modal-details-json" class="bg-white/[0.02] p-5 rounded-xl text-xs font-mono text-white/60 overflow-x-auto custom-scrollbar"></pre>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

</div>

@section Scripts {
    <script src="~/js/AuditLog.js" asp-append-version="true"></script>
}
