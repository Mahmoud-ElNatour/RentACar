@model RentACar.Application.DTOs.AuditLogViewModel
@using RentACar.Core.Entities

@{
    ViewData["Title"] = "Audit Log Report";
}

<!-- Removed conflicting CSS link -->

<div class="layout-container flex h-full grow flex-col bg-background-dark min-h-screen">
    <div class="flex flex-1 justify-center py-6 px-4 md:px-8">
        <div class="layout-content-container flex flex-col w-full max-w-[1400px] flex-1">
<!-- Page Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 p-4 mb-4">
    <div class="flex flex-col gap-2">
        <h1 class="text-white text-3xl md:text-4xl font-extrabold leading-tight tracking-tight">Audit Log Report</h1>
        <p class="text-white/60 text-base font-normal">Track system changes, user activities, and administrative actions.</p>
    </div>
    <!-- Export Button -->
     <!-- Added name="exportBtn" to identify it, usually formaction works but JS intercepts it -->
    <button type="submit" form="filterForm" asp-action="ExportAuditLog" class="flex shrink-0 cursor-pointer items-center justify-center gap-2 rounded-lg h-10 px-6 bg-gold hover:bg-gold-hover text-background-dark text-sm font-bold leading-normal tracking-wide transition-colors" formnovalidate>
        <span class="material-symbols-outlined text-[20px]">download</span>
        <span class="truncate">Export Report</span>
    </button>
</div>

            <!-- Filters Area -->
            <form method="get" asp-action="AuditLog" class="flex flex-col xl:flex-row gap-4 p-4 mb-6 bg-surface-dark rounded-xl shadow-lg relative z-50 items-start xl:items-center" id="filterForm">
                <input type="hidden" name="page" value="1" />
                
                <!-- Search Box -->
                <div class="relative group w-full xl:w-auto xl:flex-1 max-w-md">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-gold transition-colors">search</span>
                    <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search User, ID, or IP..." 
                           class="w-full h-10 pl-12 pr-4 rounded-lg bg-surface-dark-lighter text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-gold/50 transition-all border-transparent" />
                </div>

                <!-- Date Range Filter -->
                <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
                    <div class="relative group shrink-0">
                        <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="h-10 px-4 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors border-transparent placeholder-gray-500 w-full md:w-auto" placeholder="Start Date">
                    </div>
                    <span class="text-gray-500 shrink-0">-</span>
                    <div class="relative group shrink-0">
                        <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="h-10 px-4 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors border-transparent placeholder-gray-500 w-full md:w-auto" placeholder="End Date">
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3 w-full xl:w-auto xl:justify-end">
                    
                    <style>
                        /* Attempt to style select options - Support varies */
                        option:hover, option:focus, option:active, option:checked {
                            background-color: #f2b90d !important; /* gold */
                            color: #0a0a0a !important; /* background-dark */
                        }
                    </style>
                    
                    <!-- Action Type Filter -->
                    <div class="relative group shrink-0">
                        <select name="actionType" class="appearance-none h-10 pl-4 pr-8 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors cursor-pointer w-full md:w-auto border-transparent">
                            <option value="" class="bg-surface-dark-lighter text-white">All Actions</option>
                            <!option value="Create" class="bg-surface-dark-lighter text-white" @(Model.ActionType == "Create" ? "selected" : "")>Create</!option>
                            <!option value="Update" class="bg-surface-dark-lighter text-white" @(Model.ActionType == "Update" ? "selected" : "")>Update</!option>
                            <!option value="Delete" class="bg-surface-dark-lighter text-white" @(Model.ActionType == "Delete" ? "selected" : "")>Delete</!option>
                            <!option value="Login" class="bg-surface-dark-lighter text-white" @(Model.ActionType == "Login" ? "selected" : "")>Login</!option>
                        </select>
                        <span class="material-symbols-outlined text-white/40 text-[18px] absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none">expand_more</span>
                    </div>

                    <!-- Entity Filter -->
                    <div class="relative group shrink-0">
                        <select name="entity" class="appearance-none h-10 pl-4 pr-8 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors cursor-pointer w-full md:w-auto border-transparent">
                            <option value="" class="bg-surface-dark-lighter text-white">All Entities</option>
                            <!option value="Car" class="bg-surface-dark-lighter text-white" @(Model.EntityName == "Car" ? "selected" : "")>Car</!option>
                            <!option value="Customer" class="bg-surface-dark-lighter text-white" @(Model.EntityName == "Customer" ? "selected" : "")>Customer</!option>
                            <!option value="Booking" class="bg-surface-dark-lighter text-white" @(Model.EntityName == "Booking" ? "selected" : "")>Booking</!option>
                            <!option value="Payment" class="bg-surface-dark-lighter text-white" @(Model.EntityName == "Payment" ? "selected" : "")>Payment</!option>
                            <!option value="Employee" class="bg-surface-dark-lighter text-white" @(Model.EntityName == "Employee" ? "selected" : "")>Employee</!option>
                            <!option value="Blacklist" class="bg-surface-dark-lighter text-white" @(Model.EntityName == "Blacklist" ? "selected" : "")>Blacklist</!option>
                        </select>
                        <span class="material-symbols-outlined text-white/40 text-[18px] absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none">expand_more</span>
                    </div>

                     <!-- Status Filter -->
                    <div class="relative group shrink-0">
                        <select name="status" class="appearance-none h-10 pl-4 pr-8 rounded-lg bg-surface-dark-lighter text-white/80 text-sm font-medium focus:outline-none focus:border-gold/50 hover:bg-gold/10 transition-colors cursor-pointer w-full md:w-auto border-transparent">
                            <option value="" class="bg-surface-dark-lighter text-white">All Statuses</option>
                            <!option value="Success" class="bg-surface-dark-lighter text-white" @(Model.Status == "Success" ? "selected" : "")>Success</!option>
                            <!option value="Failed" class="bg-surface-dark-lighter text-white" @(Model.Status == "Failed" ? "selected" : "")>Failed</!option>
                        </select>
                         <span class="material-symbols-outlined text-white/40 text-[18px] absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none">expand_more</span>
                    </div>

                    <button type="submit" class="h-10 px-4 rounded-lg bg-gold text-background-dark font-bold text-sm hover:bg-gold-hover transition-colors shrink-0">Apply</button>
                    <a asp-action="AuditLog" class="h-10 px-4 flex items-center justify-center rounded-lg border border-gold/10 text-white/70 hover:text-white hover:bg-white/5 transition-colors text-sm shrink-0">Reset</a>

                </div>
            </form>

            <!-- Table Container -->
            <div id="audit-log-table-container">
                <!-- Loading State (Initial) -->
                <div class="flex justify-center items-center p-12">
                    <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-gold"></div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/AuditLog.js" asp-append-version="true"></script>
}
