@model List<RentACar.Core.Entities.EmailTemplate>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Templates";
    ViewData["BodyClass"] = "bg-background-dark";
}

@section Styles {
    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #0a0a0a; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #332d1d; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #d4af35; }
        
        /* Checkbox styles using Tailwind apply with Layout specific colors if needed, 
           or just manual CSS since we are inside a style block. 
           Assuming Tailwind is processed or we use direct CSS.
        */
        .toggle-checkbox:checked {
            background-color: #f2b90d; /* gold */
            border-color: #f2b90d;
            right: 0;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: rgba(242, 185, 13, 0.2);
            border-color: rgba(242, 185, 13, 0.5);
        }
    </style>
}

<div class="max-w-[1600px] mx-auto px-6 py-12">
    <div class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
        <div>
            <div class="flex items-center gap-3 mb-4">
                <div class="size-8 rounded bg-gold/10 flex items-center justify-center border border-gold/20">
                    <span class="material-symbols-outlined text-gold text-xl">terminal</span>
                </div>
                <h1 class="text-white text-3xl font-black leading-tight tracking-tight"><span class="text-gold font-bold text-[40px]">Email Templates</span> Management</h1>
            </div>
            <p class="text-text-secondary text-sm font-medium uppercase tracking-widest">Email Engine Control Center</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
            <div class="flex items-center bg-surface-dark border border-white/10 rounded-lg px-3 py-2.5 focus-within:border-gold/50 transition-colors">
                <span class="material-symbols-outlined text-gold mr-2">search</span>
                <input class="bg-transparent border-none focus:ring-0 text-sm text-white placeholder:text-text-secondary/50 w-full sm:w-64" placeholder="Search template keys or names..." type="text"/>
            </div>
            <a href="@Url.Action("Create", "Templates")" class="group flex items-center justify-center gap-2 px-6 py-2.5 bg-gold !text-background-dark text-sm font-black rounded-lg hover:!text-background-dark hover:brightness-110 hover:-translate-y-1 active:scale-95 transition-all duration-300 shadow-lg shadow-gold/10 hover:shadow-gold/25 whitespace-nowrap" style="text-decoration:none;">
                <span class="material-symbols-outlined font-bold transition-transform duration-500 group-hover:rotate-180">add</span>
                CREATE TEMPLATE
            </a>
        </div>
    </div>
    <div class="grid grid-cols-12 gap-8">
        <div class="col-span-12">
            <div class="rounded-xl border border-white/10 bg-surface-dark/30 overflow-hidden shadow-2xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-surface-dark border-b border-white/10">
                                <th class="px-6 py-5 text-white text-[10px] font-bold uppercase tracking-[0.2em]">Template Name</th>
                                <th class="px-6 py-5 text-white text-[10px] font-bold uppercase tracking-[0.2em]">Template Key</th>
                                <th class="px-6 py-5 text-white text-[10px] font-bold uppercase tracking-[0.2em]">Category</th>
                                <th class="px-6 py-5 text-white text-[10px] font-bold uppercase tracking-[0.2em]">Status</th>
                                <th class="px-6 py-5 text-white text-[10px] font-bold uppercase tracking-[0.2em] text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var template in Model)
                            {
                                <tr class="hover:bg-gold/5 transition-colors group">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <div class="size-8 rounded bg-background-dark flex items-center justify-center border border-white/10 group-hover:border-gold/30 transition-colors">
                                                <span class="material-symbols-outlined text-gold/40 group-hover:text-gold transition-colors text-lg">mail</span>
                                            </div>
                                            <span class="text-white font-bold">@template.Name</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 font-mono text-xs text-text-secondary">@template.TemplateKey</td>
                                    <td class="px-6 py-5">
                                        <span class="px-3 py-1 bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase rounded-full border border-blue-500/20">@template.Category</span>
                                    </td>
                                    <td class="px-6 py-5">
                                        @if (template.IsActive)
                                        {
                                            <div class="flex items-center gap-2 text-emerald-500 font-bold text-[10px] tracking-widest uppercase">
                                                <div class="size-1.5 bg-emerald-500 rounded-full shadow-[0_0_8px_rgba(16,185,129,0.6)]"></div>
                                                Active
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex items-center gap-2 text-white/30 font-bold text-[10px] tracking-widest uppercase">
                                                <div class="size-1.5 bg-white/20 rounded-full"></div>
                                                Disabled
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-5 text-right">
                                        <div class="flex justify-end gap-4">
                                            <a href="@Url.Action("Edit", "Templates", new { key = template.TemplateKey })" class="!text-gold hover:!text-gold hover:scale-110 transition-transform flex items-center gap-1 group/btn" title="Edit Template" style="text-decoration:none;">
                                                <span class="material-symbols-outlined text-xl">edit_square</span>
                                            </a>
                                            <button onclick="openDeleteModal('@Url.Action("Delete", "Templates", new { key = template.TemplateKey })')" class="!text-red-500 hover:!text-red-500 hover:scale-110 transition-transform flex items-center gap-1 group/btn bg-transparent border-none p-0" title="Remove Template">
    <span class="material-symbols-outlined text-xl">delete</span>
</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- System Status Indicator Fixed Position -->
    <div class="fixed bottom-8 right-8 z-50 pointer-events-none">
        <div class="bg-surface-dark/80 backdrop-blur-md border border-white/10 rounded-full px-6 py-3 flex items-center gap-6 shadow-2xl pointer-events-auto">
            <div class="flex items-center gap-2">
                <div class="size-2 bg-emerald-500 rounded-full animate-pulse"></div>
                <span class="text-[10px] font-bold text-white uppercase tracking-widest">System Engine: Operational</span>
            </div>
            <div class="h-4 w-px bg-white/10"></div>
            <button class="text-text-secondary hover:text-gold transition-colors">
                <span class="material-symbols-outlined text-xl">help</span>
            </button>
        </div>
    </div>
</div>

<partial name="_DeleteConfirmationModal" />
