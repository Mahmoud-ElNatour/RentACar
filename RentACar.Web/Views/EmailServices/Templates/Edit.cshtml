@model RentACar.Core.Entities.EmailTemplate
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Advanced Email Template Editor</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=JetBrains+Mono&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet"/>
<script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#d4af37",
              "background-light": "#f8fafc",
              "background-dark": "#0a0a0a",
              "surface-dark": "#121212",
              "border-dark": "#262626",
            },
            fontFamily: {
              display: ["Inter", "sans-serif"],
              mono: ["JetBrains Mono", "monospace"],
            },
            borderRadius: {
              DEFAULT: "8px",
            },
          },
        },
      };
    </script>
<style>
        body { font-family: 'Inter', sans-serif; }
        .code-syntax-tag { color: #f472b6; }
        .code-syntax-attr { color: #fbbf24; }
        .code-syntax-string { color: #34d399; }
        .code-syntax-token { color: #d4af37; font-weight: 600; }::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #121212; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #444; }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen transition-colors duration-200">
<form method="post" asp-action="Edit" asp-route-key="@Model.TemplateKey">
<input type="hidden" asp-for="TemplateKey" />
@Html.AntiForgeryToken()

<header class="border-b border-slate-200 dark:border-border-dark bg-white dark:bg-surface-dark px-6 py-4 flex items-center justify-between sticky top-0 z-50">
<div class="flex items-center gap-4">
<a href="@Url.Action("Index")" class="w-10 h-10 bg-primary flex items-center justify-center rounded-lg shadow-lg shadow-primary/20 hover:brightness-110 transition-all text-white" style="text-decoration:none;">
<span class="material-icons-round">arrow_back</span>
</a>
<div>
<h1 class="text-xl font-bold tracking-tight">
                    Edit Template: <span class="text-primary">@Model.Name</span>
</h1>
<p class="text-xs text-slate-500 dark:text-slate-400 font-medium uppercase tracking-widest">Configuring System Automated Dispatch</p>
</div>
</div>
<div class="flex items-center gap-6">
<div class="flex items-center gap-3 px-4 py-2 bg-slate-100 dark:bg-black/40 rounded-full border border-slate-200 dark:border-border-dark">
<span class="text-[10px] font-bold tracking-widest uppercase text-slate-500 dark:text-slate-400">Status:</span>
<label class="relative inline-flex items-center cursor-pointer">
<input class="sr-only peer" type="checkbox" asp-for="IsActive" />
<div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-green-600"></div>
</label>
<span class="text-xs font-bold text-green-600 dark:text-green-500">@(Model.IsActive ? "ACTIVE" : "INACTIVE")</span>
</div>
<div class="flex items-center gap-3">
<a href="@Url.Action("Index")" class="px-6 py-2.5 text-sm font-semibold rounded-lg hover:bg-slate-100 dark:hover:bg-white/5 transition-colors border border-transparent text-slate-500 dark:text-slate-300" style="text-decoration:none;">
                    Discard
                </a>
<button type="submit" class="px-6 py-2.5 bg-primary hover:bg-opacity-90 text-white font-bold text-sm rounded-lg shadow-lg shadow-primary/20 transition-all transform active:scale-95 uppercase tracking-wider">
                    Save Template
                </button>
</div>
</div>
</header>
<main class="max-w-[1600px] mx-auto p-6 grid grid-cols-12 gap-6">
<div class="col-span-12 lg:col-span-8 flex flex-col gap-6">
<section class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-xl p-6">
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
<div>
<label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-2">Template Name</label>
<input class="w-full bg-slate-50 dark:bg-black/40 border-slate-200 dark:border-border-dark rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all" type="text" asp-for="Name" />
</div>
<div>
<label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-2">Template Key</label>
<input class="w-full bg-slate-50 dark:bg-black/40 border-slate-200 dark:border-border-dark rounded-lg px-4 py-2.5 text-sm font-mono text-primary/80 focus:ring-primary focus:border-primary transition-all" type="text" asp-for="TemplateKey" readonly />
</div>
<div>
<label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-2">Category</label>
<select class="w-full bg-slate-50 dark:bg-black/40 border-slate-200 dark:border-border-dark rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all appearance-none" asp-for="Category">
<option value="Customer">Customer</option>
<option value="Employee">Employee</option>
<option value="System">System</option>
</select>
</div>
</div>
<div>
<label class="block text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-2">Email Subject</label>
<input class="w-full bg-slate-50 dark:bg-black/40 border-slate-200 dark:border-border-dark rounded-lg px-4 py-2.5 text-sm focus:ring-primary focus:border-primary transition-all" type="text" asp-for="Subject" />
</div>
</section>
<section class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-xl flex flex-col h-[600px] overflow-hidden">
<div class="px-4 py-3 border-b border-slate-200 dark:border-border-dark flex items-center justify-between bg-slate-50/50 dark:bg-black/20">
<div class="flex items-center gap-1">
<span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mr-4">Rich HTML Editor</span>
</div>
<div class="flex items-center gap-1.5">
<div class="w-2.5 h-2.5 rounded-full bg-red-500/30"></div>
<div class="w-2.5 h-2.5 rounded-full bg-amber-500/30"></div>
<div class="w-2.5 h-2.5 rounded-full bg-green-500/30"></div>
</div>
</div>
<div class="flex-1 overflow-auto bg-[#0d0d0d] p-0 font-mono text-sm leading-relaxed text-slate-300">
    <textarea asp-for="Body" class="w-full h-full bg-transparent border-none text-slate-300 p-4 focus:ring-0 font-mono"></textarea>
</div>
</section>
</div>
<aside class="col-span-12 lg:col-span-4 flex flex-col gap-6">
<section class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-xl p-6">
<div class="flex items-center gap-2 mb-4">
<span class="material-icons-round text-primary text-xl">token</span>
<h2 class="text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Available Tokens</h2>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400 mb-4 italic">Click to copy token to clipboard</p>
<div class="flex flex-col gap-2">
<button type="button" onclick="navigator.clipboard.writeText('{{CustomerName}}')" class="group flex items-center justify-between px-4 py-2.5 rounded-lg border border-slate-200 dark:border-border-dark bg-slate-50 dark:bg-black/20 hover:border-primary/50 transition-all">
<code class="text-sm font-mono text-slate-700 dark:text-slate-300">{{CustomerName}}</code>
<span class="material-icons-round text-xs opacity-0 group-hover:opacity-100 text-primary transition-opacity">content_copy</span>
</button>
<button type="button" onclick="navigator.clipboard.writeText('{{BookingRef}}')" class="group flex items-center justify-between px-4 py-2.5 rounded-lg border border-slate-200 dark:border-border-dark bg-slate-50 dark:bg-black/20 hover:border-primary/50 transition-all">
<code class="text-sm font-mono text-slate-700 dark:text-slate-300">{{BookingRef}}</code>
<span class="material-icons-round text-xs opacity-0 group-hover:opacity-100 text-primary transition-opacity">content_copy</span>
</button>
<!-- Add more tokens as needed -->
</div>
</section>
</aside>
</main>
</form>
</body></html>
