@model List<RentACar.Application.DTOs.DistributionListDto>
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Distribution Lists Management - Rent a Car</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;700;900&amp;family=Noto+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#daad52",
                        "background-light": "#f4f4eb",
                        "background-dark": "#13151b",
                        "card-dark": "#1c1f26",
                        "border-dark": "#2d323d",
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Epilogue', sans-serif;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-white min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
        <!-- HEADER -->
        <header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-slate-200 dark:border-border-dark px-6 md:px-10 py-3 bg-white dark:bg-background-dark sticky top-0 z-50">
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-4">
                    <div class="size-6 text-primary">
                        <svg fill="currentColor" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
                            <path d="M44 11.2727C44 14.0109 39.8386 16.3957 33.69 17.6364C39.8386 18.877 44 21.2618 44 24C44 26.7382 39.8386 29.123 33.69 30.3636C39.8386 31.6043 44 33.9891 44 36.7273C44 40.7439 35.0457 44 24 44C12.9543 44 4 40.7439 4 36.7273C4 33.9891 8.16144 31.6043 14.31 30.3636C8.16144 29.123 4 26.7382 4 24C4 21.2618 8.16144 18.877 14.31 17.6364C8.16144 16.3957 4 14.0109 4 11.2727C4 7.25611 12.9543 4 24 4C35.0457 4 44 7.25611 44 11.2727Z"></path>
                        </svg>
                    </div>
                    <a href="@Url.Action("Index", "Home")" class="text-lg font-bold leading-tight tracking-[-0.015em] hidden sm:block text-primary no-underline">Rent Luxury</a>
                </div>
                <!-- Search (Keep static visual or functional if needed) -->
                <label class="flex flex-col min-w-40 !h-10 max-w-64 hidden lg:flex">
                    <div class="flex w-full flex-1 items-stretch rounded-lg h-full overflow-hidden">
                        <div class="text-slate-500 dark:text-[#c3b498] flex border-none bg-slate-100 dark:bg-[#2d323d] items-center justify-center pl-4">
                            <span class="material-symbols-outlined text-xl">search</span>
                        </div>
                        <input class="form-input flex w-full min-w-0 flex-1 border-none bg-slate-100 dark:bg-[#2d323d] text-slate-900 dark:text-white focus:ring-0 placeholder:text-slate-400 dark:placeholder:text-[#c3b498] px-4 pl-2 text-sm font-normal" placeholder="Search lists..." value=""/>
                    </div>
                </label>
            </div>
            <div class="flex flex-1 justify-end gap-4 md:gap-8">
                <nav class="hidden xl:flex items-center gap-9">
                    <a class="text-sm font-medium hover:text-primary transition-colors no-underline dark:text-white" href="@Url.Action("Index", "Dashboard")">Dashboard</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors no-underline dark:text-white" href="#">Fleet</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors no-underline dark:text-white" href="#">Bookings</a>
                    <!-- Active State -->
                    <a class="text-primary text-sm font-bold border-b-2 border-primary pb-1 no-underline" href="@Url.Action("Index", "DistributionLists")">Email Lists</a>
                    <a class="text-sm font-medium hover:text-primary transition-colors no-underline dark:text-white" href="#">Settings</a>
                </nav>
                <button class="flex min-w-[84px] cursor-pointer items-center justify-center rounded-lg h-10 px-4 bg-primary text-background-dark text-sm font-bold transition-all hover:bg-opacity-90 active:scale-95 border-none">
                    <span>Profile</span>
                </button>
                <div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10 border-2 border-primary/20" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBf52VE9uAjxx-Tb8jPsz6URg2yyvh2oOAPoeoncx-BB0enuDKYyUo6Wgd3PPcj-pHmYjruFvX6N3RIMS-N0Y_MVCulI3TLX8H78JW_7slYjObWHwwyXalL-C3Cj16HYo9XUuTTKNWlJ7PEcKetUZRfk_dyTVlejTuddunyNCzx37N-hXpfBTQnuiDuQdbDYGKv29veBTCD0jYP-QvNZzxfmBwTqDU3w6ExvJyEKrWKN-LDmD6u0rg-lOuDc2ycwyPT2D4yxrp2xOZP");'></div>
            </div>
        </header>

        <main class="flex-1 flex flex-col max-w-[1280px] w-full mx-auto px-4 md:px-10 py-8 gap-8">
            
            <!-- Success Notification (Dynamic Inject) -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                    <strong class="font-bold">Success!</strong>
                    <span class="block sm:inline">@TempData["SuccessMessage"]</span>
                </div>
            }

            <div class="flex flex-wrap items-end justify-between gap-4">
                <div class="flex flex-col gap-1">
                    <p class="text-primary text-sm font-bold uppercase tracking-widest">Administration</p>
                    <h1 class="text-3xl md:text-4xl font-black leading-tight tracking-[-0.033em]">Distribution Lists Management</h1>
                    <p class="text-slate-500 dark:text-[#c3b498] text-base">Group and manage your communication channels for customers and staff.</p>
                </div>
                <button onclick="document.getElementById('gen-list-name').focus()" class="flex min-w-[180px] cursor-pointer items-center justify-center gap-2 rounded-lg h-12 px-6 bg-primary text-background-dark text-base font-bold shadow-lg shadow-primary/20 hover:shadow-primary/40 transition-all border-none">
                    <span class="material-symbols-outlined font-bold">add</span>
                    <span>New List</span>
                </button>
            </div>
            
            <!-- Generate List Section (Using Partial for organization, but content matches template) -->
            @await Html.PartialAsync("_GenerateEmailsListPartial")

            <div class="flex flex-col gap-4">
                <div class="flex items-center justify-between px-1">
                    <h2 class="text-xl font-bold">Master Distribution Lists</h2>
                    <div class="flex items-center gap-3">
                        <div class="relative">
                            <input class="bg-white dark:bg-card-dark border border-slate-200 dark:border-border-dark rounded-lg text-xs py-2 pl-8 focus:ring-primary focus:border-primary text-slate-900 dark:text-white" placeholder="Filter lists..." type="text"/>
                            <span class="material-symbols-outlined absolute left-2 top-1/2 -translate-y-1/2 text-sm text-slate-400">filter_list</span>
                        </div>
                    </div>
                </div>
                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-border-dark bg-white dark:bg-card-dark shadow-sm">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 dark:border-border-dark bg-slate-50/50 dark:bg-white/5">
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#c3b498]">List Name</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#c3b498]">Total Emails</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#c3b498]">Included Roles</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#c3b498]">Status</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-[#c3b498]">Last Updated</th>
                                <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-primary text-center bg-primary/5 border-l border-primary/20">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-border-dark">
                            @if(Model != null)
                            {
                                foreach(var item in Model)
                                {
                                    <tr class="hover:bg-slate-50 dark:hover:bg-white/5 transition-colors group">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-lg bg-primary/20 flex items-center justify-center text-primary">
                                                    <span class="material-symbols-outlined text-lg">campaign</span>
                                                </div>
                                                <div class="flex flex-col">
                                                    <span class="font-bold text-sm">@item.Name</span>
                                                    <span class="text-[10px] text-slate-400">@item.Description</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 font-medium text-sm">@item.MemberCount</td>
                                        <td class="px-6 py-4">
                                           @* Display roles tags *@
                                            <div class="flex flex-wrap gap-1.5">
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">Mixed</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            @if(item.IsActive)
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border border-primary text-primary">
                                                    <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border border-slate-400 text-slate-400">
                                                    <span class="size-1.5 rounded-full bg-slate-400"></span>
                                                    Inactive
                                                </span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-sm text-slate-400">@(item.UpdatedAt?.ToString("MMM dd, yyyy") ?? "-")</td>
                                        <td class="px-6 py-4 text-center bg-primary/5 border-l border-primary/20">
                                            <div class="flex justify-center items-center gap-2">
                                                <a href="#" onclick="openMemberModal(@item.Id); return false;" class="flex items-center justify-center size-8 rounded-lg text-primary bg-primary/10 hover:bg-primary hover:text-background-dark transition-all no-underline" title="View List">
                                                    <span class="material-symbols-outlined text-lg">visibility</span>
                                                </a>
                                                 <!-- Toggle Active -->
                                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                                     <button type="submit" class="flex items-center justify-center size-8 rounded-lg text-primary bg-primary/10 hover:bg-primary hover:text-background-dark transition-all border-none cursor-pointer" title="Toggle Status">
                                                        <span class="material-symbols-outlined text-lg">power_settings_new</span>
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteList" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this list?');">
                                                    <button type="submit" class="flex items-center justify-center size-8 rounded-lg text-primary bg-primary/10 hover:bg-red-500 hover:text-white transition-all border-none cursor-pointer" title="Delete List">
                                                        <span class="material-symbols-outlined text-lg">delete</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                     @if(Model == null || !Model.Any())
                    {
                        <div class="p-4 text-center text-slate-500">No distribution lists found. Create one above.</div>
                    }
                    <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-4 border-t border-slate-100 dark:divide-border-dark bg-slate-50/50 dark:bg-white/5">
                        <p class="text-sm text-slate-500 dark:text-[#c3b498]">Total @(Model?.Count ?? 0) Distribution Lists</p>
                        <div class="flex gap-2">
                            <button class="px-3 py-1.5 rounded border border-slate-200 dark:border-border-dark text-xs font-medium hover:bg-primary hover:text-background-dark transition-all text-slate-500 dark:text-white">Previous</button>
                            <button class="px-3 py-1.5 rounded bg-primary text-background-dark text-xs font-bold border-none">1</button>
                            <button class="px-3 py-1.5 rounded border border-slate-200 dark:border-border-dark text-xs font-medium hover:bg-primary hover:text-background-dark transition-all text-slate-500 dark:text-white">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        
        <!-- FOOTER -->
        <footer class="mt-auto py-8 border-t border-slate-200 dark:border-border-dark text-center bg-white dark:bg-background-dark">
            <p class="text-xs text-slate-500 dark:text-[#c3b498]">© 2024 Rent a Car Management System. Distribution Hub v2.5.0</p>
        </footer>
    </div>
    
    <!-- Modal Container -->
    <div id="member-modal-container" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Background backdrop -->
        <div class="fixed inset-0 bg-gray-500/75 backdrop-blur-sm transition-opacity" onclick="closeModal()"></div>

        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
                <div id="member-modal-content" class="relative transform overflow-hidden rounded-lg bg-white dark:bg-card-dark text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-4xl border border-slate-200 dark:border-border-dark">
                     <!-- Content loaded via AJAX -->
                     <div class="p-10 flex justify-center">
                         <span class="material-symbols-outlined animate-spin text-primary text-4xl">progress_activity</span>
                     </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openMemberModal(id) {
            const container = document.getElementById('member-modal-container');
            const content = document.getElementById('member-modal-content');
            
            container.classList.remove('hidden');
            
            fetch(`/DistributionLists/GetListMembers/${id}`)
                .then(response => response.text())
                .then(html => {
                    content.innerHTML = html;
                })
                .catch(err => {
                    console.error('Failed to load members', err);
                    content.innerHTML = '<div class="p-6 text-red-500">Failed to load members</div>';
                });
        }

        function closeModal() {
            const container = document.getElementById('member-modal-container');
            container.classList.add('hidden');
            document.getElementById('member-modal-content').innerHTML = '<div class="p-10 flex justify-center"><span class="material-symbols-outlined animate-spin text-primary text-4xl">progress_activity</span></div>';
        }
    </script>
</body>
</html>
