@model List<RentACar.Application.DTOs.DistributionListMemberDto>

<div class="p-6 bg-card-dark rounded-lg max-w-4xl" style="background-color: #1c1f26;">
    <div class="flex justify-between items-center mb-4 pb-4 border-b border-border-dark">
        <div>
            <h3 class="text-xl font-bold text-white">Preview Recipients</h3>
            <p class="text-gray-400 text-sm">@Model.Count email(s) will be included</p>
        </div>
        <button onclick="closePreviewModal()" class="text-slate-400 hover:text-primary transition-colors border-none bg-transparent cursor-pointer">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>

    <div class="max-h-96 overflow-y-auto">
        @if (Model.Any())
        {
            <table class="w-full text-left">
                <thead class="sticky top-0 bg-card-dark border-b border-border-dark">
                    <tr>
                        <th class="px-4 py-2 text-xs font-bold uppercase text-gray-400">Email</th>
                        <th class="px-4 py-2 text-xs font-bold uppercase text-gray-400">Type</th>
                        <th class="px-4 py-2 text-xs font-bold uppercase text-gray-400">Label</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr class="border-b border-border-dark/50 hover:bg-white/5">
                            <td class="px-4 py-3 text-sm text-white">@member.Email</td>
                            <td class="px-4 py-3 text-sm">
                                @if (member.MemberType == "Customer")
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold" style="background-color: rgba(34, 197, 94, 0.2); color: #22c55e;">Customer</span>
                                }
                                else if (member.MemberType == "Employee")
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold" style="background-color: rgba(59, 130, 246, 0.2); color: #3b82f6;">Employee</span>
                                }
                                else if (member.MemberType == "Admin")
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold" style="background-color: rgba(239, 68, 68, 0.2); color: #ef4444;">Admin</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold text-gray-400">@member.MemberType</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-400">@member.Label</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-8 text-gray-400">
                <span class="material-symbols-outlined text-4xl mb-2">inbox</span>
                <p>No recipients match the selected filters</p>
            </div>
        }
    </div>

    <div class="mt-4 pt-4 border-t border-border-dark flex justify-end">
        <button onclick="closePreviewModal()" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition-all">Close</button>
    </div>
</div>
