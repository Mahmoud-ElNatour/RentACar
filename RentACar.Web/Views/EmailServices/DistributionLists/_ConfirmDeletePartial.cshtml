@model RentACar.Application.DTOs.DistributionListDto

<div class="p-6 bg-card-dark rounded-lg border border-red-500/30" style="background-color: #1c1f26;">
    <div class="flex items-start gap-4 mb-4">
        <div class="flex-shrink-0">
            <span class="material-symbols-outlined text-red-500 text-4xl">warning</span>
        </div>
        <div class="flex-1">
            <h3 class="text-xl font-bold text-white mb-2">Delete Distribution List?</h3>
            <p class="text-gray-400 mb-4">
                Are you sure you want to delete <strong class="text-primary">@Model.Name</strong>?
            </p>
            <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-3 mb-4" style="background-color: rgba(239, 68, 68, 0.1);">
                <p class="text-sm text-red-400">
                    <strong>Warning:</strong> This will permanently delete the list and remove all <strong>@Model.MemberCount members</strong>. This action cannot be undone.
                </p>
            </div>
        </div>
    </div>

    <div class="flex gap-3 justify-end">
        <button onclick="closeConfirmModal()" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition-all">Cancel</button>
        <form asp-action="DeleteList" asp-route-id="@Model.Id" method="post" class="inline">
            <button type="submit" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">delete</span>
                Delete List
            </button>
        </form>
    </div>
</div>
