@model RentACar.Web.ViewModels.EmailConfigurationCenterVM
@{
    Layout = null;
    ViewData["Title"] = "Advanced Email Config";
}
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>@ViewData["Title"]</title>

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />

  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "gold": "#d4af37", 
            "pure-black": "#050505",
            "card-glass": "rgba(18, 18, 20, 0.7)",
            "border-gold": "rgba(242, 185, 13, 0.2)",
          },
          fontFamily: {
            "display": ["Manrope", "sans-serif"]
          }
        },
      },
    }
  </script>

  <style type="text/tailwindcss">
    @@layer base {
      body { @@apply bg-pure-black text-zinc-100 font-display; }
    }
    .glass-card {
      background: #121214; /* Fallback */
      background: linear-gradient(145deg, #121214 0%, #080809 100%);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .gold-glow { box-shadow: 0 0 15px rgba(242, 185, 13, 0.15); }

    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(242, 185, 13, 0.2);
      border-radius: 10px;
    }
    .toggle-icon { cursor: pointer; user-select: none; }
  </style>
</head>

<body class="min-h-screen">
  <form id="configForm" method="post" action="@Url.Action("Save", "EmailConfigurationCenter")">
  <div class="max-w-[1600px] mx-auto px-8 py-10">

    <!-- Header -->
    <header class="mb-10 flex justify-between items-center bg-black/40 backdrop-blur-md p-6 -mx-8 -mt-10 border-b border-white/5 sticky top-0 z-50">
      <div>
        <div class="flex items-center gap-3">
             <span class="material-symbols-outlined text-gold text-2xl">settings_applications</span>
             <h1 class="text-xl font-bold tracking-[0.25em] uppercase text-zinc-100">Advanced Email Config</h1>
        </div>
        <div class="h-0.5 w-20 bg-gradient-to-r from-transparent via-gold to-transparent opacity-60 mt-2"></div>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right">
          <p class="text-[10px] uppercase tracking-[0.2em] text-gold font-bold">Engine Status</p>
          <p class="text-xl font-mono text-white">SYSTEM ONLINE</p>
        </div>
        <div class="h-10 w-[1px] bg-white/10 mx-2"></div>
        <div class="flex gap-4">
          <a href="/Admin/EmailServices" class="flex flex-col items-center group">
             <span class="material-symbols-outlined text-gold group-hover:scale-110 transition-transform">arrow_back</span>
             <span class="text-[8px] uppercase font-bold text-slate-500 mt-1">Back</span>
          </a>
          <button class="flex flex-col items-center group" type="button">
            <span class="material-symbols-outlined text-gold group-hover:scale-110 transition-transform">settings_suggest</span>
            <span class="text-[8px] uppercase font-bold text-slate-500 mt-1">Global</span>
          </button>
          <button class="flex flex-col items-center group" type="button">
            <span class="material-symbols-outlined text-slate-500 group-hover:text-white transition-colors">history</span>
            <span class="text-[8px] uppercase font-bold text-slate-500 mt-1">Audit</span>
          </button>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-12 gap-8 items-start">

      <!-- Main Column -->
      <div class="col-span-9 space-y-8">

        <!-- Master Switch -->
        <div class="glass-card rounded-2xl p-6 border-gold/30 bg-gold/5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <span class="material-symbols-outlined text-3xl text-gold">notifications_active</span>
              <div>
                <h3 class="text-lg font-bold text-white uppercase tracking-wider">Enable All Notification Emails</h3>
                <p class="text-xs text-slate-400">Master switch for all outgoing communication triggers</p>
              </div>
            </div>
            
            <input type="hidden" name="NotificationSettings.AllNotificationEmailsEnabled" id="AllNotificationEmailsEnabled" value="@Model.NotificationSettings.AllNotificationEmailsEnabled.ToString().ToLower()" />
            <span class="material-symbols-outlined text-gold text-5xl toggle-icon" 
                  data-target="AllNotificationEmailsEnabled" 
                  onclick="toggleState(this)">
                  @(Model.NotificationSettings.AllNotificationEmailsEnabled ? "toggle_on" : "toggle_off")
            </span>
          </div>
        </div>

        <!-- System Health & Processing -->
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-gold">analytics</span>
              System Health &amp; Processing
            </h3>
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-3 bg-black/40 px-4 py-2 rounded-lg border border-white/5">
                <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Enable Reminder Processing</span>
                 <input type="hidden" name="NotificationSettings.ReminderProcessingEnabled" id="ReminderProcessingEnabled" value="@Model.NotificationSettings.ReminderProcessingEnabled.ToString().ToLower()" />
                <span class="material-symbols-outlined text-gold text-2xl toggle-icon"
                      data-target="ReminderProcessingEnabled"
                      onclick="toggleState(this)">
                      @(Model.NotificationSettings.ReminderProcessingEnabled ? "toggle_on" : "toggle_off")
                </span>
              </div>
              <div class="flex items-center gap-3 bg-black/40 px-4 py-2 rounded-lg border border-white/5">
                <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Pause Processing</span>
                <input type="hidden" name="NotificationSettings.ReminderProcessingPaused" id="ReminderProcessingPaused" value="@Model.NotificationSettings.ReminderProcessingPaused.ToString().ToLower()" />
                <span class="material-symbols-outlined text-slate-600 text-2xl toggle-icon"
                      data-target="ReminderProcessingPaused"
                      onclick="toggleState(this)">
                      @(Model.NotificationSettings.ReminderProcessingPaused ? "toggle_on" : "toggle_off")
                </span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-7 gap-4">
            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <p class="text-[9px] text-slate-500 uppercase font-black tracking-widest mb-1">Last Run Time</p>
              <p class="text-lg font-bold text-white">@(Model.LastRunRecord?.RunAt.ToLocalTime().ToString("hh:mm:ss tt") ?? "--:--")</p>
            </div>

            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <p class="text-[9px] text-slate-500 uppercase font-black tracking-widest mb-1">Next Scheduled</p>
               @{
                   var nextRun = Model.LastRunRecord?.RunAt.AddMinutes(Model.NotificationSettings.CheckIntervalMinutes);
                   string nextRunStr = nextRun.HasValue ? nextRun.Value.ToLocalTime().ToString("hh:mm:ss tt") : "Pending";
               }
              <p class="text-lg font-bold text-gold">@nextRunStr</p>
            </div>

            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <p class="text-[9px] text-slate-500 uppercase font-black tracking-widest mb-1">Processed Count</p>
              <p class="text-lg font-bold text-white">@(Model.LastRunRecord?.ProcessedCount ?? 0)</p>
            </div>

            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <p class="text-[9px] text-slate-500 uppercase font-black tracking-widest mb-1">Sent Last Run</p>
              <p class="text-lg font-bold text-white">@(Model.LastRunRecord?.SentCount ?? 0)</p>
            </div>

            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <p class="text-[9px] text-slate-500 uppercase font-black tracking-widest mb-1">Failed Last Run</p>
              <p class="text-lg font-bold text-white">@(Model.LastRunRecord?.FailedCount ?? 0)</p>
            </div>

            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <p class="text-[9px] text-slate-500 uppercase font-black tracking-widest mb-1">Interval (Mins)</p>
              <input class="w-full bg-transparent border-none p-0 text-lg font-bold text-white focus:ring-0" 
                     type="number" name="NotificationSettings.CheckIntervalMinutes" value="@Model.NotificationSettings.CheckIntervalMinutes" />
            </div>

            <div class="flex items-center justify-end">
              <button
                class="w-full h-full bg-white/5 hover:bg-white/10 border border-white/20 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all"
                type="button"
                data-open-modal="modalLastRun"
              >
                View Last Run Details
              </button>
            </div>
          </div>
        </div>

        <!-- Provider Settings -->
        <input type="hidden" name="ProviderSettings.Id" value="@Model.ProviderSettings.Id" />
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-8 border-b border-white/5 pb-4">
            <div class="flex items-center gap-4">
              <h3 class="text-lg font-bold flex items-center gap-2">
                <span class="material-symbols-outlined text-gold">api</span>
                Provider Settings
              </h3>
              <div class="h-4 w-[1px] bg-white/10"></div>
              <div class="flex items-center gap-2 bg-yellow-500/10 border border-yellow-500/30 px-3 py-1 rounded">
                <span class="text-[10px] font-bold text-yellow-500 uppercase tracking-widest">Sandbox Mode</span>
                <input type="hidden" name="ProviderSettings.SandboxModeEnabled" id="SandboxModeEnabled" value="@Model.ProviderSettings.SandboxModeEnabled.ToString().ToLower()" />
                <span class="material-symbols-outlined text-yellow-500 text-lg toggle-icon"
                      data-target="SandboxModeEnabled"
                      onclick="toggleState(this)">
                      @(Model.ProviderSettings.SandboxModeEnabled ? "toggle_on" : "toggle_off")
                </span>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <button
                class="px-5 py-2 border border-gold/40 text-gold text-[10px] font-black uppercase tracking-widest rounded hover:bg-gold/10 transition-colors"
                type="button"
                data-open-modal="modalTestProvider"
              >
                Test Provider
              </button>
              <button type="submit" class="px-8 py-2 bg-gold text-pure-black text-[10px] font-black uppercase tracking-widest rounded shadow-lg shadow-gold/20 hover:brightness-110">
                Save
              </button>
            </div>
          </div>

          <div class="grid grid-cols-4 gap-6">
            <div class="space-y-4">
              <div>
                <label class="block text-[9px] uppercase tracking-widest font-black text-gold mb-1.5">Provider</label>
                <input class="w-full bg-black/40 border-white/10 rounded-lg py-2 px-3 text-sm text-white focus:border-gold focus:ring-0" 
                       type="text" name="ProviderSettings.ProviderType" value="@Model.ProviderSettings.ProviderType" readonly />
              </div>
              <div>
                <label class="block text-[9px] uppercase tracking-widest font-black text-slate-500 mb-1.5">Reply-To</label>
                <input class="w-full bg-black/20 border-white/10 text-white rounded-lg py-2 px-3 text-sm" 
                       type="email" name="ProviderSettings.DefaultReplyToEmail" value="@Model.ProviderSettings.DefaultReplyToEmail" />
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-[9px] uppercase tracking-widest font-black text-gold mb-1.5">Secret Key</label>
                <input class="w-full bg-black/40 border-white/10 rounded-lg py-2 px-3 text-sm text-gray-500 focus:border-gold focus:ring-0" 
                       type="password" value="************************" readonly title="Managed via Environment" />
              </div>
              <div>
                <label class="block text-[9px] uppercase tracking-widest font-black text-slate-500 mb-1.5">Rate Limit (emails/min)</label>
                <input class="w-full bg-black/20 border-white/10 text-white rounded-lg py-2 px-3 text-sm" 
                       type="number" name="ProviderSettings.RateLimitPerMinute" value="@Model.ProviderSettings.RateLimitPerMinute" />
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-[9px] uppercase tracking-widest font-black text-slate-500 mb-1.5">Retry Count</label>
                <input class="w-full bg-black/20 border-white/10 text-white rounded-lg py-2 px-3 text-sm" 
                       type="number" name="ProviderSettings.RetryCount" value="@Model.ProviderSettings.RetryCount" />
              </div>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-[9px] uppercase tracking-widest font-black text-slate-500 mb-1.5">Retry Delay (mins)</label>
                <input class="w-full bg-black/20 border-white/10 text-white rounded-lg py-2 px-3 text-sm" 
                       type="number" name="ProviderSettings.RetryDelayMinutes" value="@Model.ProviderSettings.RetryDelayMinutes" />
              </div>
            </div>
          </div>
        </div>

        <!-- Sender Identities -->
        <div class="glass-card rounded-2xl p-6">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-gold">verified_user</span>
              Sender Identities
            </h3>
            <button class="text-[10px] text-gold font-black hover:underline tracking-[0.2em] uppercase" 
                    type="button" 
                    data-open-modal="modalIdentity"
                    onclick="openCreateIdentity()">
              + Add Identity
            </button>
          </div>

          <div class="overflow-hidden border border-white/10 rounded-xl bg-black/20">
            <table class="w-full text-left text-sm">
              <thead class="bg-white/5 text-[9px] uppercase tracking-widest font-black text-slate-500 border-b border-white/5">
                <tr>
                  <th class="px-6 py-4">Label &amp; Status</th>
                  <th class="px-6 py-4">Email Address</th>
                  <th class="px-6 py-4">Reply-To</th>
                  <th class="px-6 py-4 text-center">Active</th>
                  <th class="px-6 py-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                @foreach(var identity in Model.SenderIdentities)
                {
                    <tr class="hover:bg-white/[0.04] transition-colors">
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-2">
                          <span class="font-bold text-white">@identity.DisplayName</span>
                          @if(identity.IsDefault) {
                            <span class="material-symbols-outlined text-[16px] text-gold fill-1" title="Default">stars</span>
                          }
                          @if(identity.VerifiedStatus == "Verified") {
                             <span class="ml-2 text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">Verified</span>
                          }
                          else {
                             <span class="ml-2 text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded bg-yellow-500/10 border border-yellow-500/20 text-yellow-400">Pending</span>
                          }
                        </div>
                      </td>
                      <td class="px-6 py-4 text-slate-400">@identity.FromEmail</td>
                      <td class="px-6 py-4 text-slate-500">@identity.ReplyToEmail</td>
                      <td class="px-6 py-4 text-center">
                         <button type="button" 
                                 onclick="toggleIdentityActive(@identity.Id)"
                                 class="material-symbols-outlined @(identity.IsActive ? "text-green-500" : "text-gray-500") text-xl">
                             toggle_on
                         </button>
                      </td>
                      <td class="px-6 py-4 text-right">
                        <div class="flex justify-end gap-3 text-slate-500">
                          <button class="hover:text-gold transition-colors material-symbols-outlined text-lg" type="button">star</button>
                          <button class="hover:text-white transition-colors material-symbols-outlined text-lg" 
                                  type="button" 
                                  data-open-modal="modalIdentity"
                                  onclick="openEditIdentity(@identity.Id, '@identity.DisplayName', '@identity.FromEmail', '@identity.ReplyToEmail', @identity.IsActive.ToString().ToLower(), @identity.IsDefault.ToString().ToLower())">
                              edit
                          </button>
                          <button class="hover:text-red-400 transition-colors material-symbols-outlined text-lg" 
                                  type="button"
                                  onclick="deleteIdentity(@identity.Id)">
                              delete
                          </button>
                        </div>
                      </td>
                    </tr>
                }
              </tbody>
            </table>
          </div>
        </div>

        <!-- Feature Routing Expansion -->
        <div class="space-y-4">
          <h3 class="text-lg font-bold flex items-center gap-2 px-2">
            <span class="material-symbols-outlined text-gold">route</span>
            Feature Routing Expansion
          </h3>

          <div class="space-y-4">
             @foreach(var group in Model.FeatureConfigs.GroupBy(c => c.Category))
             {
                <div class="glass-card rounded-xl overflow-hidden border-gold/10">
                  <div class="p-4 bg-white/5 flex items-center justify-between cursor-pointer" onclick="this.nextElementSibling.classList.toggle('hidden')">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-gold">
                            @(group.Key == "Authentication & Security" ? "lock_open" : 
                              group.Key == "Customer & Lifecycle" ? "person" : 
                              group.Key == "Background Reminders" ? "schedule" : "admin_panel_settings")
                        </span>
                      <span class="font-bold uppercase text-sm tracking-wide text-white">@group.Key</span>
                    </div>
                    <span class="material-symbols-outlined text-gold">expand_more</span>
                  </div>

                  <div class="p-4 bg-black/20 space-y-2">
                    <div class="grid grid-cols-12 gap-4 text-[9px] uppercase font-black tracking-widest text-slate-500 mb-3 px-2">
                      <div class="col-span-1 text-center">Enabled</div>
                      <div class="col-span-4">Feature Event</div>
                      <div class="col-span-3">Sender Identity</div>
                      <div class="col-span-3">Template Mapping</div>
                      <div class="col-span-1 text-center">Preview</div>
                    </div>
                    
                    @foreach(var config in group)
                    {
                        var idx = Model.FeatureConfigs.IndexOf(config);
                        <input type="hidden" name="FeatureConfigs[@idx].Id" value="@config.Id" />
                        <input type="hidden" name="FeatureConfigs[@idx].FeatureKey" value="@config.FeatureKey" />
                        <input type="hidden" name="FeatureConfigs[@idx].FeatureName" value="@config.FeatureName" />
                        <input type="hidden" name="FeatureConfigs[@idx].Category" value="@config.Category" />

                        <div class="grid grid-cols-12 gap-4 items-center bg-white/[0.03] p-3 rounded-lg border border-white/5">
                          <div class="col-span-1 flex justify-center">
                             <input type="hidden" name="FeatureConfigs[@idx].Enabled" id="FC_Enabled_@idx" value="@config.Enabled.ToString().ToLower()" />
                             <span class="material-symbols-outlined text-gold text-xl toggle-icon"
                                   data-target="FC_Enabled_@idx"
                                   onclick="toggleState(this)">
                                   @(config.Enabled ? "toggle_on" : "toggle_off")
                             </span>
                          </div>
                          <div class="col-span-4 text-sm font-medium text-white">@config.FeatureName</div>
                          <div class="col-span-3">
                              <select name="FeatureConfigs[@idx].SenderIdentityId" class="w-full bg-black border-white/10 rounded py-1 text-xs text-slate-300">
                                  <option value="">Default Provider</option>
                                  @foreach(var sid in Model.SenderIdentities)
                                  {
                                      <option value="@sid.Id" selected="@(config.SenderIdentityId == sid.Id)">@sid.DisplayName</option>
                                  }
                              </select>
                          </div>
                          <div class="col-span-3">
                              <select name="FeatureConfigs[@idx].TemplateKey" class="w-full bg-black border-white/10 rounded py-1 text-xs text-gold font-mono">
                                  <option value="">(None)</option>
                                  @foreach(var tmpl in Model.AvailableTemplates)
                                  {
                                      <option value="@tmpl.TemplateKey" selected="@(config.TemplateKey == tmpl.TemplateKey)">@tmpl.TemplateKey</option>
                                  }
                              </select>
                          </div>
                          <div class="col-span-1 flex justify-center">
                            <button class="text-gold/60 hover:text-gold transition-colors" 
                                    type="button" 
                                    data-open-modal="modalTemplatePreview"
                                    onclick="previewTemplate('@config.TemplateKey')">
                              <span class="material-symbols-outlined text-lg">visibility</span>
                            </button>
                          </div>
                        </div>
                    }
                  </div>
                </div>
             }
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="col-span-3 sticky top-10 space-y-6">

        <div class="space-y-3">
          <a href="/Admin/EmailServices/Templates" class="w-full py-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-2xl flex items-center justify-between px-6 group transition-all" type="button">
            <span class="text-[10px] font-black uppercase tracking-widest text-slate-300 group-hover:text-white">Open Templates</span>
            <span class="material-symbols-outlined text-gold">auto_stories</span>
          </a>
          <a href="/Admin/EmailServices/SendEmail/Drafts" class="w-full py-4 bg-white/5 hover:bg-white/10 border border-white/10 rounded-2xl flex items-center justify-between px-6 group transition-all" type="button">
            <span class="text-[10px] font-black uppercase tracking-widest text-slate-300 group-hover:text-white">Open Outbox (Drafts)</span>
            <span class="material-symbols-outlined text-gold">outbox</span>
          </a>
        </div>

        <!-- Reminder Testing -->
        <div class="glass-card rounded-2xl p-6 border-gold/20">
          <h3 class="text-sm font-black text-white uppercase tracking-widest mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-gold">biotech</span>
            Reminder Testing
          </h3>
           <div class="space-y-4">
            <div>
              <label class="block text-[9px] uppercase tracking-widest font-black text-slate-500 mb-2">Booking ID</label>
              <input id="bookingIdInput" class="w-full bg-black/40 border-white/10 rounded-lg py-2 px-3 text-sm text-white focus:border-gold focus:ring-0" placeholder="e.g. RL-BK-9921" type="text" />
            </div>

            <div class="grid grid-cols-1 gap-2">
              <button class="w-full py-2 bg-gold/10 hover:bg-gold/20 border border-gold/30 text-gold text-[10px] font-black uppercase tracking-widest rounded transition-all" 
                      type="button" onclick="alert('Manual trigger feature coming soon')">
                Test Payment
              </button>
               <button class="w-full py-2 bg-gold/10 hover:bg-gold/20 border border-gold/30 text-gold text-[10px] font-black uppercase tracking-widest rounded transition-all" 
                      type="button" onclick="alert('Manual trigger feature coming soon')">
                Test Pickup
              </button>
               <button class="w-full py-2 bg-gold/10 hover:bg-gold/20 border border-gold/30 text-gold text-[10px] font-black uppercase tracking-widest rounded transition-all" 
                      type="button" onclick="alert('Manual trigger feature coming soon')">
                Test Return
              </button>
            </div>
          </div>
        </div>

        <!-- Reminder Policies -->
        <div class="glass-card rounded-2xl p-6">
          <h3 class="text-sm font-black text-white uppercase tracking-widest mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-gold">history_toggle_off</span>
            Reminder Policies
          </h3>
          
          <div class="space-y-4 max-h-[400px] overflow-y-auto custom-scrollbar pr-1">
             <!-- Payment Reminder -->
             <div class="space-y-3 p-3 rounded-xl bg-white/5 border border-white/5">
                <div class="flex justify-between items-center">
                   <span class="text-[10px] font-black text-white uppercase tracking-widest">Payment Reminder</span>
                   <input type="hidden" name="NotificationSettings.PaymentReminderEnabled" id="PaymentReminderEnabled" value="@Model.NotificationSettings.PaymentReminderEnabled.ToString().ToLower()" />
                   <span class="material-symbols-outlined text-gold toggle-icon" data-target="PaymentReminderEnabled" onclick="toggleState(this)">
