  <!-- 1) View Last Run Details Modal -->
  <div id="modalLastRun" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/70" onclick="closeModal(this.parentElement)"></div>
    <div class="absolute inset-0 flex items-center justify-center p-6 pointer-events-none">
      <div class="glass-card w-full max-w-5xl rounded-2xl border border-gold/20 overflow-hidden pointer-events-auto">
        <div class="p-5 bg-white/5 border-b border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-gold">query_stats</span>
            <div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-slate-500 font-black">Last Run Summary</p>
              <h3 class="text-lg font-black text-white">@Model.LastRunRecord?.RunAt.ToLocalTime().ToString("g")</h3>
            </div>
          </div>
          <button class="material-symbols-outlined text-slate-400 hover:text-white transition-colors" type="button" data-close-modal>close</button>
        </div>

        <div class="p-6 space-y-5 bg-black/20">
             <!-- Modal Content Bound to LastRunRecord -->
              @if(Model.LastRunRecord != null && Model.LastRunRecord.RunItems != null)
              {
                  <div class="overflow-hidden border border-white/10 rounded-xl bg-black/30 max-h-[400px] overflow-y-auto custom-scrollbar">
                    <table class="w-full text-left">
                      <thead class="bg-white/5 text-[9px] uppercase tracking-widest font-black text-slate-500 border-b border-white/10">
                        <tr>
                          <th class="px-5 py-3">Event Type</th>
                          <th class="px-5 py-3">Recipient</th>
                          <th class="px-5 py-3">Result</th>
                          <th class="px-5 py-3">Error</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-white/5 text-sm">
                        @foreach(var item in Model.LastRunRecord.RunItems)
                        {
                            <tr class="hover:bg-white/[0.04] transition-colors">
                              <td class="px-5 py-3 text-white font-semibold">@item.EventType</td>
                              <td class="px-5 py-3 text-slate-400">@item.RecipientEmail</td>
                              <td class="px-5 py-3">
                                @if(item.Result == "Success") {
                                    <span class="text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">Success</span>
                                } else {
                                    <span class="text-[9px] font-black uppercase tracking-widest px-2 py-1 rounded bg-red-500/10 border border-red-500/20 text-red-400">Failed</span>
                                }
                              </td>
                              <td class="px-5 py-3 text-slate-500">@item.Error</td>
                            </tr>
                        }
                      </tbody>
                    </table>
                  </div>
              }
              else
              {
                  <p class="text-slate-400">No details available for the last run.</p>
              }
          <div class="flex justify-end gap-3">
            <button class="px-6 py-2 bg-gold text-pure-black rounded text-[10px] font-black uppercase tracking-widest" type="button" data-close-modal>
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

