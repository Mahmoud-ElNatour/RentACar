        </div>

        <div class="p-6 bg-black/20 space-y-4">
          <div class="flex items-center justify-between bg-white/5 border border-white/10 rounded-xl p-4">
            <div>
              <p class="text-[9px] uppercase tracking-widest font-black text-slate-500">Context</p>
              <p class="text-white font-bold" id="recipientContextName">Marketing Operations DL</p>
            </div>
            <div class="text-right">
              <p class="text-[9px] uppercase tracking-widest font-black text-slate-500">Status</p>
              <p class="text-emerald-400 font-black text-md">Active</p>
            </div>
          </div>

          <div class="bg-white/5 border border-white/10 rounded-xl p-4 max-h-[320px] overflow-y-auto custom-scrollbar space-y-2" id="recipientListContainer">
             <p class="text-xs text-slate-400 font-mono">Loading recipients...</p>
          </div>

          <div class="flex justify-end gap-3">
            <button class="px-6 py-2 bg-gold text-pure-black rounded text-[10px] font-black uppercase tracking-widest" type="button" data-close-modal>
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script>
    (function () {
      const openButtons = document.querySelectorAll("[data-open-modal]");
      const closeButtons = document.querySelectorAll("[data-close-modal]");

      function openModal(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove("hidden");
      }

      window.closeModal = function(el) {
        if (!el) return;
        el.classList.add("hidden");
      }

      openButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-open-modal");
          openModal(id);
        });
      });

      closeButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          const modal = btn.closest(".fixed.inset-0");
          closeModal(modal);
        });
      });

      // close on ESC
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          document.querySelectorAll(".fixed.inset-0").forEach(m => m.classList.add("hidden"));
        }
      });
    })();

    // Toggle Helper
    function toggleState(icon) {
        const targetId = icon.getAttribute("data-target");
        const input = document.getElementById(targetId);
        if(!input) return;

        const currentVal = input.value === "true";
        const newVal = !currentVal;
        
        input.value = newVal.toString().toLowerCase();
        icon.textContent = newVal ? "toggle_on" : "toggle_off";
    }

    // Modal Helpers
    window.openCreateIdentity = function() {
        document.getElementById('modalIdentityTitle').textContent = "Add Identity";
        document.getElementById('identityForm').action = "@Url.Action("CreateSender")";
        document.getElementById('SenderId').value = "0";
        document.getElementById('SenderDisplayName').value = "";
        document.getElementById('SenderFromEmail').value = "";
        document.getElementById('SenderReplyToEmail').value = "";
        document.getElementById('SenderIsActive').value = "true";
        document.querySelector('[data-target="SenderIsActive"]').textContent = "toggle_on";
        document.getElementById('SenderIsDefault').value = "false";
        document.querySelector('[data-target="SenderIsDefault"]').textContent = "toggle_off";
    }

    window.openEditIdentity = function(id, name, email, replyTo, isActive, isDefault) {
        document.getElementById('modalIdentityTitle').textContent = "Edit Identity";
        document.getElementById('identityForm').action = "@Url.Action("EditSender")";
        document.getElementById('SenderId').value = id;
        document.getElementById('SenderDisplayName').value = name;
        document.getElementById('SenderFromEmail').value = email;
        document.getElementById('SenderReplyToEmail').value = replyTo || "";
        document.getElementById('SenderIsActive').value = isActive ? "true" : "false";
        document.querySelector('[data-target="SenderIsActive"]').textContent = isActive ? "toggle_on" : "toggle_off";
        document.getElementById('SenderIsDefault').value = isDefault ? "true" : "false";
        document.querySelector('[data-target="SenderIsDefault"]').textContent = isDefault ? "toggle_on" : "toggle_off";
    }

    window.deleteIdentity = function(id) {
        if(confirm("Are you sure you want to delete this identity?")) {
            var form = document.createElement('form');
            form.method = 'post';
            form.action = '/Admin/EmailServices/NotificationsEmailManagement/Sender/Delete/' + id;
            document.body.appendChild(form);
            form.submit();
        }
    }

    window.toggleIdentityActive = function(id) {
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '/Admin/EmailServices/NotificationsEmailManagement/Sender/ToggleActive/' + id;
        document.body.appendChild(form);
        form.submit();
    }
    
    // Preview Logic
    window.previewTemplate = function(templateKey) {
        document.getElementById('previewTemplateKey').innerText = templateKey || "Unknown";
        document.getElementById('previewSubject').innerText = "Loading specific template...";
        document.getElementById('previewBody').innerHTML = "<p class='text-gold'>Simulated visual preview for " + templateKey + "</p>";
    }

    window.previewRecipients = function(featureName) {
        document.getElementById('recipientContextName').innerText = featureName;
        document.getElementById('recipientListContainer').innerHTML = "<p class='text-xs text-slate-400 font-mono'>Fetching list members for " + featureName + "...</p><p class='text-xs text-slate-500 font-mono mt-2'>[Simulation] Dynamic retrieval would occur here.</p>";
    }
  </script>
</body>
</html>
