@model RentACar.Web.Models.DriverBookingDetailsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pickupLat = Model.PickupLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var pickupLng = Model.PickupLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var driverLat = Model.DriverLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var driverLng = Model.DriverLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var statusLabel = Model.TripStatus?.ToLowerInvariant() switch
    {
        "assigned" => "Assigned",
        "pending" => "Scheduled",
        "booked" => "Scheduled",
        "ontheway" => "On the way",
        "on the way" => "On the way",
        "on_the_way" => "On the way",
        "arrived" => "Arrived",
        "intrip" => "In Trip",
        "in trip" => "In Trip",
        "in_trip" => "In Trip",
        "completed" => "Completed",
        "cancelled" => "Cancelled",
        _ => string.IsNullOrWhiteSpace(Model.TripStatus) ? "Assigned" : Model.TripStatus
    };
    var normalizedTripStatus = (Model.TripStatus ?? "Assigned").Trim().ToLowerInvariant();
    var isTerminal = normalizedTripStatus == "completed" || normalizedTripStatus == "cancelled";
}
<style>
    .glass-card {
        background: rgba(39, 36, 27, 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .status-pill {
        border-radius: 9999px;
        padding: 0.35rem 0.8rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 700;
    }

    .trip-map {
        height: 360px;
        min-height: 280px;
    }

    .pulse-live {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @@keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }
    }
</style>

<main class="px-6 md:px-20 lg:px-32 flex flex-1 justify-center py-8">
    <div class="layout-content-container flex flex-col max-w-[1100px] flex-1 gap-6">
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2 text-white/50 text-sm font-medium">
                <a class="hover:text-primary" href="@Url.Action("Dashboard", "DriverPortal")">Bookings</a>
                <span>/</span>
                <span class="text-white">BK-@Model.BookingId</span>
            </div>
            <div class="flex flex-wrap justify-between items-center gap-4 py-2">
                <div class="flex flex-col gap-1">
                    <h1 class="text-white text-3xl md:text-4xl font-black leading-tight tracking-[-0.033em]">Trip Overview</h1>
                    <p class="text-white/60 text-base">Booking #@Model.BookingId • @Model.CustomerName</p>
                </div>
                <span class="status-pill bg-primary/20 text-primary border border-primary/30" id="statusPill">@statusLabel</span>
            </div>
        </div>

        <div class="p-px rounded-xl bg-gradient-to-r from-primary/30 to-transparent">
            <div class="glass-card rounded-xl p-6 flex flex-wrap md:flex-nowrap items-center gap-8 shadow-2xl">
                <div class="flex-1 space-y-3">
                    <div>
                        <h2 class="text-2xl font-bold text-white leading-none mb-1">@Model.CarName</h2>
                        <p class="text-white/60 font-medium">Plate: <span class="text-primary/80">@Model.CarPlate</span></p>
                    </div>
                    <div class="text-white/60">
                        Pickup: @Model.PickupLocationLabel
                        @if (Model.PickupDateTime.HasValue)
                        {
                            <span class="ms-2 text-primary">@Model.PickupDateTime.Value:g</span>
                        }
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <a id="navigateButton" class="bg-primary text-background-dark px-4 py-2 rounded-lg font-bold text-sm shadow-[0_0_15px_rgba(244,195,37,0.3)] hover:scale-105 transition-transform" target="_blank" rel="noopener noreferrer">
                        Navigate
                    </a>
                    <span class="text-xs text-white/50">Opens Google Maps</span>
                </div>
            </div>
        </div>

        <div class="glass-card rounded-xl p-4 md:p-6 shadow-2xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white">Route to Pickup</h3>
                <div class="flex items-center gap-2 bg-green-500/10 px-3 py-1.5 rounded-full border border-green-500/20">
                    <div class="size-2 rounded-full bg-green-500 pulse-live"></div>
                    <span class="text-green-500 text-[10px] font-black tracking-widest uppercase" id="trackingStatus">Live: Not started</span>
                </div>
            </div>
            <div id="tripMap" class="trip-map rounded-xl border border-white/10"></div>
            <p class="text-white/40 text-xs mt-3">Pickup pin always shown with route guidance to help you arrive fast.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="glass-card rounded-xl flex flex-col p-6 shadow-xl">
                <h3 class="text-lg font-bold text-white flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-primary">person</span>
                    Customer
                </h3>
                <p class="text-white/80">@Model.CustomerName</p>
                <p class="text-white/50 text-sm">Driver ID: @Model.DriverId</p>
            </div>
            <div class="glass-card rounded-xl flex flex-col p-6 shadow-xl">
                <h3 class="text-lg font-bold text-white flex items-center gap-2 mb-4">
                    <span class="material-symbols-outlined text-primary">location_on</span>
                    Pickup Location
                </h3>
                <p class="text-white/80">@Model.PickupLocationLabel</p>
                <p class="text-white/50 text-xs mt-2">Pin: @(string.IsNullOrWhiteSpace(pickupLat) || string.IsNullOrWhiteSpace(pickupLng) ? "Not set" : $"{pickupLat}, {pickupLng}")</p>
            </div>
            <div class="glass-card rounded-xl flex flex-col p-6 shadow-xl gap-3">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">flag</span>
                    Trip Actions
                </h3>
                <div class="flex flex-col gap-3">
                    @if (normalizedTripStatus == "assigned")
                    {
                        <form method="post" asp-action="StartTracking">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.BookingId" />
                            <button class="h-12 w-full rounded-xl bg-primary text-background-dark text-sm font-black tracking-wider shadow-[0_0_20px_-5px_#f4c325] hover:brightness-110 transition-all">
                                Start Tracking / On the way
                            </button>
                        </form>
                    }
                    else if (normalizedTripStatus == "ontheway" || normalizedTripStatus == "on_the_way" || normalizedTripStatus == "on the way")
                    {
                        <form method="post" asp-action="MarkArrived">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.BookingId" />
                            <button class="h-12 w-full rounded-xl border border-white/10 text-white font-semibold hover:bg-white/10 transition-all">I Arrived</button>
                        </form>
                    }
                    else if (normalizedTripStatus == "arrived")
                    {
                        <form method="post" asp-action="StartTrip">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.BookingId" />
                            <button class="h-12 w-full rounded-xl bg-primary text-background-dark text-sm font-black tracking-wider shadow-[0_0_20px_-5px_#f4c325] hover:brightness-110 transition-all">
                                Start Trip
                            </button>
                        </form>
                    }
                    else if (normalizedTripStatus == "intrip" || normalizedTripStatus == "in_trip" || normalizedTripStatus == "in trip")
                    {
                        <form method="post" asp-action="CompleteTrip">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookingId" value="@Model.BookingId" />
                            <button class="h-12 w-full rounded-xl border border-green-500/40 text-green-400 font-semibold hover:bg-green-500/10 transition-all">Complete Trip</button>
                        </form>
                    }
                    else if (normalizedTripStatus == "completed")
                    {
                        <button class="h-12 rounded-xl border border-green-500/40 text-green-400 font-semibold opacity-70 cursor-not-allowed" disabled>
                            Trip Completed
                        </button>
                    }
                    else if (normalizedTripStatus == "cancelled")
                    {
                        <button class="h-12 rounded-xl border border-red-500/40 text-red-400 font-semibold opacity-70 cursor-not-allowed" disabled>
                            Trip Cancelled
                        </button>
                    }
                </div>
                @if (!isTerminal)
                {
                    <form method="post" asp-action="CancelTrip" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.BookingId" />
                        <input type="text" name="reason" placeholder="Cancel reason (optional)"
                               class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs text-white/80 placeholder:text-white/40" />
                        <button class="mt-2 h-10 w-full rounded-xl border border-red-500/30 text-red-400 font-semibold hover:bg-red-500/10 transition-all">
                            Cancel Trip
                        </button>
                    </form>
                }
                @if (TempData["TripError"] != null)
                {
                    <div id="statusMessage" class="text-xs text-red-400">@TempData["TripError"]</div>
                }
            </div>
        </div>

        <div class="glass-card rounded-xl p-6 border border-primary/10 shadow-2xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white">Live Tracking</h3>
                <div class="text-xs text-white/50" id="trackingHint">Share your location while en route.</div>
            </div>
            <div class="flex flex-col md:flex-row gap-4">
                <button id="startTracking"
                        class="flex-1 h-14 flex items-center justify-center rounded-xl bg-primary text-background-dark text-base font-black tracking-wider shadow-[0_0_25px_-5px_#f4c325] hover:brightness-110 transition-all">
                    <span class="material-symbols-outlined mr-3 font-black text-2xl">sensors</span>
                    Start Tracking
                </button>
                <button id="stopTracking"
                        class="flex-1 h-14 flex items-center justify-center rounded-xl border-2 border-red-500/30 bg-red-500/5 text-red-500 font-bold hover:bg-red-500/10 transition-all group">
                    <span class="material-symbols-outlined mr-2 group-hover:rotate-180 transition-transform">stop_circle</span>
                    Stop Tracking
                </button>
            </div>
            <div class="flex items-center gap-3 mt-4 text-xs text-white/60">
                <span id="gpsSignal">GPS: Ready</span>
                <span id="accuracyStatus">Accuracy: --</span>
                <span id="trackingError" class="text-red-400 hidden"></span>
                <button id="retryTracking" class="text-primary underline hidden">Retry</button>
            </div>
        </div>
    </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" integrity="sha512-1Yf1sAP0f1C4XqE1P6rrG0o7b4EJhp3hsl2Ov9gfy6dqr8e3VshqV4xRtZ8y6k+GOpAxv4C9M4D9YolX2a+8tw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
    const bookingId = @Model.BookingId;
    const driverId = @Model.DriverId;
    const pickupLat = '@pickupLat';
    const pickupLng = '@pickupLng';
    const initialDriverLat = '@driverLat';
    const initialDriverLng = '@driverLng';

    const statusPill = document.getElementById('statusPill');
    const trackingStatus = document.getElementById('trackingStatus');
    const trackingError = document.getElementById('trackingError');
    const retryTracking = document.getElementById('retryTracking');
    const gpsSignal = document.getElementById('gpsSignal');
    const accuracyStatus = document.getElementById('accuracyStatus');

    let watchId = null;
    let lastSentAt = 0;
    let lastSentPosition = null;
    let lastMovementAt = 0;
    let isIdle = false;
    let hubConnection = null;

    const throttleMs = 25000;
    const idleMs = 120000;
    const movementThresholdMeters = 15;

    let map;
    let driverMarker;
    let pickupMarker;
    let directionsService;
    let directionsRenderer;

    function haversineMeters(a, b) {
        if (!a || !b) return 0;
        const toRad = (deg) => (deg * Math.PI) / 180;
        const R = 6371000;
        const dLat = toRad(b.lat - a.lat);
        const dLng = toRad(b.lng - a.lng);
        const lat1 = toRad(a.lat);
        const lat2 = toRad(b.lat);
        const sinLat = Math.sin(dLat / 2);
        const sinLng = Math.sin(dLng / 2);
        const h = sinLat * sinLat + Math.cos(lat1) * Math.cos(lat2) * sinLng * sinLng;
        return 2 * R * Math.asin(Math.sqrt(h));
    }

    function updateTrackingStatus(message) {
        trackingStatus.textContent = message;
    }

    async function ensureHubConnection() {
        if (hubConnection) {
            return hubConnection;
        }

        hubConnection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/driverTracking')
            .withAutomaticReconnect()
            .build();

        hubConnection.on('DriverLocationUpdated', (payload) => {
            if (!payload || payload.bookingId !== bookingId) return;
            const position = { lat: payload.latitude, lng: payload.longitude };
            updateDriverMarker(position);
        });

        await hubConnection.start();
        await hubConnection.invoke('JoinBookingGroup', bookingId);
        return hubConnection;
    }

    async function sendLocation(position) {
        const connection = await ensureHubConnection();
        await connection.invoke('UpdateLocation', bookingId, driverId, position.coords.latitude, position.coords.longitude, new Date().toISOString(),
            position.coords.speed ?? null, position.coords.heading ?? null, position.coords.accuracy ?? null);

        lastSentAt = Date.now();
        lastSentPosition = { lat: position.coords.latitude, lng: position.coords.longitude };
        gpsSignal.textContent = 'GPS: Live';
        accuracyStatus.textContent = `Accuracy: ${position.coords.accuracy ? Math.round(position.coords.accuracy) + 'm' : '--'}`;
        updateTrackingStatus(`Live: Last sent ${new Date().toLocaleTimeString()}`);
    }

    function shouldSend(position) {
        if (!lastSentPosition) {
            lastMovementAt = Date.now();
            return true;
        }

        const current = { lat: position.coords.latitude, lng: position.coords.longitude };
        const distance = haversineMeters(lastSentPosition, current);
        const moved = distance >= movementThresholdMeters;

        if (moved) {
            lastMovementAt = Date.now();
            if (isIdle) {
                isIdle = false;
            }
        }

        if (isIdle) {
            return false;
        }

        if (Date.now() - lastMovementAt >= idleMs) {
            isIdle = true;
            updateTrackingStatus('Live: Idle (waiting for movement)');
            return false;
        }

        if (!moved) {
            return false;
        }

        return Date.now() - lastSentAt >= throttleMs;
    }

    function onGeoError(err) {
        gpsSignal.textContent = 'GPS: Permission required';
        trackingError.textContent = 'Location permission denied. Please allow location access.';
        trackingError.classList.remove('hidden');
        retryTracking.classList.remove('hidden');
        console.error('Geolocation error:', err);
    }

    function startWatching() {
        if (!navigator.geolocation) {
            trackingError.textContent = 'Geolocation is not supported by this browser.';
            trackingError.classList.remove('hidden');
            return;
        }

        if (watchId) return;

        trackingError.classList.add('hidden');
        retryTracking.classList.add('hidden');
        gpsSignal.textContent = 'GPS: Requesting...';
        updateTrackingStatus('Live: Requesting location...');

        watchId = navigator.geolocation.watchPosition(
            async (position) => {
                if (!lastSentPosition) {
                    await sendLocation(position);
                } else if (shouldSend(position)) {
                    await sendLocation(position);
                }
            },
            onGeoError,
            {
                enableHighAccuracy: true,
                maximumAge: 1000,
                timeout: 10000
            }
        );
    }

    function stopWatching() {
        if (watchId) {
            navigator.geolocation.clearWatch(watchId);
            watchId = null;
        }
        updateTrackingStatus('Live: Tracking stopped');
        gpsSignal.textContent = 'GPS: Stopped';
    }

    function updateDriverMarker(position) {
        if (!map || !driverMarker) return;
        driverMarker.setPosition(position);
        updateRoute(position);
    }

    function updateRoute(origin) {
        if (!directionsService || !directionsRenderer || !pickupMarker) return;
        directionsService.route({
            origin,
            destination: pickupMarker.getPosition(),
            travelMode: google.maps.TravelMode.DRIVING
        }, (result, status) => {
            if (status === 'OK' && result) {
                directionsRenderer.setDirections(result);
            }
        });
    }


<script>
    window.initTripMap = function () {
        if (!pickupLat || !pickupLng || !window.google) return;
        const pickup = { lat: parseFloat(pickupLat), lng: parseFloat(pickupLng) };
        const driver = initialDriverLat && initialDriverLng
            ? { lat: parseFloat(initialDriverLat), lng: parseFloat(initialDriverLng) }
            : pickup;

        window.tripMap = new google.maps.Map(document.getElementById('tripMap'), {
            center: pickup,
            zoom: 13,
            disableDefaultUI: true,
            gestureHandling: 'greedy'
        });

        pickupMarker = new google.maps.Marker({
            position: pickup,
            map: window.tripMap,
            label: 'P'
        });

        driverMarker = new google.maps.Marker({
            position: driver,
            map: window.tripMap,
            icon: {
                path: google.maps.SymbolPath.CIRCLE,
                scale: 6,
                fillColor: '#f4c325',
                fillOpacity: 1,
                strokeWeight: 2,
                strokeColor: '#111827'
            }
        });

        directionsService = new google.maps.DirectionsService();
        directionsRenderer = new google.maps.DirectionsRenderer({
            map: window.tripMap,
            suppressMarkers: true,
            polylineOptions: {
                strokeColor: '#f4c325',
                strokeOpacity: 0.9,
                strokeWeight: 4
            }
        });

        updateRoute(driver);

        const navigateButton = document.getElementById('navigateButton');
        if (navigateButton) {
            navigateButton.href = `https://www.google.com/maps/dir/?api=1&destination=${pickup.lat},${pickup.lng}`;
        }
    };

    document.getElementById('startTracking')?.addEventListener('click', startWatching);
    document.getElementById('stopTracking')?.addEventListener('click', stopWatching);
    document.getElementById('retryTracking')?.addEventListener('click', startWatching);

    if (statusPill && statusPill.textContent.toLowerCase().includes('on the way')) {
        updateTrackingStatus('Live: Tracking available');
    }
</script>

@if (!string.IsNullOrWhiteSpace(ViewBag.GoogleMapsKey))
{
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsKey&callback=initTripMap&loading=async">
    </script>
}
