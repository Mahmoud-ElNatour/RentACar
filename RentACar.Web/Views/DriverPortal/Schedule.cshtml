@model RentACar.Web.Models.DriverScheduleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "My Schedule";
}

<style>
    :root {
        --gold-primary: #D4AF37;
        --gold-glow: rgba(212, 175, 55, 0.4);
        --surface-deep: #0f172a;
        --border-glass: rgba(148, 163, 184, 0.1);
    }

    .calendar-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .glass-card {
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-glass);
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    .calendar-day {
        aspect-ratio: 1;
        border-radius: 16px;
        position: relative;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        padding: 8px;
        border: 1px solid transparent;
        background: rgba(255, 255, 255, 0.02);
    }

    .calendar-day:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(212, 175, 55, 0.3);
        transform: translateY(-2px);
    }

    .calendar-day.is-today {
        border-color: var(--gold-primary);
        box-shadow: 0 0 15px var(--gold-glow);
    }

    .calendar-day.not-current-month {
        opacity: 0.3;
        pointer-events: none;
    }

    .availability-indicator {
        position: absolute;
        bottom: 8px;
        left: 8px;
        right: 8px;
        height: 4px;
        border-radius: 999px;
    }

    .available-bar {
        background: #10b981;
    }

    .unavailable-bar {
        background: #ef4444;
    }

    .booking-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gold-primary);
        display: inline-block;
        margin-left: 2px;
    }

    /* Availability Modal Styles */
    #availabilityModal {
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .modal-content-glass {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(212, 175, 55, 0.2);
    }
</style>

<div class="py-10 px-4 sm:px-6 lg:px-8">
    <div class="calendar-container">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
            <div>
                <h1 class="text-4xl font-black text-white tracking-tight">Schedule</h1>
                <p class="text-gray-400 mt-1">Manage your availability and view upcoming trips.</p>
            </div>

            <div class="flex items-center gap-3 bg-surface-deep/50 p-2 rounded-2xl border border-white/5">
                <button onclick="changeMonth(-1)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <h2 id="currentMonthLabel" class="text-lg font-bold text-white min-w-[140px] text-center">Month Year
                </h2>
                <button onclick="changeMonth(1)" class="p-2 text-gray-400 hover:text-white transition-colors">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
                <div class="w-px h-6 bg-white/10 mx-1"></div>
                <button onclick="goToToday()"
                    class="px-4 py-1.5 text-xs font-bold bg-white/5 text-gray-300 rounded-xl hover:bg-white/10 transition-colors">
                    Today
                </button>
            </div>
        </div>

        <div class="glass-card p-6 md:p-8">
            <!-- Weekdays -->
            <div class="grid grid-cols-7 mb-4 text-center">
                @foreach (var day in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })

                {
                    <span class="text-[10px] uppercase tracking-widest text-gray-500 font-bold">@day</span>
                }
            </div>

            <!-- Calendar Grid -->
            <div id="calendarGrid" class="calendar-grid">
                <!-- Days injected via JS -->
            </div>

            <!-- Legend -->
            <div
                class="mt-8 pt-6 border-t border-white/5 flex flex-wrap gap-6 text-[10px] uppercase tracking-wider font-bold text-gray-500">
                <div class="flex items-center gap-2">
                    <div class="w-3 h-1 available-bar rounded-full"></div> Available
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-1 unavailable-bar rounded-full"></div> Unavailable
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-gold-primary"></div> Booking
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Availability Modal -->
<div id="availabilityModal"
    class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm opacity-0 invisible pointer-events-none">
    <div class="modal-content-glass w-full max-w-md rounded-3xl p-8 shadow-2xl scale-95 transition-all duration-300"
        id="modalInner">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 id="modalDateLabel" class="text-xl font-bold text-white italic">Date</h3>
                <p class="text-xs text-gray-500 mt-1 uppercase tracking-widest font-bold">Set Availability</p>
            </div>
            <button onclick="closeModal()" class="text-gray-500 hover:text-white transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form id="availabilityForm" class="space-y-6">
            <input type="hidden" id="selectedDate" name="Date" />

            <div class="flex p-1 bg-white/5 rounded-2xl border border-white/5">
                <button type="button" onclick="setAvailable(true)" id="btnAvailable"
                    class="flex-1 py-3 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">check_circle</span>
                    Available
                </button>
                <button type="button" onclick="setAvailable(false)" id="btnUnavailable"
                    class="flex-1 py-3 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">cancel</span>
                    Unavailable
                </button>
                <input type="hidden" id="isAvailableInput" name="IsAvailable" value="true" />
            </div>

            <div id="timeFields" class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Start Time</label>
                    <input type="time" name="StartTime"
                        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-gold-primary/50 outline-none transition-all" />
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">End Time</label>
                    <input type="time" name="EndTime"
                        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-gold-primary/50 outline-none transition-all" />
                </div>
            </div>

            <div class="pt-4">
                <button type="submit"
                    class="w-full bg-gold-primary text-black font-black py-4 rounded-2xl hover:bg-yellow-500 transition-all shadow-xl shadow-gold-glow flex items-center justify-center gap-2">
                    <span id="saveLabel">Save Status</span>
                    <div id="saveSpinner"
                        class="hidden animate-spin h-4 w-4 border-2 border-black border-t-transparent rounded-full">
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentViewDate = new Date();
    let availabilityRecords = [];
    let bookings = [];

    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

    async function fetchData() {
        const from = new Date(currentViewDate.getFullYear(), currentViewDate.getMonth(), 1).toISOString().split('T')[0];
        const to = new Date(currentViewDate.getFullYear(), currentViewDate.getMonth() + 1, 0).toISOString().split('T')[0];

        try {
            const resp = await fetch(`/api/driver/availability?from=${from}&to=${to}`);
            availabilityRecords = await resp.json();

            // For now, load bookings from model if needed, or fetched as well.
            // Using existing booking data passed from Model if available
            bookings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Bookings.Select(b => new {
                id = b.BookingId,
                start = b.StartDate.ToString("yyyy-MM-dd"),
                end = b.EndDate.ToString("yyyy-MM-dd")
                })));

            renderCalendar();
        } catch (e) {
            console.error("Failed to fetch data:", e);
        }
    }

    function renderCalendar() {
        const grid = document.getElementById('calendarGrid');
        grid.innerHTML = '';

        const year = currentViewDate.getFullYear();
        const month = currentViewDate.getMonth();

        document.getElementById('currentMonthLabel').textContent = `${monthNames[month]} ${year}`;

        const firstDay = new Date(year, month, 1).getDay();
        const lastDate = new Date(year, month + 1, 0).getDate();
        const prevLastDate = new Date(year, month, 0).getDate();

        // Fill previous month days
        for (let i = firstDay; i > 0; i--) {
            const dayDiv = document.createElement('div');
            dayDiv.className = 'calendar-day not-current-month';
            dayDiv.innerHTML = `<span class="text-xs font-bold text-gray-700">${prevLastDate - i + 1}</span>`;
            grid.appendChild(dayDiv);
        }

        const today = new Date();
        const todayStr = today.toISOString().split('T')[0];

        // Fill current month days
        for (let d = 1; d <= lastDate; d++) {
            const dateObj = new Date(year, month, d);
            const dateStr = dateObj.toLocaleDateString('en-CA'); // YYYY-MM-DD

            const isToday = dateStr === todayStr;
            const record = availabilityRecords.find(r => r.date === dateStr);
            const hasBookings = bookings.some(b => dateStr >= b.start && dateStr <= b.end);

            const dayDiv = document.createElement('div');
            dayDiv.className = `calendar-day ${isToday ? 'is-today' : ''}`;
            dayDiv.onclick = () => openModal(dateStr, record);

            let content = `<span class="text-sm font-bold text-white">${d}</span>`;

            if (hasBookings) {
                content += `<div class="mt-1 flex gap-0.5">${bookings.filter(b => dateStr >= b.start && dateStr <= b.end).map(() => '<div class="booking-dot"></div>').join('')}</div>`;
            }

            if (record) {
                const colorClass = record.isAvailable ? 'available-bar' : 'unavailable-bar';
                content += `<div class="availability-indicator ${colorClass}"></div>`;
            }

            dayDiv.innerHTML = content;
            grid.appendChild(dayDiv);
        }
    }

    function changeMonth(offset) {
        currentViewDate.setMonth(currentViewDate.getMonth() + offset);
        fetchData();
    }

    function goToToday() {
        currentViewDate = new Date();
        fetchData();
    }

    function openModal(dateStr, record) {
        const modal = document.getElementById('availabilityModal');
        const inner = document.getElementById('modalInner');
        const form = document.getElementById('availabilityForm');

        document.getElementById('modalDateLabel').textContent = new Date(dateStr).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
        document.getElementById('selectedDate').value = dateStr;

        form.reset();

        if (record) {
            setAvailable(record.isAvailable);
            if (record.startTime) form.StartTime.value = record.startTime.substring(0, 5);
            if (record.endTime) form.EndTime.value = record.endTime.substring(0, 5);
        } else {
            setAvailable(true); // Default
        }

        modal.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
        inner.classList.remove('scale-95');
    }

    function closeModal() {
        const modal = document.getElementById('availabilityModal');
        const inner = document.getElementById('modalInner');
        modal.classList.add('invisible', 'opacity-0', 'pointer-events-none');
        inner.classList.add('scale-95');
    }

    function setAvailable(val) {
        document.getElementById('isAvailableInput').value = val;
        const btnAvail = document.getElementById('btnAvailable');
        const btnUnavail = document.getElementById('btnUnavailable');
        const timeFields = document.getElementById('timeFields');

        if (val) {
            btnAvail.className = "flex-1 py-3 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40";
            btnUnavail.className = "flex-1 py-3 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 text-gray-500 hover:text-gray-300";
            timeFields.classList.remove('hidden');
        } else {
            btnUnavail.className = "flex-1 py-3 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 bg-red-500/20 text-red-400 border border-red-500/40";
            btnAvail.className = "flex-1 py-3 px-4 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 text-gray-500 hover:text-gray-300";
            timeFields.classList.add('hidden');
        }
    }

    document.getElementById('availabilityForm').onsubmit = async (e) => {
        e.preventDefault();
        const data = {
            date: document.getElementById('selectedDate').value,
            isAvailable: document.getElementById('isAvailableInput').value === 'true',
            startTime: e.target.StartTime.value || null,
            endTime: e.target.EndTime.value || null
        };

        const btn = e.target.querySelector('button[type="submit"]');
        const label = document.getElementById('saveLabel');
        const spinner = document.getElementById('saveSpinner');

        btn.disabled = true;
        label.classList.add('hidden');
        spinner.classList.remove('hidden');

        try {
            const resp = await fetch('/api/driver/availability', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (resp.ok) {
                closeModal();
                fetchData();
            } else {
                alert("Error saving availability");
            }
        } catch (ex) {
            console.error(ex);
        } finally {
            btn.disabled = false;
            label.classList.remove('hidden');
            spinner.classList.add('hidden');
        }
    };

    // Auto load on init
    fetchData();
</script>
