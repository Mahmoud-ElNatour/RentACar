@model RentACar.Web.Models.DriverDashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Driver Command Center";
    var googleMapsKey = ViewBag.GoogleMapsKey as string;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
    <style>
        .glass {
            background: rgba(22, 22, 22, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .pulse-gold {
            box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4);
            animation: pulse-animation 2s infinite;
        }

        @@keyframes pulse-animation {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.7);
            }

            70% {
                transform: scale(1);
                box-shadow: 0 0 0 10px rgba(212, 175, 55, 0);
            }

            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(212, 175, 55, 0);
            }
        }
        
        .glowing-dot-container {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .font-display { font-family: 'Outfit', sans-serif; }
    </style>
}

<div class="max-w-[1440px] mx-auto py-10 px-6 lg:px-10">
    <header class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-4xl font-display font-bold tracking-tight text-white">Dashboard</h1>
            <p class="text-slate-400 mt-1">Welcome back, <span class="text-primary italic font-medium">@Model.DriverName</span></p>
        </div>
        <div class="flex items-center bg-card-dark p-1.5 rounded-full border border-white/5">
            <button onclick="window.location.href='@Url.Action("Schedule", "DriverPortal")'" class="px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 shadow-sm @(Model.IsAvailable ? "bg-primary text-slate-900" : "text-slate-500 hover:text-slate-300")">
                ONLINE
            </button>
            <button onclick="window.location.href='@Url.Action("Schedule", "DriverPortal")'" class="px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 shadow-sm @(!Model.IsAvailable ? "bg-primary text-slate-900" : "text-slate-500 hover:text-slate-300")">
                OFFLINE
            </button>
        </div>
    </header>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
        <!-- Total Trips -->
        <div class="glass p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-icons-round">route</span>
            </div>
            <div>
                <p class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Total Trips</p>
                <p class="text-2xl font-display font-bold text-white">@Model.TotalTrips</p>
            </div>
        </div>
        
        <!-- Upcoming Month -->
        <div class="glass p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500">
                <span class="material-icons-round">upcoming</span>
            </div>
            <div>
                <p class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Upcoming (Month)</p>
                <p class="text-2xl font-display font-bold text-white">@Model.UpcomingTripsMonth</p>
            </div>
        </div>
        
        <!-- Completed Month -->
        <div class="glass p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
                <span class="material-icons-round">task_alt</span>
            </div>
            <div>
                <p class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Completed (Month)</p>
                <p class="text-2xl font-display font-bold text-white">@Model.CompletedTripsMonth</p>
            </div>
        </div>
        
        <!-- Hours -->
        <div class="glass p-5 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-500">
                <span class="material-icons-round">schedule</span>
            </div>
            <div>
                <p class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Driving Hours</p>
                <p class="text-2xl font-display font-bold text-white">@Model.TotalHours<span class="text-sm text-slate-500 font-normal">h</span></p>
            </div>
        </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
            <div class="flex items-center justify-between mb-2">
                <h2 class="text-xs uppercase tracking-[0.2em] font-bold text-slate-500">Today's Missions</h2>
                <a href="@Url.Action("Schedule", "DriverPortal")" class="text-xs font-semibold text-primary hover:underline">View History</a>
            </div>
            
            @if (Model.TodayBookings.Any())
            {
                @foreach (var booking in Model.TodayBookings)
                {
                    var statusColor = booking.BookingStatus == "Completed" ? "emerald" :
                                      booking.BookingStatus == "Cancelled" ? "red" : 
                                      booking.BookingStatus == "InProgress" ? "primary" : "slate";
                    
                    var badgeClass = booking.BookingStatus == "Completed" ? "bg-emerald-500/10 text-emerald-500 border-emerald-500/20" :
                                     booking.BookingStatus == "Cancelled" ? "bg-red-500/10 text-red-500 border-red-500/20" :
                                     "bg-primary/10 text-primary border-primary/20";

                    <div class="glass rounded-2xl p-6 border-l-4 border-@statusColor-500 group transition-all duration-300 hover:bg-white/5 cursor-pointer" onclick="openMapModal(@booking.BookingId)">
                        <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center">
                                    <span class="material-icons-round text-slate-400">directions_car</span>
                                </div>
                                <div>
                                    <h3 class="text-lg font-bold font-display text-white">#@booking.BookingId</h3>
                                    <p class="text-sm text-slate-400 uppercase font-semibold">@booking.CustomerName</p>
                                    @if (!string.IsNullOrEmpty(booking.CustomerPhone))
                                    {
                                        <p class="text-xs text-primary/80 font-medium">@booking.CustomerPhone</p>
                                    }
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-widest border @badgeClass">@booking.BookingStatus.ToUpper()</span>
                                <button class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-800 text-slate-400 hover:text-white transition-colors">
                                    <span class="material-icons-round text-sm">map</span>
                                </button>
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 gap-8 mb-6">
                            <div class="space-y-4">
                                <div class="flex gap-3">
                                    <span class="material-icons-round text-primary text-base">location_on</span>
                                    <div>
                                        <p class="text-[10px] uppercase font-bold text-slate-500 tracking-wider">Pickup</p>
                                        <p class="text-sm font-medium text-slate-200">@booking.PickupLocationLabel</p>
                                    </div>
                                </div>
                            </div>
                            <div class="space-y-4">
                                <div class="flex gap-3">
                                    <span class="material-icons-round text-slate-500 text-base">access_time</span>
                                    <div>
                                        <p class="text-[10px] uppercase font-bold text-slate-500 tracking-wider">Timing</p>
                                        <p class="text-sm font-medium text-slate-200">@booking.StartDate.ToString("MMM dd") - @booking.EndDate.ToString("MMM dd")</p>
                                    </div>
                                </div>
                                 <button onclick="event.stopPropagation(); openMapModal(@booking.BookingId)" class="w-full bg-primary hover:bg-opacity-90 text-slate-900 font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2 uppercase tracking-wider">
                                    <span class="material-icons-round text-lg">navigation</span>
                                    Navigate
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="glass rounded-2xl p-10 flex flex-col items-center justify-center text-center opacity-60">
                     <span class="material-icons-round text-6xl text-slate-600 mb-4">event_busy</span>
                     <p class="text-lg font-medium text-slate-400">No missions scheduled for today.</p>
                </div>
            }
        </div>
        
        <div class="space-y-6">
             <!-- Live Center (Map) -->
            <div class="glass rounded-3xl p-6 relative overflow-hidden">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-display font-bold text-white">Live Center</h2>
                    <div id="trackingStatus" class="flex items-center gap-2 bg-orange-500/10 px-2 py-1 rounded-full">
                        <div class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></div>
                        <span class="text-[10px] font-bold text-orange-500 tracking-tighter">COLD</span>
                    </div>
                </div>
                <div class="relative w-full aspect-square rounded-2xl bg-slate-900 overflow-hidden mb-6 border border-white/5">
                    <div id="miniMapCanvas" class="w-full h-full bg-[#111827]"></div>
                    
                    <div class="absolute bottom-4 left-4 right-4 z-10">
                        <button id="toggleTrackingBtn" onclick="toggleTracking()" class="w-full py-3 bg-slate-900/90 backdrop-blur-md text-white rounded-xl font-bold flex items-center justify-center gap-2 border border-white/10 pulse-gold click-sound">
                            <span class="material-icons-round text-primary" id="gpsIcon">gps_not_fixed</span>
                            <span class="tracking-wide" id="trackingBtnLabel">GO ONLINE</span>
                        </button>
                    </div>
                    
                    <!-- Expand Overlay -->
                     <div class="absolute top-4 right-4 z-10">
                         <button onclick="openMapModal(null)" class="w-10 h-10 bg-slate-900/80 backdrop-blur rounded-xl border border-white/10 flex items-center justify-center hover:bg-white/10 text-white transition-all">
                             <span class="material-icons-round">fullscreen</span>
                         </button>
                     </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <a href="@Url.Action("Schedule", "DriverPortal")" class="py-2.5 rounded-xl bg-white text-slate-900 text-xs font-bold tracking-widest shadow-lg text-center flex items-center justify-center">SCHEDULE</a>
                    <button onclick="openMapModal(null)" class="py-2.5 rounded-xl bg-slate-800 text-slate-300 text-xs font-bold tracking-widest">SYSTEM MAP</button>
                </div>
            </div>

            <!-- Assigned Vehicle -->
            <div class="glass rounded-3xl p-6">
                <h2 class="text-xs uppercase tracking-[0.2em] font-bold text-slate-500 mb-4">Assigned Vehicle</h2>
                <div class="flex items-center gap-5">
                    <div class="w-20 h-20 rounded-2xl bg-slate-900 flex items-center justify-center border border-white/5 overflow-hidden">
                         <span class="material-icons-round text-4xl text-slate-600">directions_car</span>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-display font-bold text-lg leading-tight text-white">My Vehicle</h3>
                        <p class="text-primary font-mono text-sm tracking-widest mt-0.5">ACTIVE</p>
                        <div class="mt-3">
                            <div class="flex justify-between text-[10px] font-bold text-slate-400 mb-1 uppercase">
                                <span>Status</span>
                                <span class="text-emerald-500">Ready</span>
                            </div>
                            <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500" style="width: 100%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Map Modal (Hidden) -->
<div id="mapModal" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl opacity-0 invisible transition-all duration-300 flex items-center justify-center p-4">
    <div class="w-full h-full max-w-[95vw] max-h-[90vh] bg-[#0F1218] rounded-[32px] border border-white/10 overflow-hidden flex flex-col relative shadow-[0_0_100px_rgba(0,0,0,0.8)] scale-95 transition-all duration-300" id="modalContent">
         <div class="flex-1 relative" id="modalBody">
             <!-- Content handled by JS -->
            <div class="flex items-center justify-center h-full text-white/50">
                 <div class="flex flex-col items-center gap-4">
                     <span class="material-icons-round text-4xl animate-spin">sync</span>
                     <p>Loading Trip Data...</p>
                 </div>
            </div>
         </div>
         <button onclick="closeMapModal()" class="absolute top-6 right-6 z-[120] w-10 h-10 rounded-full bg-black/50 backdrop-blur-md border border-white/10 text-white flex items-center justify-center hover:bg-white/10 transition-all">
            <span class="material-icons-round">close</span>
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        // Global state
        window.miniMap = null;
        window.modalMap = null;
        let driverMarkerElement = null;
        let directionsService = null;
        let directionsRenderer = null;
        let currentPos = null;
        let isTracking = false;
        let watchId = null;
        let selectedBookingId = localStorage.getItem('selectedBookingId');
        let hubConnection = null;

        const mapStyles = [
            { "elementType": "geometry", "stylers": [{ "color": "#111827" }] },
            { "elementType": "labels.text.stroke", "stylers": [{ "color": "#111827" }, { "weight": 2 }] },
            { "elementType": "labels.text.fill", "stylers": [{ "color": "#6b7280" }] },
            { "featureType": "road", "elementType": "geometry", "stylers": [{ "color": "#1f2937" }] },
            { "featureType": "road", "elementType": "geometry.stroke", "stylers": [{ "color": "#374151" }] },
            { "featureType": "water", "elementType": "geometry", "stylers": [{ "color": "#000000" }] }
        ];

        async function initSignalR() {
            if (hubConnection) return;
            hubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/driverTracking')
                .withAutomaticReconnect()
                .build();
            await hubConnection.start();
        }

        // Define CustomMarker before it's used in initMaps
        let CustomMarkerClass = null;

        function defineCustomMarker() {
            if (CustomMarkerClass) return;
            CustomMarkerClass = class extends google.maps.OverlayView {
                constructor(pos, map) {
                    super();
                    this.pos = pos;
                    this.setMap(map);
                }
                onAdd() {
                    const div = document.createElement('div');
                    div.className = 'glowing-dot-container';
                    div.style.position = 'absolute';
                    div.innerHTML = '<div class="w-4 h-4 rounded-full bg-emerald-500 shadow-[0_0_15px_rgba(16,185,129,0.8)] border-2 border-white relative z-10"></div><div class="absolute inset-0 rounded-full bg-emerald-500 animate-ping opacity-75"></div>';
                    this.div = div;
                    const panes = this.getPanes();
                    panes.overlayMouseTarget.appendChild(div);
                }
                draw() {
                    const overlayProjection = this.getProjection();
                    const sw = overlayProjection.fromLatLngToDivPixel(this.pos);
                    const div = this.div;
                    if (sw && div) {
                        div.style.left = (sw.x - 16) + 'px'; // Center 32px element
                        div.style.top = (sw.y - 16) + 'px';
                    }
                }
                onRemove() {
                    if (this.div) {
                        this.div.parentNode.removeChild(this.div);
                        this.div = null;
                    }
                }
                updatePosition(pos) {
                    this.pos = pos;
                    this.draw();
                }
            };
        }

        // GLOBAL callback for Google Maps API
        window.initMaps = function () {
            defineCustomMarker();

            window.miniMap = new google.maps.Map(document.getElementById('miniMapCanvas'), {
                center: { lat: 33.8938, lng: 35.5018 }, // Default to Beirut
                zoom: 13,
                styles: mapStyles,
                disableDefaultUI: true,
                gestureHandling: 'none'
            });

            directionsService = new google.maps.DirectionsService();

            // Now that map is ready, initial location fetch
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(pos => {
                    updatePosition(pos.coords.latitude, pos.coords.longitude);
                }, (err) => console.warn("Initial geo fetch failed", err));
            }
            
            // Re-init partials form handling
             document.getElementById('modalBody').addEventListener('submit', async function(e) {
                if (e.target.matches('.trip-action-form')) {
                    e.preventDefault();
                    await handleTripAction(e.target);
                }
            });
        };

        function updatePosition(lat, lng) {
            if (!window.miniMap) return;

            currentPos = { lat, lng };
            if (!driverMarkerElement) {
                if(CustomMarkerClass) driverMarkerElement = new CustomMarkerClass(currentPos, window.miniMap);
            } else {
                driverMarkerElement.updatePosition(currentPos);
            }
            window.miniMap.panTo(currentPos);

            const statusEl = document.getElementById('trackingStatus');
            if (statusEl && isTracking) {
                 statusEl.innerHTML = `
                    <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-[10px] font-bold text-emerald-500 tracking-tighter">LIVE</span>
                `;
            }
        }

        async function openMapModal(bookingId) {
            const modal = document.getElementById('mapModal');
            const content = document.getElementById('modalContent');
            modal.classList.remove('invisible', 'opacity-0');
            content.classList.remove('scale-95');

            const bidValue = bookingId || selectedBookingId;
            const url = bidValue ? `/DriverPortal/TripDetailsPartial?bookingId=${bidValue}` : '/DriverPortal/MapPanel';

            try {
                const resp = await fetch(url);
                if (!resp.ok) throw new Error("Failed to load");
                const html = await resp.text();
                
                const modalBody = document.getElementById('modalBody');
                modalBody.innerHTML = html;

                 // Map Init from Partial Data
                const root = modalBody.querySelector('#mapPanelRoot');
                if (root) {
                    const lat = root.getAttribute('data-pickup-lat');
                    const lng = root.getAttribute('data-pickup-lng');
                    const bid = root.getAttribute('data-booking-id');

                    const pickup = (lat && lng) ? { lat: parseFloat(lat), lng: parseFloat(lng) } : null;
                    const bookingId = bid ? parseInt(bid) : null;
                    selectedBookingId = bookingId;

                    // Small delay to ensure DOM parsing is complete
                    setTimeout(() => {
                        if (window.initModalMap) {
                            window.initModalMap(pickup, bookingId);
                        }
                    }, 100);
                }
            } catch(e) {
                console.error(e);
                document.getElementById('modalBody').innerHTML = "<div class='h-full flex items-center justify-center text-white/50'>Error loading details.</div>";
            }
        }

        window.closeMapModal = function () {
            document.getElementById('mapModal').classList.add('invisible', 'opacity-0');
            document.getElementById('modalContent').classList.add('scale-95');
        };

        window.initModalMap = function (pickup, bookingId) {
            const mapEl = document.getElementById('modal-map-inner');
            if (!mapEl) return;
            window.modalMap = new google.maps.Map(mapEl, {
                center: currentPos || { lat: 33.8938, lng: 35.5018 },
                zoom: 14,
                styles: mapStyles,
                disableDefaultUI: false
            });

            if (CustomMarkerClass) {
                new CustomMarkerClass(currentPos || { lat: 33.8938, lng: 35.5018 }, window.modalMap);
            }

            if (directionsRenderer) directionsRenderer.setMap(null);
            directionsRenderer = new google.maps.DirectionsRenderer({
                map: window.modalMap,
                suppressMarkers: false,
                polylineOptions: { strokeColor: '#D4AF37', strokeWeight: 6, strokeOpacity: 0.8 }
            });

            if (pickup && currentPos) {
                directionsService.route({ origin: currentPos, destination: pickup, travelMode: 'DRIVING' }, (res, status) => {
                    if (status === 'OK') {
                        directionsRenderer.setDirections(res);
                        
                        // Update overlay info
                         const leg = res.routes[0].legs[0];
                         const distVal = document.getElementById('dist-val');
                         const timeVal = document.getElementById('time-val');
                         if (distVal) distVal.textContent = leg.distance.text;
                         if (timeVal) timeVal.textContent = leg.duration.text;
                    }
                });
            }
        };

        async function toggleTracking() {
            if (isTracking) {
                isTracking = false;
                document.getElementById('trackingBtnLabel').textContent = "GO ONLINE";
                document.getElementById('gpsIcon').textContent = "gps_not_fixed";
                
                const statusEl = document.getElementById('trackingStatus');
                if(statusEl) statusEl.innerHTML = `<div class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></div><span class="text-[10px] font-bold text-orange-500 tracking-tighter">COLD</span>`;

                if (watchId) navigator.geolocation.clearWatch(watchId);
            } else {
                if (!navigator.geolocation) return;
                isTracking = true;
                document.getElementById('trackingBtnLabel').textContent = "STOP TRACKING";
                document.getElementById('gpsIcon').textContent = "gps_fixed";

                await initSignalR();
                
                watchId = navigator.geolocation.watchPosition(pos => {
                    const { latitude, longitude, speed, heading, accuracy } = pos.coords;
                    updatePosition(latitude, longitude);
                    
                    if (hubConnection) {
                         hubConnection.invoke('UpdateLocationForActiveTrips', latitude, longitude, new Date().toISOString(), speed, heading, accuracy)
                         .catch(err => console.error("Hub invocation failed", err));
                    }
                }, (err) => console.warn("Watch position error", err), { enableHighAccuracy: true });
            }
        }
        
        async function handleTripAction(form) {
            const url = form.action;
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');
            if(submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="material-icons-round animate-spin text-sm">sync</span>';
            }

            try {
                const resp = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await resp.json();
                
                if (result.success) {
                    const hiddenId = form.querySelector('input[name="bookingId"]').value;
                    await openMapModal(hiddenId); 
                } else {
                    alert("Error: " + result.message);
                }
            } catch (error) {
                console.error("Action failed", error);
            }
        }
    </script>

    @if (!string.IsNullOrEmpty(googleMapsKey))
    {
        <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=@googleMapsKey&callback=initMaps&loading=async"></script>
    }
}
