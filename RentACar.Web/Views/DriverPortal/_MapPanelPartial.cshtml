@model RentACar.Web.Models.DriverBookingDetailsViewModel
@{
    var pickupLat = Model?.PickupLatitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var pickupLng = Model?.PickupLongitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var bookingId = Model?.BookingId.ToString() ?? "";
}

<div class="flex flex-col h-full bg-surface-dark overflow-hidden map-panel-root" id="mapPanelRoot"
    data-pickup-lat="@pickupLat" data-pickup-lng="@pickupLng" data-booking-id="@bookingId">
    <!-- Map Header / Trip Info -->
    <div class="p-4 border-b border-border-dark bg-black/20">
        @if (Model != null)
        {
            <div class="flex justify-between items-start mb-2">
                <div>
                    <h3 class="text-white font-bold">Booking #@Model.BookingId</h3>
                    <p class="text-xs text-gold uppercase tracking-wider font-semibold">@Model.BookingStatus</p>
                </div>
                <div class="text-right">
                    <p class="text-sm text-gray-400">@Model.PickupDateTime?.ToString("MMM dd, HH:mm")</p>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 mt-3">
                <div class="bg-white/5 rounded-lg p-3 border border-white/5">
                    <p class="text-[10px] text-gray-500 uppercase font-bold">Customer</p>
                    <p class="text-xs text-white font-medium truncate">@Model.CustomerName</p>
                </div>
                <div class="bg-white/5 rounded-lg p-3 border border-white/5">
                    <p class="text-[10px] text-gray-500 uppercase font-bold">Vehicle</p>
                    <p class="text-xs text-white font-medium truncate">@Model.CarName (@Model.CarPlate)</p>
                </div>
            </div>

            <div class="mt-3 flex items-start gap-2 text-xs text-gray-400 bg-black/30 p-2 rounded-md">
                <span class="material-symbols-outlined text-sm text-gold">location_on</span>
                <span class="truncate">@Model.PickupLocationLabel</span>
            </div>
        }
        else
        {
            <div class="text-center py-6">
                <span class="material-symbols-outlined text-4xl text-gray-600 mb-2">my_location</span>
                <p class="text-sm text-gray-400">No booking selected</p>
                <p class="text-xs text-gray-500 mt-1">Showing your current location</p>
            </div>
        }
    </div>

    <!-- Map Container -->
    <div id="modal-map-container" class="flex-1 w-full bg-background-dark relative">
        <!-- Directions Info Overlay -->
        <div id="directions-overlay"
            class="hidden absolute top-4 left-4 right-4 z-10 bg-surface-dark/95 backdrop-blur-md border border-gold/20 p-3 rounded-xl shadow-2xl">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-gold/10 rounded-full">
                        <span class="material-symbols-outlined text-gold">near_me</span>
                    </div>
                    <div>
                        <p id="dist-val" class="text-sm font-bold text-gold">-- km</p>
                        <p id="time-val" class="text-[10px] text-gray-400 uppercase font-bold">-- mins</p>
                    </div>
                </div>
                <button onclick="window.openInExternalMaps()"
                    class="text-[10px] px-3 py-1.5 bg-gold text-black font-bold rounded-lg uppercase hover:bg-yellow-500 transition-colors">
                    Navigate
                </button>
            </div>
        </div>

        <div id="modal-map-inner" class="h-full w-full"></div>
    </div>
</div>
