@model RentACar.Application.DTOs.CustomerDTO

<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-[#141414] border border-white/10 shadow-2xl rounded-2xl overflow-hidden">
            <!-- Header -->
            <div class="modal-header border-b border-white/5 p-5">
                <h5 class="text-xl font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-gold">lock_reset</span>
                    Reset Password
                </h5>
                <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>
            
            <!-- Body -->
            <div class="modal-body p-6">
                
                <p class="text-gray-400 text-sm mb-4">
                    Resetting password for <strong class="text-white">@Model.Name</strong>. The user will be notified via email.
                </p>

                <!-- Tabs -->
                <div class="flex border-b border-white/10 mb-4">
                    <button class="flex-1 pb-2 text-sm font-medium text-gold border-b-2 border-gold transition-colors focus:outline-none" id="tab-auto" onclick="switchTab('auto')">
                        Auto-Generate
                    </button>
                    <button class="flex-1 pb-2 text-sm font-medium text-gray-500 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none" id="tab-manual" onclick="switchTab('manual')">
                        Manual Entry
                    </button>
                </div>

                <form id="resetPasswordForm">
                    <input type="hidden" name="customerId" value="@Model.UserId" />
                    <input type="hidden" name="mode" id="resetMode" value="auto" />

                    <!-- Auto Gen Section -->
                    <div id="content-auto" class="space-y-3">
                        <div class="bg-white/5 p-4 rounded-xl border border-white/10 flex items-center gap-3">
                            <span class="material-symbols-outlined text-blue-400">auto_fix_high</span>
                            <div class="text-sm text-gray-300">
                                A secure password will be generated automatically and emailed to the user.
                            </div>
                        </div>
                    </div>

                    <!-- Manual Section -->
                    <div id="content-manual" class="space-y-4 hidden">
                         <div class="space-y-1">
                            <label class="text-xs font-bold text-gray-500 uppercase tracking-wider block">New Password</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500">key</span>
                                <input type="text" name="newPassword" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-2.5 pl-10 pr-4 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" placeholder="Enter new password" />
                            </div>
                        </div>
                        <div class="text-xs text-yellow-500/80 flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">info</span>
                            Ensure it meets complexity requirements (Uppercase, digit, symbol).
                        </div>
                    </div>

                    <div id="resetError" class="hidden bg-red-500/10 border border-red-500/20 text-red-400 text-sm p-3 rounded-xl mt-4"></div>

                    <div class="flex gap-3 mt-6">
                        <button type="button" class="flex-1 bg-white/5 hover:bg-white/10 text-white font-medium py-2.5 rounded-xl transition-colors border border-white/10" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="flex-1 bg-gold hover:bg-[#b5952f] text-black font-bold py-2.5 rounded-xl transition-colors shadow-lg shadow-gold/10">
                            Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function switchTab(mode) {
        document.getElementById('resetMode').value = mode;
        
        // Update Tab styles
        if(mode === 'auto') {
            document.getElementById('tab-auto').className = 'flex-1 pb-2 text-sm font-medium text-gold border-b-2 border-gold transition-colors focus:outline-none';
            document.getElementById('tab-manual').className = 'flex-1 pb-2 text-sm font-medium text-gray-500 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none';
            
            document.getElementById('content-auto').classList.remove('hidden');
            document.getElementById('content-manual').classList.add('hidden');
        } else {
             document.getElementById('tab-manual').className = 'flex-1 pb-2 text-sm font-medium text-gold border-b-2 border-gold transition-colors focus:outline-none';
             document.getElementById('tab-auto').className = 'flex-1 pb-2 text-sm font-medium text-gray-500 hover:text-white border-b-2 border-transparent transition-colors focus:outline-none';
             
             document.getElementById('content-manual').classList.remove('hidden');
             document.getElementById('content-auto').classList.add('hidden');
        }
    }

    document.getElementById('resetPasswordForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const id = this.querySelector('[name="customerId"]').value;
        const mode = document.getElementById('resetMode').value;
        const passwordInput = this.querySelector('[name="newPassword"]');
        const errorAlert = document.getElementById('resetError');
        
        // Validate manual
        if(mode === 'manual' && (!passwordInput.value || passwordInput.value.length < 6)) {
             errorAlert.textContent = 'Password must be at least 6 characters.';
             errorAlert.classList.remove('hidden');
             return;
        }

        // Button Loading State
        const btn = this.querySelector('button[type="submit"]');
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">sync</span> Processing...';
        
        if (errorAlert) {
            errorAlert.classList.add('hidden');
            errorAlert.textContent = '';
        }

        try {
            const body = mode === 'manual' ? JSON.stringify({ newPassword: passwordInput.value }) : null;
            const headers = mode === 'manual' ? { 'Content-Type': 'application/json' } : {};
            
            const response = await fetch('/api/Customer/' + id + '/reset-password', { 
                method: 'POST',
                headers: headers,
                body: body
            });

            if (!response.ok) {
                 let message = 'Failed to reset password.';
                 try {
                    const payload = await response.json();
                    if (payload && payload.message) message = payload.message;
                } catch { }
                throw new Error(message);
            }

            const modalEl = document.getElementById('resetPasswordModal');
            bootstrap.Modal.getInstance(modalEl).hide();
            if (window.showPopup) window.showPopup('Password reset successfully.', 'success');

        } catch (err) {
            console.error(err);
            if (errorAlert) {
                errorAlert.textContent = err.message || 'Unable to connect to the server.';
                errorAlert.classList.remove('hidden');
            }
        } finally {
            btn.disabled = false;
            btn.textContent = originalText;
        }
    });
</script>
