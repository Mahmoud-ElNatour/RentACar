@model RentACar.Application.DTOs.CustomerDTO

<div class="modal fade" id="customerFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-[#141414] border border-white/10 shadow-2xl rounded-2xl">
            <!-- Header -->
            <div class="modal-header border-b border-white/5 p-5">
                <h5 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#d4af37]">
                        @(Model.UserId == 0 ? "person_add" : "manage_accounts")
                    </span>
                    @((Model.UserId == 0) ? "Add Customer" : "Edit Customer")
                </h5>
                <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>
            
            <!-- Body -->
            <div class="modal-body p-6">
                <form id="customerForm" class="space-y-4">
                    <input type="hidden" asp-for="UserId" />
                    
                    <!-- Basic Info -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-500 uppercase mb-1.5">Full Name</label>
                            <input asp-for="Name" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-[#d4af37]/50 focus:ring-1 focus:ring-[#d4af37]/50 placeholder-gray-600" placeholder="e.g. John Doe" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-500 uppercase mb-1.5">Email Address</label>
                            <input asp-for="Email" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-[#d4af37]/50 focus:ring-1 focus:ring-[#d4af37]/50 placeholder-gray-600" placeholder="john@example.com" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-gray-500 uppercase mb-1.5">Phone Number</label>
                        <input asp-for="PhoneNumber" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-[#d4af37]/50 focus:ring-1 focus:ring-[#d4af37]/50 placeholder-gray-600" placeholder="+1 234 567 890" />
                    </div>

                    @if (Model.UserId == 0)
                    {
                        <div>
                            <label class="block text-xs font-medium text-gray-500 uppercase mb-1.5">Password</label>
                            <input type="password" name="Password" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-[#d4af37]/50 focus:ring-1 focus:ring-[#d4af37]/50 placeholder-gray-600" />
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                             <div class="col-span-2">
                                <label class="block text-xs font-medium text-[#d4af37] uppercase mb-1.5 border-b border-white/5 pb-1">Required Documents</label>
                            </div>
                            <div>
                                <label class="block text-xs text-gray-400 mb-1">Driving License (Front)</label>
                                <input type="file" name="DrivingLicenseFront" class="w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#d4af37]/10 file:text-[#d4af37] hover:file:bg-[#d4af37]/20" />
                            </div>
                            <div>
                                <label class="block text-xs text-gray-400 mb-1">Driving License (Back)</label>
                                <input type="file" name="DrivingLicenseBack" class="w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#d4af37]/10 file:text-[#d4af37] hover:file:bg-[#d4af37]/20" />
                            </div>
                            <div>
                                <label class="block text-xs text-gray-400 mb-1">National ID (Front)</label>
                                <input type="file" name="NationalIdfront" class="w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#d4af37]/10 file:text-[#d4af37] hover:file:bg-[#d4af37]/20" />
                            </div>
                            <div>
                                <label class="block text-xs text-gray-400 mb-1">National ID (Back)</label>
                                <input type="file" name="NationalIdback" class="w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#d4af37]/10 file:text-[#d4af37] hover:file:bg-[#d4af37]/20" />
                            </div>
                        </div>
                    }

                    <div>
                        <label class="block text-xs font-medium text-gray-500 uppercase mb-1.5">Address</label>
                        <input asp-for="Address" class="w-full bg-[#0a0a0a] border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-[#d4af37]/50 focus:ring-1 focus:ring-[#d4af37]/50 placeholder-gray-600" placeholder="Full Address" />
                    </div>

                    <div class="flex items-center gap-6 pt-2">
                        <label class="flex items-center gap-3 cursor-pointer group">
                             <div class="relative">
                                <input asp-for="IsVerified" type="checkbox" class="peer sr-only" />
                                <div class="w-10 h-6 bg-white/10 rounded-full peer-checked:bg-green-500/50 transition-colors"></div>
                                <div class="absolute left-1 top-1 w-4 h-4 bg-gray-400 rounded-full transition-transform peer-checked:translate-x-4 peer-checked:bg-white"></div>
                            </div>
                            <span class="text-sm text-gray-300 group-hover:text-white transition-colors">Verified</span>
                        </label>
                        
                        <label class="flex items-center gap-3 cursor-pointer group">
                             <div class="relative">
                                <input asp-for="Isactive" type="checkbox" class="peer sr-only" />
                                <div class="w-10 h-6 bg-white/10 rounded-full peer-checked:bg-blue-500/50 transition-colors"></div>
                                <div class="absolute left-1 top-1 w-4 h-4 bg-gray-400 rounded-full transition-transform peer-checked:translate-x-4 peer-checked:bg-white"></div>
                            </div>
                            <span class="text-sm text-gray-300 group-hover:text-white transition-colors">Active Account</span>
                        </label>
                    </div>

                    <div class="pt-4 border-t border-white/5 flex gap-3">
                         <button type="submit" class="flex-1 bg-[#d4af37] hover:bg-[#b5952f] text-black font-semibold py-2.5 rounded-xl transition-all shadow-[0_0_15px_rgba(212,175,55,0.3)]">
                            @(Model.UserId == 0 ? "Create Customer" : "Save Changes")
                        </button>
                         <button type="button" class="flex-1 bg-white/5 hover:bg-white/10 text-white font-medium py-2.5 rounded-xl transition-colors border border-white/10" data-bs-dismiss="modal">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    function fileToBase64(file) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => {
                if (typeof reader.result === 'string') {
                    const commaIndex = reader.result.indexOf(',');
                    resolve(commaIndex >= 0 ? reader.result.substring(commaIndex + 1) : reader.result);
                } else {
                    reject(new Error('Unable to read file.'));
                }
            };
            reader.onerror = () => reject(reader.error ?? new Error('Unable to read file.'));
            reader.readAsDataURL(file);
        });
    }

    document.getElementById('customerForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const form = e.target;
        
        // Show Loading State on Button
        const btn = form.querySelector('button[type="submit"]');
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">sync</span> Processing...';

        const f = form.elements;
        const data = {
            userId: parseInt(form.querySelector('[name="UserId"]').value || '0'),
            name: f['Name'].value,
            email: f['Email'].value,
            username: f['Email'].value, // Using email as username
            phoneNumber: f['PhoneNumber'].value,
            address: f['Address'].value,
            isVerified: form.querySelector('[name="IsVerified"]')?.checked ?? false,
            isactive: form.querySelector('[name="Isactive"]')?.checked ?? false
        };
        
        try {
            let url = '/api/Customer';
            let method = 'POST';
            const isUpdate = Boolean(data.userId); // userId != 0

            if (isUpdate) {
                url += '/' + data.userId;
                method = 'PUT';
            } else {
                data.password = f['Password'].value;
                const licenseFrontFile = f['DrivingLicenseFront'].files[0];
                const licenseBackFile = f['DrivingLicenseBack'].files[0];
                const nationalFrontFile = f['NationalIdfront'].files[0];
                const nationalBackFile = f['NationalIdback'].files[0];

                if (licenseFrontFile) data.drivingLicenseFront = await fileToBase64(licenseFrontFile);
                if (licenseBackFile) data.drivingLicenseBack = await fileToBase64(licenseBackFile);
                if (nationalFrontFile) data.nationalIdfront = await fileToBase64(nationalFrontFile);
                if (nationalBackFile) data.nationalIdback = await fileToBase64(nationalBackFile);
            }

            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (!response.ok) {
                let message = 'Failed to save customer.';
                try {
                    const payload = await response.json();
                    if (payload && payload.message) message = payload.message;
                } catch { 
                    try { message = await response.text(); } catch {} 
                }
                
                if (window.showPopup) window.showPopup(message, 'error');
                return;
            }

            if (window.showPopup) window.showPopup(isUpdate ? 'Customer updated.' : 'Customer created.', 'success');

            const modalEl = document.getElementById('customerFormModal');
            bootstrap.Modal.getInstance(modalEl).hide();
            if (window.loadCustomers) loadCustomers();
            if (window.updateStatsWidgets) updateStatsWidgets(); // Refresh stats

        } catch (err) {
            console.error(err);
            if (window.showPopup) window.showPopup('An unexpected error occurred.', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = originalText;
        }
    });
</script>
