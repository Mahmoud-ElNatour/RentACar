<!-- Global Modal Placeholder -->
<div id="customerModalPlaceholder"></div>

<script>
    // State
    let currentPage = 1;
    let pageSize = 10;
    let totalPages = 1;
    let sortColumn = 'Name';
    let sortDirection = 'asc';

    // Init
    document.addEventListener('DOMContentLoaded', () => {
        loadCustomers();
        updateStatsWidgets();

        document.getElementById('filterForm').addEventListener('submit', (e) => {
            e.preventDefault();
            currentPage = 1;
            loadCustomers();
        });

        document.getElementById('addCustomerBtn').addEventListener('click', () => {
            loadModal('/Customer/Add');
        });
        
        // Debounce search
        let timeout = null;
        document.getElementById('searchInput').addEventListener('input', () => {
           clearTimeout(timeout);
           timeout = setTimeout(() => {
               currentPage = 1;
               loadCustomers();
           }, 400);
        });
        
        // Filter changes
        document.getElementById('verifiedFilter').addEventListener('change', () => { currentPage = 1; loadCustomers(); });
        document.getElementById('activeFilter').addEventListener('change', () => { currentPage = 1; loadCustomers(); });
    });

    function setSort(col) {
        if(sortColumn === col) {
            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            sortColumn = col;
            sortDirection = 'asc';
        }
        
        // Update icons
        document.querySelectorAll('[id^="sort-"]').forEach(el => el.textContent = 'unfold_more');
        const active = document.getElementById('sort-' + col);
        if(active) active.textContent = sortDirection === 'asc' ? 'keyboard_arrow_up' : 'keyboard_arrow_down';
        
        loadCustomers();
    }
    
    function changePage(delta) {
        const novo = currentPage + delta;
        if(novo > 0 && novo <= totalPages) {
            currentPage = novo;
            loadCustomers();
        }
    }
    
    function gotoPage(p) {
        currentPage = p;
        loadCustomers();
    }

    async function loadCustomers() {
        const tbody = document.getElementById('customerRows');
        const loading = document.getElementById('loadingState');
        const empty = document.getElementById('emptyState');
        const pagination = document.getElementById('paginationControls');
        
        tbody.closest('table').style.opacity = '0.5';
        
        try {
            const formData = new FormData(document.getElementById('filterForm'));
            const params = new URLSearchParams();
            for(let [k,v] of formData) {
                if(v) params.append(k,v);
            }
            
            params.append('page', currentPage);
            params.append('pageSize', pageSize);
            params.append('sortColumn', sortColumn);
            params.append('sortDirection', sortDirection);

            const res = await fetch('/api/Customer/GetFilteredCustomers?' + params.toString());
            if(!res.ok) throw new Error('Failed to load data');
            
            const data = await res.json();
            
            tbody.closest('table').style.opacity = '1';
            tbody.innerHTML = '';
            
            if(data.items.length === 0) {
                empty.classList.remove('hidden');
                loading.classList.add('hidden');
                pagination.classList.add('hidden');
                // updateStatsWidgets(); // Optional refresh
                return;
            }
            
            empty.classList.add('hidden');
            loading.classList.add('hidden');
                pagination.classList.remove('hidden');

            const isAdmin = @((User.IsInRole("Admin") || User.IsInRole("Employee")).ToString().ToLower());
            
            // Render Table
            data.items.forEach(c => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-white/5 transition-colors group border-b border-[#262626] last:border-0 align-middle';
                
                tr.innerHTML = `
                    <td class="px-6 py-4 text-center font-mono text-gray-500 text-xs">#${c.userId}</td>
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-[#d4af37]/10 flex items-center justify-center text-[#d4af37] font-bold text-sm border border-[#d4af37]/20">
                                ${c.name.charAt(0).toUpperCase()}
                            </div>
                            <div>
                                <div class="font-bold text-white text-base">${c.name}</div>
                                <div class="text-xs text-gray-500">${c.address || 'No Address'}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-sm text-gray-300 font-medium">${c.email}</div>
                        <div class="text-xs text-gray-500">${c.phoneNumber || '-'}</div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        ${c.isVerified 
                           ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-500/10 text-green-500 border border-green-500/20">Verified</span>'
                           : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-500/10 text-red-500 border border-red-500/20">Pending</span>'}
                    </td>
                    <td class="px-6 py-4 text-center">
                         ${c.isactive 
                           ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-500/10 text-blue-500 border border-blue-500/20">Active</span>'
                           : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-500/10 text-gray-500 border border-gray-500/20">Inactive</span>'}
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2 opacity-100 transition-opacity">
                            <button class="view-docs p-2 text-green-500 hover:text-green-400 hover:bg-green-500/10 rounded-lg transition-colors" data-id="${c.userId}" title="Documents">
                                <span class="material-symbols-outlined text-[20px]">description</span>
                            </button>
                            <button class="edit-customer p-2 text-gold hover:text-[#b5952f] hover:bg-gold/10 rounded-lg transition-colors" data-id="${c.userId}" title="Edit">
                                <span class="material-symbols-outlined text-[20px]">edit</span>
                            </button>
                            <div class="dropdown inline-block relative">
                                <button class="p-2 text-gold hover:text-[#b5952f] hover:bg-gold/10 rounded-lg transition-colors" type="button" data-bs-toggle="dropdown" title="Security & Actions">
                                    <span class="material-symbols-outlined text-[20px]">security</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark bg-[#1a1a1a] border border-[#262626] shadow-xl text-sm min-w-[180px]">
                                    ${isAdmin ? `
                                        <li>
                                            <a class="dropdown-item hover:bg-white/5 text-gray-300 flex items-center gap-2 px-4 py-2 reset-pass" href="#" data-id="${c.userId}">
                                                <span class="material-symbols-outlined text-[18px]">lock_reset</span> Reset Password
                                            </a>
                                        </li>
                                    ` : ''}
                                    ${!c.isVerified ? `
                                    <li>
                                        <a class="dropdown-item hover:bg-white/5 text-gray-300 flex items-center gap-2 px-4 py-2 resend-email" href="#" data-id="${c.userId}">
                                            <span class="material-symbols-outlined text-[18px]">forward_to_inbox</span> Resend Verification
                                        </a>
                                    </li>` : ''}
                                    ${isAdmin ? `
                                    <li><hr class="dropdown-divider border-[#262626] my-1"></li>
                                    <li>
                                        <a class="dropdown-item hover:bg-red-500/10 text-red-400 flex items-center gap-2 px-4 py-2 delete-customer" href="#" data-id="${c.userId}">
                                            <span class="material-symbols-outlined text-[18px]">person_remove</span> Delete User
                                        </a>
                                    </li>` : ''}
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>
            `;
                tbody.appendChild(tr);
            });
            
            // Pagination UI
            totalPages = data.totalPages;
            document.getElementById('showingText').innerText = `Showing ${(currentPage-1)*pageSize + 1} - ${Math.min(currentPage*pageSize, data.totalCount)} of ${data.totalCount}`;
            document.getElementById('prevBtn').disabled = currentPage <= 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages;
            
            renderPageNumbers(totalPages, currentPage);

        } catch(e) {
            console.error(e);
            tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-red-500">Failed to load data</td></tr>';
            tbody.closest('table').style.opacity = '1';
        }
    }
    
    function renderPageNumbers(total, current) {
        const container = document.getElementById('pageNumbers');
        container.innerHTML = '';
        
        let pages = [];
        if(total <= 7) {
            pages = Array.from({length: total}, (_, i) => i + 1);
        } else {
            if(current <= 4) {
                pages = [1,2,3,4,5, '...', total];
            } else if(current >= total - 3) {
                pages = [1, '...', total-4, total-3, total-2, total-1, total];
            } else {
                pages = [1, '...', current-1, current, current+1, '...', total];
            }
        }
        
        pages.forEach(p => {
             if(p === '...') {
                 const span = document.createElement('span');
                 span.className = 'text-gray-600 px-2';
                 span.textContent = '...';
                 container.appendChild(span);
             } else {
                 const btn = document.createElement('button');
                 btn.className = `w-8 h-8 rounded-lg text-xs font-bold transition-all ${p === current ? 'bg-gold text-black shadow-lg shadow-gold/20' : 'bg-[#16181a] text-gray-400 hover:text-white hover:bg-white/10'}`;
                 btn.textContent = p;
                 btn.onclick = () => gotoPage(p);
                 container.appendChild(btn);
             }
        });
    }

    async function updateStatsWidgets() {
         const getCount = async (params) => {
             const p = new URLSearchParams(params);
             p.append('pageSize', '1'); 
             const res = await fetch('/api/Customer/GetFilteredCustomers?' + p.toString());
             const data = await res.json();
             return data.totalCount;
         };

         const [total, verified, active, unverified] = await Promise.all([
             getCount({}), 
             getCount({verified: 'true'}), 
             getCount({active: 'true'}),
             getCount({verified: 'false'})
         ]);

         document.getElementById('stat-total').textContent = total;
         document.getElementById('stat-verified').textContent = verified;
         document.getElementById('stat-active').textContent = active;
         document.getElementById('stat-unverified').textContent = unverified;
    }

    async function loadModal(url) {
        try {
            const res = await fetch(url);
            if(!res.ok) throw new Error("Failed to load modal");
            const html = await res.text();
            
            const placeholder = document.getElementById('customerModalPlaceholder');
            placeholder.innerHTML = html; 
            
            // Execute scripts
            placeholder.querySelectorAll('script').forEach(scr => {
                const s = document.createElement('script');
                if(scr.src) s.src = scr.src;
                else s.textContent = scr.textContent;
                document.body.appendChild(s);
                document.body.removeChild(s);
            });

            const modalEl = placeholder.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
            
        } catch(e) { console.error(e); }
    }
    
    // Delegation for Action Buttons
    document.getElementById('customerRows').addEventListener('click', async e => {
        const edit = e.target.closest('.edit-customer');
        const del = e.target.closest('.delete-customer');
        const docs = e.target.closest('.view-docs');
        const reset = e.target.closest('.reset-pass');
        const resend = e.target.closest('.resend-email');

        if (edit) {
           loadModal('/Customer/Edit/' + edit.dataset.id);
        } else if (del) {
           loadModal('/Customer/Delete/' + del.dataset.id);
        } else if (docs) {
           loadModal('/Customer/Documents/' + docs.dataset.id);
        } else if (reset) {
            loadModal('/Customer/ResetPassword/' + reset.dataset.id);
        } else if (resend) {
             const btn = resend;
             const originalHtml = btn.innerHTML;
             btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span> Sending...';
             btn.style.pointerEvents = 'none';
             
             try {
                const response = await fetch('/api/Customer/' + btn.dataset.id + '/resend-verification', { method: 'POST' });
                if (response.ok) {
                    if(window.showPopup) window.showPopup('Verification reminder sent.', 'success');
                } else {
                    if(window.showPopup) window.showPopup('Failed to send reminder.', 'error');
                }
             } catch(err) {
                console.error(err);
                if(window.showPopup) window.showPopup('Error connecting to server.', 'error');
             } finally {
                 btn.innerHTML = originalHtml;
                 btn.style.pointerEvents = 'auto';
             }
        }
    });

</script>
