@model RentACar.Application.DTOs.PagedResultDto<RentACar.Application.DTOs.EmployeeDisplayDto>

@{
    ViewData["Title"] = "Employee Management";
    Layout = "_Layout";
    ViewData["BodyClass"] = "bg-background-dark";
}

<!-- Tailwind & Custom Styles -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    "gold": "#d4af37",
                },
                fontFamily: {
                    "display": ["Manrope", "sans-serif"],
                }
            }
        }
    }
</script>

<div class="px-4 md:px-10 py-8 max-w-[1440px] mx-auto w-full text-white font-display">

    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
        <div>
            <h1 class="text-3xl md:text-4xl font-black tracking-tight flex items-center gap-3">
                <span class="material-symbols-outlined text-gold text-4xl">badge</span>
                Employee Management
            </h1>
            <p class="text-gray-400 mt-2">Manage staff access, roles, and performance.</p>
        </div>
        <button id="addEmployeeBtn"
            class="flex items-center gap-2 bg-gold hover:bg-[#b5952f] text-black px-6 py-3 rounded-xl font-bold shadow-lg shadow-gold/10 transition-all hover:scale-105 active:scale-95">
            <span class="material-symbols-outlined text-[20px]">person_add</span>
            <span>Add Employee</span>
        </button>
    </div>

    <!-- Stats Grid (Car Style) -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8 px-4 md:px-0">
        <!-- Total -->
        <div
            class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-6xl text-gold">group</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Total Employees</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-total">-</p>
            </div>
            <div class="flex items-center gap-2 z-10">
                <span class="text-[#0bda1d] text-sm font-bold flex items-center">
                    <span class="material-symbols-outlined text-sm mr-1">trending_up</span>+0%
                </span>
                <span class="text-gray-500 text-xs tracking-wide">new hires</span>
            </div>
        </div>

        <!-- Active -->
        <div
            class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-6xl text-green-500">how_to_reg</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Active Staff</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-active">-</p>
            </div>
            <div class="flex items-center gap-2 z-10">
                <span class="text-green-500 text-xs font-bold tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">verified</span> Online
                </span>
            </div>
        </div>

        <!-- Admins -->
        <div
            class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-6xl text-purple-500">admin_panel_settings</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Administrators</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-admins">-</p>
            </div>
            <div class="flex items-center gap-2 z-10">
                <span class="text-purple-500 text-xs font-bold tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">shield</span> Privileged
                </span>
            </div>
        </div>

        <!-- Inactive -->
        <div
            class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-6xl text-red-500">person_off</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Inactive Staff</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-inactive">-</p>
            </div>
            <div class="flex items-center gap-2 z-10">
                <span class="text-red-500 text-xs font-bold tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">warning</span> Suspended
                </span>
            </div>
        </div>
    </div>

    <!-- Filters & Toolbar (Car Style) -->
    <div class="bg-[#16181a] border border-[#262626] rounded-2xl p-4 mb-6 shadow-xl">
        <form id="filterForm" class="flex flex-col lg:flex-row gap-4 items-end">
            <!-- Search -->
            <label class="flex flex-col w-full lg:flex-[2]">
                <span class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">Search</span>
                <div class="relative">
                    <span
                        class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500">search</span>
                    <input type="text" name="search" id="searchInput"
                        class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 pl-12 pr-4 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all"
                        placeholder="Search Name or Email..." />
                </div>
            </label>

            <!-- Status Filter -->
            <label class="flex flex-col w-full lg:flex-1">
                <span class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">Status</span>
                <div class="relative">
                    <select name="active" id="activeFilter"
                        class="w-full bg-[#0a0a0a] bg-none border border-[#262626] rounded-xl py-3 pl-4 pr-10 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold appearance-none cursor-pointer">
                        <option value="">All Statuses</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <span
                        class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500 pointer-events-none">expand_more</span>
                </div>
            </label>

            <!-- Role Filter -->
            <label class="flex flex-col w-full lg:flex-1">
                <span class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">Role</span>
                <div class="relative">
                    <select name="role" id="roleFilter"
                        class="w-full bg-[#0a0a0a] bg-none border border-[#262626] rounded-xl py-3 pl-4 pr-10 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold appearance-none cursor-pointer">
                        <option value="">All Roles</option>
                        <option value="Admin">Admin</option>
                        <option value="Employee">Employee</option>
                        <option value="Driver">Driver</option>
                    </select>
                    <span
                        class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500 pointer-events-none">expand_more</span>
                </div>
            </label>

            <button type="submit"
                class="w-full lg:w-auto h-[50px] bg-white/5 hover:bg-white/10 text-white border border-[#262626] px-6 rounded-xl font-bold transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">filter_list</span>
                Filter
            </button>
        </form>
    </div>

    <!-- Table Container (Car Style) -->
    <div class="bg-[#16181a] border border-[#262626] rounded-2xl overflow-hidden shadow-2xl">
        <div class="overflow-x-auto min-h-[400px]">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr
                        class="bg-white/5 border-b border-[#262626] text-gray-400 text-xs uppercase tracking-wider font-bold">
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors"
                            onclick="setSort('Name')">
                            <div class="flex items-center gap-1">Employee <span
                                    class="material-symbols-outlined text-[14px]" id="sort-Name">unfold_more</span>
                            </div>
                        </th>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors"
                            onclick="setSort('Email')">
                            <div class="flex items-center gap-1">Email <span
                                    class="material-symbols-outlined text-[14px]" id="sort-Email">unfold_more</span>
                            </div>
                        </th>
                        <th class="px-6 py-4">Role</th>
                        <th class="px-6 py-4">Phone</th>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors"
                            onclick="setSort('Salary')">
                            <div class="flex items-center gap-1">Salary <span
                                    class="material-symbols-outlined text-[14px]" id="sort-Salary">unfold_more</span>
                            </div>
                        </th>
                        <th class="px-6 py-4">Address</th>
                        <th class="px-6 py-4 text-center cursor-pointer hover:text-white transition-colors"
                            onclick="setSort('IsActive')">
                            <div class="flex items-center justify-center gap-1">Status <span
                                    class="material-symbols-outlined text-[14px]" id="sort-IsActive">unfold_more</span>
                            </div>
                        </th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="employeeRows" class="divide-y divide-[#262626]">
                    <!-- Rows injected via JS -->
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div id="paginationControls"
            class="border-t border-[#262626] p-4 flex items-center justify-between bg-[#0a0a0a] hidden">
            <div class="text-sm text-gray-500" id="showingText">Showing 0 of 0</div>
            <div class="flex items-center gap-2">
                <button id="prevBtn" onclick="changePage(-1)"
                    class="p-2 rounded-lg hover:bg-white/10 text-gray-400 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <div id="pageNumbers" class="flex items-center gap-1"></div>
                <button id="nextBtn" onclick="changePage(1)"
                    class="p-2 rounded-lg hover:bg-white/10 text-gray-400 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </div>

        <!-- Loading / Empty -->
        <div id="loadingState" class="hidden p-12 text-center text-gray-500">
            <span class="material-symbols-outlined text-4xl animate-spin mb-2">progress_activity</span>
            <p>Loading staff data...</p>
        </div>
        <div id="emptyState" class="hidden p-12 text-center text-gray-500">
            <span class="material-symbols-outlined text-4xl mb-2">person_off</span>
            <p>No employees found.</p>
        </div>
    </div>

</div>

<!-- Global Modal Placeholder -->
<div id="employeeModalPlaceholder"></div>

<script>
    // State
    let currentPage = 1;
    let pageSize = 10;
    let totalPages = 1;
    let sortColumn = 'Name';
    let sortDirection = 'asc';
    const canResetEmployeePassword = @(User.IsInRole("Admin").ToString().ToLower());

    // Init
    document.addEventListener('DOMContentLoaded', () => {
        loadEmployees();

        document.getElementById('filterForm').addEventListener('submit', (e) => {
            e.preventDefault();
            currentPage = 1;
            loadEmployees();
        });

        document.getElementById('addEmployeeBtn').addEventListener('click', () => {
            loadModal('/Employee/Add');
        });

        // Debounce search
        let timeout = null;
        document.getElementById('searchInput').addEventListener('input', () => {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
                currentPage = 1;
                loadEmployees();
            }, 400);
        });

        // Filter changes
        document.getElementById('roleFilter').addEventListener('change', () => { currentPage = 1; loadEmployees(); });
        document.getElementById('activeFilter').addEventListener('change', () => { currentPage = 1; loadEmployees(); });
    });

    function setSort(col) {
        if (sortColumn === col) {
            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            sortColumn = col;
            sortDirection = 'asc';
        }

        // Update icons
        document.querySelectorAll('[id^="sort-"]').forEach(el => el.textContent = 'unfold_more');
        const active = document.getElementById('sort-' + col);
        if (active) active.textContent = sortDirection === 'asc' ? 'keyboard_arrow_up' : 'keyboard_arrow_down';

        loadEmployees();
    }

    function changePage(delta) {
        const novo = currentPage + delta;
        if (novo > 0 && novo <= totalPages) {
            currentPage = novo;
            loadEmployees();
        }
    }

    function gotoPage(p) {
        currentPage = p;
        loadEmployees();
    }

    function formatCurrency(val) {
        if (val === null || val === undefined) return '-';
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(val);
    }

    async function loadEmployees() {
        const tbody = document.getElementById('employeeRows');
        const loading = document.getElementById('loadingState');
        const empty = document.getElementById('emptyState');
        const pagination = document.getElementById('paginationControls');

        tbody.closest('table').style.opacity = '0.5';

        try {
            const formData = new FormData(document.getElementById('filterForm'));
            const params = new URLSearchParams();
            for (let [k, v] of formData) {
                if (v) params.append(k, v);
            }

            params.append('page', currentPage);
            params.append('pageSize', pageSize);
            params.append('sortColumn', sortColumn);
            params.append('sortDirection', sortDirection);

            const res = await fetch('/api/Employee?' + params.toString());
            if (!res.ok) throw new Error('Failed to load data');

            const data = await res.json();

            tbody.closest('table').style.opacity = '1';
            tbody.innerHTML = '';

            if (data.items.length === 0) {
                empty.classList.remove('hidden');
                loading.classList.add('hidden');
                pagination.classList.add('hidden');
                // Stats can be updated even if empty result set (server might return specific stats)
                // For now, doing separate stat update
                updateStatsWidgets();
                return;
            }

            empty.classList.add('hidden');
            loading.classList.add('hidden');
            pagination.classList.remove('hidden');

            // Render Table
            data.items.forEach(emp => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-white/5 transition-colors group border-b border-[#262626] last:border-0 align-middle';

                tr.innerHTML = `
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-[#d4af37]/10 flex items-center justify-center text-[#d4af37] font-bold text-sm border border-[#d4af37]/20">
                                ${emp.name.substring(0, 2).toUpperCase()}
                            </div>
                            <span class="font-bold text-white text-base">${emp.name}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 text-gray-400 text-sm">${emp.email}</td>
                    <td class="px-6 py-4">
                         <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold ${emp.role === 'Admin' ? 'bg-purple-500/10 text-purple-500 border border-purple-500/20' : 'bg-blue-500/10 text-blue-500 border border-blue-500/20'}">
                            ${emp.role}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-gray-400 text-sm font-mono">${emp.phoneNumber || '-'}</td>
                    <td class="px-6 py-4 text-gray-300 text-sm font-mono font-bold">${formatCurrency(emp.salary)}</td>
                    <td class="px-6 py-4 text-gray-500 text-sm truncate max-w-[150px]" title="${emp.address || ''}">${emp.address || '-'}</td>
                    <td class="px-6 py-4 text-center">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold ${emp.isActive ? 'bg-green-500/10 text-green-500 border border-green-500/20' : 'bg-red-500/10 text-red-500 border border-red-500/20'}">
                            ${emp.isActive ? 'Active' : 'Inactive'}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2 opacity-100 transition-opacity">
                            ${canResetEmployeePassword ? `
                            <button class="reset-pass p-2 text-blue-400 hover:text-blue-300 hover:bg-blue-500/10 rounded-lg transition-colors" data-id="${emp.employeeId}" title="Reset Password">
                                <span class="material-symbols-outlined text-[20px]">key</span>
                            </button>` : ''}
                            <button class="edit-employee p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors" data-id="${emp.employeeId}" title="Edit">
                                <span class="material-symbols-outlined text-[20px]">edit</span>
                            </button>
                            ${emp.role !== 'Admin' ? `
                            <button class="delete-employee p-2 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-colors" data-id="${emp.employeeId}" title="Delete">
                               <span class="material-symbols-outlined text-[20px]">delete</span>
                            </button>` : ''}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            // Pagination UI
            totalPages = data.totalPages;
            document.getElementById('showingText').innerText = `Showing ${(currentPage - 1) * pageSize + 1} - ${Math.min(currentPage * pageSize, data.totalCount)} of ${data.totalCount}`;
            document.getElementById('prevBtn').disabled = currentPage <= 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages;

            renderPageNumbers(totalPages, currentPage);
            updateStatsWidgets();

        } catch (e) {
            console.error(e);
            tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-red-500">Failed to load data</td></tr>';
            tbody.closest('table').style.opacity = '1';
        }
    }

    function renderPageNumbers(total, current) {
        const container = document.getElementById('pageNumbers');
        container.innerHTML = '';

        let pages = [];
        if (total <= 7) {
            pages = Array.from({ length: total }, (_, i) => i + 1);
        } else {
            if (current <= 4) {
                pages = [1, 2, 3, 4, 5, '...', total];
            } else if (current >= total - 3) {
                pages = [1, '...', total - 4, total - 3, total - 2, total - 1, total];
            } else {
                pages = [1, '...', current - 1, current, current + 1, '...', total];
            }
        }

        pages.forEach(p => {
            if (p === '...') {
                const span = document.createElement('span');
                span.className = 'text-gray-600 px-2';
                span.textContent = '...';
                container.appendChild(span);
            } else {
                const btn = document.createElement('button');
                btn.className = `w-8 h-8 rounded-lg text-xs font-bold transition-all ${p === current ? 'bg-gold text-black shadow-lg shadow-gold/20' : 'bg-[#16181a] text-gray-400 hover:text-white hover:bg-white/10'}`;
                btn.textContent = p;
                btn.onclick = () => gotoPage(p);
                container.appendChild(btn);
            }
        });
    }

    async function updateStatsWidgets() {
        const getCount = async (params) => {
            const p = new URLSearchParams(params);
            p.append('pageSize', '1');
            const res = await fetch('/api/Employee?' + p.toString());
            const data = await res.json();
            return data.totalCount;
        };

        const [total, active, admins, inactive] = await Promise.all([
            getCount({}),
            getCount({ active: 'true' }),
            getCount({ role: 'Admin' }),
            getCount({ active: 'false' })
        ]);

        document.getElementById('stat-total').textContent = total;
        document.getElementById('stat-active').textContent = active;
        document.getElementById('stat-admins').textContent = admins;
        document.getElementById('stat-inactive').textContent = inactive;
    }

    async function loadModal(url) {
        try {
            const res = await fetch(url);
            if (!res.ok) throw new Error("Failed to load modal");
            const html = await res.text();

            const placeholder = document.getElementById('employeeModalPlaceholder');
            placeholder.innerHTML = html;

            // Execute scripts
            placeholder.querySelectorAll('script').forEach(scr => {
                const s = document.createElement('script');
                s.textContent = scr.textContent;
                document.body.appendChild(s);
                document.body.removeChild(s);
            });

            const modalEl = placeholder.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();

            // Re-bind modal events if needed (specifically for delete/edit logic handled within partials usually)

        } catch (e) { console.error(e); }
    }

    // Delegation for Action Buttons
    document.getElementById('employeeRows').addEventListener('click', async e => {
        const edit = e.target.closest('.edit-employee');
        const del = e.target.closest('.delete-employee');
        const reset = e.target.closest('.reset-pass');

        if (edit) {
            loadModal('/Employee/Edit/' + edit.dataset.id);
        } else if (del) {
            loadModal('/Employee/Delete/' + del.dataset.id);
        } else if (reset) {
            if (confirm('Are you sure you want to reset the password for this employee?')) {
                try {
                    const response = await fetch('/api/Employee/' + reset.dataset.id + '/reset-password', { method: 'POST' });
                    if (response.ok) {
                        if (window.showPopup) window.showPopup('Password reset successfully.', 'success');
                    } else {
                        if (window.showPopup) window.showPopup('Failed to reset password.', 'error');
                    }
                } catch (err) {
                    console.error(err);
                    if (window.showPopup) window.showPopup('Error connecting to server.', 'error');
                }
            }
        }
    });

</script>
