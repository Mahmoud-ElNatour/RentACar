@{
    ViewData["Title"] = "Employees";
    Layout = null;
    var canResetEmployeePassword = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employees.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("_PopupNotifications")
    <div class="employee-container container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="../ControlPanel" class="btn btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px" title="Back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="flex-grow-1 text-center m-0">Manage Employees</h2>
            <div style="width:40px;"></div>
        </div>




        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="btn btn-outline-light role-tab active" data-role="">All</button>
            <button class="btn btn-outline-light role-tab" data-role="Employee">Employees</button>
            <button class="btn btn-outline-light role-tab" data-role="Driver">Drivers</button>
            <button class="btn btn-outline-light role-tab" data-role="Manager">Managers</button>
            <button class="btn btn-outline-light role-tab" data-role="Admin">Admins</button>
            <button type="button" id="addEmployee" class="btn btn-primary ms-auto"><i class="fas fa-plus me-1"></i>Add Employee</button>
        </div>

        <form id="filterForm" class="row g-2 mb-4 align-items-end">
            <div class="col">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Name, Email, or Driver Code" />
            </div>
            <div class="col">
                <label class="form-label">Active</label>
                <select name="active" class="form-select">
                    <option value="">Any</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Filter</button>
            </div>
        </form>






        <div class="mb-3">
            <input type="text" id="tableSearch" class="form-control" placeholder="Search table..." />
        </div>
        <div class="table-responsive">
            <table id="employeeTable" class="table table-striped table-dark align-middle">
                <thead id="employeeTableHead"></thead>
                <tbody id="employeeRows"></tbody>
            </table>
        </div>
    </div>
    <div id="employeeModalPlaceholder"></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const canResetPassword = @(canResetEmployeePassword.ToString().ToLower());
        let activeRoleFilter = '';

        function renderHeader(roleFilter) {
            const head = document.getElementById('employeeTableHead');
            if (roleFilter === 'Driver') {
                head.innerHTML = `
                    <tr>
                        <th>Employee ID</th>
                        <th>Driver Code</th>
                        <th>Full Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Rating</th>
                        <th>License #</th>
                        <th>Expiry</th>
                        <th>Languages</th>
                        <th>Active</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>`;
                return;
            }

            if (roleFilter === 'Employee') {
                head.innerHTML = `
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Salary</th>
                        <th>Address</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>`;
                return;
            }

            head.innerHTML = `
                <tr>
                    <th>Employee ID</th>
                    <th>Name</th>
                    <th>Roles</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>`;
        }

        async function loadEmployees() {
            const params = new URLSearchParams(new FormData(document.getElementById('filterForm')));
            if (activeRoleFilter) {
                params.append('role', activeRoleFilter);
            }
            const res = await fetch('/api/Employee?' + params.toString());
            const data = await res.json();
            const tbody = document.getElementById('employeeRows');
            tbody.innerHTML = '';
            renderHeader(activeRoleFilter);
            data.forEach(emp => {
                const row = document.createElement('tr');
                if (activeRoleFilter === 'Driver') {
                    row.innerHTML = `
                        <td>${emp.employeeId}</td>
                        <td>${emp.driverCode ?? ''}</td>
                        <td>${emp.driverFullName ?? emp.name}</td>
                        <td>${emp.driverPhone ?? ''}</td>
                        <td>${emp.driverEmail ?? emp.email ?? ''}</td>
                        <td>${emp.driverRating ?? ''}</td>
                        <td>${emp.driverLicenseNumber ?? ''}</td>
                        <td>${emp.driverLicenseExpiry ?? ''}</td>
                        <td>${emp.driverLanguages ?? ''}</td>
                        <td class="text-center">${emp.driverIsActive ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>'}</td>
                        <td>${emp.driverCreatedAt ?? ''}</td>
                        <td>${emp.driverUpdatedAt ?? ''}</td>
                        <td>
                            <a href="#" class="text-warning me-2 edit-employee" data-id="${emp.employeeId}"><i class="fas fa-pencil-alt"></i></a>
                            <a href="#" class="text-danger delete-employee" data-id="${emp.employeeId}"><i class="fas fa-trash"></i></a>
                            ${canResetPassword ? `<a href="#" class="text-info ms-2 reset-pass" data-id="${emp.employeeId}" title="Reset Password"><i class="fas fa-key"></i></a>` : ''}
                        </td>`;
                } else if (activeRoleFilter === 'Employee') {
                    row.innerHTML = `
                        <td>${emp.employeeId}</td>
                        <td>${emp.name}</td>
                        <td>${emp.salary ?? ''}</td>
                        <td>${emp.address ?? ''}</td>
                        <td class="text-center">${emp.isActive ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>'}</td>
                        <td>
                            <a href="#" class="text-warning me-2 edit-employee" data-id="${emp.employeeId}"><i class="fas fa-pencil-alt"></i></a>
                            <a href="#" class="text-danger delete-employee" data-id="${emp.employeeId}"><i class="fas fa-trash"></i></a>
                            ${canResetPassword ? `<a href="#" class="text-info ms-2 reset-pass" data-id="${emp.employeeId}" title="Reset Password"><i class="fas fa-key"></i></a>` : ''}
                        </td>`;
                } else {
                    const roles = (emp.roles ?? []).map(r => `<span class="badge bg-secondary me-1">${r}</span>`).join('');
                    row.innerHTML = `
                        <td>${emp.employeeId}</td>
                        <td>${emp.name}</td>
                        <td>${roles || ''}</td>
                        <td class="text-center">${emp.isActive ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>'}</td>
                        <td>
                            <a href="#" class="text-warning me-2 edit-employee" data-id="${emp.employeeId}"><i class="fas fa-pencil-alt"></i></a>
                            <a href="#" class="text-danger delete-employee" data-id="${emp.employeeId}"><i class="fas fa-trash"></i></a>
                            ${canResetPassword ? `<a href="#" class="text-info ms-2 reset-pass" data-id="${emp.employeeId}" title="Reset Password"><i class="fas fa-key"></i></a>` : ''}
                        </td>`;
                }
                tbody.appendChild(row);
            });
        }
        async function loadModal(url) {
            const res = await fetch(url);
            const html = await res.text();
            const placeholder = document.getElementById('employeeModalPlaceholder');
            placeholder.innerHTML = html;
            placeholder.querySelectorAll('script').forEach(scr => {
                const s = document.createElement('script');
                s.textContent = scr.textContent;
                document.body.appendChild(s);
                document.body.removeChild(s);
            });
            const modalEl = placeholder.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
        document.addEventListener('DOMContentLoaded', () => {
            loadEmployees();
            document.getElementById('filterForm').addEventListener('submit', e => { e.preventDefault(); loadEmployees(); });
            document.getElementById('addEmployee').addEventListener('click', () => loadModal('/Employee/Add'));
            document.querySelectorAll('.role-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    document.querySelectorAll('.role-tab').forEach(btn => btn.classList.remove('active'));
                    tab.classList.add('active');
                    activeRoleFilter = tab.dataset.role;
                    loadEmployees();
                });
            });
            document.getElementById('employeeRows').addEventListener('click', async e => {
                const edit = e.target.closest('.edit-employee');
                const del = e.target.closest('.delete-employee');
                const reset = canResetPassword ? e.target.closest('.reset-pass') : null;
                if (edit) {
                    e.preventDefault();
                    loadModal('/Employee/Edit/' + edit.dataset.id);
                } else if (del) {
                    e.preventDefault();
                    loadModal('/Employee/Delete/' + del.dataset.id);
                } else if (reset) {
                    e.preventDefault();
                    showPopupConfirm('Reset password for this employee?', {
                        type: 'warning',
                        confirmLabel: 'Reset',
                        cancelLabel: 'Keep',
                    }).then(async confirmed => {
                        if (!confirmed) {
                            return;
                        }
                        const response = await fetch('/api/Employee/' + reset.dataset.id + '/reset-password', { method: 'POST' });
                        if (response.ok) {
                            showPopup('Password reset successfully to E@e123456', 'success');
                        } else if (response.status === 404) {
                            showPopup('Employee not found.', 'warning');
                        } else {
                            showPopup('Failed to reset password.', 'error');
                        }
                    });
                }
            });
            document.getElementById('tableSearch').addEventListener('keyup', function () {
                const value = this.value.toLowerCase();
                document.querySelectorAll('#employeeTable tbody tr').forEach(tr => {
                    tr.style.display = tr.textContent.toLowerCase().includes(value) ? '' : 'none';
                });
            });
        });
    </script>
</body>
</html>
