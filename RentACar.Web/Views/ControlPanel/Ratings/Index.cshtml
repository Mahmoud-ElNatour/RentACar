@model IEnumerable<RentACar.Application.DTOs.CustomerRatingDisplayDto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Booking Reviews";
}

<!-- Injecting User's Tailwind Config and Styles for this specific page -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                colors: {
                    "primary": "#edbc1d",
                    "background-light": "#f8f8f6",
                    "background-dark": "#050505", // True black for luxury feel
                    "card-dark": "#121212",
                },
                fontFamily: {
                    "display": ["Manrope", "sans-serif"]
                },
                borderRadius: {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
                },
            },
        },
    }
</script>
<style>
    .gold-underline {
        position: relative;
    }
    .gold-underline::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 16px;
        width: 80px;
        height: 4px;
        background-color: #edbc1d;
        border-radius: 2px;
    }
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #050505;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 10px;
    }
    .fill-1 {
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    /* Ensure no conflicts with global styles */
    .ratings-wrapper {
        font-family: 'Manrope', sans-serif;
    }
</style>

<div class="ratings-wrapper bg-[#050505] text-white transition-colors duration-300 min-h-screen">
    <div class="layout-container flex h-full grow flex-col">
        <!-- Main Content Wrapper -->
        <main class="max-w-[1200px] mx-auto w-full px-6 py-10 flex flex-col gap-8">
            
            <!-- Search Form -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 px-4">
                <div class="flex flex-col gap-2">
                    <h1 class="text-white tracking-tight text-4xl font-extrabold leading-tight gold-underline">
                        Booking Reviews
                    </h1>
                    <p class="text-slate-400 mt-4 text-sm uppercase tracking-widest font-medium">Customer Satisfaction Management</p>
                </div>
                <div class="w-full max-w-md">
                    <form method="get" asp-action="Index">
                        <label class="flex flex-col min-w-40 h-12 w-full">
                            <div class="flex w-full flex-1 items-stretch rounded-lg h-full border border-white/10 focus-within:border-primary/50 transition-all">
                                <button type="submit" class="text-primary flex items-center justify-center pl-4 rounded-l-lg bg-card-dark hover:text-white transition-colors">
                                    <span class="material-symbols-outlined">search</span>
                                </button>
                                <input name="searchTerm" value="@ViewBag.CurrentSearch" class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-white focus:outline-0 focus:ring-0 border-none bg-card-dark placeholder:text-slate-500 px-4 rounded-l-none border-l-0 pl-2 text-base font-normal leading-normal" placeholder="Filter by customer or content..." />
                            </div>
                        </label>
                    </form>
                </div>
            </div>

            <!-- Stats Row -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 px-4">
                <!-- Average Rating Card -->
                <div class="flex flex-col gap-3 rounded-xl p-8 bg-card-dark border-t-2 border-primary shadow-2xl">
                    <p class="text-slate-400 text-sm font-semibold uppercase tracking-wider">Average Rating</p>
                    <div class="flex items-center gap-3">
                        <p class="text-white tracking-tight text-4xl font-bold">@((ViewBag.AverageRating as double?)?.ToString("0.0"))</p>
                        <div class="flex text-primary">
                            @{
                                var avg = (ViewBag.AverageRating as double?) ?? 0;
                                for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= avg) { <span class="material-symbols-outlined fill-1">star</span> }
                                    else if (i - 0.5 <= avg) { <span class="material-symbols-outlined fill-1">star_half</span> }
                                    else { <span class="material-symbols-outlined">star</span> }
                                }
                            }
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[#0bda1d] text-sm font-bold flex items-center">
                            <span class="material-symbols-outlined text-sm mr-1">trending_up</span>+0.0%
                        </span>
                        <span class="text-slate-500 text-xs tracking-wide">vs last month</span>
                    </div>
                </div>

                <!-- Total Reviews Card -->
                <div class="flex flex-col gap-3 rounded-xl p-8 bg-card-dark border-t-2 border-primary shadow-2xl">
                    <p class="text-slate-400 text-sm font-semibold uppercase tracking-wider">Total Reviews</p>
                    <p class="text-white tracking-tight text-4xl font-bold">@ViewBag.TotalRatings</p>
                    <div class="flex items-center gap-2">
                        <span class="text-[#0bda1d] text-sm font-bold flex items-center">
                            <span class="material-symbols-outlined text-sm mr-1">trending_up</span>+0%
                        </span>
                        <span class="text-slate-500 text-xs tracking-wide">new submissions</span>
                    </div>
                </div>

                <!-- Positive Sentiment % Card (Mocked logic for now: % of 4+ stars) -->
                @{
                    var ratingsList = Model.ToList();
                    var total = ratingsList.Count;
                    var positive = ratingsList.Count(r => r.Stars >= 4);
                    var percent = total > 0 ? (int)((double)positive / total * 100) : 0;
                }
                <div class="flex flex-col gap-3 rounded-xl p-8 bg-card-dark border-t-2 border-primary shadow-2xl">
                    <p class="text-slate-400 text-sm font-semibold uppercase tracking-wider">Positive Sentiment</p>
                    <div class="flex items-center gap-4">
                        <p class="text-white tracking-tight text-4xl font-bold">@percent%</p>
                        <div class="flex-1 h-2 bg-white/10 rounded-full overflow-hidden">
                            <div class="bg-primary h-full" style="width: @percent%; box-shadow: 0 0 10px rgba(237, 188, 29, 0.4)"></div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[#0bda1d] text-sm font-bold flex items-center">
                            <span class="material-symbols-outlined text-sm mr-1">trending_up</span>+0%
                        </span>
                        <span class="text-slate-500 text-xs tracking-wide">satisfaction peak</span>
                    </div>
                </div>
            </div>

            <!-- Table Container -->
            <div class="px-4">
                <div class="rounded-xl overflow-hidden border border-white/5 bg-card-dark shadow-2xl">
                    <div class="p-6 border-b border-white/10 flex justify-between items-center">
                        <h2 class="text-xl font-bold text-white">Recent Feedback</h2>
                        <a asp-action="Export" asp-route-searchTerm="@ViewBag.CurrentSearch" asp-route-sortColumn="@ViewBag.CurrentSort" asp-route-sortDirection="@ViewBag.CurrentSortDir" class="text-primary text-sm font-bold flex items-center gap-2 hover:text-primary/80 transition-colors cursor-pointer decoration-0 hover:no-underline">
                            <span class="material-symbols-outlined text-base">download</span> Export Report
                        </a>
                    </div>
                    <div class="overflow-x-auto custom-scrollbar">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-white/5">
                                    <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest">
                                        <a asp-action="Index" asp-route-sortColumn="BookingId" asp-route-sortDirection="@ViewBag.NextSortDir" asp-route-searchTerm="@ViewBag.CurrentSearch" class="hover:text-white transition-colors flex items-center gap-1 group">
                                            Booking ID <span class="material-symbols-outlined text-[14px] opacity-0 group-hover:opacity-100 transition-opacity">sort</span>
                                        </a>
                                    </th>
                                    <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest">
                                        <a asp-action="Index" asp-route-sortColumn="RatingDate" asp-route-sortDirection="@ViewBag.NextSortDir" asp-route-searchTerm="@ViewBag.CurrentSearch" class="hover:text-white transition-colors flex items-center gap-1 group">
                                            Rating Date <span class="material-symbols-outlined text-[14px] opacity-0 group-hover:opacity-100 transition-opacity">sort</span>
                                        </a>
                                    </th>
                                    <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest">
                                        <a asp-action="Index" asp-route-sortColumn="Customer" asp-route-sortDirection="@ViewBag.NextSortDir" asp-route-searchTerm="@ViewBag.CurrentSearch" class="hover:text-white transition-colors flex items-center gap-1 group">
                                            Customer <span class="material-symbols-outlined text-[14px] opacity-0 group-hover:opacity-100 transition-opacity">sort</span>
                                        </a>
                                    </th>
                                    <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest">
                                        <a asp-action="Index" asp-route-sortColumn="Stars" asp-route-sortDirection="@ViewBag.NextSortDir" asp-route-searchTerm="@ViewBag.CurrentSearch" class="hover:text-white transition-colors flex items-center gap-1 group">
                                            Rating <span class="material-symbols-outlined text-[14px] opacity-0 group-hover:opacity-100 transition-opacity">sort</span>
                                        </a>
                                    </th>
                                    <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest">Feedback</th>
                                    <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                @foreach (var item in Model)
                                {
                                    <tr class="hover:bg-white/5 transition-colors group">
                                        <td class="px-6 py-5 text-sm font-mono text-slate-300">#@item.BookingId</td>
                                        <td class="px-6 py-5 text-sm text-slate-300">@item.RatingDate.ToString("MMM dd, yyyy")</td>
                                        <td class="px-6 py-5">
                                            <div class="flex items-center gap-3">
                                                <div class="size-9 rounded-full bg-cover bg-center border border-primary/20" 
                                                     style="background-image: url('https://ui-avatars.com/api/?name=@item.CustomerName&background=121212&color=edbc1d');"></div>
                                                <span class="text-white font-semibold">@item.CustomerName</span>
                                            </div>
                                        </td>
                                        <td class="px-6 py-5">
                                            <div class="flex text-primary gap-0.5">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= item.Stars) { <span class="material-symbols-outlined text-lg fill-1">star</span> }
                                                    else { <span class="material-symbols-outlined text-lg">star</span> }
                                                }
                                            </div>
                                        </td>
                                        <td class="px-6 py-5">
                                            <p class="text-slate-400 text-sm max-w-xs truncate" title="@item.Feedback">
                                                @(string.IsNullOrEmpty(item.Feedback) ? "No written feedback" : item.Feedback)
                                            </p>
                                        </td>
                                        <td class="px-6 py-5 text-right">
                                            <button onclick="viewRatingDetails(@item.RatingId)" class="text-primary hover:scale-110 transition-transform p-2 rounded-lg hover:bg-primary/10">
                                                <span class="material-symbols-outlined">visibility</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination / Footer -->
                    <div class="px-6 py-4 border-t border-white/10 flex items-center justify-between">
                        <span class="text-slate-500 text-xs">Showing @Model.Count() reviews</span>
                        <div class="flex gap-2">
                           <!-- Simple pagination for now -->
                           <button class="px-3 py-1 bg-primary text-black rounded text-sm font-bold shadow-lg shadow-primary/20">1</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Quote Area -->
            <div class="mt-10 px-4 flex justify-center text-center">
                <div class="max-w-2xl flex flex-col items-center gap-4">
                    <div class="text-primary flex gap-1">
                        <span class="material-symbols-outlined">verified</span>
                        <span class="text-xs uppercase tracking-[0.3em] font-bold">Excellence Guaranteed</span>
                    </div>
                    <p class="italic text-slate-500 text-sm">"Customer feedback is the compass for our engineering of perfection. Every review is a chance to refine the RentACar signature service."</p>
                </div>
            </div>
        </main>
    </div>
    
    <!-- Background Decoration -->
    <div class="fixed top-0 right-0 -z-10 w-1/3 h-1/2 bg-primary/5 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="fixed bottom-0 left-0 -z-10 w-1/4 h-1/3 bg-primary/5 blur-[100px] rounded-full pointer-events-none"></div>
</div>

<!-- Details Modal -->
<!-- We'll reuse the Bootstrap modal structure to load the new Partial View because the app uses Bootstrap modals -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 800px;">
        <div class="modal-content bg-transparent border-0">
             <!-- Partial loads here -->
             <div id="detailsModalBody"></div>
        </div>
    </div>
</div>

<script>
    function viewRatingDetails(id) {
        var modal = new bootstrap.Modal(document.getElementById('detailsModal'));
        modal.show();
        
        $('#detailsModalBody').load('/ControlPanel/Ratings/Details/' + id, function(response, status, xhr) {
            if (status == "error") {
                $('#detailsModalBody').html('<div class="text-center text-danger py-4 font-bold bg-[#121212] rounded-xl border border-white/10">Failed to load details.</div>');
            }
        });
    }
</script>
