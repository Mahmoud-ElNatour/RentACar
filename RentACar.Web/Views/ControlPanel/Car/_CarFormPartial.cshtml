@model RentACar.Application.DTOs.CarDto
<div class="modal fade" id="carFormModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content !bg-[#121212] !border !border-gold shadow-2xl rounded-2xl overflow-hidden">
            <div class="modal-header border-b border-[#262626] p-6 !bg-[#121212]">
                <h5 class="flex items-center gap-3 text-xl font-bold text-white uppercase tracking-wider">
                    <span class="material-symbols-outlined text-gold">@(Model.CarId == 0 ? "add_circle" : "edit_square")</span>
                    @(Model.CarId == 0 ? "Register New Vehicle" : "Edit Vehicle Details")
                </h5>
                <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>
            
            <div class="modal-body p-6 md:p-8 bg-[#121212]">
                <form id="carForm" class="space-y-6">
                    <input type="hidden" name="CarId" value="@Model.CarId" />
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Left Column -->
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Model Name</label>
                                <input asp-for="ModelName" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 px-4 text-white focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" placeholder="e.g. BMW X5" />
                                <span asp-validation-for="ModelName" class="text-red-500 text-xs mt-1 block"></span>
                            </div>
                            
                            <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Plate Number</label>
                                <input asp-for="PlateNumber" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 px-4 text-white font-mono uppercase focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" placeholder="XXX-0000" />
                                <span asp-validation-for="PlateNumber" class="text-red-500 text-xs mt-1 block"></span>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Year</label>
                                    <input asp-for="ModelYear" type="number" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 px-4 text-white focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Color</label>
                                    <input asp-for="Color" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 px-4 text-white focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" />
                                </div>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="space-y-4">
                             <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Price Per Day ($)</label>
                                <div class="relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gold font-bold">$</span>
                                    <input asp-for="PricePerDay" type="number" step="0.01" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 pl-8 pr-4 text-white font-mono font-bold focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Category</label>
                                <div class="relative">
                                     <select asp-for="CategoryId" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 pl-4 pr-10 text-white focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold appearance-none cursor-pointer" asp-items="ViewBag.Categories">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                    <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500 pointer-events-none">expand_more</span>
                                </div>
                            </div>

                             <div>
                                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Vehicle Image</label>
                                <input type="file" id="CarImage" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-2 px-4 text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-white/5 file:text-gold hover:file:bg-gold/10 transition-all text-sm" accept="image/*" />
                                
                                <div id="previewContainer" class="mt-4 h-32 w-full bg-[#0a0a0a] border border-[#262626] border-dashed rounded-xl flex items-center justify-center overflow-hidden relative group">
                                    <img id="CarImagePreview" class="w-full h-full object-cover @(Model.CarImage == null ? "hidden" : "")" 
                                         src="@(Model.CarImage != null ? $"data:image;base64,{Convert.ToBase64String(Model.CarImage)}" : "")" />
                                    
                                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none @(Model.CarImage != null ? "hidden" : "")" id="uploadPlaceholder">
                                        <div class="flex flex-col items-center text-gray-600">
                                            <span class="material-symbols-outlined text-3xl mb-1">cloud_upload</span>
                                            <span class="text-xs">No image selected</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-[#262626]">
                         <label class="flex items-center gap-3 cursor-pointer group">
                             <div class="relative">
                                <input asp-for="IsAvailable" type="checkbox" class="sr-only peer" />
                                <div class="w-10 h-6 bg-[#262626] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-600"></div>
                             </div>
                             <span class="text-sm font-bold text-gray-300 group-hover:text-white transition-colors">Active / Operational</span>
                        </label>

                        <div class="flex gap-3">
                            <button type="button" class="px-6 py-2.5 rounded-xl border border-[#262626] text-gray-400 font-bold hover:bg-white/5 hover:text-white transition-colors" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="px-8 py-2.5 rounded-xl bg-gold text-black font-bold hover:bg-[#b5952f] transition-colors shadow-lg shadow-gold/10">
                                @(Model.CarId == 0 ? "Add Vehicle" : "Save Changes")
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
