@model RentACar.Application.DTOs.CarDto
<div class="modal fade" id="deleteCarModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content !bg-[#121212] !border !border-red-900/50 shadow-2xl rounded-2xl overflow-hidden">
            <div class="modal-body p-8 text-center bg-[#121212]">
                <!-- Icon -->
                <div class="w-20 h-20 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center mx-auto mb-6">
                    <span class="material-symbols-outlined text-4xl text-red-500">warning</span>
                </div>

                <h3 class="text-xl font-bold text-white mb-2">Delete Confirmation</h3>
                <p class="text-gray-400 mb-8">
                    Are you sure you want to permanently remove vehicle <br/>
                    <span class="text-white font-mono bg-white/5 px-2 py-0.5 rounded font-bold">@Model.PlateNumber</span> ?
                    <br/><span class="text-xs text-gray-500 mt-2 block">This action cannot be undone.</span>
                </p>

                <form id="deleteCarForm" class="flex flex-col gap-3">
                    <div class="p-3 mb-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm hidden flex items-center gap-2" id="deleteCarError" role="alert">
                         <span class="material-symbols-outlined text-lg">error</span>
                         <span class="error-text"></span>
                    </div>

                    <input type="hidden" name="carId" value="@Model.CarId" />
                    
                    <button type="submit" class="w-full py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold transition-colors shadow-lg shadow-red-900/20 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">delete</span>
                        Confirm Deletion
                    </button>
                    
                    <button type="button" class="w-full py-3 rounded-xl border border-[#262626] text-gray-400 font-bold hover:bg-white/5 hover:text-white transition-colors" data-bs-dismiss="modal">
                        Cancel
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
