@model RentACar.Application.DTOs.CarDto
<div class="modal fade" id="carInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content !bg-[#121212] !border !border-gold shadow-2xl rounded-2xl overflow-hidden">
            <div class="modal-header border-b border-[#262626] p-6 !bg-[#121212]">
                <h5 class="flex items-center gap-3 text-xl font-bold text-white uppercase tracking-wider">
                    <span class="material-symbols-outlined text-gold">info</span>
                    Vehicle Complete Details
                </h5>
                <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>
            
            <div class="modal-body p-6 md:p-8 bg-[#121212] text-white space-y-8">
                
                <!-- Basic Info -->
                <div class="flex flex-col md:flex-row gap-6">
                    <div class="w-full md:w-1/3 h-48 bg-[#0a0a0a] border border-[#262626] rounded-xl flex items-center justify-center overflow-hidden">
                        @if (Model.CarImage != null)
                        {
                            <img class="w-full h-full object-cover" src="data:image;base64,@Convert.ToBase64String(Model.CarImage)" alt="Car Image" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-gray-600 text-5xl">directions_car</span>
                        }
                    </div>
                    
                    <div class="grid grid-cols-2 gap-y-4 gap-x-8 w-full md:w-2/3">
                        <div>
                            <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Model Name</p>
                            <p class="font-bold text-lg">@Model.ModelName</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Plate Number</p>
                            <p class="font-mono bg-[#0a0a0a] border border-[#262626] px-2 py-1 inline-block rounded">@Model.PlateNumber</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Year</p>
                            <p class="font-bold">@Model.ModelYear</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Color</p>
                            <p class="font-bold flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full border border-white/20" style="background-color: @(Model.Color ?? " #333")"></span>
                                @(Model.Color ?? "N/A")
                            </p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Category</p>
                            <p class="font-bold">@Model.CategoryName</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Status</p>
                            <p>
                                @if(Model.IsAvailable)
                                {
                                    <span class="text-green-500 font-bold bg-green-500/10 px-2 py-1 border border-green-500/20 rounded-full text-xs">Active / Available</span>
                                }
                                else
                                {
                                    <span class="text-red-500 font-bold bg-red-500/10 px-2 py-1 border border-red-500/20 rounded-full text-xs">Inactive</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Pricing -->
                <div class="border-t border-[#262626] pt-6 grid grid-cols-2 gap-6">
                    <div>
                        <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Price Per Day</p>
                        <p class="text-2xl font-black text-gold">$@Model.PricePerDay</p>
                    </div>
                     <div>
                        <p class="text-gray-400 text-xs uppercase font-bold tracking-wider mb-1">Extra Driver Fee</p>
                        <p class="text-xl font-bold font-mono">$@(Model.ExtraDriverFeePerDay ?? 0)<span class="text-sm text-gray-500"> / day</span></p>
                    </div>
                </div>

                <!-- Specifications -->
                <div class="border-t border-[#262626] pt-6">
                    <h6 class="text-gold font-bold uppercase tracking-widest text-sm mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined">tune</span> Technical Specifications
                    </h6>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-[#0a0a0a] border border-[#262626] p-4 rounded-xl">
                        <div>
                            <p class="text-gray-500 text-xs font-bold uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">airline_seat_recline_normal</span> Seats</p>
                            <p class="font-bold">@Model.SeatsCapacity</p>
                        </div>
                        <div>
                            <p class="text-gray-500 text-xs font-bold uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">sensor_door</span> Doors</p>
                            <p class="font-bold">@Model.Doors</p>
                        </div>
                        <div>
                            <p class="text-gray-500 text-xs font-bold uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">luggage</span> Luggage (Bags)</p>
                            <p class="font-bold">@(Model.LuggageCapacity?.ToString() ?? "N/A")</p>
                        </div>
                        <div>
                            <p class="text-gray-500 text-xs font-bold uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">settings</span> Transmission</p>
                            <p class="font-bold text-sm">@Model.TransmissionType.ToString()</p>
                        </div>
                        <div>
                            <p class="text-gray-500 text-xs font-bold uppercase mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">local_gas_station</span> Fuel</p>
                            <p class="font-bold text-sm">@Model.FuelType.ToString()</p>
                        </div>
                    </div>
                </div>

                <!-- Features Checklist -->
                <div class="border-t border-[#262626] pt-6">
                     <h6 class="text-gold font-bold uppercase tracking-widest text-sm mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined">star</span> Extra Features
                    </h6>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-y-3 gap-x-4">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined @(Model.SupportsBabySeat ? "text-green-500" : "text-gray-600")">@(Model.SupportsBabySeat ? "check_circle" : "cancel")</span>
                            <span class="text-sm @(Model.SupportsBabySeat ? "text-white" : "text-gray-500")">Baby Seat Support</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined @(Model.HasInfotainmentScreen ? "text-green-500" : "text-gray-600")">@(Model.HasInfotainmentScreen ? "check_circle" : "cancel")</span>
                            <span class="text-sm @(Model.HasInfotainmentScreen ? "text-white" : "text-gray-500")">Infotainment</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined @(Model.HasGPS ? "text-green-500" : "text-gray-600")">@(Model.HasGPS ? "check_circle" : "cancel")</span>
                            <span class="text-sm @(Model.HasGPS ? "text-white" : "text-gray-500")">Built-in GPS</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined @(Model.HasSunroof ? "text-green-500" : "text-gray-600")">@(Model.HasSunroof ? "check_circle" : "cancel")</span>
                            <span class="text-sm @(Model.HasSunroof ? "text-white" : "text-gray-500")">Sunroof</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined @(Model.HasParkingSensors ? "text-green-500" : "text-gray-600")">@(Model.HasParkingSensors ? "check_circle" : "cancel")</span>
                            <span class="text-sm @(Model.HasParkingSensors ? "text-white" : "text-gray-500")">Parking Sensors</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined @(Model.HasRearCamera ? "text-green-500" : "text-gray-600")">@(Model.HasRearCamera ? "check_circle" : "cancel")</span>
                            <span class="text-sm @(Model.HasRearCamera ? "text-white" : "text-gray-500")">Rear Camera</span>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer border-t border-[#262626] p-4 !bg-[#121212] flex justify-end">
                <button type="button" class="px-6 py-2.5 rounded-xl bg-[#262626] text-white font-bold hover:bg-white/10 transition-colors" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
