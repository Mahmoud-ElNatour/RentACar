@{
    ViewData["Title"] = "Payment Methods";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payment-methods.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("_PopupNotifications")
    <div class="payment-method-container">
        <a href="../ControlPanel" class="btn btn-outline-warning mb-3 rounded-circle d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px" title="Back">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h2 class="page-title mb-4 text-center" style="color:white; font-size: 2rem; font-weight:600;">Payment Methods</h2>
        <div class="text-end mb-3">
            <button class="btn btn-primary add-method">Add Method</button>
        </div>
        <div class="payment-method-grid" id="methodGrid">
        </div>
    </div>
    <div id="methodModalPlaceholder"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        async function loadMethods() {
            try {
                const res = await fetch('/api/PaymentMethod');
                const data = await res.json();
                const grid = document.getElementById('methodGrid');
                grid.innerHTML = '';

                data.forEach(m => {
                    const div = document.createElement('div');
                    div.className = `payment-method-card ${m.isActive ? '' : 'inactive'}`;
                    div.dataset.id = m.id;

                    const statusBadge = m.isActive 
                        ? `<span class="status-badge status-active">Active</span>`
                        : `<span class="status-badge status-inactive">Inactive</span>`;

                    div.innerHTML = statusBadge +
                        `<span class="payment-method-name">${m.paymentMethodName}</span>` +
                        `<div class="actions">` +
                        `<a href="#" class="edit-method" data-id="${m.id}"><i class="fas fa-pencil-alt"></i></a>` +
                        `<a href="#" class="delete-method" data-id="${m.id}" title="${m.isActive ? 'Deactivate' : 'Already Inactive'}"><i class="fas fa-trash"></i></a>` +
                        `</div>`;
                    grid.appendChild(div);
                });

            } catch (error) {
                console.error('Failed to load payment methods', error);
                showPopup('Failed to load payment methods.', 'error');
            }
        }

        async function loadModal(url) {
            const res = await fetch(url);
            const html = await res.text();
            const placeholder = document.getElementById('methodModalPlaceholder');
            placeholder.innerHTML = html;
            placeholder.querySelectorAll('script').forEach(scr => {
                const s = document.createElement('script');
                s.textContent = scr.textContent;
                document.body.appendChild(s);
                document.body.removeChild(s);
            });
            const modalEl = placeholder.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadMethods();
            document.querySelector('.add-method').addEventListener('click', () => loadModal('/PaymentMethod/Add'));

            document.getElementById('methodGrid').addEventListener('click', (e) => {
                const edit = e.target.closest('.edit-method');
                const del = e.target.closest('.delete-method');
                if (edit) {
                    e.preventDefault();
                    loadModal('/PaymentMethod/Edit/' + edit.dataset.id);
                } else if (del) {
                    e.preventDefault();
                    loadModal('/PaymentMethod/Delete/' + del.dataset.id);
                }
            });
        });
    </script>
</body>
</html>
