<script>
    function closeAddModal() {
        const modal = document.getElementById('addMethodModal');
        if(modal) {
            modal.remove();
        }
    }

    document.getElementById('addMethodForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const name = document.getElementById('paymentMethodName').value;
        const isActive = document.getElementById('isActive').checked;

        const dto = {
            paymentMethodName: name,
            isActive: isActive
        };

        try {
            const res = await fetch('/api/PaymentMethod', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dto)
            });

            if(res.ok) {
                closeAddModal();
                if(typeof loadPaymentMethods === 'function') {
                    loadPaymentMethods();
                } else {
                    window.location.reload();
                }
            } else {
                alert("Failed to create. Check if name exists.");
            }
        } catch(err) {
            console.error(err);
            alert("Error submitting form.");
        }
    });

    // Auto focus name
    setTimeout(() => {
        const input = document.getElementById('paymentMethodName');
        if(input) input.focus();
    }, 100);
</script>
