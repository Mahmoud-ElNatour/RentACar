@model RentACar.Application.DTOs.PaymentMethodDto
@{
    ViewData["Title"] = "Delete Payment Method";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login-style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("_PopupNotifications")
    <div class="container1">
        <div class="login-container text-center">
            <a href="/PaymentMethod" class="btn btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center"
               style="width: 40px; height: 40px;" title="Back">
                <i class="fas fa-arrow-left"></i>
            </a>

            <div class="logo-text mt-3">
                <i class="fas fa-money-check-alt fa-lg"></i>
                <div>RentACar</div>
            </div>

            <h2 class="mb-4">Delete Payment Method</h2>
            <p>Are you sure you want to delete <strong>@Model.PaymentMethodName</strong>?</p>

            <form id="deleteMethodForm" class="mt-3">
                <div class="alert alert-danger d-none" id="deleteMethodError" role="alert"></div>
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger me-2">
                    <i class="fas fa-trash-alt me-1"></i> Delete
                </button>
                <a href="/PaymentMethod" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('deleteMethodForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const id = this.querySelector('[name="Id"]').value;
            const errorAlert = document.getElementById('deleteMethodError');
            if (errorAlert) {
                errorAlert.classList.add('d-none');
                errorAlert.textContent = '';
            }

            try {
                const res = await fetch('/api/PaymentMethod/' + id, {
                    method: 'DELETE'
                });

                if (res.ok) {
                    showPopup('Payment method deleted successfully.', 'success');
                    setTimeout(() => { window.location.href = '/PaymentMethod'; }, 900);
                    return;
                }

                let message = 'Failed to delete payment method.';
                const contentType = res.headers.get('Content-Type') || '';

                try {
                    if (contentType.includes('application/json')) {
                        const data = await res.json();
                        if (data && typeof data === 'object') {
                            message = data.message || message;
                        }
                    } else {
                        const text = await res.text();
                        if (text) {
                            message = text;
                        }
                    }
                } catch {
                    // ignore parsing errors
                }

                if (errorAlert) {
                    errorAlert.textContent = message;
                    errorAlert.classList.remove('d-none');
                }
                showPopup(message, 'error');
            } catch (err) {
                if (errorAlert) {
                    errorAlert.textContent = 'Unable to connect to the server. Please try again.';
                    errorAlert.classList.remove('d-none');
                }
                showPopup('Unable to connect to the server.', 'error');
            }
        });
    </script>
</body>
</html>
