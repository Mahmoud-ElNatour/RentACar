@model RentACar.Application.DTOs.AddToBlacklistRequestDto

<div class="modal fade" id="blacklistAddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title">Add To Blacklist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <style>
                    .ui-autocomplete {
                        z-index: 2055 !important
                    }</style>

                <!-- (optional) honeypot to keep password extensions away -->
                <input class="d-none" type="text" name="username" autocomplete="username">
                <input class="d-none" type="password" name="password" autocomplete="current-password">

                <form id="addBlacklistForm" autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label" for="IdentifierInput">User</label>
                        <input type="text"
                               id="IdentifierInput"
                               class="form-control"
                               placeholder="Search by email or username"
                               autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
                               data-form-type="other" data-lpignore="true" data-1p-ignore="true" />
                        <input type="hidden" asp-for="Identifier" id="Identifier" />
                        <input type="hidden" asp-for="UseUsername" id="UseUsername" value="true" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Reason">Reason</label>
                        <input asp-for="Reason" class="form-control" autocomplete="off" />
                    </div>

                    <button type="submit" class="btn btn-primary">Add</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
      console.log("jQuery version:", $.fn.jquery, " | jQuery UI present:", !!$.ui, " | has autocomplete:", !!$.fn.autocomplete);

    // init autocomplete AFTER modal content exists
    function initBlacklistAutocomplete() {

      const $input = $("#IdentifierInput");
          console.log("initBlacklistAutocomplete() called. input exists:", $input.length > 0);

      if (!$input.length) return;

      if ($input.data("ui-autocomplete")) $input.autocomplete("destroy");

      $input.autocomplete({
        appendTo: "#blacklistAddModal",
        minLength: 2,
        delay: 150,
        source: function (request, response) {
                    console.log("typing term:", request.term);   // should log on each keystroke

          $.ajax({
          url: "/api/Blacklist/identifiers",
          data: { term: request.term },
          dataType: "json"
        })
        .done(function (data) {
          console.log("api/Blacklist/identifiers ->", data.length, "items");
          response(data);
        })
        .fail(function (xhr) {
          console.error("identifiers call failed", xhr.status, xhr.responseText);
          response([]);
        });
      },
      select: function (e, ui) {
        $("#IdentifierInput").val(ui.item.value || ui.item.label);
        $("#Identifier").val(ui.item.id);
        $("#UseUsername").val("false");
        return false;
      }
    });
    }

    // 1) Re-init autocomplete when modal opens (partial just injected)
    $(document).on("shown.bs.modal", "#blacklistAddModal", function () {
      initBlacklistAutocomplete();
    });

    // 2) Delegate SUBMIT handler so it works even if partial is injected later
    $(document).on("submit", "#addBlacklistForm", async function (e) {
      e.preventDefault(); // stop navigation to /Blacklist?... (your redirect)
      const form = this;
      const payload = {
        identifier: form.Identifier.value,                 // hidden field
        reason: form.Reason.value,
        useUsername: (form.UseUsername.value === "true")
      };

      try {
        const res = await fetch('/api/Blacklist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        showPopup(result.message || (res.ok ? 'Added.' : 'Failed.'), res.ok ? 'success' : 'error');
        if (res.ok) {
          const modalEl = form.closest('.modal');
          (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)).hide();
          if (window.loadBlacklist) loadBlacklist(true);
        }
      } catch (err) {
        console.error(err);
        showPopup('Network error while adding to blacklist.', 'error');
      }
    });
</script>
