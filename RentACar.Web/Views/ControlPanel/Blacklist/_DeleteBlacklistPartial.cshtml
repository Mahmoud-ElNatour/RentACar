<script>
(function () {
  const form = document.getElementById('deleteBlacklistForm');
  if (!form) return;

  form.addEventListener('submit', async function (e) {
    e.preventDefault();

    const id = this.querySelector('[name="id"]').value;
    const errorAlert = this.querySelector('#deleteBlacklistError');

    // Clear any old error
    if (errorAlert) {
      errorAlert.classList.add('d-none');
      errorAlert.textContent = '';
    }

    // Optional: Anti-forgery token support (if you’re using it)
    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    const headers = {};
    if (tokenInput && tokenInput.value) {
      headers['RequestVerificationToken'] = tokenInput.value;
    }
    headers['Accept'] = 'application/json';

    try {
      const res = await fetch(`/api/Blacklist/${encodeURIComponent(id)}`, {
        method: 'DELETE',
        headers
      });

      // Try to read a message from JSON or text
      let message = '';
      const ct = res.headers.get('Content-Type') || '';
      try {
        if (ct.includes('application/json')) {
          const data = await res.json();
          message = (data && (data.message || data.error || data.title)) || '';
        } else {
          message = await res.text();
        }
      } catch { /* ignore parse errors */ }

      if (!res.ok) {
        if (!message) message = 'An error occurred while unblocking this user.';
        if (typeof showPopup === 'function') {
          showPopup(message, 'error');
        } else if (errorAlert) {
          errorAlert.textContent = message;
          errorAlert.classList.remove('d-none');
        }
        return;
      }

      // Success UI
      if (!message) message = 'User unblocked successfully.';
      if (typeof showPopup === 'function') {
        showPopup(message, 'success');
      }

      // Hide the modal safely whether or not an instance exists yet
      const modalEl = this.closest('.modal');
      if (modalEl) {
        let instance = window.bootstrap && window.bootstrap.Modal.getInstance
          ? window.bootstrap.Modal.getInstance(modalEl)
          : null;
        if (!instance && window.bootstrap && window.bootstrap.Modal) {
          instance = new window.bootstrap.Modal(modalEl);
        }
        if (instance && typeof instance.hide === 'function') instance.hide();
      }

      if (typeof window.loadBlacklist === 'function') {
        window.loadBlacklist(true);
      }
    } catch (err) {
      const msg = 'Unable to connect to the server. Please try again.';
      if (typeof showPopup === 'function') {
        showPopup(msg, 'error');
      } else if (errorAlert) {
        errorAlert.textContent = msg;
        errorAlert.classList.remove('d-none');
      }
    }
  });
})();
