@model RentACar.Application.DTOs.PromocodeDto
<div class="modal fade" id="deletePromocodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-[#121212] border border-[#2a2a2a] text-white rounded-xl shadow-2xl">
            <div class="modal-header border-b border-[#2a2a2a] p-6">
                <h5 class="modal-title text-xl font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-red-500">warning</span> Delete Promocode
                </h5>
            </div>
            <form id="deletePromocodeForm">
                <div class="modal-body p-6">
                    <div class="alert alert-danger d-none mb-4 bg-red-900/20 border border-red-900/50 text-red-200 rounded-lg p-3 text-sm" id="deletePromocodeError" role="alert"></div>
                    <input type="hidden" asp-for="PromocodeId" />
                    <p class="text-gray-300 text-base leading-relaxed">
                        Are you sure you want to permanently delete the promocode <strong class="text-white">@Model.Name</strong>?
                        <br/><span class="text-red-400 text-sm mt-1 block">This action cannot be undone.</span>
                    </p>
                </div>
                <div class="modal-footer border-t border-[#2a2a2a] p-6 flex justify-end gap-3">
                    <button type="button" class="px-4 py-2 rounded-lg text-red-500 hover:text-red-400 hover:bg-red-500/10 transition-colors font-medium text-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-6 rounded-lg transition-all duration-200 shadow-[0_0_15px_rgba(220,38,38,0.2)] hover:shadow-[0_0_20px_rgba(220,38,38,0.4)] flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">delete</span>
                        <span>Delete Forever</span>
                    </button>
                </div>
            </form>
            <script>
                document.getElementById('deletePromocodeForm').addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const id = this.PromocodeId.value;
                    const errorAlert = this.querySelector('#deletePromocodeError');
                    const submitBtn = this.querySelector('button[type="submit"]');
                    const originalBtnContent = submitBtn.innerHTML;

                    if (errorAlert) {
                        errorAlert.classList.add('d-none');
                        errorAlert.textContent = '';
                    }

                    try {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-lg">progress_activity</span> Deleting...';

                        const response = await fetch('/api/Promocode/' + id, { method: 'DELETE' });

                        if (!response.ok) {
                            let message = 'An error occurred while deleting the promocode.';
                            const contentType = response.headers.get('Content-Type') || '';

                            try {
                                if (contentType.includes('application/json')) {
                                    const data = await response.json();
                                    if (data && typeof data === 'object') {
                                        message = data.message || message;
                                    }
                                } else {
                                    const text = await response.text();
                                    if (text) {
                                        message = text;
                                    }
                                }
                            } catch {
                                // ignore
                            }

                            if (errorAlert) {
                                errorAlert.textContent = message;
                                errorAlert.classList.remove('d-none');
                            }
                            showPopup(message, 'error');
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnContent;
                            return;
                        }

                        bootstrap.Modal.getInstance(document.getElementById('deletePromocodeModal')).hide();
                        showPopup('Promocode deleted successfully.', 'success');
                        if (window.loadPromocodes) loadPromocodes();
                    } catch (err) {
                        if (errorAlert) {
                            errorAlert.textContent = 'Unable to connect to the server. Please try again.';
                            errorAlert.classList.remove('d-none');
                        }
                        showPopup('Unable to delete promocode right now.', 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalBtnContent;
                    }
                });
            </script>
        </div>
    </div>
</div>
