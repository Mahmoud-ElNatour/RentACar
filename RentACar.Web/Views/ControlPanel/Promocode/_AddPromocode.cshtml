@model RentACar.Application.DTOs.PromocodeDto
<div class="modal fade" id="addPromocodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-[#121212] border border-[#2a2a2a] text-white rounded-xl shadow-2xl">
            <div class="modal-header border-b border-[#2a2a2a] p-6">
                <h5 class="modal-title text-xl font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-gold">add_circle</span> Add Promocode
                </h5>
            </div>
            <form id="addPromocodeForm">
                <div class="modal-body p-6 space-y-4">
                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-gray-400 mb-1.5"></label>
                        <input asp-for="Name" class="w-full bg-[#0a0a0a] text-white border border-[#2a2a2a] rounded-lg px-4 py-2.5 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all placeholder-zinc-600" placeholder="e.g. SUMMER2024" />
                    </div>
                    <div>
                        <label asp-for="DiscountPercentage" class="block text-sm font-medium text-gray-400 mb-1.5"></label>
                        <div class="relative">
                            <input asp-for="DiscountPercentage" type="number" step="0.01" class="w-full bg-[#0a0a0a] text-white border border-[#2a2a2a] rounded-lg pl-4 pr-10 py-2.5 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" placeholder="0" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 font-bold">%</span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="ValidUntil" class="block text-sm font-medium text-gray-400 mb-1.5"></label>
                        <input asp-for="ValidUntil" type="date" class="w-full bg-[#0a0a0a] text-white border border-[#2a2a2a] rounded-lg px-4 py-2.5 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all [&::-webkit-calendar-picker-indicator]:invert" />
                    </div>
                    <div>
                        <label asp-for="Description" class="block text-sm font-medium text-gray-400 mb-1.5"></label>
                        <textarea asp-for="Description" rows="3" class="w-full bg-[#0a0a0a] text-white border border-[#2a2a2a] rounded-lg px-4 py-2.5 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all resize-none" placeholder="Enter description..."></textarea>
                    </div>
                    <div class="flex items-center gap-3 pt-2">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input asp-for="IsActive" type="checkbox" class="sr-only peer">
                            <div class="w-11 h-6 bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gold"></div>
                            <span class="ms-3 text-sm font-medium text-gray-300">Is Active</span>
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-t border-[#2a2a2a] p-6 flex justify-end gap-3">
                    <button type="button" class="px-4 py-2 rounded-lg text-red-500 hover:text-red-400 hover:bg-red-500/10 transition-colors font-medium text-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="bg-gold hover:bg-[#dcae1a] text-black font-bold py-2 px-6 rounded-lg transition-all duration-200 shadow-[0_0_15px_rgba(237,188,29,0.2)] hover:shadow-[0_0_20px_rgba(237,188,29,0.4)] flex items-center gap-2">
                        <span>Save Promocode</span>
                    </button>
                </div>
            </form>
            <script>
                document.getElementById('addPromocodeForm').addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const form = e.target;
                    const isActiveCheckbox = form.querySelector('input[type="checkbox"][name="IsActive"]');
                    const data = {
                        name: form.Name.value,
                        discountPercentage: parseFloat(form.DiscountPercentage.value || '0'),
                        validUntil: form.ValidUntil.value || null,
                        description: form.Description.value,
                        isActive: isActiveCheckbox ? isActiveCheckbox.checked : false
                    };
                    try {
                        const submitBtn = form.querySelector('button[type="submit"]');
                        const originalBtnContent = submitBtn.innerHTML;
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span> Saving...';

                        const response = await fetch('/api/Promocode', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });

                        if (!response.ok) {
                            const message = await response.text();
                            showPopup(message || 'Failed to add promocode.', 'error');
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnContent;
                            return;
                        }

                        bootstrap.Modal.getInstance(document.getElementById('addPromocodeModal')).hide();
                        showPopup('Promocode added successfully.', 'success');
                        if (window.loadPromocodes) loadPromocodes();
                    } catch {
                        showPopup('Unable to add promocode right now.', 'error');
                        const submitBtn = form.querySelector('button[type="submit"]');
                        if(submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = 'Save Promocode'; 
                        }
                    }
                });
            </script>
        </div>
    </div>
</div>
