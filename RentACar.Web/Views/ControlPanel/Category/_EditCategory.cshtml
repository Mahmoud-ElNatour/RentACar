@model RentACar.Application.DTOs.CategoryDto

<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-[#121212] border border-[#2a2a2a] text-white rounded-xl shadow-2xl">
            <div class="modal-header border-b border-[#2a2a2a] p-6">
                <h5 class="modal-title text-xl font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">edit</span> Edit Category
                </h5>
                <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal">
                     <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <form id="editCategoryForm" enctype="multipart/form-data">
                <div class="modal-body p-6 space-y-4">
                    <input type="hidden" asp-for="CategoryId" />
                    <div class="flex items-center bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-2.5">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="hidden" name="IsActive" value="false">
                            <input type="checkbox" name="IsActive" value="true" class="sr-only peer" @(Model.IsActive ? "checked" : "")>
                            <div class="w-11 h-6 bg-gray-700 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary/50 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                            <span class="ml-3 text-sm font-medium text-gray-300">Is Available / Active</span>
                        </label>
                    </div>
                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-gray-400 mb-1.5"></label>
                        <input asp-for="Name" class="w-full bg-[#0a0a0a] text-white border border-[#2a2a2a] rounded-lg px-4 py-2.5 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder-zinc-600" />
                        <span asp-validation-for="Name" class="text-red-400 text-xs mt-1"></span>
                    </div>
                    <div>
                        <label asp-for="ImageFile" class="block text-sm font-medium text-gray-400 mb-1.5">Update Image</label>
                         @if (!string.IsNullOrEmpty(Model.ImageBase64))
                        {
                            <div class="mb-2">
                                <img src="data:image/jpeg;base64,@Model.ImageBase64" alt="Current Image" class="h-20 w-32 object-cover rounded-lg border border-surface-accent" />
                                <p class="text-[10px] text-text-muted mt-1">Current Image</p>
                            </div>
                        }
                        <input type="file" asp-for="ImageFile" class="w-full bg-[#0a0a0a] text-white border border-[#2a2a2a] rounded-lg px-4 py-2.5 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20" accept="image/*" />
                         <p class="text-xs text-text-muted mt-1">Select a new image to replace the current one (Max 2MB)</p>
                    </div>
                </div>
                <div class="modal-footer border-t border-[#2a2a2a] p-6 flex justify-end gap-3">
                    <button type="button" class="px-4 py-2 rounded-lg text-red-400 hover:bg-red-400/10 transition-colors font-medium text-sm border border-transparent hover:border-red-400/20" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="bg-primary hover:bg-[#dcae1a] text-black font-bold py-2 px-6 rounded-lg transition-all duration-200 shadow-[0_0_15px_rgba(237,188,29,0.2)] hover:shadow-[0_0_20px_rgba(237,188,29,0.4)] flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">save</span>
                        <span>Update Category</span>
                    </button>
                </div>
            </form>
            <script>
                document.getElementById('editCategoryForm').addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const form = e.target;
                    const btn = form.querySelector('button[type="submit"]');
                    const originalContent = btn.innerHTML;
                    
                    btn.disabled = true;
                    btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Saving...`;

                    const formData = new FormData(form);

                    try {
                        const response = await fetch('/api/Category/' + form.CategoryId.value, {
                            method: 'PUT',
                            body: formData
                        });

                        if (!response.ok) {
                            const message = await response.text();
                            showPopup(message || 'Failed to update category.', 'error');
                            return;
                        }

                        bootstrap.Modal.getInstance(document.getElementById('editCategoryModal')).hide();
                        showPopup('Category updated successfully.', 'success');
                        if (window.loadCategories) loadCategories();
                    } catch {
                        showPopup('Unable to update category right now.', 'error');
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = originalContent;
                    }
                });
            </script>
        </div>
    </div>
</div>
