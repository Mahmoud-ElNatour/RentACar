@{
    ViewData["Title"] = "Payments";
    Layout = "_Layout";
    ViewData["BodyClass"] = "bg-background-dark";
}
<link rel="stylesheet" href="~/css/employees.css" />
@await Html.PartialAsync("_PopupNotifications")
    <div class="booking-container container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="../ControlPanel" class="btn btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px" title="Back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="flex-grow-1 text-center m-0">Manage Payments</h2>
            <div style="width:40px;"></div>
        </div>
        <div class="text-end mb-3">
            <a href="/Payment/Add" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Payment</a>
        </div>
        <div class="mb-3">
            <input type="text" id="tableSearch" class="form-control" placeholder="Search table..." />
        </div>
        <div class="table-responsive">
            <table id="paymentsTable" class="table table-striped table-dark align-middle">
                <thead>
                    <tr>
                        <th onclick="sortTable(0)" style="cursor:pointer">ID <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(1)" style="cursor:pointer">Booking <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(2)" style="cursor:pointer">Customer <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(3)" style="cursor:pointer">Subtotal <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(4)" style="cursor:pointer">Promo Code <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(5)" style="cursor:pointer">Discount % <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(6)" style="cursor:pointer">Total <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(7)" style="cursor:pointer">Amount <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(8)" style="cursor:pointer">Date <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(9)" style="cursor:pointer">Method <i class="fas fa-sort"></i></th>
                        <th onclick="sortTable(10)" style="cursor:pointer">Status <i class="fas fa-sort"></i></th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="paymentRows"></tbody>
            </table>
        </div>
        </div>
    </div>
    <div id="modalPlaceholder"></div>

    <script>
        function formatAmount(value) {
            if (value === null || value === undefined) {
                return '-';
            }
            const number = Number(value);
            if (Number.isNaN(number)) {
                return value;
            }
            return number.toFixed(2);
        }

        function formatPercentage(value) {
            if (value === null || value === undefined) {
                return '-';
            }
            const number = Number(value);
            if (Number.isNaN(number)) {
                return value;
            }
            return `${number.toFixed(2)}%`;
        }

        let currentData = []; // Store data for sorting

        document.addEventListener('DOMContentLoaded', async () => {
             // Search functionality
            document.getElementById('tableSearch').addEventListener('keyup', function () {
                const value = this.value.toLowerCase();
                document.querySelectorAll('#paymentRows tr').forEach(tr => {
                    tr.style.display = tr.textContent.toLowerCase().includes(value) ? '' : 'none';
                });
            });

            await loadPayments();
        });

        async function loadPayments() {
            const tbody = document.getElementById('paymentRows');
            try {
                const res = await fetch('/api/Payment');
                if (!res.ok) throw new Error(await res.text());
                currentData = await res.json();
                renderTable(currentData);
            } catch (error) {
                console.error(error);
                if (window.showPopup) window.showPopup('Failed to load payments.', 'error');
            }
        }

        function renderTable(data) {
             const tbody = document.getElementById('paymentRows');
             tbody.innerHTML = '';
             data.forEach(payment => {
                const customerParts = [];
                if (payment.customerName) customerParts.push(payment.customerName);
                if (payment.customerUsername) customerParts.push(`(${payment.customerUsername})`);
                const customerDisplay = customerParts.join(' ') || '-';
                const row = document.createElement('tr');
                row.innerHTML =
                    `<td>${payment.paymentId}</td>` +
                    `<td>#${payment.bookingId}</td>` +
                    `<td>${customerDisplay}</td>` +
                    `<td>${formatAmount(payment.bookingSubtotal)}</td>` +
                    `<td>${payment.promocodeName ?? '-'}</td>` +
                    `<td>${formatPercentage(payment.promocodeDiscountPercentage)}</td>` +
                    `<td>${formatAmount(payment.bookingTotal)}</td>` +
                    `<td>${formatAmount(payment.amount)}</td>` +
                    `<td>${payment.paymentDate ?? ''}</td>` +
                    `<td class='text-capitalize'>${payment.paymentMethodName ?? ''}</td>` +
                    `<td class='text-capitalize'>${payment.status ?? ''}</td>` +
                    `<td>` +
                    `<a href='/Payment/Details/${payment.paymentId}' class='text-info me-2' title='View details'><i class='fas fa-eye'></i></a>` +
                    `<a href='/Payment/Edit/${payment.paymentId}' class='text-warning me-2' title='Edit payment'><i class='fas fa-pencil-alt'></i></a>` +
                    `<a href='#' class='text-success me-2' onclick='applyPromoCode(${payment.paymentId}); return false;' title='Apply Promocode'><i class='fas fa-tags'></i></a>` +
                    `<a href='#' class='text-light' onclick='printReceipt(${payment.paymentId}); return false;' title='Print Receipt'><i class='fas fa-print'></i></a>` +
                    `</td>`;
                tbody.appendChild(row);
            });
        }

        // Sorting
        let sortDirection = {}; // Store direction per column
        function sortTable(n) {
            const table = document.getElementById("paymentsTable");
            let rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
            switching = true;
            dir = sortDirection[n] === 'asc' ? 'desc' : 'asc'; 
            sortDirection[n] = dir;

            while (switching) {
                switching = false;
                rows = table.rows;
                // loop starts from 1 (skip header)
                for (i = 1; i < (rows.length - 1); i++) {
                    shouldSwitch = false;
                    x = rows[i].getElementsByTagName("TD")[n];
                    y = rows[i + 1].getElementsByTagName("TD")[n];
                    
                    let xContent = x.innerHTML.toLowerCase();
                    let yContent = y.innerHTML.toLowerCase();
                    
                    // Basic number detection (remove currency symbols etc if needed)
                    // But simpler to just string compare for now unless explicit requirement
                    if (!isNaN(parseFloat(xContent)) && !isNaN(parseFloat(yContent))) {
                         if (dir == "asc") {
                            if (parseFloat(xContent) > parseFloat(yContent)) {
                                shouldSwitch = true;
                                break;
                            }
                        } else if (dir == "desc") {
                            if (parseFloat(xContent) < parseFloat(yContent)) {
                                shouldSwitch = true;
                                break;
                            }
                        }
                    } else {
                        if (dir == "asc") {
                            if (xContent > yContent) {
                                shouldSwitch = true;
                                break;
                            }
                        } else if (dir == "desc") {
                            if (xContent < yContent) {
                                shouldSwitch = true;
                                break;
                            }
                        }
                    }
                }
                if (shouldSwitch) {
                    rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                    switching = true;
                    switchcount++;
                }
            }
        }

        async function loadModal(url) {
            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error('Failed to load modal');
                const html = await res.text();
                const placeholder = document.getElementById('modalPlaceholder');
                placeholder.innerHTML = html;
                
                // Execute scripts in partial
                placeholder.querySelectorAll('script').forEach(scr => {
                    const s = document.createElement('script');
                    s.textContent = scr.textContent;
                    document.body.appendChild(s);
                    document.body.removeChild(s);
                });

                const modalEl = placeholder.querySelector('.modal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            } catch (e) {
                console.error(e);
                if (window.showPopup) showPopup('Failed to load dialog.', 'error');
            }
        }

        function applyPromoCode(id) {
            loadModal(`/api/Payment/ApplyPromocode/${id}`);
        }

        function printReceipt(id) {
            // Open Details page in new window with print param
             const url = `/Payment/Details/${id}?print=true`;
             const win = window.open(url, '_blank', 'width=800,height=800');
        }
    </script>

