        // Sorting
        let sortDirection = {}; // Store direction per column
        function sortTable(n) {
            const table = document.getElementById("paymentsTable");
            let rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
            switching = true;
            dir = sortDirection[n] === 'asc' ? 'desc' : 'asc'; 
            sortDirection[n] = dir;

            while (switching) {
                switching = false;
                rows = table.rows;
                // loop starts from 1 (skip header)
                for (i = 1; i < (rows.length - 1); i++) {
                    shouldSwitch = false;
                    x = rows[i].getElementsByTagName("TD")[n];
                    y = rows[i + 1].getElementsByTagName("TD")[n];
                    
                    let xContent = x.innerHTML.toLowerCase();
                    let yContent = y.innerHTML.toLowerCase();
                    
                    // Basic number detection (remove currency symbols etc if needed)
                    // But simpler to just string compare for now unless explicit requirement
                    if (!isNaN(parseFloat(xContent)) && !isNaN(parseFloat(yContent))) {
                         if (dir == "asc") {
                            if (parseFloat(xContent) > parseFloat(yContent)) {
                                shouldSwitch = true;
                                break;
                            }
                        } else if (dir == "desc") {
                            if (parseFloat(xContent) < parseFloat(yContent)) {
                                shouldSwitch = true;
                                break;
                            }
                        }
                    } else {
                        if (dir == "asc") {
                            if (xContent > yContent) {
                                shouldSwitch = true;
                                break;
                            }
                        } else if (dir == "desc") {
                            if (xContent < yContent) {
                                shouldSwitch = true;
                                break;
                            }
                        }
                    }
                }
                if (shouldSwitch) {
                    rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                    switching = true;
                    switchcount++;
                }
            }
        }

        async function loadModal(url) {
