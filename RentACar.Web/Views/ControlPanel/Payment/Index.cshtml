                });

                const modalEl = placeholder.querySelector('.modal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            } catch (e) {
                console.error(e);
                if (window.showPopup) showPopup('Failed to load dialog.', 'error');
            }
        }

