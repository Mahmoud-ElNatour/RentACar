            const number = Number(value);
            if (Number.isNaN(number)) {
                return value;
            }
            return number.toFixed(2);
        }

        function formatPercentage(value) {
            if (value === null || value === undefined) {
                return '-';
            }
            const number = Number(value);
            if (Number.isNaN(number)) {
                return value;
            }
            return `${number.toFixed(2)}%`;
