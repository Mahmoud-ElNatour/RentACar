<div id="modalPlaceholder"></div>

<script>
    // State
    let currentPage = 1;
    const pageSize = 10;
    let totalPages = 1;
    let sortColumn = 'paymentId';
    let sortDirection = 'desc';
    let timeout = null;

    document.addEventListener('DOMContentLoaded', () => {
         loadPageData();
    });

    function debounceLoad() {
        clearTimeout(timeout);
        timeout = setTimeout(() => {
            currentPage = 1;
            loadPageData();
        }, 400);
    }

    function resetAndLoad() {
        currentPage = 1;
        loadPageData();
    }

    function changePage(delta) {
        const newPage = currentPage + delta;
        if (newPage >= 1 && newPage <= totalPages) {
            currentPage = newPage;
            loadTableData();
        }
    }

    function setSort(col) {
        if (sortColumn === col) {
            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            sortColumn = col;
            sortDirection = 'asc';
        }
        
        // Update icons
        document.querySelectorAll('[id^="sort-"]').forEach(el => el.textContent = 'unfold_more');
        const active = document.getElementById('sort-' + col);
        if(active) active.textContent = sortDirection === 'asc' ? 'keyboard_arrow_up' : 'keyboard_arrow_down';

        loadTableData();
    }

    async function loadPageData() {
        await loadTableData();
        setTimeout(loadStatsData, 300);
    }

    function getFilterQuery() {
        const search = document.getElementById('tableSearch').value;
        const status = document.getElementById('statusFilter').value;
        const start = document.getElementById('dateFrom').value;
        const end = document.getElementById('dateTo').value;

        return new URLSearchParams({
            page: currentPage,
            pageSize: pageSize,
            searchTerm: search,
            status: status,
            startDate: start,
            endDate: end,
            sortColumn: sortColumn,
            sortDirection: sortDirection
        });
    }

    async function loadTableData() {
        const tbody = document.getElementById('paymentRows');
        tbody.closest('table').style.opacity = '0.5';
        
        try {
            const qs = getFilterQuery();
            const res = await fetch(`/api/Payment?${qs}`);
            if(!res.ok) throw new Error("Failed to load");
            const data = await res.json();
            
            tbody.closest('table').style.opacity = '1';
            renderTable(data.items);
            
            totalPages = data.totalPages;
            document.getElementById('showingText').innerText = `Showing page ${currentPage} of ${totalPages} (${data.totalCount} total)`;
            document.getElementById('pageIndicator').innerText = currentPage;
            document.getElementById('prevBtn').disabled = currentPage <= 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages;

        } catch(e) {
            console.error(e);
            tbody.innerHTML = `<tr><td colspan="10" class="p-8 text-center text-red-500">Failed to load data.</td></tr>`;
            tbody.closest('table').style.opacity = '1';
        }
    }

    async function loadStatsData() {
         try {
            const qs = getFilterQuery();
            const res = await fetch(`/api/Payment/Stats?${qs}`);
            if(!res.ok) throw new Error("Failed to load stats");
            const stats = await res.json();
            renderStats(stats);
         } catch(e) { console.error("Stats failed", e); }
    }

    function renderStats(stats) {
        if(!stats) return;
        const grid = document.getElementById('statsGrid');
        grid.innerHTML = `
            <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
                <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                     <span class="material-symbols-outlined text-6xl text-gold">payments</span>
                </div>
                <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Total Revenue</p>
                <div class="flex items-center gap-3 z-10">
                    <p class="text-white tracking-tight text-4xl font-bold">$${formatMoney(stats.totalRevenue)}</p>
                </div>
                 <div class="flex items-center gap-2 z-10">
                    <span class="text-[#0bda1d] text-sm font-bold flex items-center">
                        <span class="material-symbols-outlined text-sm mr-1">trending_up</span>+12.5%
                    </span>
                    <span class="text-gray-500 text-xs tracking-wide">all time</span>
                </div>
            </div>

            <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
                 <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                     <span class="material-symbols-outlined text-6xl text-yellow-500">pending_actions</span>
                </div>
                <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Pending</p>
                <div class="flex items-center gap-3 z-10">
                     <p class="text-white tracking-tight text-4xl font-bold">$${formatMoney(stats.pendingAmount)}</p>
                </div>
                <div class="flex items-center gap-2 z-10">
                    <span class="text-yellow-500 text-xs font-bold tracking-wide flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">schedule</span> ${stats.pendingCount} Waiting
                    </span>
                </div>
            </div>

            <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
                 <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                     <span class="material-symbols-outlined text-6xl text-green-500">check_circle</span>
                </div>
                <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Successful</p>
                <div class="flex items-center gap-3 z-10">
                    <p class="text-white tracking-tight text-4xl font-bold">${stats.successCount}</p>
                </div>
                 <div class="flex items-center gap-2 z-10">
                    <span class="text-green-500 text-xs font-bold tracking-wide flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">verified</span> ${((stats.successCount/stats.totalCount)*100 || 0).toFixed(1)}% Rate
                    </span>
                </div>
            </div>

            <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
                 <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                     <span class="material-symbols-outlined text-6xl text-purple-500">keyboard_return</span>
                </div>
                <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Refunds</p>
                <div class="flex items-center gap-3 z-10">
                    <p class="text-white tracking-tight text-4xl font-bold">$${formatMoney(stats.refundAmount)}</p>
                </div>
                 <div class="flex items-center gap-2 z-10">
                    <span class="text-purple-500 text-xs font-bold tracking-wide flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">replay</span> Processed
                    </span>
                </div>
            </div>
        `;
    }

    function renderTable(data) {
        const tbody = document.getElementById('paymentRows');
        if(!data || data.length === 0) {
            tbody.innerHTML = `<tr><td colspan="10" class="p-8 text-center text-gray-500">No payments found.</td></tr>`;
            return;
        }

        tbody.innerHTML = data.map(p => `
            <tr class="hover:bg-white/5 transition-colors group border-b border-[#262626] last:border-0 align-middle">
                <td class="px-6 py-4 font-mono text-white">#${p.paymentId}</td>
                <td class="px-6 py-4 text-gray-400 text-sm">${formatDate(p.paymentDate)}</td>
                <td class="px-6 py-4 text-gray-400 text-sm">#${p.bookingId}</td>
                <td class="px-6 py-4">
                    <div class="flex flex-col">
                        <span class="text-sm font-bold text-white">${p.customerName || 'Unknown'}</span>
                        <span class="text-xs text-gray-500">${p.customerUsername || ''}</span>
                    </div>
                </td>
                <td class="px-6 py-4 text-right text-gray-400 text-sm">$${formatMoney(p.bookingSubtotal)}</td>
                <td class="px-6 py-4">
                    ${p.promocodeName ? `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-green-500/10 text-green-500 border border-green-500/20">${p.promocodeName} (-${p.promocodeDiscountPercentage}%)</span>` : '<span class="text-gray-600">-</span>'}
                </td>
                <td class="px-6 py-4 text-right font-bold text-gold text-base">$${formatMoney(p.amount)}</td>
                <td class="px-6 py-4">
                    ${getMethodBadge(p.paymentMethodName)}
                </td>
                <td class="px-6 py-4">
                    ${getStatusBadge(p.status)}
                </td>
                <td class="px-6 py-4 text-right">
                    <div class="flex items-center justify-end gap-2 opacity-100 transition-opacity">
                        <button onclick="loadModal('/Payment/Details/${p.paymentId}')" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors" title="View Details">
                            <span class="material-symbols-outlined text-[20px]">visibility</span>
                        </button>
                        ${p.status !== 'Paid' && p.status !== 'Refunded' ? `
                        <button onclick="loadModal('/Payment/Edit/${p.paymentId}')" class="p-2 text-gold hover:text-[#b5952f] hover:bg-gold/10 rounded-lg transition-colors" title="Edit">
                            <span class="material-symbols-outlined text-[20px]">edit</span>
                        </button>
                        <button onclick="loadModal('/Payment/ApplyPromocode/${p.paymentId}')" class="p-2 text-green-500 hover:text-green-400 hover:bg-green-500/10 rounded-lg transition-colors" title="Apply Discount">
                            <span class="material-symbols-outlined text-[20px]">percent</span>
                        </button>
                        ` : ''}
                        <button onclick="window.open('/Payment/Receipt/${p.paymentId}', '_blank', 'width=500,height=700')" class="p-2 text-blue-400 hover:text-blue-300 hover:bg-blue-400/10 rounded-lg transition-colors" title="Print Receipt">
                            <span class="material-symbols-outlined text-[20px]">print</span>
                        </button>
                    </div>
                </td>
            </tr>
        `).join('');
    }

    function formatMoney(amount) {
        return (amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function formatDate(dateStr) {
        return dateStr ? new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '-';
    }
    
    function getMethodBadge(method) {
        method = (method||"").toLowerCase();
        let color = "text-gray-400 border-gray-500/20 bg-gray-500/10";
        let icon = "attach_money";

        if(method.includes("card")) { color = "text-blue-400 border-blue-500/20 bg-blue-500/10"; icon = "credit_card"; }
        else if(method.includes("cash")) { color = "text-green-400 border-green-500/20 bg-green-500/10"; icon = "payments"; }
        else if(method.includes("bank")) { color = "text-purple-400 border-purple-500/20 bg-purple-500/10"; icon = "account_balance"; }

        return `<div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border ${color}">
                 <span class="material-symbols-outlined text-[14px]">${icon}</span>
                 <span class="capitalize text-xs font-bold">${method || '-'}</span>
            </div>`;
    }
    
    function getStatusBadge(status) {
        status = status || "Unknown";
        const classes = {
            'Paid': 'bg-green-500/10 text-green-500 border-green-500/20',
            'Pending': 'bg-yellow-500/10 text-yellow-500 border-yellow-500/20',
            'Failed': 'bg-red-500/10 text-red-500 border-red-500/20',
            'Refunded': 'bg-purple-500/10 text-purple-500 border-purple-500/20',
            'Cancelled': 'bg-red-900/20 text-red-400 border-red-900/40'
        };
        const cls = classes[status] || 'bg-gray-500/10 text-gray-500 border-gray-500/20';
        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border ${cls}">${status}</span>`;
    }
    
    async function loadModal(url) {
         try {
            const res = await fetch(url);
            if (!res.ok) throw new Error('Failed to load modal');
            const html = await res.text();
            
            const placeholder = document.getElementById('modalPlaceholder');
             placeholder.innerHTML = `<div class="modal fade" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg text-left">${html}</div></div>`;
            
            // Execute scripts
            placeholder.querySelectorAll('script').forEach(scr => {
                const s = document.createElement('script');
                s.textContent = scr.textContent;
                document.body.appendChild(s);
                document.body.removeChild(s);
            });

            const modalEl = placeholder.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        } catch (e) { console.error(e); }
    }
    
    function exportTable() {
         const rows = [
            ["ID", "Date", "Booking", "Customer", "Subtotal", "Promo", "Total", "Method", "Status"]
        ];
         
         const qs = getFilterQuery();
         // Override pageSize for full export
         qs.set('page', 1);
         qs.set('pageSize', 10000);

         fetch(`/api/Payment?${qs}`)
            .then(r => r.json())
            .then(data => {
                data.items.forEach(p => {
                    rows.push([
                        p.paymentId, 
                        formatDate(p.paymentDate), 
                        p.bookingId, 
                        p.customerName || "Unknown", 
                        p.bookingSubtotal, 
                        p.promocodeName || "", 
                        p.amount, 
                        p.paymentMethodName || "Unknown", 
                        p.status
                    ]);
                });
                
                let csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
                const encodedUri = encodeURI(csvContent);
                const link = document.createElement("a");
                link.setAttribute("href", encodedUri);
                link.setAttribute("download", `payments_export_${new Date().toISOString().split('T')[0]}.csv`);
                document.body.appendChild(link);
                link.click();
                link.remove();
            })
            .catch(e => console.error("Export failed", e));
    }
</script>
