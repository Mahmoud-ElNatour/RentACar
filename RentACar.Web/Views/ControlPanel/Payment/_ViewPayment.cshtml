@model RentACar.Application.DTOs.PaymentDetailsDto

<div class="modal-content bg-surface-dark border border-border-dark shadow-2xl rounded-2xl overflow-hidden font-display">
    <div class="modal-header border-b border-border-dark bg-black/50 p-6 flex justify-between items-center">
        <div class="flex items-center gap-3">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-gold/10 text-gold border border-gold/20">
                 <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <div>
                <h5 class="text-lg font-bold text-white m-0">Payment Details</h5>
                <p class="text-sm text-gray-400 m-0">ID: <span class="text-gold font-mono">#@Model.PaymentId</span></p>
            </div>
        </div>
        <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal" aria-label="Close">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <div class="modal-body p-6 max-h-[60vh] overflow-y-auto">
        <!-- Status Banner -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/5 mb-6">
            <div class="flex flex-col">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Status</span>
                <span class="text-lg font-bold text-white capitalize">@Model.Status</span>
            </div>
            <div class="flex flex-col text-right">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Amount</span>
                <span class="text-2xl font-bold text-gold">$@Model.Amount.ToString("N2")</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Left Column -->
            <div class="space-y-4">
                <h6 class="text-sm font-bold text-white border-b border-white/10 pb-2 mb-3">Customer Information</h6>
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-white m-0">@Model.CustomerName</p>
                        <p class="text-xs text-gray-500 m-0">@Model.CustomerUsername</p>
                    </div>
                </div>
                
                <!-- Linked Booking Card -->
                <div class="mt-4 p-4 rounded-xl bg-gradient-to-br from-gold/5 to-gold/10 border border-gold/20">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="h-8 w-8 rounded bg-gold/20 flex items-center justify-center text-gold">
                            <span class="material-symbols-outlined text-sm">directions_car</span>
                        </div>
                        <div class="flex-1">
                             <p class="text-xs text-gray-400 m-0">Booking Reference</p>
                             <p class="text-sm font-bold text-white m-0">#@Model.BookingId</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CarModel))
                    {
                        <div class="flex items-center gap-2 mb-2">
                            <span class="material-symbols-outlined text-gold text-sm">car_rental</span>
                            <span class="text-sm text-white">@Model.CarModel</span>
                            @if (!string.IsNullOrEmpty(Model.CarPlateNumber))
                            {
                                <span class="text-xs text-gray-400 ml-auto font-mono bg-black/30 px-2 py-0.5 rounded">@Model.CarPlateNumber</span>
                            }
                        </div>
                    }
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-gold text-sm">info</span>
                        <span class="text-xs text-white">Status: <span class="font-bold">@Model.BookingStatus</span></span>
                    </div>
                    @if (Model.BookingStartDate.HasValue && Model.BookingEndDate.HasValue)
                    {
                        <div class="mt-3 pt-3 border-t border-gold/20">
                            <div class="grid grid-cols-2 gap-3">
                                <div class="flex items-start gap-2">
                                    <span class="material-symbols-outlined text-green-400 text-sm">login</span>
                                    <div>
                                        <p class="text-xs text-gray-400 m-0">Start Date</p>
                                        <p class="text-sm font-bold text-white m-0">@Model.BookingStartDate.Value.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-2">
                                    <span class="material-symbols-outlined text-red-400 text-sm">logout</span>
                                    <div>
                                        <p class="text-xs text-gray-400 m-0">End Date</p>
                                        <p class="text-sm font-bold text-white m-0">@Model.BookingEndDate.Value.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column -->
            <div class="space-y-4">
                <h6 class="text-sm font-bold text-white border-b border-white/10 pb-2 mb-3">Payment Information</h6>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Date</p>
                        <p class="text-sm font-medium text-white">@Model.PaymentDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Method</p>
                        <div class="flex items-center gap-2">
                             <span class="material-symbols-outlined text-gold text-sm">payments</span>
                             <span class="text-sm font-medium text-white">@Model.PaymentMethodName</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.PaymentProvider))
                {
                    <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20">
                        <p class="text-xs text-blue-400 mb-1 font-bold uppercase tracking-wider">Payment Provider</p>
                        <p class="text-sm text-white capitalize">@Model.PaymentProvider</p>
                        @if (!string.IsNullOrEmpty(Model.PaymentProviderSessionId))
                        {
                            <p class="text-xs text-gray-500 mt-2 mb-0.5">Session ID</p>
                            <p class="text-xs text-gray-400 font-mono break-all">@Model.PaymentProviderSessionId</p>
                        }
                    </div>
                }

                <!-- Cost Breakdown -->
                <div class="mt-4 space-y-2 p-4 rounded-xl bg-gradient-to-br from-white/5 to-white/10 border border-white/10 text-sm">
                    <h6 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Cost Breakdown</h6>
                    <div class="flex justify-between text-gray-300">
                        <span>Rental Subtotal</span>
                        <span class="font-medium">$@(Model.BookingSubtotal?.ToString("N2") ?? "0.00")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PromocodeName))
                    {
                        <div class="p-2 rounded-lg bg-green-500/10 border border-green-500/20 -mx-1">
                            <div class="flex justify-between text-green-400">
                                <div class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs">local_offer</span>
                                    <span>@Model.PromocodeName</span>
                                </div>
                                <span class="font-bold">-@(Model.PromocodeDiscountPercentage?.ToString("N0") ?? "0")%</span>
                            </div>
                        </div>
                    }
                    <div class="flex justify-between font-bold text-white border-t border-white/20 pt-3 mt-3 text-base">
                        <span>Amount Paid</span>
                        <span class="text-gold text-xl">$@Model.Amount.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer border-t border-border-dark bg-black/50 p-4 flex justify-between">
        <button type="button" class="px-5 py-2.5 rounded-lg border border-white/10 text-gray-300 font-medium hover:bg-white/5 transition-colors" data-bs-dismiss="modal">Close</button>
        <div class="flex gap-2">
            <a href="/Payment/Receipt/@Model.PaymentId" target="_blank" class="px-5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white font-medium hover:bg-white/10 transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">print</span> Print
            </a>
            @if (Model.Status != "Paid" && Model.Status != "Refunded")
            {
                <button type="button" onclick="loadModal('/Payment/Edit/@Model.PaymentId')" class="px-5 py-2.5 rounded-lg bg-gold text-black font-bold hover:bg-gold-hover transition-colors shadow-lg shadow-gold/20">
                    Edit
                </button>
            }
        </div>
    </div>
</div>
