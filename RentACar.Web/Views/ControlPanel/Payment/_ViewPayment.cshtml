@model RentACar.Application.DTOs.PaymentDetailsDto

<div class="modal-content bg-surface-dark border border-border-dark shadow-2xl rounded-2xl overflow-hidden font-display">
    <div class="modal-header border-b border-border-dark bg-black/50 p-6 flex justify-between items-center">
        <div class="flex items-center gap-3">
            <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-gold/10 text-gold border border-gold/20">
                 <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <div>
                <h5 class="text-lg font-bold text-white m-0">Payment Details</h5>
                <p class="text-sm text-gray-400 m-0">ID: <span class="text-gold font-mono">#@Model.PaymentId</span></p>
            </div>
        </div>
        <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal" aria-label="Close">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <div class="modal-body p-6">
        <!-- Status Banner -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/5 mb-6">
            <div class="flex flex-col">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Status</span>
                <span class="text-lg font-bold text-white capitalize">@Model.Status</span>
            </div>
            <div class="flex flex-col text-right">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Amount</span>
                <span class="text-2xl font-bold text-gold">$@Model.Amount.ToString("N2")</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Customer Info -->
            <div class="space-y-4">
                <h6 class="text-sm font-bold text-white border-b border-white/10 pb-2 mb-3">Customer Information</h6>
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-white m-0">@Model.CustomerName</p>
                        <p class="text-xs text-gray-500 m-0">@Model.CustomerUsername</p>
                    </div>
                </div>
                <!-- Linked Booking -->
                <div class="flex items-center gap-3 mt-4 p-3 rounded-lg bg-black/30 border border-white/5">
                    <div class="h-8 w-8 rounded bg-gold/10 flex items-center justify-center text-gold">
                        <span class="material-symbols-outlined text-sm">directions_car</span>
                    </div>
                    <div class="flex-1">
                         <p class="text-xs text-gray-400 m-0">Booking Reference</p>
                         <p class="text-sm font-bold text-white m-0">#@Model.BookingId</p>
                    </div>
                    <a href="#" class="text-xs text-gold hover:underline">View Booking</a>
                </div>
            </div>

            <!-- Payment Info -->
            <div class="space-y-4">
                <h6 class="text-sm font-bold text-white border-b border-white/10 pb-2 mb-3">Payment Information</h6>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Date</p>
                        <p class="text-sm font-medium text-white">@Model.PaymentDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 mb-1">Method</p>
                        <div class="flex items-center gap-2">
                             <span class="material-symbols-outlined text-gold text-sm">payments</span>
                             <span class="text-sm font-medium text-white">@Model.PaymentMethodName</span>
                        </div>
                    </div>
                </div>

                <!-- Breakdown -->
                <div class="mt-4 space-y-2 p-3 rounded-lg bg-white/5 border border-white/5 text-sm">
                    <div class="flex justify-between text-gray-400">
                        <span>Subtotal</span>
                        <span>$@Model.BookingSubtotal?.ToString("N2")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.PromocodeName))
                    {
                        <div class="flex justify-between text-green-400">
                            <span>Promo (@Model.PromocodeName)</span>
                            <span>-@Model.PromocodeDiscountPercentage?.ToString("N2")%</span>
                        </div>
                    }
                    <div class="flex justify-between font-bold text-white border-t border-white/10 pt-2 mt-2">
                        <span>Total Due</span>
                        <span>$@Model.BookingTotal?.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer border-t border-border-dark bg-black/50 p-4 flex justify-between">
        <button type="button" class="px-5 py-2.5 rounded-lg border border-white/10 text-gray-300 font-medium hover:bg-white/5 transition-colors" data-bs-dismiss="modal">Close</button>
        <div class="flex gap-2">
            <a href="/Payment/Receipt/@Model.PaymentId" target="_blank" class="px-5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-white font-medium hover:bg-white/10 transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">print</span> Print
            </a>
            <button type="button" onclick="loadModal('/Payment/Edit/@Model.PaymentId')" class="px-5 py-2.5 rounded-lg bg-gold text-black font-bold hover:bg-gold-hover transition-colors shadow-lg shadow-gold/20">
                Edit
            </button>
        </div>
    </div>
</div>
