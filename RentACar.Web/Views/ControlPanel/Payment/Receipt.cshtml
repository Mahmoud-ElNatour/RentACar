@model RentACar.Application.DTOs.PaymentDetailsDto
@using RentACar.Application.Services
@{
    Layout = null;
    var hasDates = Model.BookingStartDate.HasValue && Model.BookingEndDate.HasValue;
    var pricing = hasDates
        ? BookingPricingCalculator.Calculate(
            Model.CarPricePerDay ?? 0m,
            Model.BookingStartDate!.Value,
            Model.BookingEndDate!.Value,
            Model.BookingHasDriver ?? false,
            Model.BookingDriverDailyFee,
            Model.CarExtraDriverFeePerDay,
            Model.PromocodeDiscountPercentage)
        : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Receipt #@Model.PaymentId - RentACar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Space Mono', monospace; }
        @@media print {
            .no-print { 
                display: none !important; 
                visibility: hidden !important;
            }
            body { 
                background: white !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .bg-gray-100 {
                background: white !important;
            }
            .receipt {
                box-shadow: none !important;
                margin: 0 auto;
            }
            @@page {
                margin: 1cm;
            }
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen p-8 flex flex-col items-center">

    <div class="max-w-md w-full bg-white shadow-xl p-8 relative overflow-hidden receipt">
        <!-- Receipt Top Edge -->
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-yellow-400 via-yellow-500 to-yellow-600"></div>

        <!-- Header -->
        <div class="text-center mb-8">
            <div class="flex items-center justify-center gap-2 mb-2">
                <span class="text-2xl font-bold tracking-tight">RENTCAR<span class="text-yellow-600">LB</span></span>
            </div>
            <p class="text-xs text-gray-500 uppercase tracking-widest">Official Receipt</p>
        </div>

        <!-- Meta -->
        <div class="flex justify-between text-xs text-gray-500 mb-6 border-b border-dashed border-gray-300 pb-4">
            <div>
                <p>Date: @Model.PaymentDate.ToString("MMM dd, yyyy")</p>
                <p>Time: @DateTime.Now.ToShortTimeString()</p>
            </div>
            <div class="text-right">
                <p>Receipt #: @Model.PaymentId.ToString().PadLeft(8, '0')</p>
                <p>Booking #: @Model.BookingId</p>
            </div>
        </div>

        <!-- Customer -->
        <div class="mb-6">
            <p class="text-xs font-bold text-gray-400 uppercase">Billed To</p>
            <p class="text-sm font-bold">@Model.CustomerName</p>
            <p class="text-xs text-gray-500">@Model.CustomerUsername</p>
        </div>

        <!-- Line Items -->
        <div class="space-y-3 mb-6">
            <div class="flex justify-between text-sm">
                <span>Rental Charge</span>
                <span>$@(pricing?.BaseRental.ToString("N2") ?? Model.BookingSubtotal?.ToString("N2"))</span>
            </div>
            @if (pricing?.DriverService > 0)
            {
                <div class="flex justify-between text-sm">
                    <span>Driver Service Fee</span>
                    <span>$@pricing.DriverService.ToString("N2")</span>
                </div>
            }
            @if (pricing?.CarExtraDriverFee > 0)
            {
                <div class="flex justify-between text-sm">
                    <span>Car Extra Driver Fee</span>
                    <span>$@pricing.CarExtraDriverFee.ToString("N2")</span>
                </div>
            }
            <div class="flex justify-between text-sm font-semibold">
                <span>Subtotal</span>
                <span>$@(pricing?.Subtotal.ToString("N2") ?? Model.BookingSubtotal?.ToString("N2"))</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.PromocodeName))
            {
                <div class="flex justify-between text-sm text-green-600">
                    <span>Promo: @Model.PromocodeName (@Model.PromocodeDiscountPercentage%)</span>
                    <span>-$@(pricing?.Discount.ToString("N2") ?? "0.00")</span>
                </div>
            }
        </div>

        <!-- Total -->
        <div class="border-t-2 border-black pt-4 mb-8">
            <div class="flex justify-between items-end">
                <div>
                    <p class="text-xs font-bold text-gray-400 uppercase">Total Paid</p>
                    <p class="text-xs text-gray-500">Via @Model.PaymentMethodName</p>
                </div>
                <div class="text-2xl font-bold">
                    $@Model.Amount.ToString("N2")
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-[10px] text-gray-400 space-y-1">
            <p>Thank you for choosing RentCarLB</p>
            <p>support@rentacarlb.com | +961 1 234 567</p>
            <p>123 Hamra St, Beirut, Lebanon</p>
        </div>

        <!-- Barcode Fake -->
        <div class="mt-6 flex justify-center opacity-50">
             <div class="h-8 w-48 bg-[url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAABAAQMAAACQdd1iAAAABlBMVEUAAAD///+l2Z/dAAAAAXRSTlMAQObYZgAAAAxJREFUeNp1jwA0MCAAABJ0BwZ4qO8AAAAAASUVORK5CYII=')] bg-repeat-x bg-contain"></div>
        </div>
    </div>

    <!-- Actions -->
    <div class="mt-8 flex gap-4 no-print">
        <button onclick="window.print()" class="px-6 py-2 bg-black text-white rounded hover:bg-gray-800 transition-colors shadow-lg">Print Receipt</button>
        <button onclick="window.close()" class="px-6 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 transition-colors">Close</button>
    </div>

</body>
</html>
