@using RentACar.Application.DTOs
@{
    var activePromocodes = ViewBag.ActivePromocodes as List<PromocodeDto>;
    var paymentId = ViewBag.PaymentId;
}

<div class="modal fade" id="applyPromocodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 class="modal-title">Apply Promocode</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="applyPromocodeForm">
                <div class="modal-body">
                    <input type="hidden" name="paymentId" value="@paymentId" />
                    <div class="mb-3">
                        <label class="form-label">Select Promocode</label>
                        <select name="promocodeId" class="form-select" required>
                            <option value="" disabled selected>Select a promocode...</option>
                            @if (activePromocodes != null)
                            {
                                foreach (var promo in activePromocodes)
                                {
                                    <option value="@promo.PromocodeId">@promo.Name - @promo.DiscountPercentage%</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Apply</button>
                </div>
            </form>
            <script>
                document.getElementById('applyPromocodeForm').addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const form = e.target;
                    const paymentId = form.paymentId.value;
                    const promocodeId = form.promocodeId.value;

                    // Create FormData
                    const formData = new FormData();
                    formData.append('promocodeId', promocodeId);

                    try {
                        const response = await fetch(`/api/Payment/ApplyPromocode/${paymentId}`, {
                            method: 'POST',
                            body: formData
                        });

                        if (!response.ok) {
                            const message = await response.text();
                            // If user has a generic showPopup function
                            if (window.showPopup) showPopup(message || 'Failed to apply promocode.', 'error');
                            else alert(message || 'Failed to apply promocode.');
                            return;
                        }

                        // Success
                        bootstrap.Modal.getInstance(document.getElementById('applyPromocodeModal')).hide();
                        if (window.showPopup) showPopup('Promocode applied successfully.', 'success');
                        
                        // Reload table if function exists, or reload page
                        // The Index page loads data via fetch, we might need a way to refresh it.
                        // For now we can reload page or call the load function if accessible.
                         setTimeout(() => location.reload(), 1000);

                    } catch (err) {
                        console.error(err);
                         if (window.showPopup) showPopup('Unable to apply promocode right now.', 'error');
                    }
                });
            </script>
        </div>
    </div>
</div>
