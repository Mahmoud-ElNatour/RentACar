@model RentACar.Web.Models.DriverAssignmentViewModel

<div class="modal fade" id="driverAssignmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-[#141414] border border-[#262626] shadow-2xl rounded-2xl">
            <div class="modal-header border-b border-white/5 p-5">
                <h5 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
                    <span class="material-symbols-outlined text-gold">badge</span>
                    Driver Assignment #@Model.BookingId
                </h5>
                <button type="button" class="text-gray-400 hover:text-white transition-colors" data-bs-dismiss="modal">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>

            <div class="modal-body p-6 space-y-6">
                <div class="alert alert-danger d-none bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl p-4" id="driverAssignError" role="alert"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <p class="text-xs font-bold uppercase text-gray-500">Current Driver</p>
                        <div class="text-white font-semibold">@Model.DriverName ?? "Not Assigned"</div>
                        <div class="text-sm text-gray-400">@Model.DriverEmail ?? "-"</div>
                        <div class="text-sm text-gray-400">@Model.DriverPhone ?? "-"</div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-500 mb-2">Assign Driver</label>
                        <div class="relative">
                            <select id="driverSelect" class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 px-4 text-white appearance-none focus:border-gold focus:ring-1 focus:ring-gold" @(Model.DriverId.HasValue ? "disabled" : "")>
                                <option value="">Select Driver</option>
                                @foreach (var driver in Model.Drivers)
                                {
                                    <option value="@driver.DriverId" selected="@(Model.DriverId == driver.DriverId ? "selected" : null)">
                                        @driver.FullName
                                    </option>
                                }
                            </select>
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500 pointer-events-none">expand_more</span>
                        </div>
                        <p class="text-[10px] text-gray-500 mt-1">Availability and booking conflicts are validated on save.</p>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-t border-white/5 p-5 flex gap-3">
                <button type="button" class="flex-1 bg-white/5 hover:bg-white/10 text-white font-medium py-2.5 rounded-xl transition-colors border border-white/10" data-bs-dismiss="modal">Close</button>
                <button type="button" id="driverAssignOk" class="flex-1 bg-gold hover:bg-[#b5952f] text-black font-bold py-2.5 rounded-xl transition-all shadow-lg shadow-gold/10 @(Model.DriverId.HasValue ? "" : "hidden")">OK</button>
                <button type="button" id="driverAssignEdit" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white font-bold py-2.5 rounded-xl transition-all shadow-lg shadow-blue-500/20 @(Model.DriverId.HasValue ? "" : "hidden")">Edit</button>
                <button type="button" id="driverAssignSave" class="flex-1 bg-gold hover:bg-[#b5952f] text-black font-bold py-2.5 rounded-xl transition-all shadow-lg shadow-gold/10 @(Model.DriverId.HasValue ? "hidden" : "")">Save</button>
                <button type="button" id="driverAssignCancel" class="flex-1 bg-white/5 hover:bg-white/10 text-white font-medium py-2.5 rounded-xl transition-colors border border-white/10 @(Model.DriverId.HasValue ? "hidden" : "")">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const select = document.getElementById('driverSelect');
        const errorAlert = document.getElementById('driverAssignError');
        const okBtn = document.getElementById('driverAssignOk');
        const editBtn = document.getElementById('driverAssignEdit');
        const saveBtn = document.getElementById('driverAssignSave');
        const cancelBtn = document.getElementById('driverAssignCancel');

        const setEditing = (isEditing) => {
            select.disabled = !isEditing;
            okBtn?.classList.toggle('hidden', isEditing);
            editBtn?.classList.toggle('hidden', isEditing);
            saveBtn?.classList.toggle('hidden', !isEditing);
            cancelBtn?.classList.toggle('hidden', !isEditing);
        };

        editBtn?.addEventListener('click', () => setEditing(true));
        cancelBtn?.addEventListener('click', () => setEditing(false));
        okBtn?.addEventListener('click', () => bootstrap.Modal.getInstance(document.getElementById('driverAssignmentModal'))?.hide());

        saveBtn?.addEventListener('click', async () => {
            if (errorAlert) errorAlert.classList.add('d-none');

            const driverId = parseInt(select.value);
            if (!driverId) {
                if (errorAlert) {
                    errorAlert.textContent = "Please select a driver.";
                    errorAlert.classList.remove('d-none');
                }
                return;
            }

            saveBtn.disabled = true;
            const originalText = saveBtn.innerHTML;
            saveBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm mr-2">sync</span> Saving...';

            try {
                const res = await fetch('/api/Booking/AssignDriver', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        bookingId: @Model.BookingId,
                        driverId: driverId
                    })
                });

                if (!res.ok) {
                    const message = await res.text();
                    throw new Error(message || 'Failed to assign driver.');
                }

                bootstrap.Modal.getInstance(document.getElementById('driverAssignmentModal'))?.hide();
                if (window.showPopup) window.showPopup('Driver assignment updated.', 'success');
                if (window.loadBookings) loadBookings();
            } catch (err) {
                if (errorAlert) {
                    errorAlert.textContent = err.message || 'Unable to update driver assignment.';
                    errorAlert.classList.remove('d-none');
                }
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalText;
                setEditing(false);
            }
        });
    })();
</script>
