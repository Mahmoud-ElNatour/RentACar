@model RentACar.Application.DTOs.BookingDto

<div class="modal fade" id="deleteBookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-[#141414] border border-red-500/30 shadow-[0_0_50px_-12px_rgba(239,68,68,0.2)] rounded-2xl overflow-hidden font-display">
            <div class="p-8 text-center">
                <!-- Warning Icon -->
                <div class="w-20 h-20 rounded-full bg-red-500/10 flex items-center justify-center mx-auto mb-6 border border-red-500/20">
                    <span class="material-symbols-outlined text-4xl text-red-500">warning</span>
                </div>

                <h3 class="text-2xl font-bold text-white mb-2">Cancel Booking?</h3>
                <p class="text-gray-400 mb-8 leading-relaxed">
                    Are you sure you want to cancel/delete booking <span class="text-white font-mono font-bold">#@Model.BookingId</span>?<br>
                    This action <span class="text-red-400 font-bold">cannot be undone</span> and will remove all associated payment records.
                </p>

                <form asp-action="Delete" asp-controller="Booking" method="post" class="flex flex-col gap-3">
                    <input type="hidden" name="id" value="@Model.BookingId" />
                    
                    <button type="submit" class="w-full py-3.5 rounded-xl bg-red-500 hover:bg-red-600 text-white font-bold text-lg shadow-lg shadow-red-500/20 transition-all hover:scale-[1.02] active:scale-[0.98]">
                        Yes, Delete Booking
                    </button>
                    
                    <button type="button" class="w-full py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 font-bold border border-white/10 transition-colors" data-bs-dismiss="modal">
                        No, Keep It
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
