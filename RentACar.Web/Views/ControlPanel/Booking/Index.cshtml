@{
    ViewData["Title"] = "Booking Management";
    Layout = "_Layout";
    ViewData["BodyClass"] = "bg-background-dark";
}

<!-- Tailwind & Custom Styles -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                colors: { "gold": "#d4af37" },
                fontFamily: { "display": ["Manrope", "sans-serif"] }
            }
        }
    }
</script>

<div class="px-4 md:px-10 py-8 max-w-[1440px] mx-auto w-full text-white font-display">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
        <div>
            <h1 class="text-3xl md:text-4xl font-black tracking-tight flex items-center gap-3">
                <span class="material-symbols-outlined text-gold text-4xl">calendar_month</span>
                Booking Management
            </h1>
            <p class="text-gray-400 mt-2">Manage reservations, track detailed status, and view financials.</p>
        </div>
        <a href="/Browse" class="flex items-center gap-2 bg-gold hover:bg-[#b5952f] text-black px-6 py-3 rounded-xl font-bold shadow-lg shadow-gold/10 transition-all hover:scale-105 active:scale-95">
            <span class="material-symbols-outlined text-[20px]">add_circle</span>
            <span>New Booking</span>
        </a>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-3 px-4 md:px-0">
        <!-- Total -->
        <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
            <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                 <span class="material-symbols-outlined text-6xl text-gold">book_online</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Total Bookings</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-total">-</p>
            </div>
             <div class="flex items-center gap-2 z-10">
                <span class="text-[#0bda1d] text-sm font-bold flex items-center">
                    <span class="material-symbols-outlined text-sm mr-1">trending_up</span> All Time
                </span>
            </div>
        </div>

        <!-- Active/Ongoing -->
        <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
             <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                 <span class="material-symbols-outlined text-6xl text-blue-500">directions_car</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Active Rentals</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-active">-</p>
            </div>
             <div class="flex items-center gap-2 z-10">
                 <span class="text-blue-500 text-xs font-bold tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">timelapse</span> On Road
                </span>
            </div>
        </div>

        <!-- Pending -->
        <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
             <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                 <span class="material-symbols-outlined text-6xl text-yellow-500">pending_actions</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Pending Approval</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-pending">-</p>
            </div>
             <div class="flex items-center gap-2 z-10">
                 <span class="text-yellow-500 text-xs font-bold tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">hourglass_empty</span> Action Required
                </span>
            </div>
        </div>

        <!-- Revenue -->
        <div class="flex flex-col gap-3 rounded-xl p-8 bg-[#121212] border-t-2 border-gold shadow-2xl relative overflow-hidden group">
             <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                 <span class="material-symbols-outlined text-6xl text-green-500">payments</span>
            </div>
            <p class="text-gray-400 text-sm font-semibold uppercase tracking-wider z-10">Est. Revenue</p>
            <div class="flex items-center gap-3 z-10">
                <p class="text-white tracking-tight text-4xl font-bold" id="stat-revenue">-</p>
            </div>
             <div class="flex items-center gap-2 z-10">
                <span class="text-green-500 text-xs font-bold tracking-wide flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">attach_money</span> Completed/Active
                </span>
            </div>
        </div>
    </div>

    </div>

    <!-- Lifecycle Flow Visual -->
    <div class="mb-6 hidden md:block mx-auto max-w-[95%]">
        <h3 class="text-white text-lg font-bold mb-3 flex items-center gap-1">
            <span class="material-symbols-outlined text-gold">sync_alt</span> Booking Lifecycle
        </h3>
        <div class="bg-[#121212] border border-[#262626] rounded-xl p-6 flex items-center justify-between relative">
             <!-- Connector Line -->
             <div class="absolute top-[50%] left-16 right-16 h-0.5 bg-gray-800 -z-0 transform -translate-y-1/2"></div>
 
             <!-- Steps -->
             <div class="flex flex-col items-center gap-2 z-10 relative group px-2">
                 <!-- Tooltip -->
                 <div class="absolute bottom-full mb-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-20 w-48 left-1/2 -translate-x-1/2">
                     <div class="bg-[#121212] text-gray-300 text-[10px] font-medium rounded-lg py-2 px-3 shadow-2xl border border-yellow-500/30 relative text-center">
                         Until payment is done successfully
                         <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-yellow-500/30"></div>
                     </div>
                 </div>

                 <div class="w-10 h-10 rounded-full bg-[#121212] border-2 border-yellow-500 flex items-center justify-center text-yellow-500 shadow-lg shadow-yellow-500/10 transition-transform group-hover:scale-110">
                    <span class="material-symbols-outlined text-[20px]">pending_actions</span>
                 </div>
                 <div class="text-center">
                     <p class="text-[10px] font-bold text-yellow-500 uppercase tracking-wider">Pending</p>
                 </div>
             </div>
             
             <div class="flex flex-col items-center gap-2 z-10 relative group px-2">
                 <!-- Tooltip -->
                 <div class="absolute bottom-full mb-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-20 w-48 left-1/2 -translate-x-1/2">
                     <div class="bg-[#121212] text-gray-300 text-[10px] font-medium rounded-lg py-2 px-3 shadow-2xl border border-sky-500/30 relative text-center">
                         Paid but waiting customer to sign contract & take car
                         <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-sky-500/30"></div>
                     </div>
                 </div>

                 <div class="w-10 h-10 rounded-full bg-[#121212] border-2 border-sky-500 flex items-center justify-center text-sky-500 shadow-lg shadow-sky-500/10 transition-transform group-hover:scale-110">
                    <span class="material-symbols-outlined text-[20px]">book_online</span>
                 </div>
                 <div class="text-center">
                     <p class="text-[10px] font-bold text-sky-500 uppercase tracking-wider">Confirmed</p>
                 </div>
             </div>
 
             <div class="flex flex-col items-center gap-2 z-10 relative group px-2">
                 <!-- Tooltip -->
                 <div class="absolute bottom-full mb-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-20 w-48 left-1/2 -translate-x-1/2">
                     <div class="bg-[#121212] text-gray-300 text-[10px] font-medium rounded-lg py-2 px-3 shadow-2xl border border-blue-500/30 relative text-center">
                         Customer has taken the car
                         <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-blue-500/30"></div>
                     </div>
                 </div>

                 <div class="w-10 h-10 rounded-full bg-[#121212] border-2 border-blue-500 flex items-center justify-center text-blue-500 shadow-lg shadow-blue-500/10 transition-transform group-hover:scale-110">
                    <span class="material-symbols-outlined text-[20px]">directions_car</span>
                 </div>
                 <div class="text-center">
                     <p class="text-[10px] font-bold text-blue-500 uppercase tracking-wider">InProgress</p>
                 </div>
             </div>
 
             <div class="flex flex-col items-center gap-2 z-10 relative group px-2">
                 <!-- Tooltip -->
                 <div class="absolute bottom-full mb-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-20 w-48 left-1/2 -translate-x-1/2">
                     <div class="bg-[#121212] text-gray-300 text-[10px] font-medium rounded-lg py-2 px-3 shadow-2xl border border-orange-500/30 relative text-center">
                         Booking is overdue, waiting for return
                         <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-orange-500/30"></div>
                     </div>
                 </div>

                 <div class="w-10 h-10 rounded-full bg-[#121212] border-2 border-orange-500 flex items-center justify-center text-orange-500 shadow-lg shadow-orange-500/10 transition-transform group-hover:scale-110">
                    <span class="material-symbols-outlined text-[20px]">assignment_late</span>
                 </div>
                 <div class="text-center">
                     <p class="text-[10px] font-bold text-orange-500 uppercase tracking-wider">AwaitingReturn</p>
                 </div>
             </div>
 
             <div class="flex flex-col items-center gap-2 z-10 relative group px-2">
                 <!-- Tooltip -->
                 <div class="absolute bottom-full mb-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-20 w-48 left-1/2 -translate-x-1/2">
                     <div class="bg-[#121212] text-gray-300 text-[10px] font-medium rounded-lg py-2 px-3 shadow-2xl border border-green-500/30 relative text-center">
                         Customer returned car - End of cycle
                         <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-green-500/30"></div>
                     </div>
                 </div>

                 <div class="w-10 h-10 rounded-full bg-[#121212] border-2 border-green-500 flex items-center justify-center text-green-500 shadow-lg shadow-green-500/10 transition-transform group-hover:scale-110">
                    <span class="material-symbols-outlined text-[20px]">task_alt</span>
                 </div>
                 <div class="text-center">
                     <p class="text-[10px] font-bold text-green-500 uppercase tracking-wider">Completed</p>
                 </div>
             </div>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8 px-4 md:px-0 mx-auto max-w-[98%]">

    </div>

    <!-- Filters & Toolbar -->
    <div class="bg-[#16181a] border border-[#262626] rounded-2xl p-4 mb-6 shadow-xl mx-auto max-w-[98%]">
        <form id="filterForm" class="flex flex-col lg:flex-row gap-4 items-end">
            <!-- Search -->
            <label class="flex flex-col w-full lg:flex-[2]">
                <span class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">Search</span>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500">search</span>
                    <input type="text" name="search" id="searchInput"
                           class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 pl-12 pr-4 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all" 
                           placeholder="Search Booking ID, Customer, or Car..." />
                </div>
            </label>
            
            <!-- Status Filter -->
            <label class="flex flex-col w-full lg:flex-1">
                <span class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">Status</span>
                <div class="relative">
                     <select name="status" id="statusFilter"
                            class="w-full bg-[#0a0a0a] bg-none border border-[#262626] rounded-xl py-3 pl-4 pr-10 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold appearance-none cursor-pointer">
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="InProgress">InProgress</option>
                        <option value="AwaitingReturn">AwaitingReturn</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500 pointer-events-none">expand_more</span>
                </div>
            </label>
            
             <!-- Date Range -->
            <div class="flex gap-2 w-full lg:flex-[1.5]">
                <label class="flex flex-col w-full">
                    <span class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">From</span>
                    <input type="date" name="startDate" id="startDate" 
                           class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 px-4 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all [color-scheme:dark]" />
                </label>
                <label class="flex flex-col w-full">
                    <span class="text-gray-400 text-xs font-bold uppercase tracking-wider mb-2">To</span>
                    <input type="date" name="endDate" id="endDate" 
                           class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 px-4 text-white placeholder-gray-600 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-all [color-scheme:dark]" />
                </label>
            </div>

            <button type="submit" class="w-full lg:w-auto h-[50px] bg-white/5 hover:bg-white/10 text-white border border-[#262626] px-6 rounded-xl font-bold transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">filter_list</span>
                Filter
            </button>
        </form>
    </div>

    <!-- Table Container -->
    <div class="bg-[#16181a] border border-[#262626] rounded-2xl overflow-hidden shadow-2xl mx-auto max-w-[98%]">
        <div class="overflow-x-auto min-h-[400px]">
             <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white/5 border-b border-[#262626] text-gray-400 text-xs uppercase tracking-wider font-bold">
                        <th class="px-6 py-4 text-center cursor-default">ID</th>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors" onclick="setSort('Customer')">
                            <div class="flex items-center gap-1">Customer <span class="material-symbols-outlined text-[14px]" id="sort-Customer">unfold_more</span></div>
                        </th>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors" onclick="setSort('Car')">
                            <div class="flex items-center gap-1">Car <span class="material-symbols-outlined text-[14px]" id="sort-Car">unfold_more</span></div>
                        </th>
                        <th class="px-6 py-4 cursor-pointer hover:text-white transition-colors" onclick="setSort('StartDate')">
                            <div class="flex items-center gap-1">Schedule <span class="material-symbols-outlined text-[14px]" id="sort-StartDate">unfold_more</span></div>
                        </th>
                        <th class="px-6 py-4 text-center cursor-pointer hover:text-white transition-colors" onclick="setSort('Status')">
                             <div class="flex items-center justify-center gap-1">Status <span class="material-symbols-outlined text-[14px]" id="sort-Status">unfold_more</span></div>
                        </th>
                        <th class="px-6 py-4 text-right cursor-pointer hover:text-white transition-colors" onclick="setSort('Price')">
                             <div class="flex items-center justify-end gap-1">Total <span class="material-symbols-outlined text-[14px]" id="sort-Price">unfold_more</span></div>
                        </th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="bookingRows" class="divide-y divide-[#262626]">
                    <!-- Rows injected via JS -->
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div id="paginationControls" class="border-t border-[#262626] p-4 flex items-center justify-between bg-[#0a0a0a] hidden">
            <div class="text-sm text-gray-500" id="showingText">Showing 0 of 0</div>
            <div class="flex items-center gap-2">
                <button id="prevBtn" onclick="changePage(-1)" class="p-2 rounded-lg hover:bg-white/10 text-gray-400 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <div id="pageNumbers" class="flex items-center gap-1"></div>
                <button id="nextBtn" onclick="changePage(1)" class="p-2 rounded-lg hover:bg-white/10 text-gray-400 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </div>

        <!-- Loading / Empty -->
        <div id="loadingState" class="hidden p-12 text-center text-gray-500">
            <span class="material-symbols-outlined text-4xl animate-spin mb-2">progress_activity</span>
            <p>Loading bookings...</p>
        </div>
        <div id="emptyState" class="hidden p-12 text-center text-gray-500">
            <span class="material-symbols-outlined text-4xl mb-2">event_busy</span>
            <p>No bookings found.</p>
        </div>
    </div>
</div>

<!-- Global Modal Placeholder -->
<div id="bookingModalPlaceholder"></div>

<script>
    // State
    let currentPage = 1;
    let pageSize = 10;
    let totalPages = 1;
    let sortColumn = 'BookingId';
    let sortDirection = 'desc';

    // Init
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if(urlParams.has('search')) {
            document.getElementById('searchInput').value = urlParams.get('search');
        }

        loadBookings();

        document.getElementById('filterForm').addEventListener('submit', (e) => {
            e.preventDefault();
            currentPage = 1;
            loadBookings();
        });

        // Debounce search
        let timeout = null;
        document.getElementById('searchInput').addEventListener('input', () => {
           clearTimeout(timeout);
           timeout = setTimeout(() => {
               currentPage = 1;
               loadBookings();
           }, 400);
        });
        
        // Filter changes
        document.getElementById('statusFilter').addEventListener('change', () => { currentPage = 1; loadBookings(); });
    });

    function setSort(col) {
        if(sortColumn === col) {
            sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            sortColumn = col;
            sortDirection = 'asc'; // Default
        }
        
        // Update icons
        document.querySelectorAll('[id^="sort-"]').forEach(el => el.textContent = 'unfold_more');
        const active = document.getElementById('sort-' + col);
        if(active) active.textContent = sortDirection === 'asc' ? 'keyboard_arrow_up' : 'keyboard_arrow_down';
        
        loadBookings();
    }
    
    function changePage(delta) {
        const novo = currentPage + delta;
        if(novo > 0 && novo <= totalPages) {
            currentPage = novo;
            loadBookings();
        }
    }
    
    function gotoPage(p) {
        currentPage = p;
        loadBookings();
    }

    function getFilterParams() {
        const formData = new FormData(document.getElementById('filterForm'));
        const params = new URLSearchParams();
        for(let [k,v] of formData) {
            if(v) params.append(k,v);
        }
        params.append('page', currentPage);
        params.append('pageSize', pageSize);
        params.append('sortColumn', sortColumn);
        params.append('sortDirection', sortDirection);
        return params;
    }

    function loadBookings() {
        // Trigger both loads in parallel
        loadTableData();
        loadStatsData();
    }

    async function loadStatsData() {
        try {
            const params = getFilterParams();
            // Stats endpoint doesn't need page/pageSize/sort, but it ignores them so it's fine or we can strip them.
            // Cleaner to strip them but for speed just pass all.
            const res = await fetch('/api/Booking/GetStats?' + params.toString());
            if(!res.ok) return;
            const stats = await res.json();
            
            document.getElementById('stat-total').textContent = stats.total;
            document.getElementById('stat-active').textContent = stats.active;
            document.getElementById('stat-pending').textContent = stats.pending;
            document.getElementById('stat-revenue').textContent = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0 }).format(stats.revenue);
        } catch(e) { console.error("Stats load failed", e); }
    }

    async function loadTableData() {
        const tbody = document.getElementById('bookingRows');
        const loading = document.getElementById('loadingState');
        const empty = document.getElementById('emptyState');
        const pagination = document.getElementById('paginationControls');
        
        tbody.closest('table').style.opacity = '0.5';
        
        try {
            const params = getFilterParams();
            const res = await fetch('/api/Booking/GetFilteredBookings?' + params.toString());
            if(!res.ok) throw new Error('Failed to load data');
            
            const data = await res.json();
            
            tbody.closest('table').style.opacity = '1';
            tbody.innerHTML = '';
            
            if(data.items.length === 0) {
                empty.classList.remove('hidden');
                loading.classList.add('hidden');
                pagination.classList.add('hidden');
                return;
            }
            
            empty.classList.add('hidden');
            loading.classList.add('hidden');
            pagination.classList.remove('hidden');

            // Render Table
            data.items.forEach(b => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-white/5 transition-colors group border-b border-[#262626] last:border-0 align-middle';
                
                // Status Badge Logic
                // Status Badge Logic
                let statusClass = 'bg-gray-500/10 text-gray-500 border border-gray-500/20';
                const s = (b.bookingStatus || '').toLowerCase();
                
                if(s === 'pending') statusClass = 'bg-yellow-500/10 text-yellow-500 border border-yellow-500/20';
                else if(s === 'confirmed' || s === 'booked') statusClass = 'bg-sky-500/10 text-sky-500 border border-sky-500/20';
                else if(s === 'inprogress' || s === 'active') statusClass = 'bg-blue-500/10 text-blue-500 border border-blue-500/20';
                else if(s === 'awaitingreturn') statusClass = 'bg-orange-500/10 text-orange-500 border border-orange-500/20';
                else if(s === 'completed' || s === 'returned') statusClass = 'bg-green-500/10 text-green-500 border border-green-500/20';
                else if(s === 'cancelled' || s === 'rejected') statusClass = 'bg-red-500/10 text-red-500 border border-red-500/20';

                // Helpers
                const formatDate = (dateStr) => {
                    if(!dateStr) return '-';
                    return new Date(dateStr).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year:'numeric' });
                };

                const formatMoney = (amount) => {
                     return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount || 0);
                };

                tr.innerHTML = `
                    <td class="px-6 py-4 text-center font-mono text-gray-500 text-xs">#${b.bookingId}</td>
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-xs font-bold text-gray-400">
                                ${(b.customerName || 'U').charAt(0).toUpperCase()}
                            </div>
                            <div>
                                <div class="font-bold text-white text-sm">${b.customerName || 'Unknown'}</div>
                                <div class="text-xs text-gray-500">${b.customerEmail || ''}</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                         <div class="font-medium text-white text-sm">${b.carModel || 'Unknown Car'}</div>
                         <div class="text-xs text-gold/80 bg-gold/5 px-1.5 rounded inline-block border border-gold/10">${b.carPlate || 'No Plate'}</div>
                    </td>
                    <td class="px-6 py-4 text-xs text-gray-400">
                        <div><span class="font-bold text-gray-300">Start:</span> ${formatDate(b.startdate)}</div>
                        <div><span class="font-bold text-gray-300">End:</span> ${formatDate(b.enddate)}</div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold \${statusClass}">
                            ${b.bookingStatus}
                        </span>
                        ${b.hasDriver && b.driverId ? `
                            <button class="assign-driver mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-green-500/10 text-green-500 border border-green-500/20 hover:bg-green-500/20 transition-colors" data-id="${b.bookingId}">
                                Assigned
                            </button>
                        ` : ''}
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="font-bold text-white">${formatMoney(b.totalPrice)}</div>
                        <div class="text-xs ${b.paymentStatus === 'Paid' ? 'text-green-500' : 'text-red-400'}">
                            ${b.paymentStatus || 'Unpaid'}
                        </div>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2 opacity-100 transition-opacity">
                            <button class="view-details p-2 text-blue-400 hover:text-blue-300 hover:bg-blue-500/10 rounded-lg transition-colors" data-id="${b.bookingId}" title="View Details">
                                <span class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                            <button class="edit-booking p-2 text-gold hover:text-[#b5952f] hover:bg-gold/10 rounded-lg transition-colors" data-id="${b.bookingId}" title="Edit Booking">
                                <span class="material-symbols-outlined text-[20px]">edit</span>
                            </button>
                            <a href="/Booking/Contract/${b.bookingId}" target="_blank" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-lg transition-colors" title="Download Contract">
                                <span class="material-symbols-outlined text-[20px]">picture_as_pdf</span>
                            </a>
                            <button class="delete-booking p-2 text-red-500 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors" data-id="${b.bookingId}" title="Cancel/Delete">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            
            // Pagination UI
            totalPages = data.totalPages;
            document.getElementById('showingText').innerText = `Showing ${(currentPage-1)*pageSize + 1} - ${Math.min(currentPage*pageSize, data.totalCount)} of ${data.totalCount}`;
            document.getElementById('prevBtn').disabled = currentPage <= 1;
            document.getElementById('nextBtn').disabled = currentPage >= totalPages;
            
            renderPageNumbers(totalPages, currentPage);

        } catch(e) {
            console.error(e);
            tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-red-500">Failed to load data</td></tr>';
            tbody.closest('table').style.opacity = '1';
        }
    }
    
    function renderPageNumbers(total, current) {
        const container = document.getElementById('pageNumbers');
        container.innerHTML = '';
        /* Reuse simple logic for brevity */
        let pages = [];
        if(total <= 7) { pages = Array.from({length: total}, (_, i) => i + 1); } 
        else {
             if(current <= 4) pages = [1,2,3,4,5, '...', total];
             else if(current >= total - 3) pages = [1, '...', total-4, total-3, total-2, total-1, total];
             else pages = [1, '...', current-1, current, current+1, '...', total];
        }
        
        pages.forEach(p => {
             if(p === '...') {
                 const span = document.createElement('span');
                 span.className = 'text-gray-600 px-2';
                 span.textContent = '...';
                 container.appendChild(span);
             } else {
                 const btn = document.createElement('button');
                 btn.className = `w-8 h-8 rounded-lg text-xs font-bold transition-all ${p === current ? 'bg-gold text-black shadow-lg shadow-gold/20' : 'bg-[#16181a] text-gray-400 hover:text-white hover:bg-white/10'}`;
                 btn.textContent = p;
                 btn.onclick = () => gotoPage(p);
                 container.appendChild(btn);
             }
        });
    }

    async function loadModal(url) {
        try {
            const res = await fetch(url);
            if(!res.ok) throw new Error("Failed to load modal");
            const html = await res.text();
            
            const placeholder = document.getElementById('bookingModalPlaceholder');
            placeholder.innerHTML = html; 
            
            // Execute scripts
            placeholder.querySelectorAll('script').forEach(scr => {
                const s = document.createElement('script');
                if(scr.src) s.src = scr.src;
                else s.textContent = scr.textContent;
                document.body.appendChild(s);
                document.body.removeChild(s);
            });

            const modalEl = placeholder.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
            
        } catch(e) { console.error(e); }
    }
    
    // Delegation
    document.getElementById('bookingRows').addEventListener('click', e => {
        const view = e.target.closest('.view-details');
        const del = e.target.closest('.delete-booking');
        const edit = e.target.closest('.edit-booking');
        const assign = e.target.closest('.assign-driver');

        if(view) {
             loadModal('/Booking/Details/' + view.dataset.id);
        } else if(edit) {
             loadModal('/Booking/Edit/' + edit.dataset.id); 
        } else if(del) {
             loadModal('/Booking/Delete/' + del.dataset.id);
        } else if(assign) {
             loadModal('/Booking/AssignDriver/' + assign.dataset.id);
        }
    });

</script>
