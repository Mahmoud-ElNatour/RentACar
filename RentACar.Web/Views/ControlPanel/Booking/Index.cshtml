@{
    ViewData["Title"] = "Bookings";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employees.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("_PopupNotifications")
    <div class="booking-container container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="../ControlPanel" class="btn btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px" title="Back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="flex-grow-1 text-center m-0">Manage Bookings</h2>
            <div style="width:40px;"></div>
        </div>
        <div class="text-end mb-3">
            <a href="/Booking/Add" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Booking</a>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-dark align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Car</th>
                        <th>Employee Booker</th>
                        <th>Payment</th>
                        <th>Amount</th>
                        <th>Subtotal</th>
                        <th>Total</th>
                        <th>Promocode</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="bookingRows"></tbody>
            </table>
        </div>
    </div>
    <div id="bookingModalPlaceholder"></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function formatValue(value) {
            if (value === null || value === undefined) {
                return '';
            }
            const number = Number(value);
            if (Number.isNaN(number)) {
                return value;
            }
            return number.toFixed(2);
        }

        async function loadBookings() {
            try {
                const res = await fetch('/api/Booking');
                if (!res.ok) {
                    throw new Error(await res.text());
                }
                const data = await res.json();
                const tbody = document.getElementById('bookingRows');
                tbody.innerHTML = '';
                data.forEach(b => {
                    const tr = document.createElement('tr');
                    const customerDisplay = [b.customerName ?? '', b.customerUsername ? `(${b.customerUsername})` : ''].join(' ').trim() || '-';
                    const carDisplay = [b.carModel ?? '', b.carPlate ? `(${b.carPlate})` : ''].join(' ').trim() || '-';
                    const employeeDisplay = b.employeeName ?? '';
                    const promoDisplay = b.promocodeName ? `${b.promocodeName}${b.promocodeDiscount ? ` (${b.promocodeDiscount}%)` : ''}` : '';

                    tr.innerHTML =
                        `<td>${b.bookingId}</td>` +
                        `<td>${customerDisplay}</td>` +
                        `<td>${carDisplay}</td>` +
                        `<td>${employeeDisplay}</td>` +
                        `<td>${b.paymentId ?? ''}</td>` +
                        `<td>${formatValue(b.paymentAmount)}</td>` +
                        `<td>${formatValue(b.subtotal)}</td>` +
                        `<td>${formatValue(b.totalPrice)}</td>` +
                        `<td>${promoDisplay}</td>` +
                        `<td>${b.startdate}</td>` +
                        `<td>${b.enddate}</td>` +
                        `<td class='text-capitalize'>${b.bookingStatus ?? ''}</td>` +
                        `<td>` +
                        `<a href='#' class='text-info me-2 view-booking' data-url='/Booking/Details/${b.bookingId}' title='View details'><i class='fas fa-eye'></i></a>` +
                        `<a href='/Booking/Edit/${b.bookingId}' class='text-warning me-2' title='Edit booking'><i class='fas fa-pencil-alt'></i></a>` +
                        `<a href='/Booking/Delete/${b.bookingId}' class='text-danger me-2' title='Delete booking'><i class='fas fa-trash'></i></a>` +
                        `<a href='/Booking/Contract/${b.bookingId}' target='_blank' class='text-primary' title='Download contract'><i class='fas fa-file-pdf'></i></a>` +
                        `</td>`;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                console.error(err);
                if (window.showPopup) {
                    window.showPopup('Failed to load bookings.', 'error');
                }
            }
        }

        async function loadModal(url) {
            try {
                const res = await fetch(url);
                if (!res.ok) {
                    throw new Error(await res.text());
                }
                const html = await res.text();
                const placeholder = document.getElementById('bookingModalPlaceholder');
                placeholder.innerHTML = html;
                placeholder.querySelectorAll('script').forEach(src => {
                    const script = document.createElement('script');
                    script.textContent = src.textContent;
                    document.body.appendChild(script);
                    document.body.removeChild(script);
                });
            } catch (err) {
                console.error(err);
                if (window.showPopup) {
                    window.showPopup('Failed to load booking details.', 'error');
                }
            }
        }
        document.addEventListener('DOMContentLoaded', () => {
            loadBookings();
            document.getElementById('bookingRows').addEventListener('click', async e => {
                const viewLink = e.target.closest('.view-booking');
                if (viewLink) {
                    e.preventDefault();
                    await loadModal(viewLink.dataset.url);
                }
            });
        });
    </script>
</body>
</html>
