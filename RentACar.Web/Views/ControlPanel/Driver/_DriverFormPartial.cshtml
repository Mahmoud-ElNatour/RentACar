@model RentACar.Application.DTOs.DriverDto
<div class="modal fade" id="driverFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title">@((Model.DriverId == 0) ? "Add Driver" : "Edit Driver")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="driverForm">
                    <input type="hidden" asp-for="DriverId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Rating</label>
                            <input asp-for="Rating" class="form-control" />
                        </div>
                        @if (Model.DriverId == 0)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Password</label>
                                <input type="password" name="Password" class="form-control" />
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label">License Number</label>
                            <input asp-for="LicenseNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">License Expiry</label>
                            <input asp-for="LicenseExpiry" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Languages</label>
                            <input asp-for="Languages" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-12 form-check mt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label" asp-for="IsActive">Active</label>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">@(Model.DriverId == 0 ? "Add" : "Save")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.getElementById('driverForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const form = e.target;
        const f = form.elements;
        const data = {
            driverId: parseInt(form.querySelector('[name="DriverId"]')?.value || '0'),
            fullName: f['FullName']?.value,
            email: f['Email']?.value,
            phone: f['Phone']?.value,
            rating: f['Rating']?.value ? parseFloat(f['Rating']?.value) : null,
            licenseNumber: f['LicenseNumber']?.value,
            licenseExpiry: f['LicenseExpiry']?.value || null,
            languages: f['Languages']?.value,
            notes: f['Notes']?.value,
            isActive: form.querySelector('[name="IsActive"]')?.checked ?? false
        };
        let url = '/api/Driver';
        let method = 'POST';
        const isUpdate = Boolean(data.driverId);
        if (isUpdate) {
            url += '/' + data.driverId;
            method = 'PUT';
        } else {
            data.password = f['Password']?.value;
        }
        try {
            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (!response.ok) {
                let message = 'Failed to save driver.';
                try {
                    const contentType = response.headers.get('Content-Type') || '';
                    if (contentType.includes('application/json')) {
                        const payload = await response.json();
                        if (payload && typeof payload === 'object' && payload.message) {
                            message = payload.message;
                        }
                    } else {
                        const text = await response.text();
                        if (text) message = text;
                    }
                } catch {
                    // ignore
                }

                if (window.showPopup) {
                    window.showPopup(message, 'error');
                }
                return;
            }

            if (window.showPopup) {
                window.showPopup(isUpdate ? 'Driver updated successfully.' : 'Driver created successfully.', 'success');
            }

            const modalEl = form.closest('.modal');
            bootstrap.Modal.getInstance(modalEl).hide();
            if (window.loadDrivers) loadDrivers();
        } catch (err) {
            if (window.showPopup) {
                window.showPopup('Unexpected error occurred while saving the driver.', 'error');
            }
            console.error(err);
        }
    });
</script>
