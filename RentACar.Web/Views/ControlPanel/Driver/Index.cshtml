@{
    ViewData["Title"] = "Drivers";
    Layout = null;
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employees.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("_PopupNotifications")
    <div class="employee-container container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="../ControlPanel" class="btn btn-outline-warning rounded-circle d-inline-flex align-items-center justify-content-center" style="width:40px;height:40px" title="Back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="flex-grow-1 text-center m-0">Manage Drivers</h2>
            <div style="width:40px;"></div>
        </div>

        <form id="filterForm" class="row g-2 mb-4 align-items-end">
            <div class="col">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control" placeholder="Name, Email, or Code" />
            </div>
            <div class="col">
                <label class="form-label">Active</label>
                <select name="active" class="form-select">
                    <option value="">Any</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Filter</button>
            </div>
            @if (isAdmin)
            {
                <div class="col-auto ms-auto">
                    <button type="button" id="addDriver" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Driver</button>
                </div>
            }
        </form>

        <div class="mb-3">
            <input type="text" id="tableSearch" class="form-control" placeholder="Search table..." />
        </div>
        <div class="table-responsive">
            <table id="driverTable" class="table table-striped table-dark align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="driverRows"></tbody>
            </table>
        </div>
    </div>
    <div id="driverModalPlaceholder"></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const isAdmin = @(isAdmin.ToString().ToLower());
        async function loadDrivers() {
            const params = new URLSearchParams(new FormData(document.getElementById('filterForm')));
            const res = await fetch('/api/Driver?' + params.toString());
            const data = await res.json();
            const tbody = document.getElementById('driverRows');
            tbody.innerHTML = '';
            data.forEach(driver => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${driver.driverCode}</td>
                    <td>${driver.fullName}</td>
                    <td>${driver.phone ?? ''}</td>
                    <td>${driver.email}</td>
                    <td class="text-center">${driver.isActive ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>'}</td>
                    <td>
                        ${isAdmin ? `<a href="#" class="text-warning me-2 edit-driver" data-id="${driver.driverId}"><i class="fas fa-pencil-alt"></i></a>` : ''}
                        ${isAdmin ? `<a href="#" class="text-info me-2 toggle-driver" data-id="${driver.driverId}" data-active="${driver.isActive}"><i class="fas fa-power-off"></i></a>` : ''}
                        ${isAdmin ? `<a href="#" class="text-danger delete-driver" data-id="${driver.driverId}"><i class="fas fa-trash"></i></a>` : ''}
                    </td>`;
                tbody.appendChild(row);
            });
        }

        async function loadModal(url) {
            const res = await fetch(url);
            const html = await res.text();
            const placeholder = document.getElementById('driverModalPlaceholder');
            placeholder.innerHTML = html;
            placeholder.querySelectorAll('script').forEach(scr => {
                const s = document.createElement('script');
                s.textContent = scr.textContent;
                document.body.appendChild(s);
                document.body.removeChild(s);
            });
            const modalEl = placeholder.querySelector('.modal');
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadDrivers();
            document.getElementById('filterForm').addEventListener('submit', e => { e.preventDefault(); loadDrivers(); });
            if (isAdmin) {
                document.getElementById('addDriver').addEventListener('click', () => loadModal('/Driver/Add'));
            }
            document.getElementById('driverRows').addEventListener('click', async e => {
                const edit = e.target.closest('.edit-driver');
                const del = e.target.closest('.delete-driver');
                const toggle = e.target.closest('.toggle-driver');
                if (edit) {
                    e.preventDefault();
                    loadModal('/Driver/Edit/' + edit.dataset.id);
                } else if (del) {
                    e.preventDefault();
                    loadModal('/Driver/Delete/' + del.dataset.id);
                } else if (toggle) {
                    e.preventDefault();
                    const isActive = toggle.dataset.active === 'true';
                    const endpoint = `/api/Driver/${toggle.dataset.id}/${isActive ? 'deactivate' : 'activate'}`;
                    const response = await fetch(endpoint, { method: 'POST' });
                    if (response.ok) {
                        showPopup(isActive ? 'Driver deactivated.' : 'Driver activated.', 'success');
                        loadDrivers();
                    } else {
                        showPopup('Unable to update driver status.', 'error');
                    }
                }
            });
        });
    </script>
</body>
</html>
