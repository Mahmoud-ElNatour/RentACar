@model RentACar.Application.DTOs.AdminDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Page-Specific Styles (if any) -->
<link rel="stylesheet" href="~/css/AdminDashboard.css" />

<div class="p-6 md:p-10 max-w-7xl mx-auto w-full flex flex-col gap-8">
    <!-- Page Heading -->
    <header class="flex flex-wrap justify-between items-end gap-4 border-b border-white/5 pb-6">
        <div class="flex flex-col gap-1">
            <h1 class="text-white text-3xl md:text-4xl font-black tracking-tight">Dashboard Overview</h1>
            <p class="text-gray-400 text-base">Here is what's happening in Rent A Car today.</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 px-4 py-2 bg-surface-dark border border-white/5 rounded-lg">
                <span class="material-symbols-outlined text-primary text-sm">calendar_today</span>
                <span class="text-white text-sm font-medium">@DateTime.Now.ToString("MMM dd, yyyy")</span>
            </div>
            <a href="/Browse">
               <button class="bg-primary hover:bg-primary-hover text-black font-bold px-4 py-2 rounded-lg transition-colors flex items-center gap-2 shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-xl">add</span>
                <span>New Booking</span>
            </button>
            </a>
            
        </div>
    </header>
    <!-- Top KPI Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Fleet Card -->
        <div class="bg-surface-dark border border-white/5 rounded-xl p-5 flex flex-col justify-between gap-4 hover:border-primary/20 transition-all shadow-lg shadow-black/20">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-400 text-sm font-medium">Total Fleet</p>
                    <p class="text-white text-2xl font-bold mt-1">@Model.TotalCars Cars</p>
                </div>
                <div class="bg-primary/10 p-2 rounded-lg text-primary">
                    <span class="material-symbols-outlined">directions_car</span>
                </div>
            </div>
            <div class="flex flex-col gap-2">
                <div class="flex justify-between text-xs">
                    <span class="text-white font-medium">Availability</span>
                    @{
                        var availability = Model.TotalCars > 0 ? (int)((double)Model.AvailableCars / Model.TotalCars * 100) : 0;
                    }
                    <span class="text-primary font-bold">@availability%</span>
                </div>
                <div class="h-2 w-full bg-white/5 rounded-full overflow-hidden">
                    <div class="h-full bg-primary rounded-full shadow-[0_0_10px_rgba(212,175,53,0.5)]" style="width: @availability%"></div>
                </div>
                <p class="text-gray-500 text-xs">@Model.AvailableCars cars available for booking</p>
            </div>
        </div>
        <!-- Active Bookings -->
        <div class="bg-surface-dark border border-white/5 rounded-xl p-5 flex flex-col justify-between gap-4 hover:border-primary/20 transition-all shadow-lg shadow-black/20">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-400 text-sm font-medium">Active Bookings</p>
                    <p class="text-white text-2xl font-bold mt-1">@Model.ActiveBookings</p>
                </div>
                <div class="bg-blue-500/10 p-2 rounded-lg text-blue-400">
                    <span class="material-symbols-outlined">key</span>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500">
                <span class="text-green-400 flex items-center gap-1 font-bold"><span class="material-symbols-outlined text-[14px]">trending_up</span></span>
                <span>Total Bookings: @Model.TotalBookings</span>
            </div>
        </div>
        <!-- Total Customers -->
        <div class="bg-surface-dark border border-white/5 rounded-xl p-5 flex flex-col justify-between gap-4 hover:border-primary/20 transition-all shadow-lg shadow-black/20">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-400 text-sm font-medium">Total Customers</p>
                    <p class="text-white text-2xl font-bold mt-1">@Model.TotalCustomers.ToString("N0")</p>
                </div>
                <div class="bg-purple-500/10 p-2 rounded-lg text-purple-400">
                    <span class="material-symbols-outlined">group</span>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500">
                <span class="text-white font-medium">Registered</span>
                <span>in total</span>
            </div>
        </div>
        <!-- Employees -->
        <div class="bg-surface-dark border border-white/5 rounded-xl p-5 flex flex-col justify-between gap-4 hover:border-primary/20 transition-all shadow-lg shadow-black/20">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-gray-400 text-sm font-medium">Employees</p>
                    <p class="text-white text-2xl font-bold mt-1">@Model.TotalEmployees</p>
                </div>
                <div class="bg-orange-500/10 p-2 rounded-lg text-orange-400">
                    <span class="material-symbols-outlined">badge</span>
                </div>
            </div>
            <div class="flex items-center gap-2 text-xs text-gray-500">
                <span class="text-green-400 font-medium">Active</span>
                <span>All shifts covered</span>
            </div>
        </div>
    </div>
    <!-- Financial Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Income -->
        <div class="bg-gradient-to-br from-surface-dark to-surface-darker border border-primary/30 rounded-xl p-6 relative overflow-hidden group shadow-lg shadow-primary/5">
            <div class="absolute right-0 top-0 w-24 h-24 bg-primary/10 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
            <p class="text-gray-400 text-sm font-medium relative z-10">Monthly Income (@DateTime.Now.ToString("MMM"))</p>
            <p class="text-white text-3xl font-bold mt-2 relative z-10 tracking-tight">$@Model.IncomeThisMonth.ToString("")</p>
            <div class="mt-4 flex items-center gap-2 relative z-10">
                <span class="text-gray-500 text-xs">Year Total: $@Model.IncomeThisYear.ToString("")</span>
            </div>
        </div>
        <!-- Salaries -->
        <div class="bg-surface-dark border border-white/5 rounded-xl p-6 hover:border-primary/20 transition-all">
            <p class="text-gray-400 text-sm font-medium">Salaries Paid</p>
            <p class="text-white text-3xl font-bold mt-2 tracking-tight">$@Model.SalariesToPay.ToString("")</p>
            <div class="mt-4 flex items-center gap-2">
                <span class="bg-white/5 text-gray-400 text-xs px-2 py-1 rounded font-medium border border-white/10">Fixed per month</span>
            </div>
        </div>
        <!-- Projected -->
        <div class="bg-surface-dark border border-white/5 rounded-xl p-6 hover:border-primary/20 transition-all">
            <p class="text-gray-400 text-sm font-medium">Net Revenue (Est.)</p>
            <p class="text-primary text-3xl font-bold mt-2 tracking-tight">$@Model.ExpectedRevenue.ToString("")</p>
            <div class="mt-4 flex items-center gap-2">
                <span class="bg-primary/10 text-primary text-xs px-2 py-1 rounded font-bold border border-primary/20">Year to Date</span>
            </div>
        </div>
    </div>
    <!-- Charts & Activity Split -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Chart Section -->
        <div class="lg:col-span-2 bg-surface-dark border border-white/5 rounded-xl p-6 flex flex-col h-full min-h-[400px] shadow-lg shadow-black/20">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-white text-lg font-bold">Monthly Bookings Trend</h3>
                <select id="yearSelect" class="bg-[#0c0b08] border border-white/10 text-white text-sm rounded-lg px-3 py-1 focus:outline-none focus:border-primary [&>option]:bg-[#0c0b08] [&>option]:text-white">
                    @foreach (var year in Model.AvailableYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <!-- Canvas for Chart.js -->
            <div class="relative w-full h-full min-h-[300px]">
                <canvas id="bookingChart"></canvas>
            </div>
        </div>
        <!-- Recent Activity Feed -->
        <div class="lg:col-span-1 bg-surface-dark border border-white/5 rounded-xl p-6 flex flex-col shadow-lg shadow-black/20">
            <h3 class="text-white text-lg font-bold mb-6">Recent Activity</h3>
            <div class="flex flex-col gap-6 overflow-y-auto max-h-[400px] pr-2 custom-scrollbar">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    @foreach (var item in Model.RecentActivities)
                    {
                        <div class="flex gap-4 group">
                            <div class="relative">
                                <div class="size-10 rounded-full bg-surface-darker border border-white/10 flex items-center justify-center @item.IconColorClass group-hover:scale-110 transition-transform shadow-md">
                                    <span class="material-symbols-outlined text-[20px]">@item.Icon</span>
                                </div>
                                <!-- Vertical Line -->
                                <div class="absolute top-10 left-1/2 -translate-x-1/2 w-px h-full bg-white/5"></div>
                            </div>
                            <div class="flex flex-col pb-2">
                                <p class="text-white text-sm font-semibold group-hover:text-primary transition-colors">@item.Title</p>
                                <p class="text-gray-500 text-xs mt-0.5">@item.Description</p>
                                <p class="text-gray-600 text-[10px] font-bold mt-1 uppercase">@item.TimeAgo</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-gray-500 text-sm text-center">No recent activity.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart Script -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const monthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBookings));
        const ctx = document.getElementById('bookingChart');
        if (ctx) {
            const chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
                    datasets: [{
                        label: 'Bookings',
                        data: monthData,
                        borderColor: '#d4af35', // Primary Gold
                        backgroundColor: (context) => {
                            const ctx = context.chart.ctx;
                            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
                            gradient.addColorStop(0, 'rgba(212,175,53,0.3)');
                            gradient.addColorStop(1, 'rgba(212,175,53,0.0)');
                            return gradient;
                        },
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#d4af35',
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)', // Standardized grid color
                                borderDash: [5, 5]
                            },
                            ticks: { color: '#6b7280' } // Standardized text color
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280', font: {size: 10, weight: '500'} }
                        }
                    }
                }
            });

            document.getElementById('yearSelect').addEventListener('change', async function() {
                const year = this.value;
                try {
                    const response = await fetch(`/api/Dashboard/GetChartData?year=${year}`);
                    if (response.ok) {
                        const newData = await response.json();
                        chart.data.datasets[0].data = newData;
                        chart.update();
                    } else {
                        console.error('Failed to fetch chart data');
                    }
                } catch (error) {
                    console.error('Error fetching chart data:', error);
                }
            });
        }
    </script>
}
