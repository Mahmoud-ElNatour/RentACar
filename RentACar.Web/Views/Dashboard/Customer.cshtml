@model RentACar.Application.DTOs.CustomerDashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Dashboard";
}

<div class="p-6 lg:p-10 max-w-7xl mx-auto flex flex-col gap-8 pb-20">
    <!-- Welcome Section -->
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between border-b border-white/5 pb-8">
        <div>
            <h2 class="text-3xl font-bold text-white tracking-tight">Dashboard Overview</h2>
             <p class="text-gray-400 mt-1">Good evening, <span class="text-gold font-bold">@Model.CustomerName.Split(' ')[0]</span>. Here's your fleet overview.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="/Browse" class="flex items-center gap-2 rounded-lg bg-gold px-5 py-2.5 text-sm font-bold text-black shadow-lg shadow-gold/20 hover:bg-white hover:scale-105 transition-all">
                <span class="material-symbols-outlined text-[20px]">add</span>
                Book a Car
            </a>
            <a href="/Identity/Account/Manage" class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-gray-300 hover:bg-white/10 hover:text-white transition-colors">
                <span class="material-symbols-outlined text-[20px]">person</span>
                Profile
            </a>
            <a href="/Support" class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-gray-300 hover:bg-white/10 hover:text-white transition-colors">
                <span class="material-symbols-outlined text-[20px]">headset_mic</span>
                Support
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface-dark p-5 group hover:border-gold/30 transition-colors">
            <div class="relative z-10">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Total Bookings</p>
                <div class="mt-2 flex items-baseline gap-2">
                    <h3 class="text-3xl font-black text-white">@Model.TotalBookings</h3>
                </div>
            </div>
            <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-white/5 group-hover:text-white/10 transition-colors">directions_car</span>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface-dark p-5 group hover:border-gold/30 transition-colors">
            <div class="relative z-10">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Upcoming</p>
                <div class="mt-2 flex items-baseline gap-2">
                    <h3 class="text-3xl font-black text-white">@Model.UpcomingBookings</h3>
                    @if (Model.UpcomingBookings > 0)
                    {
                        <span class="text-xs font-bold text-gold bg-gold/10 px-1.5 py-0.5 rounded">Active</span>
                    }
                </div>
            </div>
            <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-white/5 group-hover:text-white/10 transition-colors">calendar_clock</span>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface-dark p-5 group hover:border-gold/30 transition-colors">
            <div class="relative z-10">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Total Spent</p>
                <div class="mt-2 flex items-baseline gap-2">
                    <h3 class="text-3xl font-black text-white">$@Model.TotalSpent.ToString("")</h3>
                </div>
            </div>
            <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-white/5 group-hover:text-white/10 transition-colors">payments</span>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface-dark p-5 group hover:border-gold/30 transition-colors">
            <div class="relative z-10">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Total Savings</p>
                <div class="mt-2 flex items-baseline gap-2">
                    <h3 class="text-3xl font-black text-gold">$@Model.DiscountSavings.ToString("")</h3>
                    <span class="text-xs font-bold text-gray-500">Lifetime</span>
                </div>
            </div>
            <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-white/5 group-hover:text-white/10 transition-colors">savings</span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <div class="lg:col-span-3 space-y-6">
            <!-- Upcoming Booking / Hero -->
            @if (Model.NextBooking != null)
            {
                <div class="relative overflow-hidden rounded-2xl border border-gold/50 bg-surface-dark shadow-[0_0_30px_rgba(212,175,53,0.1)] group">
                    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent z-10"></div>
                    <div class="absolute right-0 top-0 bottom-0 w-2/3 bg-cover bg-center opacity-40 group-hover:opacity-50 transition-opacity duration-700" style='background-image: url("@Model.NextBooking.CarImage.Replace("data:image/png;base64,", "data:image/png;base64,")");'></div>
                    <div class="relative z-20 p-6 sm:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
                        <div class="space-y-4 max-w-md">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center gap-1 rounded-full bg-gold px-3 py-1 text-xs font-extrabold uppercase text-black">
                                    <span class="w-1.5 h-1.5 rounded-full bg-black animate-pulse"></span>
                                    Upcoming
                                </span>
                                <span class="text-xs font-mono text-gray-400">Ref: #@Model.NextBooking.BookingId</span>
                            </div>
                            <div>
                                <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight">@Model.NextBooking.CarName</h3>
                                <p class="text-sm text-gray-400 mt-1">@Model.NextBooking.CarType • @Model.NextBooking.CarYear</p>
                            </div>
                            <div class="flex flex-wrap gap-4 pt-2">
                                <div class="pr-4 border-r border-white/10">
                                    <p class="text-xs text-gray-500 font-bold uppercase mb-1">Pick-up</p>
                                    <p class="text-sm font-bold text-white">@(Model.NextBooking.PickupDate?.ToString("MMM dd, hh:mm tt"))</p>
                                    <p class="text-xs text-gray-400">@Model.NextBooking.PickupLocation</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-500 font-bold uppercase mb-1">Return</p>
                                    <p class="text-sm font-bold text-white">@(Model.NextBooking.ReturnDate?.ToString("MMM dd, hh:mm tt"))</p>
                                    <p class="text-xs text-gray-400">@Model.NextBooking.ReturnLocation</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex gap-3 w-full sm:w-auto">
                            <a href="/Bookings/MyBookings" class="flex-1 sm:flex-none whitespace-nowrap rounded-lg bg-gold px-6 py-2.5 text-sm font-bold text-black hover:bg-white transition-colors shadow-lg shadow-gold/20 text-center">
                                Manage Booking
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                 <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface-dark p-8 text-center flex flex-col items-center justify-center gap-4">
                    <div class="p-4 rounded-full bg-white/5 text-gray-500">
                        <span class="material-symbols-outlined text-4xl">directions_car</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white">No Upcoming Trips</h3>
                        <p class="text-gray-400">You don't have any bookings scheduled. Time for a road trip?</p>
                    </div>
                    <a href="/Browse" class="px-6 py-2.5 rounded-lg bg-gold text-black font-bold hover:bg-white transition-colors">Book a Car Now</a>
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Chart -->
                <div class="rounded-2xl border border-white/10 bg-surface-dark p-6 h-full flex flex-col">
                    <div class="mb-6 flex items-center justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-white">Booking Trends</h3>
                            <p class="text-xs text-gray-500">Spending over last year</p>
                        </div>
                    </div>
                    <div class="relative h-48 w-full mt-auto">
                         <canvas id="customerChart"></canvas>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="rounded-2xl border border-white/10 bg-surface-dark p-6 h-full">
                    <div class="mb-4 flex items-center justify-between">
                        <h3 class="text-lg font-bold text-white">Recent Activity</h3>
                        <a class="text-xs font-bold text-gold hover:text-white flex items-center gap-1" href="/Bookings/MyBookings">
                            View All <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                        </a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <tbody class="text-sm">
                                @foreach (var item in Model.RecentBookings.Take(3))
                                {
                                    <tr class="group border-b border-white/5 transition-colors hover:bg-white/5 last:border-0">
                                        <td class="py-3 pl-0">
                                            <div class="flex items-center gap-3">
                                                <div class="h-10 w-10 rounded-lg bg-white/5 bg-cover bg-center" style='background-image: url("@item.CarImage");'></div>
                                                <div>
                                                    <div class="font-bold text-white group-hover:text-gold transition-colors text-xs sm:text-sm">@item.CarName</div>
                                                    <div class="text-[10px] text-gray-500">@item.DateRange</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3 text-right">
                                            <span class="inline-flex items-center gap-1 rounded bg-white/5 px-2 py-1 text-[10px] font-medium border border-white/10 @item.StatusColorClass">
                                                @item.Status
                                            </span>
                                        </td>
                                        <td class="py-3 text-right font-bold text-white text-xs sm:text-sm">$@item.TotalPrice.ToString("")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-1 space-y-6">
            <!-- Quick Book Widget -->
            <div class="rounded-2xl border border-gold/30 bg-surface-dark p-0 overflow-hidden relative group shadow-glow">
                <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                    <span class="material-symbols-outlined text-[120px] text-gold -mr-8 -mt-8 rotate-12">bolt</span>
                </div>
                <div class="p-5 border-b border-white/10 relative z-10">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="p-1.5 rounded-md bg-gold text-black">
                            <span class="material-symbols-outlined text-sm font-bold block">flash_on</span>
                        </div>
                        <h3 class="text-base font-bold text-white">Quick Booking</h3>
                    </div>
                    <p class="text-xs text-gray-400">Instantly find a ride in your favorite category.</p>
                </div>
                <div class="p-5 relative z-10">
                    <form action="/Browse" method="get" class="space-y-4">
                        <div class="space-y-1">
                            <label class="text-[10px] uppercase font-bold text-gray-500">Pick-up Date</label>
                            <div class="relative">
                                <input class="w-full bg-black/50 border border-white/10 rounded-lg py-2 pl-3 pr-2 text-sm text-white focus:border-gold focus:ring-0" type="date" name="startDate" />
                            </div>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[10px] uppercase font-bold text-gray-500">Category</label>
                            <select name="category" class="w-full bg-black/50 border border-white/10 rounded-lg py-2 pl-3 pr-8 text-sm text-white focus:border-gold focus:ring-0">
                                <option value="">Any Category</option>
                                @foreach (var cat in Model.CarCategories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <button class="w-full rounded-lg bg-white py-2.5 text-sm font-bold text-black hover:bg-gray-200 transition-colors shadow-lg mt-2" type="submit">
                            Find Available Cars
                        </button>
                        <div class="pt-2 border-t border-white/10 flex justify-between items-center">
                            <span class="text-[10px] text-gray-500">Need help?</span>
                            <a class="text-[10px] font-bold text-gold hover:underline" href="/Support">Chat with Support</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Suggested Cars -->
            <div class="rounded-2xl border border-white/10 bg-surface-dark p-5 sticky top-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-base font-bold text-white">Suggested for You</h3>
                    <span class="material-symbols-outlined text-gold text-sm">auto_awesome</span>
                </div>
                <p class="text-xs text-gray-500 mb-4">Top choices based on our fleet.</p>
                <div class="space-y-3">
                    @foreach (var car in Model.SuggestedCars)
                    {
                        <a href="/Booking/add?carId=@car.CarId" class="flex gap-3 rounded-xl bg-black/50 p-3 hover:bg-white/5 border border-white/5 hover:border-gold/30 transition-all cursor-pointer group">
                            <div class="h-16 w-20 rounded-lg bg-gray-700 bg-cover bg-center shrink-0" style='background-image: url("@car.ImageUrl");'></div>
                            <div class="flex flex-col justify-center w-full">
                                <div class="flex justify-between items-start">
                                    <h4 class="text-sm font-bold text-white group-hover:text-gold transition-colors">@car.ModelName</h4>
                                    <span class="text-xs font-bold text-gold">$@car.PricePerDay.ToString("")</span>
                                </div>
                                <div class="flex items-center gap-2 mt-1.5">
                                    <span class="px-1.5 py-0.5 rounded bg-white/5 text-[10px] text-gray-400 border border-white/10">@car.Transmission</span>
                                    <span class="px-1.5 py-0.5 rounded bg-white/5 text-[10px] text-gray-400 border border-white/10">@car.FuelType</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
                <a href="/Browse" class="block mt-4 w-full rounded-lg border border-white/10 py-2 text-xs font-bold text-gray-300 hover:bg-white/10 hover:text-white hover:border-gold/30 transition-colors text-center">
                    Browse All Cars
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart Script -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const monthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBookings));
        const ctx = document.getElementById('customerChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'line', 
                data: {
                    labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
                    datasets: [{
                        label: 'Spending',
                        data: monthData,
                        borderColor: '#d4af35',
                        backgroundColor: (context) => {
                            const ctx = context.chart.ctx;
                            const gradient = ctx.createLinearGradient(0, 0, 0, 200);
                            gradient.addColorStop(0, 'rgba(212, 175, 53, 0.2)');
                            gradient.addColorStop(1, 'rgba(212, 175, 53, 0)');
                            return gradient;
                        },
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#050505',
                        pointBorderColor: '#d4af35',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                borderDash: [4, 4] 
                            },
                            ticks: { display: false } 
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280', font: {size: 10, weight: '500'} }
                        }
                    }
                }
            });
        }
    </script>
}
