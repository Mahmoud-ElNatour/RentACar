@model RentACar.Application.DTOs.CustomerDashboardViewModel
@{
    Layout = null; 
}
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Customer Dashboard - RentCarLB</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "gold": {
                            400: "#eecf5b",
                            500: "#d4af35", // Primary Gold
                            600: "#aa8620",
                        },
                        "dark": {
                            950: "#050505", // Main BG
                            900: "#0f0f0f", // Surface
                            850: "#141414", // Lighter Surface
                            800: "#1e1e1e", // Borders/Hover
                            700: "#2a2a2a", // Borders
                        }
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    backgroundImage: {
                        'gradient-gold': 'linear-gradient(135deg, #d4af35 0%, #aa8620 100%)',
                        'gradient-dark': 'linear-gradient(to bottom, #0f0f0f, #050505)',
                    }
                },
            },
        }
    </script>
    <style type="text/tailwindcss">
        @@layer utilities {
            .text-gold { @@apply text-gold-500; }
            .bg-gold { @@apply bg-gold-500; }
            .border-gold { @@apply border-gold-500; }
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #050505;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2a2a;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #d4af35;
        }
    </style>
</head>
<body class="bg-dark-950 font-display text-gray-200 antialiased selection:bg-gold-500 selection:text-black">
    <div class="flex h-screen w-full overflow-hidden">
        <main class="flex h-full flex-1 flex-col overflow-y-auto bg-dark-950 relative">
            <!-- Header -->
            <div class="sticky top-0 z-50 flex items-center justify-between border-b border-dark-800 bg-dark-900/80 px-6 py-4 backdrop-blur-md">
                <div class="flex items-center gap-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-gold text-black shadow-lg shadow-gold-500/20">
                        <span class="material-symbols-outlined font-bold text-xl">directions_car</span>
                    </div>
                    <a href="/" class="text-xl font-extrabold text-white tracking-tight hover:opacity-80 transition-opacity">RentCar<span class="text-gold-500">LB</span></a>
                </div>
                <div class="flex items-center gap-6">
                    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
                        <a class="text-white border-b-2 border-gold-500 pb-0.5" href="/Dashboard">Dashboard</a>
                        <a class="text-gray-400 hover:text-white transition-colors" href="/Bookings/MyBookings">My Bookings</a>
                        <a class="text-gray-400 hover:text-white transition-colors" href="/Browse">Browase Cars</a>
                        <a class="text-gray-400 hover:text-white transition-colors" href="/Identity/Account/Manage/Payments">Wallet</a>
                    </nav>
                    <div class="flex items-center gap-3 pl-6 border-l border-dark-800">
                        <div class="hidden sm:flex flex-col text-right">
                            <span class="text-sm font-bold text-white">@Model.CustomerName</span>
                            <span class="text-[10px] font-medium text-gold-500 uppercase tracking-wider">@(Model.IsGoldMember ? "Gold Member" : "Member")</span>
                        </div>
                        <div class="h-9 w-9 rounded-full bg-cover bg-center ring-2 ring-gold-500/30" style='background-image: url("@Model.CustomerImageUrl");'></div>
                    </div>
                </div>
            </div>

            <div class="mx-auto w-full max-w-[1400px] p-6 lg:p-10 space-y-8">
                <!-- Welcome Section -->
                <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <h2 class="text-3xl font-bold text-white">Dashboard</h2>
                        <p class="text-gray-400 mt-1">Good evening, @Model.CustomerName.Split(' ')[0]. Here's your fleet overview.</p>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <a href="/Browse" class="flex items-center gap-2 rounded-lg bg-gold-500 px-5 py-2.5 text-sm font-bold text-black shadow-lg shadow-gold-500/20 hover:bg-gold-400 transition-all transform hover:-translate-y-0.5">
                            <span class="material-symbols-outlined text-[20px]">add</span>
                            Book a Car
                        </a>
                        <a href="/Identity/Account/Manage" class="flex items-center gap-2 rounded-lg border border-dark-700 bg-dark-900 px-4 py-2.5 text-sm font-medium text-gray-300 hover:bg-dark-800 hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-[20px]">person</span>
                            Profile
                        </a>
                        <a href="/Identity/Account/Manage/Payments" class="flex items-center gap-2 rounded-lg border border-dark-700 bg-dark-900 px-4 py-2.5 text-sm font-medium text-gray-300 hover:bg-dark-800 hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-[20px]">credit_card</span>
                            Cards
                        </a>
                        <a href="mailto:support@rentacarlb.com" class="flex items-center gap-2 rounded-lg border border-dark-700 bg-dark-900 px-4 py-2.5 text-sm font-medium text-gray-300 hover:bg-dark-800 hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-[20px]">headset_mic</span>
                            Support
                        </a>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="relative overflow-hidden rounded-2xl border border-dark-800 bg-dark-900 p-5 group hover:border-gold-500/30 transition-colors">
                        <div class="relative z-10">
                            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Total Bookings</p>
                            <div class="mt-2 flex items-baseline gap-2">
                                <h3 class="text-3xl font-black text-white">@Model.TotalBookings</h3>
                                @* <span class="text-xs font-bold text-green-500 bg-green-500/10 px-1.5 py-0.5 rounded">+3 this month</span> *@
                            </div>
                        </div>
                        <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-dark-800 group-hover:text-dark-700 transition-colors">directions_car</span>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl border border-dark-800 bg-dark-900 p-5 group hover:border-gold-500/30 transition-colors">
                        <div class="relative z-10">
                            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Upcoming</p>
                            <div class="mt-2 flex items-baseline gap-2">
                                <h3 class="text-3xl font-black text-white">@Model.UpcomingBookings</h3>
                                @if (Model.UpcomingBookings > 0)
                                {
                                    <span class="text-xs font-bold text-gold-500 bg-gold-500/10 px-1.5 py-0.5 rounded">Active</span>
                                }
                            </div>
                        </div>
                        <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-dark-800 group-hover:text-dark-700 transition-colors">calendar_clock</span>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl border border-dark-800 bg-dark-900 p-5 group hover:border-gold-500/30 transition-colors">
                        <div class="relative z-10">
                            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Total Spent</p>
                            <div class="mt-2 flex items-baseline gap-2">
                                <h3 class="text-3xl font-black text-white">@Model.TotalSpent.ToString("C0")</h3>
                            </div>
                        </div>
                        <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-dark-800 group-hover:text-dark-700 transition-colors">payments</span>
                    </div>
                    <div class="relative overflow-hidden rounded-2xl border border-dark-800 bg-dark-900 p-5 group hover:border-gold-500/30 transition-colors">
                        <div class="relative z-10">
                            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">Total Savings</p>
                            <div class="mt-2 flex items-baseline gap-2">
                                <h3 class="text-3xl font-black text-gold-500">@Model.DiscountSavings.ToString("C0")</h3>
                                <span class="text-xs font-bold text-gray-500">Lifetime</span>
                            </div>
                        </div>
                        <span class="material-symbols-outlined absolute -right-2 -top-2 text-6xl text-dark-800 group-hover:text-dark-700 transition-colors">savings</span>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                    <div class="lg:col-span-3 space-y-6">
                        <!-- Upcoming Booking / Hero -->
                        @if (Model.NextBooking != null)
                        {
                            <div class="relative overflow-hidden rounded-2xl border border-gold-500/50 bg-dark-900 shadow-[0_0_30px_rgba(212,175,53,0.1)] group">
                                <div class="absolute inset-0 bg-gradient-to-r from-dark-900 via-dark-900/90 to-transparent z-10"></div>
                                <div class="absolute right-0 top-0 bottom-0 w-2/3 bg-cover bg-center opacity-40 group-hover:opacity-50 transition-opacity duration-700" style='background-image: url("@Model.NextBooking.CarImage.Replace("data:image/png;base64,", "data:image/png;base64,")");'></div>
                                <div class="relative z-20 p-6 sm:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
                                    <div class="space-y-4 max-w-md">
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex items-center gap-1 rounded-full bg-gold-500 px-3 py-1 text-xs font-extrabold uppercase text-black">
                                                <span class="w-1.5 h-1.5 rounded-full bg-black animate-pulse"></span>
                                                Upcoming
                                            </span>
                                            <span class="text-xs font-mono text-gray-400">Ref: #@Model.NextBooking.BookingId</span>
                                        </div>
                                        <div>
                                            <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight">@Model.NextBooking.CarName</h3>
                                            <p class="text-sm text-gray-400 mt-1">@Model.NextBooking.CarType • @Model.NextBooking.CarYear</p>
                                        </div>
                                        <div class="flex flex-wrap gap-4 pt-2">
                                            <div class="pr-4 border-r border-dark-700">
                                                <p class="text-xs text-gray-500 font-bold uppercase mb-1">Pick-up</p>
                                                <p class="text-sm font-bold text-white">@(Model.NextBooking.PickupDate?.ToString("MMM dd, hh:mm tt"))</p>
                                                <p class="text-xs text-gray-400">@Model.NextBooking.PickupLocation</p>
                                            </div>
                                            <div>
                                                <p class="text-xs text-gray-500 font-bold uppercase mb-1">Return</p>
                                                <p class="text-sm font-bold text-white">@(Model.NextBooking.ReturnDate?.ToString("MMM dd, hh:mm tt"))</p>
                                                <p class="text-xs text-gray-400">@Model.NextBooking.ReturnLocation</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex gap-3 w-full sm:w-auto">
                                        <a href="/Bookings/MyBookings" class="flex-1 sm:flex-none whitespace-nowrap rounded-lg bg-gold-500 px-6 py-2.5 text-sm font-bold text-black hover:bg-gold-400 transition-colors shadow-lg shadow-gold-500/20 text-center">
                                            Manage Booking
                                        </a>
                                        <button class="rounded-lg border border-dark-700 bg-black/50 px-3 text-gray-300 hover:text-white hover:border-gray-500 hover:bg-black/70 transition-colors backdrop-blur-sm">
                                            <span class="material-symbols-outlined text-[20px]">visibility</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                             <div class="relative overflow-hidden rounded-2xl border border-dark-800 bg-dark-900 p-8 text-center flex flex-col items-center justify-center gap-4">
                                <div class="p-4 rounded-full bg-dark-800 text-gray-500">
                                    <span class="material-symbols-outlined text-4xl">directions_car</span>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-white">No Upcoming Trips</h3>
                                    <p class="text-gray-400">You don't have any bookings scheduled. Time for a road trip?</p>
                                </div>
                                <a href="/Browse" class="px-6 py-2.5 rounded-lg bg-gold-500 text-black font-bold hover:bg-gold-400 transition-colors">Book a Car Now</a>
                            </div>
                        }

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Chart -->
                            <div class="rounded-2xl border border-dark-800 bg-dark-900 p-6 h-full flex flex-col">
                                <div class="mb-6 flex items-center justify-between">
                                    <div>
                                        <h3 class="text-lg font-bold text-white">Booking Trends</h3>
                                        <p class="text-xs text-gray-500">Spending over last year</p>
                                    </div>
                                </div>
                                <div class="relative h-48 w-full mt-auto">
                                     <canvas id="customerChart"></canvas>
                                </div>
                            </div>

                            <!-- Recent Activity -->
                            <div class="rounded-2xl border border-dark-800 bg-dark-900 p-6 h-full">
                                <div class="mb-4 flex items-center justify-between">
                                    <h3 class="text-lg font-bold text-white">Recent Activity</h3>
                                    <a class="text-xs font-bold text-gold-500 hover:text-gold-400 flex items-center gap-1" href="/Bookings/MyBookings">
                                        View All <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                                    </a>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left">
                                        <tbody class="text-sm">
                                            @foreach (var item in Model.RecentBookings.Take(3))
                                            {
                                                <tr class="group border-b border-dark-800 transition-colors hover:bg-white/5 last:border-0">
                                                    <td class="py-3 pl-0">
                                                        <div class="flex items-center gap-3">
                                                            <div class="h-10 w-10 rounded-lg bg-dark-800 bg-cover bg-center" style='background-image: url("@item.CarImage");'></div>
                                                            <div>
                                                                <div class="font-bold text-white group-hover:text-gold-500 transition-colors text-xs sm:text-sm">@item.CarName</div>
                                                                <div class="text-[10px] text-gray-500">@item.DateRange</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 text-right">
                                                        <span class="inline-flex items-center gap-1 rounded bg-dark-800 px-2 py-1 text-[10px] font-medium border border-dark-700 @item.StatusColorClass">
                                                            @item.Status
                                                        </span>
                                                    </td>
                                                    <td class="py-3 text-right font-bold text-white text-xs sm:text-sm">@item.TotalPrice.ToString("C0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-1 space-y-6">
                        <!-- Quick Book Widget -->
                        <div class="rounded-2xl border border-dark-800 bg-dark-900 p-0 overflow-hidden relative group">
                            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                                <span class="material-symbols-outlined text-[120px] text-gold-500 -mr-8 -mt-8 rotate-12">bolt</span>
                            </div>
                            <div class="p-5 border-b border-dark-800 relative z-10">
                                <div class="flex items-center gap-2 mb-2">
                                    <div class="p-1.5 rounded-md bg-gold-500 text-black">
                                        <span class="material-symbols-outlined text-sm font-bold block">flash_on</span>
                                    </div>
                                    <h3 class="text-base font-bold text-white">Quick Booking</h3>
                                </div>
                                <p class="text-xs text-gray-400">Instantly find a ride in your favorite category.</p>
                            </div>
                            <div class="p-5 relative z-10">
                                <form action="/Browse" method="get" class="space-y-4">
                                    <div class="space-y-1">
                                        <label class="text-[10px] uppercase font-bold text-gray-500">Pick-up Date</label>
                                        <div class="relative">
                                            <input class="w-full bg-dark-950 border border-dark-700 rounded-lg py-2 pl-3 pr-2 text-sm text-white focus:border-gold-500 focus:ring-0" type="date" name="startDate" />
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                        <label class="text-[10px] uppercase font-bold text-gray-500">Category</label>
                                        <select name="category" class="w-full bg-dark-950 border border-dark-700 rounded-lg py-2 pl-3 pr-8 text-sm text-white focus:border-gold-500 focus:ring-0">
                                            <option value="">Any Category</option>
                                            @foreach (var cat in Model.CarCategories)
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                    </div>
                                    <button class="w-full rounded-lg bg-white py-2.5 text-sm font-bold text-black hover:bg-gray-200 transition-colors shadow-lg mt-2" type="submit">
                                        Find Available Cars
                                    </button>
                                    <div class="pt-2 border-t border-dark-800 flex justify-between items-center">
                                        <span class="text-[10px] text-gray-500">Need help?</span>
                                        <a class="text-[10px] font-bold text-gold-500 hover:underline" href="#">Chat with Support</a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Suggested Cars -->
                        <div class="rounded-2xl border border-dark-800 bg-dark-900 p-5 sticky top-6">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-base font-bold text-white">Suggested for You</h3>
                                <span class="material-symbols-outlined text-gold-500 text-sm">auto_awesome</span>
                            </div>
                            <p class="text-xs text-gray-500 mb-4">Top choices based on our fleet.</p>
                            <div class="space-y-3">
                                @foreach (var car in Model.SuggestedCars)
                                {
                                    <a href="/Browse/Details/@car.CarId" class="flex gap-3 rounded-xl bg-dark-950 p-3 hover:bg-dark-800 border border-dark-800 hover:border-gold-500/30 transition-all cursor-pointer group">
                                        <div class="h-16 w-20 rounded-lg bg-gray-700 bg-cover bg-center shrink-0" style='background-image: url("@car.ImageUrl");'></div>
                                        <div class="flex flex-col justify-center w-full">
                                            <div class="flex justify-between items-start">
                                                <h4 class="text-sm font-bold text-white group-hover:text-gold-500 transition-colors">@car.ModelName</h4>
                                                <span class="text-xs font-bold text-gold-500">@car.PricePerDay.ToString("C0")</span>
                                            </div>
                                            <div class="flex items-center gap-2 mt-1.5">
                                                <span class="px-1.5 py-0.5 rounded bg-dark-800 text-[10px] text-gray-400 border border-dark-700">@car.Transmission</span>
                                                <span class="px-1.5 py-0.5 rounded bg-dark-800 text-[10px] text-gray-400 border border-dark-700">@car.FuelType</span>
                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>
                            <a href="/Browse" class="block mt-4 w-full rounded-lg border border-dark-700 py-2 text-xs font-bold text-gray-300 hover:bg-dark-800 hover:text-white hover:border-gold-500/30 transition-colors text-center">
                                Browse All Cars
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    
    <!-- Chart Script -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const monthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBookings));
        const ctx = document.getElementById('customerChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'line', // Line chart to match template somewhat (curved line) or bar
                data: {
                    labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
                    datasets: [{
                        label: 'Spending',
                        data: monthData, // Ideally value, but using counts for now as in controller
                        borderColor: '#d4af35',
                        backgroundColor: (context) => {
                            const ctx = context.chart.ctx;
                            const gradient = ctx.createLinearGradient(0, 0, 0, 200);
                            gradient.addColorStop(0, 'rgba(212, 175, 53, 0.2)');
                            gradient.addColorStop(1, 'rgba(212, 175, 53, 0)');
                            return gradient;
                        },
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#050505',
                        pointBorderColor: '#d4af35',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#1e1e1e',
                                borderDash: [4, 4] // Dashed grid
                            },
                            ticks: { display: false } // Hide Y labels for cleaner look like template
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280', font: {size: 10, weight: '500'} }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>
