@model RentACar.Application.DTOs.EmployeeDashboardViewModel
@{
    Layout = null; // Using global sidebar integration manually as per design request, but we will reuse the global layout styles where possible
}
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Employee Dashboard Activity</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&amp;display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#d4af35", // Prestige Gold
                        "primary-hover": "#c29f2b",
                        "background-light": "#f8f8f5",
                        "background-dark": "#0c0b08",
                        "surface-dark": "#1d1b14",
                        "surface-darker": "#14120b"
                    },
                    fontFamily: {
                        display: "Manrope"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    }
                }
            }
        };
    </script>
    <!-- Admin/Global Styles -->
    <link rel="stylesheet" href="~/css/AdminDashboard.css" />
    <style>
        /* Bootstrap Modal Compatibility Shim for Tailwind Page */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1055;
            display: none;
            width: 100%;
            height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
            outline: 0;
            background-color: rgba(0, 0, 0, 0.5);
        }
        .modal-dialog {
            position: relative;
            width: auto;
            margin: 1.75rem auto;
            pointer-events: none;
            max-width: 500px;
        }
        @@media (min-width: 576px) { .modal-dialog { max-width: 500px; margin: 1.75rem auto; } }
        @@media (min-width: 992px) { .modal-dialog.modal-lg { max-width: 800px; } }
        
        .modal-content {
            position: relative;
            display: flex;
            flex-direction: column;
            width: 100%;
            pointer-events: auto;
            background-color: #1d1b14; /* Matches surface-dark */
            background-clip: padding-box;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            outline: 0;
            color: white;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        }
        .modal-header {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .modal-title { margin: 0; font-size: 1.25rem; font-weight: 600; }
        .modal-body { position: relative; flex: 1 1 auto; padding: 1rem; }
        .modal-footer {
            display: flex;
            flex-wrap: wrap;
            flex-shrink: 0;
            align-items: center;
            justify-content: flex-end;
            padding: 0.75rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            gap: 0.5rem;
        }
        .btn-close {
            box-sizing: content-box;
            width: 1em;
            height: 1em;
            padding: 0.25em 0.25em;
            color: #fff;
            background: transparent url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23fff'%3e%3cpath d='M.293.293a1 1 0 0 1 1.414 0L8 6.586 14.293.293a1 1 0 1 1 1.414 1.414L9.414 8l6.293 6.293a1 1 0 0 1-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 0 1-1.414-1.414L6.586 8 .293 1.707a1 1 0 0 1 0-1.414z'/%3e%3c/svg%3e") center/1em auto no-repeat;
            border: 0;
            border-radius: 0.25rem;
            opacity: 0.5;
            cursor: pointer;
        }
        .btn-close:hover { opacity: 0.75; }

        /* Bootstrap Grid Shim for Modal Internals */
        .row { display: flex; flex-wrap: wrap; margin-top: 0; margin-right: -0.75rem; margin-left: -0.75rem; }
        .g-3 { --bs-gutter-y: 1rem; --bs-gutter-x: 1rem; }
        .row > * { box-sizing: border-box; flex-shrink: 0; width: 100%; max-width: 100%; padding-right: 0.75rem; padding-left: 0.75rem; margin-top: var(--bs-gutter-y); }
        .col-md-6 { flex: 0 0 auto; width: 50%; }
        .text-center { text-align: center; }
        
        /* Modal Content Styling */
        .form-label { display: block; margin-bottom: 0.5rem; color: #9ca3af; }
        .form-control {
            display: block;
            width: 100%;
            padding: 0.375rem 0.75rem;
            font-size: 1rem;
            font-weight: 400;
            line-height: 1.5;
            color: #fff;
            background-color: #14120b;
            background-clip: padding-box;
            border: 1px solid rgba(255, 255, 255, 0.1);
            appearance: none;
            border-radius: 0.25rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        .form-control:focus { border-color: #d4af35; outline: 0; }
        
        .img-fluid { max-width: 100%; height: auto; }
        
        /* DL/DT/DD Shim */
        dl.row { display: flex; flex-wrap: wrap; }
        .col-sm-5 { flex: 0 0 auto; width: 41.666667%; font-weight: 600; color: #9ca3af; }
        .col-sm-7 { flex: 0 0 auto; width: 58.333333%; color: #fff; }
        
        /* Button Shim */
        .btn {
            display: inline-block;
            font-weight: 500;
            line-height: 1.5;
            color: #fff;
            text-align: center;
            text-decoration: none;
            vertical-align: middle;
            cursor: pointer;
            user-select: none;
            background-color: transparent;
            border: 1px solid transparent;
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
            border-radius: 0.25rem;
            transition: all 0.2s;
        }
        .btn-secondary { color: #fff; background-color: #332f22; border-color: #332f22; }
        .btn-secondary:hover { background-color: #4a4533; border-color: #4a4533; }
        .btn-primary { color: #14120b; background-color: #d4af35; border-color: #d4af35; font-weight: 700; }
        .btn-primary:hover { background-color: #c29f2b; border-color: #c29f2b; }
        
        /* Text Utilities */
        .text-secondary { color: #9ca3af !important; }
        .text-uppercase { text-transform: uppercase !important; }
        .mb-0 { margin-bottom: 0 !important; }
        .mt-3 { margin-top: 1rem !important; }

        /* Scoped Sidebar Visibility for Employee Dashboard */
        @@media (min-width: 992px) {
            .main-sidebar {
                transform: translateX(0) !important;
            }
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-white font-display overflow-hidden antialiased">
    <div class="flex h-screen w-full">
        <!-- Global Sidebar Integration -->
        <partial name="_Sidebar" />

        <main class="flex-1 flex flex-col h-full overflow-hidden relative lg:ml-[280px]">
            <!-- Header -->
            <header class="h-16 flex items-center justify-between px-6 lg:px-10 py-3 bg-surface-darker/80 backdrop-blur-md border-b border-white/5 shrink-0 z-20">
                <div class="flex items-center gap-4 text-white">
                    <button class="md:hidden text-white" onclick="toggleSidebar()">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                    <h2 class="text-lg lg:text-xl font-bold tracking-tight">Overview</h2>
                </div>
                <div class="flex items-center gap-6">
                    <div class="hidden md:flex items-center relative group">
                        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">search</span>
                        </div>
                        <input class="bg-surface-dark border border-white/10 rounded-full py-2 pl-10 pr-4 text-sm text-white focus:outline-none focus:border-primary/50 w-64 transition-all focus:w-72 placeholder-gray-500" placeholder="Search bookings, cars..." type="text" />
                    </div>
                    <div class="flex gap-2">
                        <button class="relative flex items-center justify-center size-10 rounded-full hover:bg-white/5 text-gray-300 hover:text-primary transition-colors">
                            <span class="material-symbols-outlined">notifications</span>
                            @if (Model.WaitingBookings > 0)
                            {
                                <span class="absolute top-2 right-2 size-2 bg-red-500 rounded-full border border-surface-darker"></span>
                            }
                        </button>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <div class="flex-1 overflow-y-auto p-6 lg:p-10 pb-20 scroll-smooth">
                <div class="max-w-7xl mx-auto flex flex-col gap-8">
                    <!-- Stats Grid -->
                    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
                        <!-- Processed Bookings -->
                        <div class="flex flex-col gap-3 rounded-xl p-5 bg-surface-dark border border-white/5 hover:border-primary/20 transition-all shadow-lg shadow-black/20">
                            <div class="flex items-start justify-between">
                                <p class="text-gray-400 text-sm font-medium">My Processed Bookings</p>
                                <div class="p-1.5 rounded-md bg-primary/10 text-primary">
                                    <span class="material-symbols-outlined text-lg">check_circle</span>
                                </div>
                            </div>
                            <p class="text-white text-3xl font-bold font-display">@Model.ProcessedBookings</p>
                            <div class="flex items-center gap-1 text-xs text-green-400">
                                <span class="material-symbols-outlined text-sm">trending_up</span>
                                <span>Personal Record</span>
                            </div>
                        </div>

                        <!-- Active Bookings -->
                        <div class="flex flex-col gap-3 rounded-xl p-5 bg-surface-dark border border-white/5 hover:border-primary/20 transition-all shadow-lg shadow-black/20">
                            <div class="flex items-start justify-between">
                                <p class="text-gray-400 text-sm font-medium">Active Bookings</p>
                                <div class="p-1.5 rounded-md bg-blue-500/10 text-blue-400">
                                    <span class="material-symbols-outlined text-lg">directions_car</span>
                                </div>
                            </div>
                            <p class="text-white text-3xl font-bold font-display">@Model.ActiveBookingsSystemWide</p>
                            <div class="flex items-center gap-1 text-xs text-gray-500">
                                <span>System-wide total</span>
                            </div>
                        </div>

                        <!-- Fleet Available -->
                        <div class="flex flex-col gap-3 rounded-xl p-5 bg-surface-dark border border-white/5 hover:border-primary/20 transition-all shadow-lg shadow-black/20">
                            <div class="flex items-start justify-between">
                                <p class="text-gray-400 text-sm font-medium">Fleet Available</p>
                                <div class="p-1.5 rounded-md bg-purple-500/10 text-purple-400">
                                    <span class="material-symbols-outlined text-lg">garage_home</span>
                                </div>
                            </div>
                            @{
                                var availability = Model.TotalCars > 0 ? (int)((double)Model.AvailableCars / Model.TotalCars * 100) : 0;
                            }
                            <p class="text-white text-3xl font-bold font-display">@availability%</p>
                            <div class="w-full bg-white/10 rounded-full h-1.5 mt-1">
                                <div class="bg-primary h-1.5 rounded-full" style="width: @availability%"></div>
                            </div>
                        </div>

                        <!-- Pending Approvals -->
                        <div class="flex flex-col gap-3 rounded-xl p-5 bg-surface-dark border border-white/5 hover:border-primary/30 transition-all shadow-lg shadow-black/20 ring-1 ring-primary/20">
                            <div class="flex items-start justify-between">
                                <p class="text-primary text-sm font-bold">Pending Approvals</p>
                                <div class="p-1.5 rounded-md bg-primary/20 text-primary">
                                    <span class="material-symbols-outlined text-lg">pending_actions</span>
                                </div>
                            </div>
                            <p class="text-white text-3xl font-bold font-display">@Model.WaitingBookings</p>
                            <div class="flex items-center gap-1 text-xs text-primary/80">
                                <span>Requires attention</span>
                            </div>
                        </div>

                        <!-- Unverified Users -->
                        <div class="flex flex-col gap-3 rounded-xl p-5 bg-surface-dark border border-white/5 hover:border-red-400/20 transition-all shadow-lg shadow-black/20">
                            <div class="flex items-start justify-between">
                                <p class="text-gray-400 text-sm font-medium">Unverified Users</p>
                                <div class="p-1.5 rounded-md bg-red-500/10 text-red-400">
                                    <span class="material-symbols-outlined text-lg">person_alert</span>
                                </div>
                            </div>
                            <p class="text-white text-3xl font-bold font-display">@Model.UnverifiedCustomers</p>
                            <div class="flex items-center gap-1 text-xs text-red-400">
                                <span class="material-symbols-outlined text-sm">warning</span>
                                <span>Documents needed</span>
                            </div>
                        </div>
                    </section>

                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
                        <!-- Chart Section (Replaced bespoke grid with Chart.js for consistency) -->
                        <section class="xl:col-span-2 flex flex-col gap-4">
                            <div class="flex items-center justify-between">
                                <h3 class="text-white text-lg font-bold">Monthly Processed Bookings</h3>
                                <div class="flex gap-2">
                                    <select class="bg-surface-dark text-xs text-gray-300 border border-white/10 rounded-md px-2 py-1 focus:outline-none focus:border-primary">
                                        <option>This Year</option>
                                    </select>
                                </div>
                            </div>
                            <div class="bg-surface-dark rounded-xl border border-white/5 p-6 h-[400px] flex flex-col">
                                 <canvas id="processedBookingsChart"></canvas>
                            </div>
                        </section>

                        <!-- Unverified Customers List -->
                        <section class="xl:col-span-1 flex flex-col gap-4">
                            <div class="flex items-center justify-between">
                                <h3 class="text-white text-lg font-bold">Unverified Customers</h3>
                                <a href="/Customers?filter=unverified" class="text-primary text-sm font-medium hover:text-white transition-colors">View All</a>
                            </div>
                            <div class="bg-surface-dark rounded-xl border border-white/5 overflow-hidden flex flex-col h-[400px]">
                                <div class="overflow-y-auto p-2 flex flex-col gap-1">
                                    @foreach (var customer in Model.UnverifiedCustomersList)
                                    {
                                        <div class="flex items-center justify-between p-3 rounded-lg hover:bg-white/5 transition-colors group border-b border-white/5 last:border-0">
                                            <div class="flex items-center gap-3">
                                                <div class="size-10 rounded-full bg-cover bg-center" style='background-image: url("@customer.ImageUrl")'></div>
                                                <div>
                                                    <p class="text-white text-sm font-bold">@customer.Name</p>
                                                    <div class="flex items-center gap-1 text-xs text-gray-400">
                                                        <span class="material-symbols-outlined text-[12px] @customer.IssueColorClass">@customer.IssueIcon</span>
                                                        @customer.IssueText
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="flex gap-2">
                                                <button onclick="loadModal('/Customer/Documents/@customer.CustomerId')" class="bg-blue-500/10 text-blue-400 hover:bg-blue-500 hover:text-white px-3 py-1.5 rounded text-xs font-bold transition-all">Check Doc</button>
                                                <a href="/Customer/Verify/@customer.CustomerId" class="bg-primary/10 text-primary hover:bg-primary hover:text-background-dark px-3 py-1.5 rounded text-xs font-bold transition-all">Verify</a>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="p-4 border-t border-white/5 bg-surface-darker/50 mt-auto">
                                    <button class="w-full flex items-center justify-center gap-2 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-sm font-medium text-gray-300 transition-colors">
                                        <span class="material-symbols-outlined text-sm">mail</span>
                                        Send Reminder to All
                                    </button>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- Recent Pending Bookings Table -->
                    <section class="flex flex-col gap-4">
                        <div class="flex items-center justify-between px-1">
                            <h3 class="text-white text-lg font-bold">Recent Pending Bookings</h3>
                            <a href="/Booking?status=Pending" class="text-primary text-sm font-medium hover:text-white transition-colors">View All Pending</a>
                        </div>
                        <div class="bg-surface-dark rounded-xl border border-white/5 overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-white/5 text-gray-400 text-xs uppercase tracking-wider">
                                        <th class="p-4 font-medium">Customer</th>
                                        <th class="p-4 font-medium">Car Model</th>
                                        <th class="p-4 font-medium">Dates</th>
                                        <th class="p-4 font-medium">Status</th>
                                        <th class="p-4 font-medium text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="text-sm">
                                    @foreach (var booking in Model.RecentPendingBookings)
                                    {
                                        <tr class="group hover:bg-white/5 transition-colors border-b border-white/5 last:border-0">
                                            <td class="p-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="size-8 rounded-full bg-cover bg-center" style='background-image: url("@booking.CustomerImage")'></div>
                                                    <span class="text-white font-medium">@booking.CustomerName</span>
                                                </div>
                                            </td>
                                            <td class="p-4 text-gray-300">@booking.CarModel</td>
                                            <td class="p-4 text-gray-400">@booking.DateRange</td>
                                            <td class="p-4">
                                                <span class="inline-flex items-center px-2 py-1 rounded @booking.StatusColorClass text-xs font-bold">@booking.Status</span>
                                            </td>
                                            <td class="p-4 text-right">
                                                <a href="/Booking/Approve/@booking.BookingId" class="text-primary hover:text-white font-medium px-3">Approve</a>
                                                <button onclick="loadModal('/Booking/Details/@booking.BookingId')" class="text-gray-500 hover:text-red-400 px-2">Details</button>
                                            </td>
                                        </tr>
                                    }
                                    @if (!Model.RecentPendingBookings.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="p-8 text-center text-gray-400">No pending bookings found.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script> <!-- Ensure jQuery for some older modal logic if any -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> <!-- Bootstrap JS for Modals -->
    <script src="~/js/site.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Modal Placeholder -->
    <div id="modalPlaceholder"></div>

    <script>
        // Modal Loading Logic
        async function loadModal(url) {
            try {
                const res = await fetch(url);
                if (!res.ok) throw new Error('Failed to load modal content');
                
                const html = await res.text();
                const placeholder = document.getElementById('modalPlaceholder');
                placeholder.innerHTML = html;
                
                // Execute scripts in the loaded modal content
                placeholder.querySelectorAll('script').forEach(scr => {
                    const s = document.createElement('script');
                    s.textContent = scr.textContent;
                    document.body.appendChild(s);
                    // document.body.removeChild(s); // Optional: remove after execution
                });

                // Initialize and show modal using Bootstrap 5 API
                const modalEl = placeholder.querySelector('.modal');
                if (modalEl) {
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();
                    
                    // Cleanup on hide
                    modalEl.addEventListener('hidden.bs.modal', function () {
                        modal.dispose();
                        placeholder.innerHTML = '';
                    });
                }
            } catch (error) {
                console.error('Error loading modal:', error);
                if(window.showPopup) window.showPopup('Error loading details.', 'error');
            }
        }

        // Chart.js implementation for Processed Bookings
        const ctx = document.getElementById('processedBookingsChart');
        const monthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyProcessedBookings));
        const labels = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        
        if (ctx) {
            new Chart(ctx, {
                type: 'bar', // Using Bar to match Stitch design vertical bars
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Processed Bookings',
                        data: monthData,
                        backgroundColor: (context) => {
                            const value = context.raw;
                            // Make high values Gold, others faded
                             return value > 10 ? '#d4af35' : 'rgba(212, 175, 53, 0.2)';
                        },
                        borderRadius: 4,
                        hoverBackgroundColor: '#d4af35'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.05)',
                                drawBorder: false
                            },
                            ticks: { display: false } // Hide y-axis numbers as per design look
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280' }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>
