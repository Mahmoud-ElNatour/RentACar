@model RentACar.Web.Models.CustomerBookingViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Secure Booking";

    string carImg = "~/images/default-car.png";
    if (Model.CarImage != null && Model.CarImage.Length > 0)
    {
        carImg = $"data:image/jpeg;base64,{Convert.ToBase64String(Model.CarImage)}";
    }
}

<!-- Libraries -->
<script src="https://cdn.tailwindcss.com?plugins=forms"></script>

<style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #16181a;
    }

    ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #d4af37;
    }
</style>

<div class="min-h-screen bg-[#000000] text-white font-display py-12 px-4 md:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-12">

        <!-- LEFT: Booking Form -->
        <div class="lg:col-span-2 space-y-8">
            <div>
                <a href="javascript:history.back()"
                    class="text-gray-500 hover:text-white flex items-center gap-2 mb-4 transition-colors">
                    <span class="material-symbols-outlined">arrow_back</span> Back
                </a>
                <h1 class="text-4xl font-black tracking-tight mb-2">Complete Your <span class="text-gold">Booking</span>
                </h1>
                <p class="text-gray-400">Secure your luxury experience in just a few steps.</p>
            </div>

            <!-- Steps -->
            <div class="space-y-8">

                <!-- 1. Dates -->
                <div
                    class="bg-[#16181a] border border-[#262626] rounded-3xl p-8 shadow-2xl relative overflow-hidden group">
                    <div
                        class="absolute top-0 right-0 w-32 h-32 bg-gold/5 rounded-full blur-3xl -mr-16 -mt-16 pointer-events-none">
                    </div>

                    <h2 class="text-xl font-bold mb-6 flex items-center gap-3">
                        <span
                            class="w-8 h-8 rounded-full bg-gold text-black flex items-center justify-center font-black text-sm">1</span>
                        Choose Dates
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Custom Calendar -->
                        <div class="bg-[#0a0a0a] border border-[#262626] rounded-2xl p-4 select-none">
                            <div class="flex items-center justify-between mb-4">
                                <h4 id="calMonthYear" class="font-bold text-white">Loading...</h4>
                                <div class="flex gap-2">
                                    <button type="button" onclick="changeMonth(-1)"
                                        class="text-gold hover:text-white"><span
                                            class="material-symbols-outlined">chevron_left</span></button>
                                    <button type="button" onclick="changeMonth(1)"
                                        class="text-gold hover:text-white"><span
                                            class="material-symbols-outlined">chevron_right</span></button>
                                </div>
                            </div>
                            <div class="grid grid-cols-7 gap-1 mb-2 text-center text-xs text-gray-500 font-bold">
                                <div>S</div>
                                <div>M</div>
                                <div>T</div>
                                <div>W</div>
                                <div>T</div>
                                <div>F</div>
                                <div>S</div>
                            </div>
                            <div id="calGrid" class="grid grid-cols-7 gap-1 text-center text-sm"></div>
                        </div>

                        <!-- Inputs -->
                        <div class="space-y-4 flex flex-col justify-center">
                            <div>
                                <label
                                    class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Pick-up
                                    Date</label>
                                <input type="text" id="startDate" readonly
                                    class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl px-4 py-3 text-white font-mono text-center cursor-not-allowed"
                                    placeholder="YYYY-MM-DD" />
                            </div>
                            <div>
                                <label
                                    class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Return
                                    Date</label>
                                <input type="text" id="endDate" readonly
                                    class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl px-4 py-3 text-white font-mono text-center cursor-not-allowed"
                                    placeholder="YYYY-MM-DD" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Payment -->
                <div class="bg-[#16181a] border border-[#262626] rounded-3xl p-8 shadow-2xl relative overflow-hidden">
                    <h2 class="text-xl font-bold mb-6 flex items-center gap-3">
                        <span
                            class="w-8 h-8 rounded-full bg-gold text-black flex items-center justify-center font-black text-sm">2</span>
                        Payment Method
                    </h2>

                    <div class="space-y-6">
                        <!-- Promocode -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Have a
                                Promocode?</label>
                            <div class="flex gap-2">
                                <div class="relative flex-1">
                                    <span
                                        class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-500">sell</span>
                                    <input type="text" id="promocode"
                                        class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl py-3 pl-12 pr-4 text-white focus:border-gold focus:ring-1 focus:ring-gold outline-none transition-all placeholder-gray-700 uppercase"
                                        placeholder="ENTER CODE" />
                                </div>
                                <button type="button" id="btnApplyPromo"
                                    class="px-5 py-3 rounded-xl bg-[#262626] text-white font-bold hover:bg-[#333] transition-all border border-[#404040]">Apply</button>
                            </div>
                        </div>

                        <!-- Card (Selected by default) -->
                        <label
                            class="flex items-center justify-between p-4 bg-[#0a0a0a] border border-gold rounded-xl cursor-pointer shadow-[0_0_15px_rgba(212,175,55,0.1)]">
                            <div class="flex items-center gap-4">
                                <input type="radio" name="paymentMethod" value="Card" checked
                                    class="w-5 h-5 text-gold border-gray-600 focus:ring-gold bg-transparent accent-gold" />
                                <div>
                                    <div class="font-bold text-white">Credit / Debit Card</div>
                                    <div class="text-xs text-gray-400">Secure checkout via Stripe</div>
                                </div>
                            </div>
                            <div class="flex gap-2 opacity-70">
                                <span class="material-symbols-outlined text-gray-400">credit_card</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- 3. Driver & Pickup (Conditional) -->
                <div
                    class="bg-[#16181a] border border-[#262626] rounded-3xl p-8 shadow-2xl relative overflow-hidden transition-all duration-300">
                    <h2 class="text-xl font-bold mb-6 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span
                                class="w-8 h-8 rounded-full bg-gold text-black flex items-center justify-center font-black text-sm">3</span>
                            Driver & Pickup
                        </div>

                        <!-- Toggle -->
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="driverToggle" class="sr-only peer">
                            <div
                                class="w-11 h-6 bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gold">
                            </div>
                        </label>
                    </h2>
                    
                    <div id="driverAvailabilityStatus" class="text-xs text-gray-400 mb-4"></div>

                    <div id="driverSection" class="hidden space-y-6">
                        <p class="text-sm text-gray-400">Enable this to have a professional driver pick you up.</p>

                        <!-- Location Input -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Pickup
                                Location</label>
                            <div class="flex gap-2 mb-2">
                                <input type="text" id="pickupLocationName" readonly
                                    class="w-full bg-[#0a0a0a] border border-[#262626] rounded-xl px-4 py-3 text-white focus:border-gold outline-none cursor-default"
                                    placeholder="Select on map..." />
                                <button type="button" id="btnUseMyLoc"
                                    class="px-4 py-3 rounded-xl bg-[#262626] hover:bg-[#333] border border-[#404040] text-gold whitespace-nowrap transition-colors flex items-center gap-2">
                                    <span class="material-symbols-outlined text-lg">my_location</span>
                                </button>
                            </div>
                            <div id="locStatus" class="text-xs text-gold h-4"></div>
                        </div>

                        <!-- Map Container -->
                        <div class="h-[300px] w-full rounded-2xl overflow-hidden border border-[#262626] relative">
                            <div id="gMap" class="w-full h-full bg-[#0a0a0a]"></div>
                        </div>
                    </div>
                </div>

            </div>

            <button id="submitBtn"
                class="w-full py-4 bg-gold hover:bg-[#b5952f] text-black font-black text-lg uppercase tracking-wider rounded-xl shadow-lg shadow-gold/20 hover:shadow-gold/50 hover:scale-[1.01] transition-all flex items-center justify-center gap-2">
                <span>Proceed to Payment</span>
                <span class="material-symbols-outlined">arrow_forward</span>
            </button>
            <div id="errorMsg" class="text-red-500 text-center font-bold hidden"></div>

        </div>

        <!-- RIGHT: Summary (Sticky) -->
        <div class="lg:col-span-1">
            <div class="sticky top-8 space-y-6">
                <!-- Car Card -->
                <div class="bg-[#16181a] border border-[#262626] rounded-3xl overflow-hidden shadow-2xl">
                    <div class="aspect-video relative bg-[#0a0a0a]">
                        <!-- Skeleton placeholder -->
                        <div id="imgSkeleton"
                            class="absolute inset-0 bg-gradient-to-r from-[#1a1a1a] via-[#262626] to-[#1a1a1a] animate-pulse">
                        </div>
                        <!-- Lazy loaded image -->
                        <img src="@carImg" loading="lazy" decoding="async"
                            class="w-full h-full object-cover opacity-0 transition-opacity duration-500"
                            onload="this.classList.remove('opacity-0'); document.getElementById('imgSkeleton').classList.add('hidden');" />
                        <div class="absolute inset-0 bg-gradient-to-t from-[#16181a] to-transparent opacity-80"></div>
                        <div class="absolute bottom-4 left-6">
                            <h3 class="text-2xl font-black text-white">@Model.CarModel</h3>
                            <div class="text-gold font-bold">$@Model.PricePerDay.ToString("0") / day</div>
                        </div>
                    </div>
                    <div class="p-6 space-y-4">
                        <div id="priceLoading" class="hidden text-center text-gold text-xs animate-pulse">Updating
                            Price...</div>

                        <div id="priceContent" class="space-y-4">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400">Duration</span>
                                <span class="font-bold text-white" id="summDays">0 Days</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400">Subtotal</span>
                                <span class="font-bold text-white" id="summSubtotal">$0.00</span>
                            </div>

                            <div id="summDriverServiceRow" class="flex justify-between text-sm hidden">
                                <span class="text-gray-400">Driver Fee</span>
                                <span class="font-bold text-white" id="summDriverServiceFee">$0.00</span>
                            </div>
                            <div id="summCarDriverRow" class="flex justify-between text-sm hidden">
                                <span class="text-gray-400">Car Driver Fee</span>
                                <span class="font-bold text-white" id="summCarDriverFee">$0.00</span>
                            </div>

                            <div id="summPromoRow" class="flex justify-between text-green-500 text-sm hidden">
                                <span>Discount</span>
                                <span id="summDiscount">-$0.00</span>
                            </div>

                            <div class="pt-4 border-t border-[#262626] flex justify-between items-end">
                                <span class="text-gray-400 font-bold text-xs uppercase tracking-wider">Total</span>
                                <span class="text-3xl font-black text-gold" id="summTotal">$0.00</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Trust Badges -->
                <div class="grid grid-cols-2 gap-4">
                    <div
                        class="bg-[#16181a] p-4 rounded-2xl flex flex-col items-center text-center gap-2 border border-[#262626]">
                        <span class="material-symbols-outlined text-gold">encrypted</span>
                        <span class="text-xs font-bold text-gray-400">Secure Payment</span>
                    </div>
                    <div
                        class="bg-[#16181a] p-4 rounded-2xl flex flex-col items-center text-center gap-2 border border-[#262626]">
                        <span class="material-symbols-outlined text-gold">verified</span>
                        <span class="text-xs font-bold text-gray-400">Instant Confirm</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    const carId = @Model.CarId;
    const gMapsKey = '@ViewBag.GoogleMapsKey';
    let blockedDatesSet = new Set();
    let driverUnavailableSet = new Set();
    let isDriverServiceAvailable = true;

    // Driver & Map State
    let hasDriver = false;
    let pickupLat = null;
    let pickupLng = null;
    let pickupAddress = null;
    let pickupLocationName = null;
    let map = null;
    let marker = null;
    let mapLoaded = false;
    let hasAvailableDriver = true;

    // Toggle Logic
    // Toggle Logic
    document.getElementById('driverToggle').addEventListener('change', function (e) {
        hasDriver = e.target.checked;
        const sec = document.getElementById('driverSection');
        if (hasDriver) {
            sec.classList.remove('hidden');
            if (!mapLoaded) loadGoogleMaps();
            else if (map) {
                setTimeout(() => google.maps.event.trigger(map, "resize"), 100);
            }
            document.getElementById('summDriverServiceRow').classList.remove('hidden');
            document.getElementById('summCarDriverRow').classList.remove('hidden');
        } else {
            sec.classList.add('hidden');
            updateDriverAvailabilityStatus(null);
            document.getElementById('summDriverServiceRow').classList.add('hidden');
            document.getElementById('summCarDriverRow').classList.add('hidden');
        }
        renderGrid(); // Re-render to show/hide blocked driver dates
        calculatePrice(); 
    });

    // --- Google Maps Logic ---
    function loadGoogleMaps() {
        if (mapLoaded) return;
        if (!gMapsKey) {
            console.error("Google Maps Key missing");
            document.getElementById('locStatus').innerText = "Map configuration error.";
            return;
        }

        // Define callback
        window.initBookingPickupMap = function () {
            initMap();
        };

        const script = document.createElement('script');
        script.src = `https://maps.googleapis.com/maps/api/js?key=${gMapsKey}&callback=initBookingPickupMap`;
        script.async = true;
        document.body.appendChild(script);
        mapLoaded = true;
    }

    function initMap() {
        const defaultLoc = { lat: 33.8938, lng: 35.5018 }; // Beirut
        map = new google.maps.Map(document.getElementById("gMap"), {
            zoom: 12,
            center: defaultLoc,
            styles: [ // Dark mode style
                { elementType: "geometry", stylers: [{ color: "#242f3e" }] },
                { elementType: "labels.text.stroke", stylers: [{ color: "#242f3e" }] },
                { elementType: "labels.text.fill", stylers: [{ color: "#746855" }] },
                { featureType: "road", elementType: "geometry", stylers: [{ color: "#38414e" }] },
                { featureType: "water", elementType: "geometry", stylers: [{ color: "#17263c" }] },
            ],
            streetViewControl: false,
            mapTypeControl: false
        });

        map.addListener("click", (e) => {
            placeMarker(e.latLng);
        });
    }

    function placeMarker(latLng) {
        if (!marker) {
            marker = new google.maps.Marker({
                position: latLng,
                map: map,
                animation: google.maps.Animation.DROP
            });
        } else {
            marker.setPosition(latLng);
        }
        map.panTo(latLng);

        pickupLat = latLng.lat();
        pickupLng = latLng.lng();
        geocodePosition(latLng);
    }

    function geocodePosition(latLng) {
        const geocoder = new google.maps.Geocoder();
        document.getElementById('locStatus').innerText = "Fetching address...";

        geocoder.geocode({ location: latLng }, (results, status) => {
            if (status === "OK" && results[0]) {
                pickupAddress = results[0].formatted_address;

                // Try to comply with priority: POI > Neighborhood > Locality > Admin > Formatted
                // Simplified: Just use formatted or first component for label
                let label = results[0].formatted_address;
                // Ideally parse components, but formatted is safe fallback

                pickupLocationName = label;
                document.getElementById('pickupLocationName').value = label;
                document.getElementById('locStatus').innerText = "";
            } else {
                document.getElementById('locStatus').innerText = "Address not found, using coordinates.";
                pickupLocationName = "Pinned Location";
                document.getElementById('pickupLocationName').value = pickupLocationName;
                pickupAddress = null;
            }
        });
    }

    document.getElementById('btnUseMyLoc').addEventListener('click', () => {
        if (!map) return;
        const btn = document.getElementById('btnUseMyLoc');
        const icon = btn.querySelector('span');

        if (navigator.geolocation) {
            icon.innerText = 'hourglass_top'; // loading icon
            document.getElementById('locStatus').innerText = "Locating...";

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const pos = {
                        lat: position.coords.latitude,
                        lng: position.coords.longitude,
                    };
                    placeMarker(new google.maps.LatLng(pos.lat, pos.lng));
                    map.setZoom(15);
                    icon.innerText = 'my_location';
                },
                () => {
                    document.getElementById('locStatus').innerText = "Location access denied.";
                    icon.innerText = 'location_disabled';
                }
            );
        }
    });

    // --- Custom Calendar Logic ---
    let currDate = new Date();
    let selStart = null;
    let selEnd = null;

    function toISODate(d) {
        if (!d) return '';
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }

    async function fetchMonthDates(year, month) {
        const calTitle = document.getElementById('calMonthYear');
        calTitle.innerText = "Loading...";
        calTitle.classList.add('animate-pulse', 'text-gold');

        try {
            const apiMonth = month + 1;
            const url = `/api/Booking/GetBookedDates?carId=${carId}&year=${year}&month=${apiMonth}`;
            const resp = await fetch(url);
            if (resp.ok) {
                const dates = await resp.json();
                dates.forEach(d => blockedDatesSet.add(d));
            }
        } catch (e) { console.error("Failed to load dates", e); }
        finally {
            calTitle.classList.remove('animate-pulse', 'text-gold');
        }
    }

    async function fetchDriverUnavailableDates() {
        // Fetch next 90 days to determine global availability and blocking
        const today = new Date();
        const end = new Date();
        end.setDate(today.getDate() + 90);
        
        const s = toISODate(today);
        const e = toISODate(end);

        try {
            const url = `/api/Booking/GetDriverUnavailableDates?carId=${carId}&start=${s}&end=${e}`;
            const resp = await fetch(url);
            if (resp.ok) {
                const dates = await resp.json();
                dates.forEach(d => driverUnavailableSet.add(d));
                
                // If ALL 90 days are unavailable, assume no service exists
                // Approx check: if count > 89
                if (dates.length >= 90) {
                     isDriverServiceAvailable = false;
                     // Hide toggle wrapper
                     const toggleWrapper = document.getElementById('driverToggle').closest('label'); // The label wrapping the input
                     if(toggleWrapper) {
                         toggleWrapper.classList.add('hidden');
                         
                         // Add message
                         const h2 = toggleWrapper.closest('h2');
                         // Check if message already exists
                         if(!h2.querySelector('.driver-unavailable-msg')) {
                             const msg = document.createElement('span');
                             msg.className = "driver-unavailable-msg text-xs text-red-500 font-normal ml-auto";
                             msg.innerText = "Unavailable (No Drivers)";
                             h2.appendChild(msg);
                         }
                     }
                }
            }
        } catch (e) { console.error("Failed to load driver dates", e); }
    }

    async function init() {
        // Check pre-filled values
        const s = document.getElementById('startDate').value;
        const e = document.getElementById('endDate').value;
        if (s) selStart = new Date(s);
        if (e) selEnd = new Date(e);

        await Promise.all([
            fetchMonthDates(currDate.getFullYear(), currDate.getMonth()),
            fetchDriverUnavailableDates()
        ]);
        
        renderGrid();

        if (selStart && selEnd) {
            calculatePrice();
        }
    }

    function renderGrid() {
        const year = currDate.getFullYear();
        const month = currDate.getMonth();

        document.getElementById('calMonthYear').innerText = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(currDate);

        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const daysInMonth = lastDay.getDate();
        const startDay = firstDay.getDay();

        const grid = document.getElementById('calGrid');
        grid.innerHTML = '';

        for (let i = 0; i < startDay; i++) {
            grid.innerHTML += '<div></div>';
        }

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        for (let i = 1; i <= daysInMonth; i++) {
            const date = new Date(year, month, i);
            const iso = toISODate(date);
            const isPast = date < today;
            const isBlocked = blockedDatesSet.has(iso);
            // Driver block: ONLY if hasDriver is checked
            const isDriverBlocked = hasDriver && driverUnavailableSet.has(iso);

            const btn = document.createElement('button');
            btn.innerText = i;
            btn.className = 'w-8 h-8 rounded-lg flex items-center justify-center transition-all text-gray-300 mx-auto font-medium';

            if (isPast || isBlocked || isDriverBlocked) {
                btn.classList.add('opacity-30', 'cursor-not-allowed');
                if (isBlocked) btn.classList.add('bg-red-900/50', 'text-red-300'); // Blocked style
                if (isDriverBlocked && !isBlocked) btn.classList.add('bg-orange-900/50', 'text-orange-300'); // Driver blocked style
                btn.disabled = true;
            } else {
                btn.className += ' hover:bg-white/10';
                btn.onclick = () => selectDate(date);
            }

            // Selection styles
            const sTime = selStart ? selStart.getTime() : 0;
            const eTime = selEnd ? selEnd.getTime() : 0;
            const cTime = date.getTime();

            if (sTime && cTime === sTime) btn.className = 'w-8 h-8 rounded-lg flex items-center justify-center mx-auto bg-gold text-black font-bold shadow-lg shadow-gold/20';
            else if (eTime && cTime === eTime) btn.className = 'w-8 h-8 rounded-lg flex items-center justify-center mx-auto bg-gold text-black font-bold shadow-lg shadow-gold/20';
            else if (sTime && eTime && cTime > sTime && cTime < eTime) btn.className = 'w-8 h-8 rounded-lg flex items-center justify-center mx-auto bg-gold/20 text-gold font-bold';

            grid.appendChild(btn);
        }
    }

    async function changeMonth(dir) {
        currDate.setMonth(currDate.getMonth() + dir);
        await fetchMonthDates(currDate.getFullYear(), currDate.getMonth());
        renderGrid();
    }

    function selectDate(date) {
        if (selStart && selEnd) {
            selStart = date;
            selEnd = null;
        } else if (!selStart) {
            selStart = date;
        } else if (date < selStart) {
            selStart = date;
        } else if (date.getTime() === selStart.getTime()) {
             // Allow single day selection
             selEnd = date;
             // Check if blocked
             let iso = toISODate(date);
             if (blockedDatesSet.has(iso) || (hasDriver && driverUnavailableSet.has(iso))) {
                  // Actually if it was blocked it wouldn't be clickable? 
                  // But just in case
                  selEnd = null;
                  return;
             }
             
             // Update UI
             document.getElementById('errorMsg').classList.add('hidden');
             updateDriverToggleState();
             
             if (hasDriver) {
                 document.getElementById('driverAvailabilityStatus').innerText = "Driver available.";
                 document.getElementById('driverAvailabilityStatus').className = "text-xs text-green-500";
             }
        } else {
            // Validate range
            let valid = true;
            let check = new Date(selStart);
            let limit = new Date(date);
            // Optimize loop direction or swap if needed (selStart is always < date here usually due to logic above)
            // Logic above: date < selStart checked. date == selStart checked. so date > selStart.
            
            while (check <= limit) {
                let iso = toISODate(check);
                if (blockedDatesSet.has(iso)) {
                    valid = false;
                    document.getElementById('errorMsg').innerText = "Selected range includes already booked dates.";
                    document.getElementById('errorMsg').classList.remove('hidden');
                    break;
                }
                if (hasDriver && driverUnavailableSet.has(iso)) {
                    valid = false;
                     document.getElementById('driverAvailabilityStatus').innerText = "No drivers available for these dates.";
                     document.getElementById('driverAvailabilityStatus').className = "text-xs text-red-500 font-bold";
                    break;
                }
                check.setDate(check.getDate() + 1);
            }
            
            if (valid) {
                selEnd = date;
                // Clear errors
                 document.getElementById('errorMsg').classList.add('hidden');
                 
                 // Check driver availability for this range
                 updateDriverToggleState();
                 
                 if (hasDriver) {
                     // If still has driver (didn't get disabled), status is green
                     document.getElementById('driverAvailabilityStatus').innerText = "Driver available.";
                     document.getElementById('driverAvailabilityStatus').className = "text-xs text-green-500";
                 }
            }
            else { 
                selEnd = null; 
                return; 
            }
        }

        document.getElementById('startDate').value = toISODate(selStart);
        document.getElementById('endDate').value = toISODate(selEnd);
        renderGrid();

        if (selStart && selEnd) calculatePrice();
    }

    init();

    // 2. Calculate Price API
    async function calculatePrice() {
        const start = document.getElementById('startDate').value;
        const end = document.getElementById('endDate').value;
        const promo = document.getElementById('promocode').value;

        if (!start || !end) return;

        document.getElementById('priceLoading').classList.remove('hidden');
        document.getElementById('priceContent').classList.add('opacity-50');

        try {
            const resp = await fetch('/api/Booking/CalculatePrice', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    carId: carId,
                    startDate: start,
                    endDate: end,
                    promocode: promo,
                    hasDriver: hasDriver
                })
            });

            if (resp.ok) {
                const data = await resp.json();
                
                let finalSubtotal = data.subtotal;
                let finalTotal = data.total;

                if (hasDriver) {
                    document.getElementById('summDriverServiceRow').classList.remove('hidden');
                    document.getElementById('summCarDriverRow').classList.remove('hidden');
                    
                    document.getElementById('summDriverServiceFee').innerText = "$" + data.driverServiceFee.toFixed(2);
                    document.getElementById('summCarDriverFee').innerText = "$" + (data.carExtraDriverFee || 0).toFixed(2);
                } else {
                    document.getElementById('summDriverServiceRow').classList.add('hidden');
                    document.getElementById('summCarDriverRow').classList.add('hidden');
                }

                document.getElementById('summDays').innerText = data.days + (data.days === 1 ? " Day" : " Days");
                
                // Fix: Subtotal should only be the rental cost (Price * Days)
                // The API returns 'subtotal' as (Rent + Fees). We want to display Rent only here so the breakdown makes sense.
                let rentalSubtotal = data.days * data.pricePerDay;
                document.getElementById('summSubtotal').innerText = "$" + rentalSubtotal.toFixed(2); 

                document.getElementById('summTotal').innerText = "$" + finalTotal.toFixed(2);       // Updated total

                if (data.discountAmount > 0) {
                    document.getElementById('summPromoRow').classList.remove('hidden');
                    document.getElementById('summDiscount').innerText = "-$" + data.discountAmount.toFixed(2);
                } else {
                    document.getElementById('summPromoRow').classList.add('hidden');
                }
            }
        } catch (err) {
            console.error(err);
        } finally {
            document.getElementById('priceLoading').classList.add('hidden');
            document.getElementById('priceContent').classList.remove('opacity-50');
        }
    }

    // Old checkDriverAvailability removed/replaced by local logic
    async function checkDriverAvailability() {
        // Redundant with new logic, but kept placeholder or simple status update
        // We rely on driverUnavailableSet now
    }

    function updateDriverAvailabilityStatus(message) {
        const statusEl = document.getElementById('driverAvailabilityStatus');
        const submitBtn = document.getElementById('submitBtn');
        if (!message) {
            statusEl.innerText = '';
            submitBtn.disabled = false;
            return;
        }
        statusEl.innerText = message;
        submitBtn.disabled = hasDriver && !hasAvailableDriver;
    }

    document.getElementById('btnApplyPromo').addEventListener('click', calculatePrice);

    // 3. Submit
    document.getElementById('submitBtn').addEventListener('click', async function () {
        const s = document.getElementById('startDate').value;
        const e = document.getElementById('endDate').value;
        const promo = document.getElementById('promocode').value;
        const btn = this;
        const errDiv = document.getElementById('errorMsg');

        if (!s || !e) {
            alert("Please select dates first.");
            return;
        }

        if (hasDriver && !hasAvailableDriver) {
            errDiv.innerText = "No drivers available for the selected dates/car category.";
            errDiv.classList.remove('hidden');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin">progress_activity</span> Processing...';
        errDiv.classList.add('hidden');

        const payload = {
            carId: carId,
            startdate: s,
            enddate: e,
            paymentMethod: 'Card',
            promocode: promo || null,

            // Driver Fields
            hasDriver: hasDriver,
            pickupLatitude: hasDriver ? pickupLat : null,
            pickupLongitude: hasDriver ? pickupLng : null,
            pickupAddress: hasDriver ? pickupAddress : null,
            pickupLocationName: hasDriver ? pickupLocationName : null
        };

        if (hasDriver && (!pickupLat || !pickupLng)) {
            alert("Please select a pickup location on the map.");
            btn.disabled = false;
            btn.innerHTML = '<span>Proceed to Payment</span><span class="material-symbols-outlined">arrow_forward</span>';
            return;
        }

        try {
            const res = await fetch('/Booking/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                const data = await res.json();
                if (data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    alert("Booking Successful!"); // Fallback
                    window.location.href = "/Bookings/MyBookings";
                }
            } else {
                const txt = await res.text();
                errDiv.innerText = "Error: " + txt;
                errDiv.classList.remove('hidden');
                btn.disabled = false;
                btn.innerHTML = '<span>Proceed to Payment</span><span class="material-symbols-outlined">arrow_forward</span>';
            }
        } catch (ex) {
            console.error(ex);
            errDiv.innerText = "Network Error";
            errDiv.classList.remove('hidden');
            btn.disabled = false;
            btn.innerHTML = '<span>Proceed to Payment</span><span class="material-symbols-outlined">arrow_forward</span>';
        }
    });

    function updateDriverToggleState() {
        if (!selStart || !selEnd) return;
        
        let driverAvailableForRange = true;
        let check = new Date(selStart);
        let limit = new Date(selEnd);
        
        while (check <= limit) {
            if (driverUnavailableSet.has(toISODate(check))) {
                driverAvailableForRange = false;
                break;
            }
            check.setDate(check.getDate() + 1);
        }

        const toggle = document.getElementById('driverToggle');
        const status = document.getElementById('driverAvailabilityStatus');
        
        if (!driverAvailableForRange) {
            if (toggle.checked) {
                toggle.checked = false;
                toggle.dispatchEvent(new Event('change'));
            }
            toggle.disabled = true;
            status.innerText = "Driver service unavailable for selected dates.";
            status.className = "text-xs text-red-500 font-bold";
        } else {
            if (isDriverServiceAvailable) {
                toggle.disabled = false;
                if (!hasDriver) {
                     status.innerText = "";
                }
            }
        }
    }
</script>
