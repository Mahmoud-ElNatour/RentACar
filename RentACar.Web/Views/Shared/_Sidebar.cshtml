@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var role = "Guest";
    var displayName = "Guest";
    var avatarUrl = "https://ui-avatars.com/api/?name=Guest&background=d4af35&color=14120b";
    
    if (SignInManager.IsSignedIn(User))
    {
        // Try to get role from claims
        var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role);
        if (roleClaim != null)
        {
            role = roleClaim.Value;
        }
        else
        {
           // Fallback if no role claim found but signed in
           role = "User";
        }

        displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "User";
        avatarUrl = $"https://ui-avatars.com/api/?name={displayName}&background=d4af35&color=14120b";
    }
}

    <!-- Backdrop -->
    <div id="sidebarBackdrop" 
         class="fixed inset-0 z-[60] bg-black/50 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none" 
         onclick="toggleSidebar()"
         aria-hidden="true">
    </div>

    <!-- Sidebar -->
    <!-- Sidebar -->
    <aside id="mainSidebar" 
           class="fixed inset-y-0 left-0 z-[70] w-72 transform -translate-x-full transition-transform duration-300 ease-in-out bg-surface-dark border-r border-border-dark flex flex-col shadow-2xl">
        
        <!-- Header -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-border-dark bg-surface-dark shrink-0">
             <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-gold to-yellow-600 text-black shadow-[0_0_15px_rgba(212,175,53,0.3)]">
                    <span class="material-symbols-outlined font-bold text-xl">directions_car</span>
                </div>
                <div>
                     <h1 class="font-display font-bold text-lg tracking-tight text-white leading-tight">
                        <span class="text-white">Lebanon</span><span class="text-gold">Drive</span>
                    </h1>
                     <p class="text-[10px] font-medium text-gray-500 uppercase tracking-widest">@role Panel</p>
                </div>
             </div>
             <button onclick="toggleSidebar()" class="text-gray-400 hover:text-white transition-colors lg:hidden">
                 <span class="material-symbols-outlined">close</span>
             </button>
        </div>

        <!-- Scrollable Content -->
        <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-1 custom-scrollbar">
            
            <p class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Main</p>
            <a href="/Dashboard" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors group @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "bg-gold/10 text-gold shadow-glow" : "text-gray-400 hover:text-white hover:bg-white/5")">
                <span class="material-symbols-outlined text-[22px] group-hover:scale-110 transition-transform">dashboard</span>
                Dashboard
            </a>
            <a href="/" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors group text-gray-400 hover:text-white hover:bg-white/5">
                <span class="material-symbols-outlined text-[22px] group-hover:scale-110 transition-transform">home</span>
                Home
            </a>
            
            <a href="/Browse" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors group text-gray-400 hover:text-white hover:bg-white/5">
                <span class="material-symbols-outlined text-[22px] group-hover:scale-110 transition-transform">directions_car</span>
                Browse Cars
            </a>

            <!-- Admin & Employee Section -->
            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
            {
                <div class="mt-8">
                     <p class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Management</p>
                     
                     <!-- Control Panel Group -->
                     <button onclick="toggleSidebarDropdown('controlPanelMenu', 'cpArrow')" 
                             class="w-full flex items-center justify-between px-3 py-2 text-sm font-medium rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-colors group">
                        <div class="flex items-center gap-3">
                             <span class="material-symbols-outlined text-[22px] group-hover:scale-110 transition-transform">settings</span>
                             Control Panel
                        </div>
                        <span id="cpArrow" class="material-symbols-outlined text-[18px] transition-transform duration-200">expand_more</span>
                     </button>
                     
                     <!-- Submenu -->
                     <div id="controlPanelMenu" class="hidden pl-4 space-y-1 mt-1 border-l border-border-dark ml-5">
                          <a href="/Blacklist" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">block</span> Blacklist
                          </a>
                          <a href="/Booking" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">book_online</span> Bookings
                          </a>
                          <a href="/Car" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">directions_car</span> Cars
                          </a>
                          <a href="/Category" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">category</span> Categories
                          </a>
                          <a href="/CreditCard" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">credit_card</span> Credit Cards
                          </a>
                          <a href="/Customer" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">group</span> Customers
                          </a>
                          <a href="/Employee" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">badge</span> Employees
                          </a>
                          <a href="/Payment" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">payments</span> Financials
                          </a>
                          <a href="/PaymentMethod" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">account_balance_wallet</span> Payment Methods
                          </a>
                          <a href="/Promocode" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">local_offer</span> Promocodes
                          </a>
                          <a href="/ControlPanel/Ratings" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">star</span> Ratings
                          </a>
                          @if (User.IsInRole("Admin"))
                          {
                              <a href="/ControlPanel/ChangeRole" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                                  <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span> Change Role
                              </a>
                          }
                     </div>

                     <!-- Email Services Group -->
                     <button onclick="toggleSidebarDropdown('emailServicesMenu', 'esArrow')" 
                             class="w-full flex items-center justify-between px-3 py-2 text-sm font-medium rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-colors group mt-1">
                        <div class="flex items-center gap-3">
                             <span class="material-symbols-outlined text-[22px] group-hover:scale-110 transition-transform">mail</span>
                             Email Services
                        </div>
                        <span id="esArrow" class="material-symbols-outlined text-[18px] transition-transform duration-200">expand_more</span>
                     </button>
                     
                     <!-- Email Services Submenu -->
                     <div id="emailServicesMenu" class="hidden pl-4 space-y-1 mt-1 border-l border-border-dark ml-5">
                          <a href="/EmailServices/EmailServicesHub" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">hub</span> Email Hub
                          </a>
                          <a href="/SendEmail" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">send</span> Send Email
                          </a>
                          <a href="/DistributionLists" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">group_add</span> Dist. Lists
                          </a>
                          <a href="/EmailConfigurationCenter" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">settings_applications</span> Configure
                          </a>
                          <a href="/Admin/EmailServices/Templates" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">dashboard_customize</span> Templates
                          </a>
                          <a href="/Admin/Outbox" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">outbox</span> Outbox
                          </a>
                          <a href="/Admin/NotificationLog" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-gray-500 hover:text-gold hover:bg-gold/5 transition-colors">
                              <span class="material-symbols-outlined text-[18px]">receipt_long</span> Notification Log
                          </a>
                     </div>

                     <a href="/Reports" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors group mt-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "bg-gold/10 text-gold shadow-glow" : "text-gray-400 hover:text-white hover:bg-white/5")">
                        <span class="material-symbols-outlined text-[22px] group-hover:scale-110 transition-transform">bar_chart</span>
                        Reports
                    </a>
                </div>
            }
            
            <div class="mt-8">
                <p class="px-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Account</p>
                <a href="/Identity/Account/Manage" class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors group text-gray-400 hover:text-white hover:bg-white/5">
                    <span class="material-symbols-outlined text-[22px] group-hover:scale-110 transition-transform">person</span>
                    Profile
                </a>
            </div>

        </nav>

        <!-- Footer / User Info -->
        <div class="p-4 border-t border-border-dark bg-background-dark/50 shrink-0">
             <div class="flex items-center justify-between gap-3">
                 <div class="flex items-center gap-3 min-w-0">
                     <div class="h-10 w-10 shrink-0 rounded-full border border-gold/30 shadow-sm bg-center bg-cover" 
                          style="background-image: url('@avatarUrl');"></div>
                     <div class="min-w-0 flex-1 hidden sm:block">
                         <p class="text-sm font-medium text-white truncate">@displayName</p>
                         <p class="text-[10px] text-gray-500 truncate">@User.Identity?.Name</p>
                     </div>
                 </div>
                 
                 <!-- Logout Button -->
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="text-gray-400 hover:text-red-500 transition-colors p-2 rounded-lg hover:bg-red-500/10" title="Logout">
                         <span class="material-symbols-outlined">logout</span>
                    </button>
                </form>
             </div>
        </div>
    </aside>
