@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "User";
}

<header class="relative z-50 w-full border-b border-[1px] border-border-dark bg-surface-dark/95 backdrop-blur-sm">
    <div class="px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            <!-- Left Section: Toggle & Brand -->
            <div class="flex items-center gap-4 lg:gap-8">
                <!-- Sidebar Toggle -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <button onclick="toggleSidebar()"
                            class="group -m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-400 hover:text-gold transition-colors duration-200"
                            type="button">
                        <span class="sr-only">Open sidebar</span>
                        <span class="material-symbols-outlined text-3xl group-hover:scale-105 transition-transform">menu</span>
                    </button>
                }
                else
                {
                     <!-- Mobile Menu Toggle for Guests -->
                     <button onclick="toggleSidebar()" class="lg:hidden group -m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-400 hover:text-gold transition-colors duration-200"
                            type="button"> 
                        <span class="sr-only">Open menu</span>
                        <span class="material-symbols-outlined text-3xl group-hover:scale-105 transition-transform">menu</span>
                    </button>
                }

                <!-- Brand Logo -->
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 decoration-0 hover:no-underline">
                <img src="~/img/icons/no-bg-logo.png"
                    alt="RentACar Logo"
                    class="h-16 w-16 object-contain" /> 
                    <!-- shuf size old icon w rja3 3adel 7asaba -->
                    <h1 class="hidden sm:block text-lg font-bold tracking-tight font-display">
<span class="text-white">Lebanon</span>
<span class="text-gold">Drive</span>
</h1>

                </a>
            </div>

            <!-- Middle Section: Global Links (Desktop) -->
            <nav class="hidden md:flex flex-1 justify-center px-8">
                <div class="flex items-center gap-1 bg-background-dark/50 rounded-full p-1">
                     @if (User.IsInRole("Customer"))
                     {
                        <a asp-controller="Browse" asp-action="Index" 
                           class="px-4 py-1.5 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-full transition-all duration-200 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Browse" ? "text-gold bg-gold/10 border border-[1px] border-gold/20" : "")">
                            Browse Cars
                        </a>
                        <a asp-controller="Bookings" asp-action="MyBookings"
                           class="px-4 py-1.5 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-full transition-all duration-200 @(ViewContext.RouteData.Values["Action"]?.ToString() == "MyBookings" ? "text-gold bg-gold/10 border border-[1px] border-gold/20" : "")">
                            My Bookings
                        </a>
                     }
                     
                     @if (SignInManager.IsSignedIn(User))
                     {
                        <a asp-controller="Dashboard" asp-action="Index"
                           class="px-4 py-1.5 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-full transition-all duration-200 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "text-gold bg-gold/10 border border-[1px] border-gold/20" : "")">
                            Dashboard
                        </a>
                     }
                     
                     @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                     {
                        <a asp-controller="ControlPanel" asp-action="Index"
                           class="px-4 py-1.5 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-full transition-all duration-200 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ControlPanel" ? "text-gold bg-gold/10 border border-[1px] border-gold/20" : "")">
                            Control Panel
                        </a>
                        <a asp-controller="EmailServices" asp-action="EmailServicesHub"
                           class="px-4 py-1.5 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-full transition-all duration-200 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "EmailServices" ? "text-gold bg-gold/10 border border-[1px] border-gold/20" : "")">
                            Email Hub
                        </a>
                        <a asp-controller="Reports" asp-action="Index"
                           class="px-4 py-1.5 text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 rounded-full transition-all duration-200 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "text-gold bg-gold/10 border border-[1px] border-gold/20" : "")">
                            Reports
                        </a>
                     }
                </div>
            </nav>

            <!-- Right Section: Actions & Profile -->
            <div class="flex items-center gap-4 sm:gap-6">
                <!-- Notifications (Only if signed in) -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <button class="relative text-gray-400 hover:text-gold transition-colors group">
                        <span class="material-symbols-outlined">notifications</span>
                        <!-- Notification Badge -->
                        <span class="absolute top-0.5 right-0.5 flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-gold"></span>
                        </span>
                    </button>
                }

                <!-- Divider -->
                <div class="hidden sm:block h-6 w-px bg-border-dark"></div>

                <!-- User Profile Dropdown Trigger -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="relative flex items-center">
                        <button onclick="toggleUserDropdown()"
                                class="flex items-center gap-3 rounded-full focus:outline-none group"
                                type="button" aria-expanded="false" id="user-menu-button">
                            <div class="relative">
                                <div class="h-9 w-9 overflow-hidden rounded-full border-2 border-gold/30 shadow-sm flex items-center justify-center bg-surface-dark">
                                    <i class="fa fa-user text-gold"></i>
                                </div>
                                <div class="absolute bottom-0 right-0 h-2.5 w-2.5 rounded-full bg-green-500 ring-2 ring-surface-dark"></div>
                            </div>
                            <div class="hidden text-left sm:block">
                                <p class="text-sm font-semibold text-white group-hover:text-gold transition-colors">
                                    @displayName
                                </p>
                                @if(User.IsInRole("Admin")) { <p class="text-xs font-medium text-gold">Administrator</p> }
                                else if(User.IsInRole("Employee")) { <p class="text-xs font-medium text-blue-400">Employee</p> }
                                else { <p class="text-xs font-medium text-gray-500">Member</p> }
                            </div>
                            <span class="material-symbols-outlined text-gray-400 group-hover:text-white transition-colors hidden sm:block text-lg">expand_more</span>
                        </button>
                        
                        <!-- Dropdown Menu (Custom Tailwind) -->
                        <div id="user-dropdown-menu" class="hidden absolute right-0 top-full mt-2 w-56 origin-top-right rounded-xl bg-surface-dark shadow-2xl ring-1 ring-black ring-opacity-5 focus:outline-none z-50 transform transition-all duration-200 ease-out opacity-0 scale-95" 
                             style="display: none;"> <!-- Inline style for JS to remove, class for Tailwind -->
                            <div class="p-1">
                                <a class="block px-4 py-2.5 text-sm text-gray-300 hover:bg-gold/10 hover:text-gold rounded-lg transition-colors flex items-center gap-3 group" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    <span class="material-symbols-outlined text-[20px] text-gray-400 group-hover:text-gold transition-colors">person</span> 
                                    <span class="font-medium">Profile</span>
                                </a>
                                
                                <div class="h-px bg-border-dark my-1 mx-2"></div>
                                
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                                    <button type="submit" class="w-full text-left block px-4 py-2.5 text-sm text-gray-300 hover:bg-red-500/10 hover:text-red-500 rounded-lg transition-colors flex items-center gap-3 group">
                                        <span class="material-symbols-outlined text-[20px] text-gray-400 group-hover:text-red-500 transition-colors">logout</span> 
                                        <span class="font-medium">Logout</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-3">
                        <a asp-area="Identity" asp-page="/Account/Login" class="text-sm font-medium text-gray-300 hover:text-white transition-colors">Login</a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="px-4 py-2 text-sm font-bold text-black bg-gold rounded-lg hover:bg-yellow-500 transition-colors shadow-lg shadow-gold/20">
                            Register
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</header>
