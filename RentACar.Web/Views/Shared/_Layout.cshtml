@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentACar.Web</title>
    <!-- <link rel="icon" sizes="" type="image/png" href="~/img/icons/titleimg.png"> -->

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- jQuery + jQuery UI (must load before any feature script) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&amp;family=Noto+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <style>
        /* Scoped CSS Overrides to fix Bootstrap conflicts on new dark pages only */
        
        /* Fix Links: Remove blue color and underline (Excluding Navbar) */
        body.bg-background-dark a:not(.nav-link):not(.dropdown-item):not(.navbar-brand),
        body[class*="bg-[#050505]"] a:not(.nav-link):not(.dropdown-item):not(.navbar-brand) {
            text-decoration: none !important;
            /* color: inherit !important; */
        }

        /* Fix TOC styling specifically */
        body.bg-background-dark .toc-item,
        body[class*="bg-[#050505]"] .toc-item {
            color: #b9b29d !important;
            text-decoration: none !important;
        }
        body.bg-background-dark .toc-item:hover,
        body.bg-background-dark .toc-item.active,
        body[class*="bg-[#050505]"] .toc-item:hover,
        body[class*="bg-[#050505]"] .toc-item.active {
            color: #ffffff !important;
        }
        
        /* Fix Borders: Bootstrap .border adds a white border.  */
        body.bg-background-dark .border,
        body[class*="bg-[#050505]"] .border {
            border-color: #262626 !important;
            border-style: solid !important;
            border-width: 1px !important;
        }

        /* Fix Box Sizing if Bootstrap is messing with it */
        body.bg-background-dark *,
        body[class*="bg-[#050505]"] * {
             box-sizing: border-box;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            important: true, /* FORCE OVERRIDE OF BOOTSTRAP STYLES */
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d4af35",
                        "primary-dark": "#0a0c0e",
                        "background-light": "#f8f7f6",
                        "background-dark": "#0a0c0e",
                        "surface-dark": "#16181a",
                        "surface-dark-lighter": "#202225",
                        "border-dark": "#2a2d30",
                        
                        // Merged from pages
                        "surface-accent": "#262626",
                        "card-dark": "#121212",
                        "text-muted": "#888888",

                        // Legacy mappings to keep footer/other components working if they use these
                        "gold": "#d4af35",
                        "gold-light": "#fce186",
                        "gold-hover": "#d9a60c",
                        "brand": "#d4af35",
                        "text-body": "#d1d5db", 
                        "text-secondary": "#b9b29d",
                        "footer-bg": "#0a0a0a",
                        "footer-surface": "#171717",
                        "footer-border": "#f2b90d33",
                    },
                    fontFamily: {
                         "display": ["Manrope", "sans-serif"],
                         "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    boxShadow: {
                        "glow": "0 0 20px rgba(212, 175, 55, 0.15)"
                    },
                },
            },
        }
    </script>
    <!-- Scripts moved to site.js -->
    @await RenderSectionAsync("Styles", required: false)
    @* <link rel="stylesheet" href="~/css/index-style.css" asp-append-version="true" /> *@
    @* <link rel="stylesheet" href="~/RentACar.Web.styles.css" asp-append-version="true" /> *@
</head>
<body class="d-flex flex-column min-vh-100 bg-background-dark text-white font-display transition-colors duration-300 @ViewData["BodyClass"]">
    @await Html.PartialAsync("_Sidebar")
    @await Html.PartialAsync("_PopupNotifications")
    @await Html.PartialAsync("_Navbar")

    <div class="container-fluid m-0 p-0">
        <main role="main" class="m-0 p-0 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_Footer")

    <!-- Bootstrap JS bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/index-script.js" asp-append-version="true"></script>

    @await Html.PartialAsync("_SupportFloatingButton")

    <partial name="_SupportActionPopup" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
