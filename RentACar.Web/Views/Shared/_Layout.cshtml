    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <style>
        /* Scoped CSS Overrides to fix Bootstrap conflicts on new dark pages only */
        
        /* Fix Links: Remove blue color and underline (Excluding Navbar) */
        body.bg-background-dark a:not(.nav-link):not(.dropdown-item):not(.navbar-brand),
        body[class*="bg-[#050505]"] a:not(.nav-link):not(.dropdown-item):not(.navbar-brand) {
            text-decoration: none !important;
            /* color: inherit !important; */
        }

        /* Fix TOC styling specifically */
        body.bg-background-dark .toc-item,
        body[class*="bg-[#050505]"] .toc-item {
            color: #b9b29d !important;
            text-decoration: none !important;
        }
        body.bg-background-dark .toc-item:hover,
        body.bg-background-dark .toc-item.active,
        body[class*="bg-[#050505]"] .toc-item:hover,
        body[class*="bg-[#050505]"] .toc-item.active {
            color: #ffffff !important;
        }
        
        /* Fix Borders: Bootstrap .border adds a white border.  */
        body.bg-background-dark .border,
        body[class*="bg-[#050505]"] .border {
            border-color: #262626 !important;
            border-style: solid !important;
            border-width: 1px !important;
        }

        /* Fix Box Sizing if Bootstrap is messing with it */
        body.bg-background-dark *,
        body[class*="bg-[#050505]"] * {
             box-sizing: border-box;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            important: true, /* FORCE OVERRIDE OF BOOTSTRAP STYLES */
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#d4af35",
                        "primary-dark": "#0a0c0e",
                        "background-light": "#f8f7f6",
                        "background-dark": "#0a0c0e",
                        "surface-dark": "#16181a",
                        "surface-dark-lighter": "#202225",
                        "border-dark": "#2a2d30",
                        
                        // Merged from pages
                        "surface-accent": "#262626",
                        "card-dark": "#121212",
                        "text-muted": "#888888",

                        // Legacy mappings to keep footer/other components working if they use these
                        "gold": "#d4af35",
                        "gold-light": "#fce186",
                        "gold-hover": "#d9a60c",
                        "brand": "#d4af35",
                        "text-body": "#d1d5db", 
                        "text-secondary": "#b9b29d",
                        "footer-bg": "#0a0a0a",
                        "footer-surface": "#171717",
                        "footer-border": "#f2b90d33",
                    },
                    fontFamily: {
                         "display": ["Manrope", "sans-serif"],
                         "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    boxShadow: {
                        "glow": "0 0 20px rgba(212, 175, 55, 0.15)"
                    },
                },
            },
        }
    </script>
    <script>
        function toggleUserDropdown() {
            const dropdown = document.getElementById('user-dropdown-menu');
            if (dropdown.style.display === 'none' || dropdown.classList.contains('hidden')) {
                dropdown.style.display = 'block';
                dropdown.classList.remove('hidden');
                // Small delay to allow transition
                setTimeout(() => {
                    dropdown.classList.remove('opacity-0', 'scale-95');
                    dropdown.classList.add('opacity-100', 'scale-100');
                }, 10);
            } else {
                dropdown.classList.remove('opacity-100', 'scale-100');
                dropdown.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    dropdown.style.display = 'none';
                    dropdown.classList.add('hidden');
                }, 200);
            }
        }

        // Sidebar Toggle Logic
        function toggleSidebar() {
            const sidebar = document.getElementById('mainSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            const body = document.body;
            
            if (!sidebar || !backdrop) {
                console.error('Sidebar elements not found');
                return;
            }

            if (sidebar.classList.contains('-translate-x-full')) {
                // Open
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('opacity-0', 'pointer-events-none');
                body.style.overflow = 'hidden'; // Prevent background scrolling
            } else {
                // Close
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('opacity-0', 'pointer-events-none');
                body.style.overflow = '';
            }
        }

        // Sidebar Dropdown Toggle
        function toggleSidebarDropdown(menuId, arrowId) {
            const menu = document.getElementById(menuId);
            const arrow = document.getElementById(arrowId);
            
            if (menu.classList.contains('hidden')) {
                menu.classList.remove('hidden');
                arrow.style.transform = 'rotate(180deg)';
            } else {
                menu.classList.add('hidden');
                arrow.style.transform = 'rotate(0deg)';
            }
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {

            const dropdown = document.getElementById('user-dropdown-menu');
            const button = document.getElementById('user-menu-button');
            if (dropdown && button && !dropdown.contains(event.target) && !button.contains(event.target)) {
                 if (!dropdown.classList.contains('hidden')) {
                    dropdown.classList.remove('opacity-100', 'scale-100');
                    dropdown.classList.add('opacity-0', 'scale-95');
                    setTimeout(() => {
                        dropdown.style.display = 'none';
                        dropdown.classList.add('hidden');
                    }, 200);
                 }
            }
        });
    </script>
    @await RenderSectionAsync("Styles", required: false)
    @* <link rel="stylesheet" href="~/css/index-style.css" asp-append-version="true" /> *@
    @* <link rel="stylesheet" href="~/RentACar.Web.styles.css" asp-append-version="true" /> *@
