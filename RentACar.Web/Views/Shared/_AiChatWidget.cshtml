@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <!-- AI Chat Widget Float -->
    <div id="aiChatWidget" class="fixed bottom-6 right-6 z-[9999] flex flex-col items-end gap-4 font-sans antialiased">
        
        <!-- Chat Window (Hidden by Default) -->
        <div id="aiChatWindow" class="hidden w-[380px] h-[600px] max-h-[80vh] bg-black/90 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl flex flex-col overflow-hidden transition-all duration-300 origin-bottom-right">
            
            <!-- Header -->
            <div class="h-16 bg-gradient-to-r from-zinc-900 to-black border-b border-white/10 flex items-center justify-between px-4 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-yellow-600 flex items-center justify-center shadow-lg shadow-primary/20">
                        <span class="material-symbols-outlined text-black text-lg">smart_toy</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-white font-bold text-sm tracking-wide">LB Drive - Chatbot (AI)</span>
                        <span class="text-emerald-400 text-[10px] font-medium flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            Always Available
                        </span>
                    </div>
                </div>
                <button onclick="toggleAiChat()" class="text-zinc-500 hover:text-white transition-colors">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Escalation Banner (Hidden until needed or persistent?) -->
            <div id="aiEscalationBanner" class="hidden bg-primary/10 border-b border-white/5 p-3 flex items-center justify-between shrink-0">
                <span class="text-xs text-zinc-300">Need complex help?</span>
                <button onclick="escalateToTicket()" class="text-xs font-bold text-primary hover:text-white transition-colors flex items-center gap-1">
                    Connect to Human <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </button>
            </div>

            <!-- Messages Area -->
            <div id="aiChatMessages" class="flex-1 overflow-y-auto p-4 space-y-4 scrollbar-thin scrollbar-thumb-white/10 scrollbar-track-transparent">
                <!-- Messages will be injected here -->
                <div class="flex flex-col gap-2 items-start opacity-70">
                    <div class="px-4 py-3 rounded-2xl bg-zinc-800 text-zinc-300 text-sm max-w-[85%] rounded-tl-none">
                        Connecting to concierge service...
                    </div>
                </div>
            </div>

            <!-- Escalation Modal Injection -->
            <partial name="_AiEscalationModal" />

            <!-- Input Area -->
            <div class="p-4 border-t border-white/10 bg-black/50 backdrop-blur-md shrink-0">
                <form onsubmit="sendMessage(event)" class="relative">
                    <input id="aiChatInput" type="text" placeholder="Ask me anything..." 
                           class="w-full h-12 bg-white/5 border border-white/10 rounded-xl pl-4 pr-12 text-sm text-white placeholder:text-zinc-600 focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/50 transition-all font-light"
                           autocomplete="off">
                    <button type="submit" class="absolute right-2 top-2 w-8 h-8 rounded-lg bg-primary/20 hover:bg-primary text-primary hover:text-black flex items-center justify-center transition-all">
                        <span class="material-symbols-outlined text-sm">send</span>
                    </button>
                </form>
                <div class="flex justify-between items-center mt-2 px-1">
                     <button onclick="showEscalationModal()" class="text-[10px] uppercase tracking-wider text-zinc-600 hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-[10px]">support_agent</span> Specialist Support
                    </button>
                    <span class="text-[10px] text-zinc-600">AI Concierge</span>
                </div>
            </div>

        </div>

        <!-- Floating Button -->
        <button onclick="toggleAiChat()" class="group relative w-14 h-14 bg-gradient-to-br from-primary to-yellow-600 rounded-full shadow-[0_4px_20px_rgba(212,175,55,0.3)] hover:shadow-[0_4px_30px_rgba(212,175,55,0.5)] flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 z-50">
            <span class="material-symbols-outlined text-black text-2xl group-hover:rotate-12 transition-transform">smart_toy</span>
            <span class="absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full border-2 border-black hidden" id="aiUnreadBadge"></span>
        </button>

    </div>

    <!-- Scripts -->
    <script>
        if (typeof signalR === 'undefined') {
            document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"><\/script>');
        }
    </script>
    <script>
        let aiConnection = null;
        let aiConversationId = 0;
        const aiChatWindow = document.getElementById('aiChatWindow');
        const aiChatMessages = document.getElementById('aiChatMessages');
        const aiChatInput = document.getElementById('aiChatInput');
        
        // Modal Logic
        function showEscalationModal() {
            document.getElementById('aiEscalationModal').classList.remove('hidden');
        }

        function hideEscalationModal() {
            document.getElementById('aiEscalationModal').classList.add('hidden');
        }

        async function confirmEscalation() {
            hideEscalationModal();
            await escalateToTicket();
        }

        async function initAiChat() {
            if (aiConnection) return;

            aiConnection = new signalR.HubConnectionBuilder()
                .withUrl("/aiChatHub")
                .withAutomaticReconnect()
                .build();

            aiConnection.on("ReceiveMessage", (sender, message) => {
                appendMessage(sender, message);
            });

            aiConnection.on("HistoryLoaded", (history) => {
                aiChatMessages.innerHTML = ''; // Clear loading
                history.forEach(msg => {
                    appendMessage(msg.sender === "User" ? "User" : "AI", msg.content);
                });
                scrollToBottom();
            });

            aiConnection.on("ConversationId", (id) => {
                aiConversationId = id;
            });
            
            aiConnection.on("Escalated", (ticketId) => {
                appendMessage("System", `Ticket #${ticketId} created. Redirecting...`);
                setTimeout(() => {
                    window.location.href = `/Support/Conversation/${ticketId}`;
                }, 2000);
            });

            try {
                await aiConnection.start();
                console.log("Connected to AI Hub");
                await aiConnection.invoke("JoinWidget");
            } catch (err) {
                console.error("AI Hub Error: ", err);
            }
        }

        function toggleAiChat() {
            const isHidden = aiChatWindow.classList.contains('hidden');
            if (isHidden) {
                aiChatWindow.classList.remove('hidden');
                initAiChat(); // Connect on first open
                setTimeout(scrollToBottom, 100);
            } else {
                aiChatWindow.classList.add('hidden');
            }
        }

        async function sendMessage(e) {
            e.preventDefault();
            const text = aiChatInput.value.trim();
            if (!text || !aiConnection) return;

            aiChatInput.value = '';
            // Optimistic append? Hub echoes back user message, so maybe wait?
            // Hub code: `await Clients.Caller.SendAsync("ReceiveMessage", "User", messageText);`
            // So we wait for echo.
            
            try {
                await aiConnection.invoke("SendMessage", aiConversationId, text);
            } catch (err) {
                console.error("Send Error: ", err);
                appendMessage("System", "Failed to send message.");
            }
        }
        
        async function escalateToTicket() {
            try {
                appendMessage("System", "Creating ticket...");
                await aiConnection.invoke("Escalate");
            } catch (err) {
                console.error("Escalate Error: ", err);
                appendMessage("System", "Failed to escalate.");
            }
        }

        function appendMessage(sender, text) {
            const isUser = sender === "User";
            const isSystem = sender === "System";
            
            const div = document.createElement('div');
            
            if (isSystem) {
                 div.className = "flex justify-center my-2";
                 div.innerHTML = `<span class="text-[10px] text-zinc-500 bg-white/5 px-2 py-1 rounded-full border border-white/5">${text}</span>`;
            } else {
                div.className = `flex flex-col gap-1 max-w-[85%] ${isUser ? 'self-end items-end' : 'self-start items-start'}`;
                
                const bubble = document.createElement('div');
                bubble.className = `px-4 py-3 text-sm rounded-2xl ${
                    isUser 
                    ? 'bg-primary text-black rounded-tr-none shadow-lg shadow-primary/10 font-medium' 
                    : 'bg-zinc-800 text-zinc-200 rounded-tl-none border border-white/5'
                }`;
                
                // Markdown-ish basic formatting (newlines)
                bubble.innerText = text; 
                
                div.appendChild(bubble);
                
                // Timestamp or label?
                // const label = document.createElement('span');
                // label.className = "text-[10px] text-zinc-600 px-1";
                // label.innerText = isUser ? "You" : "Premier AI";
                // div.appendChild(label);
            }

            aiChatMessages.appendChild(div);
            scrollToBottom();
        }

        function scrollToBottom() {
            aiChatMessages.scrollTop = aiChatMessages.scrollHeight;
        }
    </script>
}
