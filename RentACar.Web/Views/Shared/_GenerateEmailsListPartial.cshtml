@* _GenerateEmailsListPartial.cshtml *@

<section class="flex flex-col gap-4" id="generate-list-section">
    <div class="flex items-center gap-2 px-1">
        <span class="material-symbols-outlined text-primary">auto_awesome</span>
        <h2 class="text-xl font-bold">Generate Distribution List</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <div class="lg:col-span-3 p-6 rounded-xl bg-white dark:bg-card-dark border border-slate-200 dark:border-border-dark flex flex-col gap-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-2">
                        <label class="font-bold text-xs text-slate-400 dark:text-[#c3b498] uppercase">List Name</label>
                        <input id="gen-list-name" class="bg-slate-100 dark:bg-background-dark border-slate-200 dark:border-border-dark rounded-lg text-sm px-4 py-2.5 focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="e.g. Q4 Marketing Mix" type="text"/>
                    </div>
                    <div class="flex flex-col gap-2">
                        <p class="font-bold text-xs text-slate-400 dark:text-[#c3b498] uppercase mt-2">Target Group</p>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-3 p-2.5 rounded-lg border border-slate-200 dark:border-border-dark hover:bg-primary/5 cursor-pointer transition-colors">
                                <input id="rule-employees" class="rounded text-primary focus:ring-primary bg-transparent border-slate-400" type="checkbox"/>
                                <span class="text-sm font-medium">Employees</span>
                            </label>
                            <label class="flex items-center gap-3 p-2.5 rounded-lg border border-slate-200 dark:border-border-dark hover:bg-primary/5 cursor-pointer transition-colors">
                                <input id="rule-customers" class="rounded text-primary focus:ring-primary bg-transparent border-slate-400" type="checkbox"/>
                                <span class="text-sm font-medium">Customers</span>
                            </label>
                            <label class="flex items-center gap-3 p-2.5 rounded-lg border border-slate-200 dark:border-border-dark hover:bg-primary/5 cursor-pointer transition-colors">
                                <input id="rule-admins" class="rounded text-primary focus:ring-primary bg-transparent border-slate-400" type="checkbox"/>
                                <span class="text-sm font-medium">Admins</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="flex flex-col gap-4">
                    <p class="font-bold text-xs text-slate-400 dark:text-[#c3b498] uppercase">Safety &amp; Status Filters</p>
                    <div class="flex flex-col gap-2">
                        <label class="flex items-center gap-3 p-2.5">
                            <input id="rule-exclude-blacklisted" checked="" class="rounded text-primary focus:ring-primary bg-transparent border-slate-400" type="checkbox"/>
                            <span class="text-sm">Exclude blacklisted</span>
                        </label>
                        <label class="flex items-center gap-3 p-2.5">
                            <input id="rule-active-only" checked="" class="rounded text-primary focus:ring-primary bg-transparent border-slate-400" type="checkbox"/>
                            <span class="text-sm">Active only</span>
                        </label>
                        <label class="flex items-center gap-3 p-2.5">
                           <!-- Optional: Marketing opted-in -->
                            <input class="rounded text-primary focus:ring-primary bg-transparent border-slate-400" type="checkbox"/>
                            <span class="text-sm">Marketing opted-in</span>
                        </label>
                        <label class="flex items-center gap-3 p-2.5">
                            <input id="rule-verified" class="rounded text-primary focus:ring-primary bg-transparent border-slate-400" type="checkbox"/>
                            <span class="text-sm">Verified emails only</span>
                        </label>
                    </div>
                </div>
                <div class="flex flex-col justify-between border-t md:border-t-0 md:border-l border-slate-200 dark:border-border-dark pt-6 md:pt-0 md:pl-6">
                    <div class="flex flex-col gap-2">
                        <p class="text-xs font-bold text-slate-400 dark:text-[#c3b498] uppercase">Estimated recipients</p>
                        <div class="flex items-baseline gap-2">
                            <p id="preview-count" class="text-4xl font-black text-primary">-</p>
                            <!-- <span class="text-sm text-green-500 font-medium">+12% vs last week</span> -->
                        </div>
                        <p id="preview-text" class="text-xs text-slate-500 dark:text-[#c3b498] mt-1 leading-relaxed">Select filters to calculate.</p>
                    </div>
                    <div class="flex flex-col gap-2 mt-6">
                        <button onclick="createListFromGenerated()" class="w-full bg-primary text-background-dark font-bold py-3 rounded-lg hover:brightness-110 transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">save</span>
                            Create Distribution List
                        </button>
                        <button onclick="previewRecipients()" class="w-full bg-slate-200 dark:bg-border-dark text-slate-900 dark:text-white font-bold py-3 rounded-lg hover:bg-slate-300 dark:hover:bg-slate-700 transition-all flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">visibility</span>
                            Preview Recipients
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-primary/10 border border-primary/30 rounded-xl p-6 flex flex-col justify-center gap-4 relative overflow-hidden">
            <div class="absolute -right-4 -top-4 opacity-10">
                <span class="material-symbols-outlined text-9xl">groups</span>
            </div>
            <h3 class="text-lg font-bold text-primary">System Statistics</h3>
            <div class="flex flex-col gap-4 z-10">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold uppercase text-[#c3b498]">Total Reach</span>
                    <span class="font-black text-xl">--</span> 
                </div>
                <div class="w-full bg-slate-200 dark:bg-border-dark h-1.5 rounded-full overflow-hidden">
                    <div class="bg-primary h-full w-[75%]"></div>
                </div>
                <p class="text-xs text-slate-400 dark:text-[#c3b498]">75% of your database is currently reachable via active distribution lists.</p>
            </div>
            <a class="text-primary text-xs font-bold flex items-center gap-1 hover:underline mt-2" href="#">
                View reach analytics <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
        </div>
    </div>
</section>

<script>
    async function getRuleData() {
        return {
            includeEmployees: document.getElementById('rule-employees').checked,
            includeCustomers: document.getElementById('rule-customers').checked,
            includeAdmins: document.getElementById('rule-admins').checked,
            excludeBlacklistedCustomers: document.getElementById('rule-exclude-blacklisted').checked,
            onlyActiveUsers: document.getElementById('rule-active-only').checked,
            onlyVerifiedEmails: document.getElementById('rule-verified').checked,
            // manual emails could be added here if we add that field input
            manualEmailsRaw: "" 
        };
    }

    async function previewRecipients() {
        const rule = await getRuleData();
        
        try {
            const response = await fetch('/DistributionLists/PreviewRecipients', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(rule)
            });
            const data = await response.json();
            
            document.getElementById('preview-count').innerText = data.count;
            document.getElementById('preview-text').innerText = `Based on filters, this list includes ${data.count} recipients.`;
            
            // Should show valid recipients modal or list
             alert(`Found ${data.count} recipients.`);

        } catch (error) {
            console.error('Error:', error);
            alert('Failed to preview recipients.');
        }
    }

    async function createListFromGenerated() {
        const name = document.getElementById('gen-list-name').value;
        if(!name) { alert('Please enter a list name'); return; }

        const rule = await getRuleData();
        
        try {
            const response = await fetch(`/DistributionLists/CreateFromGenerated?listName=${encodeURIComponent(name)}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(rule)
            });
            
            if (response.ok) {
                window.location.reload();
            } else {
                alert('Failed to create list');
            }

        } catch (error) {
             console.error('Error:', error);
             alert('Failed to create list.');
        }
    }
</script>
