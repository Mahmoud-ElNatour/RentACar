@* Shared popup notifications and confirmation modal *@
<div class="notification-container" data-popup-container aria-live="polite" aria-atomic="true">
    <span class="visually-hidden" data-popup-sr aria-live="polite" aria-atomic="true"></span>
</div>

<div class="modal fade global-popup-modal" id="globalConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header confirm-info">
                <h5 class="modal-title" id="globalConfirmTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="globalConfirmMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-light" id="globalConfirmCancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-popup-info" id="globalConfirmOk"></button>
            </div>
        </div>
    </div>
</div>
