</section>
<section class="w-full px-6 -mt-20 relative z-20 mb-20">
    <div class="max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="group flex flex-col items-center justify-center gap-2 rounded-xl p-10 bg-surface-dark border border-[#262626] hover:border-brand/50 transition-all duration-300 shadow-2xl">
                <span class="material-symbols-outlined text-5xl text-brand mb-2">history</span>
                <p class="text-5xl font-bold text-white">10+</p>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mt-2">Years of Service</p>
            </div>
            <div class="group flex flex-col items-center justify-center gap-2 rounded-xl p-10 bg-surface-dark border border-[#262626] hover:border-brand/50 transition-all duration-300 shadow-2xl">
                <span class="material-symbols-outlined text-5xl text-brand mb-2">directions_car</span>
                <p class="text-5xl font-bold text-white">500+</p>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mt-2">Premium Vehicles</p>
            </div>
            <div class="group flex flex-col items-center justify-center gap-2 rounded-xl p-10 bg-surface-dark border border-[#262626] hover:border-brand/50 transition-all duration-300 shadow-2xl">
                <span class="material-symbols-outlined text-5xl text-brand mb-2">sentiment_satisfied</span>
                <p class="text-5xl font-bold text-white">15k+</p>
                <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mt-2">Happy Customers</p>
            </div>
        </div>
    </div>
</section>
<section class="w-full py-20 px-6 md:px-20 bg-gradient-to-b from-background-dark to-surface-dark/30">
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div class="space-y-12">
            <div>
                <h2 class="text-3xl font-bold mb-6 flex items-center gap-4 text-white">
                    <span class="w-1.5 h-10 bg-brand rounded-full box-border shadow-[0_0_10px_rgba(238,192,43,0.5)]"></span>
                    Our Mission
                </h2>
                <p class="text-gray-400 text-lg leading-relaxed font-body">
                    To provide a seamless, transparent, and luxurious car rental experience across Lebanon, empowering travelers and businesses alike with administrative excellence and unwavering reliability. We believe renting a car should be as enjoyable as driving one.
                </p>
            </div>
            <div>
                <h2 class="text-3xl font-bold mb-6 flex items-center gap-4 text-white">
                    <span class="w-1.5 h-10 bg-brand rounded-full box-border shadow-[0_0_10px_rgba(238,192,43,0.5)]"></span>
                    Our Vision
                </h2>
                <p class="text-gray-400 text-lg leading-relaxed font-body">
                    To become the undisputed leader in mobility solutions in the Middle East, setting the standard for quality, safety, and customer satisfaction through innovation and a customer-first approach.
                </p>
            </div>
        </div>
        <div class="relative h-[500px] w-full rounded-2xl overflow-hidden shadow-2xl ring-1 ring-[#262626]">
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10"></div>
            <img alt="Fleet of black luxury cars parked in a row" class="w-full h-full object-cover opacity-80" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDhk64CqBgW2MJu3AG5JkCGtoRHdcrf6GloNG5HXYDQya_L_LGtTsnJ-WnWbUTosOox5Su9Tsq3r2k96MXbNV4v-wUpbf6OCtopWOD9JavTAYWfTnaKHQu771k9fUhCzlwL7RxG0-3PPIoasXqNCs1qvy3qF_NOVsUv3gD2e30GX4ET695LgLNsSJOer0aBPKTzC8ocqSztIJZ0gVofCdjAIKcFBCBEzKrVunMy-pF_Xj35zhhupG_C8gY73I2PnxGC8V3PwPQ8LntA" />
            <div class="absolute bottom-8 left-8 right-8 z-20">
                <div class="bg-black/60 backdrop-blur-md p-6 rounded-xl border border-[#393528]">
                    <div class="flex items-center gap-4 mb-3">
                        <div class="p-2 bg-brand/20 rounded-full text-brand border border-brand/20">
                            <span class="material-symbols-outlined">verified_user</span>
                        </div>
                        <h3 class="text-xl font-bold text-white">Trust &amp; Security</h3>
                    </div>
                    <p class="text-gray-400 text-sm">Every vehicle in our fleet undergoes rigorous 150-point inspection before it reaches you.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="w-full py-24 px-6 md:px-20 bg-background-dark">
    <div class="max-w-[1200px] mx-auto text-center mb-16">
        <span class="text-brand font-bold tracking-widest uppercase text-sm mb-2 block">Our Core Values</span>
        <h2 class="text-3xl md:text-5xl font-black text-white">Why Choose <span class="text-brand">RentCarLB</span>?</h2>
    </div>
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-surface-dark p-8 rounded-2xl border border-[#262626] hover:border-brand/40 transition-all duration-300 group">
            <div class="w-14 h-14 bg-surface-accent rounded-xl flex items-center justify-center text-brand mb-6 group-hover:scale-110 transition-transform duration-300 border border-[#333]">
                <span class="material-symbols-outlined text-3xl">support_agent</span>
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">24/7 Support</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
                Our dedicated team is always on standby to assist you, whether it's a booking inquiry or roadside assistance, ensuring peace of mind around the clock.
            </p>
        </div>
        <div class="bg-surface-dark p-8 rounded-2xl border border-[#262626] hover:border-brand/40 transition-all duration-300 group">
            <div class="w-14 h-14 bg-surface-accent rounded-xl flex items-center justify-center text-brand mb-6 group-hover:scale-110 transition-transform duration-300 border border-[#333]">
                <span class="material-symbols-outlined text-3xl">payments</span>
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">Transparent Pricing</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
                What you see is what you pay. No hidden fees, no surprises at the counter. We pride ourselves on clear, upfront pricing models.
            </p>
        </div>
        <div class="bg-surface-dark p-8 rounded-2xl border border-[#262626] hover:border-brand/40 transition-all duration-300 group">
            <div class="w-14 h-14 bg-surface-accent rounded-xl flex items-center justify-center text-brand mb-6 group-hover:scale-110 transition-transform duration-300 border border-[#333]">
                <span class="material-symbols-outlined text-3xl">diamond</span>
            </div>
            <h3 class="text-xl font-bold mb-4 text-white">Premium Fleet</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
                From economical city cars to high-end luxury SUVs, our diverse fleet is meticulously maintained to offer the best driving experience.
            </p>
        </div>
    </div>
</section>
