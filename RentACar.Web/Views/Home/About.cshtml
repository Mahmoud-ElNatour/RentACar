}

<section class="relative w-full flex flex-col items-center justify-center min-h-[60vh] px-6 py-24 text-center overflow-hidden">
    <div class="absolute inset-0 z-0 bg-cover bg-center bg-no-repeat" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuAYN7lV0Ib885RLBkCavZhkyO0JK2iwV3KraX5X3Grh77IuTJPvRnEzLli4aha4ZzwXCDI8Iwvv_7FlcBhsDnX4EFvoFtaOGZcQmLUCUnc_Xxn8chY3JSUCl27MNwMMb-ujNEb6iIeBqyqFV_UfvCe23Z_xLqgATg-GmwoCB4MNNFAShFIXzxsqhfwDotiWkfUGOMMEM2x3B5lOJRqhhneDPC5pEDfbEEplr6Blxy32Ofjnm688j-rPL3-QemkcugIVfA1ezuZp4dLr");'>
