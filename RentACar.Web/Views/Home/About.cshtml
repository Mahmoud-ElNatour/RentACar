@{
    ViewData["Title"] = "About Us";
}

<div class="bg-footer-bg min-h-screen text-gray-300 font-display p-6 md:p-12">
    <div class="max-w-6xl mx-auto">
        <!-- Hero Section -->
        <div class="text-center mb-16 relative">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>
            <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight relative z-10">
                Driven by <span class="text-gold">Excellence</span>
            </h1>
            <p class="text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed relative z-10">
                We are more than just a car rental company. We are your partner in exploring Lebanon with comfort, style, and reliability.
            </p>
        </div>

        <!-- Mission & Vision Cards -->
        <div class="grid md:grid-cols-2 gap-8 mb-20">
            <div class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-sm relative overflow-hidden group hover:border-gold/30 transition-all duration-500">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gold/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:bg-gold/10 transition-colors"></div>
                <div class="w-12 h-12 bg-gradient-to-br from-gold/20 to-gold/5 rounded-xl flex items-center justify-center mb-6 text-gold ring-1 ring-gold/20 group-hover:scale-110 transition-transform duration-500">
                    <span class="material-symbols-outlined text-2xl">rocket_launch</span>
                </div>
                <h2 class="text-2xl font-bold text-white mb-4">Our Mission</h2>
                <p class="text-gray-400 leading-relaxed">
                    To provide a seamless, premium car rental experience that empowers our customers to discover the beauty of Lebanon. We strive to offer the highest quality fleet and exceptional customer service at every turn.
                </p>
            </div>

            <div class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-sm relative overflow-hidden group hover:border-gold/30 transition-all duration-500">
                <div class="absolute top-0 right-0 w-32 h-32 bg-gold/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:bg-gold/10 transition-colors"></div>
                <div class="w-12 h-12 bg-gradient-to-br from-gold/20 to-gold/5 rounded-xl flex items-center justify-center mb-6 text-gold ring-1 ring-gold/20 group-hover:scale-110 transition-transform duration-500">
                    <span class="material-symbols-outlined text-2xl">visibility</span>
                </div>
                <h2 class="text-2xl font-bold text-white mb-4">Our Vision</h2>
                <p class="text-gray-400 leading-relaxed">
                    To become the leading car rental service in the region, known for innovation, trust, and setting new standards in the luxury and economy mobility sectors.
                </p>
            </div>
        </div>

        <!-- Why Choose Us -->
        <div class="mb-20">
            <h2 class="text-3xl font-bold text-white mb-10 text-center">Why Choose <span class="text-gold">RentCarLB</span></h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-black/20 border border-white/5 p-6 rounded-2xl hover:bg-white/5 transition-colors text-center group">
                    <span class="material-symbols-outlined text-4xl text-gold mb-4 group-hover:scale-110 transition-transform duration-300">directions_car</span>
                    <h3 class="text-lg font-bold text-white mb-2">Premium Fleet</h3>
                    <p class="text-sm text-gray-400">Maintained to the highest standards for your safety and comfort.</p>
                </div>
                <div class="bg-black/20 border border-white/5 p-6 rounded-2xl hover:bg-white/5 transition-colors text-center group">
                    <span class="material-symbols-outlined text-4xl text-gold mb-4 group-hover:scale-110 transition-transform duration-300">support_agent</span>
                    <h3 class="text-lg font-bold text-white mb-2">24/7 Support</h3>
                    <p class="text-sm text-gray-400">Our dedicated team is always ready to assist you on your journey.</p>
                </div>
                <div class="bg-black/20 border border-white/5 p-6 rounded-2xl hover:bg-white/5 transition-colors text-center group">
                    <span class="material-symbols-outlined text-4xl text-gold mb-4 group-hover:scale-110 transition-transform duration-300">payments</span>
                    <h3 class="text-lg font-bold text-white mb-2">Transparent Pricing</h3>
                    <p class="text-sm text-gray-400">No hidden fees. What you see is exactly what you pay.</p>
                </div>
                <div class="bg-black/20 border border-white/5 p-6 rounded-2xl hover:bg-white/5 transition-colors text-center group">
                    <span class="material-symbols-outlined text-4xl text-gold mb-4 group-hover:scale-110 transition-transform duration-300">verified_user</span>
                    <h3 class="text-lg font-bold text-white mb-2">Secure & Easy</h3>
                    <p class="text-sm text-gray-400">Seamless booking process with top-tier data security.</p>
                </div>
            </div>
        </div>

        <!-- Contact CTA -->
        <div class="bg-gradient-to-r from-gold/20 to-gold/5 border border-gold/10 rounded-3xl p-10 text-center relative overflow-hidden">
             <div class="absolute inset-0 bg-[url('/img/pattern.png')] opacity-10 mix-blend-overlay"></div>
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 relative z-10">Ready to start your journey?</h2>
            <p class="text-gray-300 mb-8 max-w-xl mx-auto relative z-10">Browse our extensive collection of vehicles and find the perfect one for your next adventure.</p>
            <div class="flex justify-center gap-4 relative z-10">
                <a asp-controller="Browse" asp-action="Index" class="px-8 py-3 rounded-xl bg-gold text-footer-bg font-bold hover:bg-gold-hover hover:scale-105 transition-all shadow-lg shadow-gold/20">
                    Browse Fleet
                </a>
                <a asp-controller="Home" asp-action="Contact" class="px-8 py-3 rounded-xl bg-white/10 text-white font-bold border border-white/10 hover:bg-white/20 hover:scale-105 transition-all">
                    Contact Us
                </a>
            </div>
        </div>
    </div>
</div>
