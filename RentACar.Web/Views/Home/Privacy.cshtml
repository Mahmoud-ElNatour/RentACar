@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["BodyClass"] = "bg-[#050505] text-white font-display antialiased selection:bg-brand/30 selection:text-white text-left";
}
<link href="~/css/privacy.css" rel="stylesheet" />

<div class="relative w-full bg-[#050505] pt-20 pb-12">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-64 bg-brand/5 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
        <div class="inline-flex items-center justify-center p-3 rounded-full bg-[#1a1a1a] border border-[#333] mb-6 shadow-2xl">
            <span class="material-symbols-outlined text-brand text-2xl">security</span>
        </div>
        <h1 class="text-white text-5xl md:text-6xl font-black tracking-tight leading-tight mb-4">
            Privacy <span class="text-brand">Policy</span>
        </h1>
        <div class="flex items-center justify-center gap-2 text-sm text-[#7e7868] font-medium uppercase tracking-wider">
            <span class="material-symbols-outlined text-base">update</span>
            <span>Last Updated: October 26, 2023</span>
        </div>
    </div>
</div>
<main class="max-w-5xl mx-auto px-8 sm:px-6 pb-24">
    <div class="mb-12 p-6 rounded-xl bg-[#121212] border border-[#2a2a2a]">
        <h3 class="text-brand font-bold text-sm uppercase tracking-widest mb-4">Contents</h3>
        <nav class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-8">
            <a class="group flex items-center gap-3 text-[#b9b29d] hover:text-white transition-colors" href="#section-1">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#2a2a2a] text-xs font-bold text-[#7e7868] group-hover:bg-brand group-hover:text-black transition-colors">1</span>
                <span class="text-sm font-medium border-b border-transparent group-hover:border-brand/50">Information We Collect</span>
            </a>
            <a class="group flex items-center gap-3 text-[#b9b29d] hover:text-white transition-colors" href="#section-2">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#2a2a2a] text-xs font-bold text-[#7e7868] group-hover:bg-brand group-hover:text-black transition-colors">2</span>
                <span class="text-sm font-medium border-b border-transparent group-hover:border-brand/50">How We Use Your Information</span>
            </a>
            <a class="group flex items-center gap-3 text-[#b9b29d] hover:text-white transition-colors" href="#section-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#2a2a2a] text-xs font-bold text-[#7e7868] group-hover:bg-brand group-hover:text-black transition-colors">3</span>
                <span class="text-sm font-medium border-b border-transparent group-hover:border-brand/50">Data Sharing &amp; Third Parties</span>
            </a>
            <a class="group flex items-center gap-3 text-[#b9b29d] hover:text-white transition-colors" href="#section-4">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#2a2a2a] text-xs font-bold text-[#7e7868] group-hover:bg-brand group-hover:text-black transition-colors">4</span>
                <span class="text-sm font-medium border-b border-transparent group-hover:border-brand/50">Data Security</span>
            </a>
            <a class="group flex items-center gap-3 text-[#b9b29d] hover:text-white transition-colors" href="#section-5">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#2a2a2a] text-xs font-bold text-[#7e7868] group-hover:bg-brand group-hover:text-black transition-colors">5</span>
                <span class="text-sm font-medium border-b border-transparent group-hover:border-brand/50">Your Rights</span>
            </a>
        </nav>
    </div>
    <div class="bg-[#121212] rounded-2xl p-8 md:p-12 border border-[#2a2a2a] shadow-2xl">
        <div class="mb-16">
            <p class="text-lg md:text-xl text-[#dcd7c9] leading-relaxed">
                At Rent a Car Lebanon, we prioritize the privacy and security of our customers above all else. This policy outlines exactly how we handle your personal data in compliance with Lebanese regulations and international data protection standards (GDPR where applicable). When you book a vehicle with us, you trust us with your information, and we take that responsibility seriously.
            </p>
        </div>
        <section id="section-1" class="scroll-mt-24 mb-16">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 flex items-center gap-3">
                <span class="text-brand">01.</span> Information We Collect
            </h2>
            <p class="text-[#b9b29d] leading-7 mb-6">
                To provide our rental services efficiently, we collect several types of information from you when you use our online booking system or visit our administrative offices.
            </p>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none">
                <li class="p-5 rounded-lg bg-[#0a0a0a] border border-[#2a2a2a]">
                    <div class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-brand">badge</span>
                        <div>
                            <h4 class="text-white font-bold mb-1">Personal Identification</h4>
                            <p class="text-sm text-[#888] leading-relaxed">Full name, date of birth, passport number, and nationality required for the rental contract.</p>
                        </div>
                    </div>
                </li>
                <li class="p-5 rounded-lg bg-[#0a0a0a] border border-[#2a2a2a]">
                    <div class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-brand">directions_car</span>
                        <div>
                            <h4 class="text-white font-bold mb-1">Driver's License</h4>
                            <p class="text-sm text-[#888] leading-relaxed">Valid driver's license number, issuing country, and expiration date to verify eligibility.</p>
                        </div>
                    </div>
                </li>
                <li class="p-5 rounded-lg bg-[#0a0a0a] border border-[#2a2a2a] md:col-span-2">
                    <div class="flex items-start gap-4">
                        <span class="material-symbols-outlined text-brand">credit_card</span>
                        <div>
                            <h4 class="text-white font-bold mb-1">Payment Information</h4>
                            <p class="text-sm text-[#888] leading-relaxed">Credit card details for deposits and rental fees. We use encrypted payment gateways and do not store sensitive CVV codes.</p>
                        </div>
                    </div>
                </li>
            </ul>
        </section>
        <div class="w-full h-px bg-[#2a2a2a] my-12"></div>
        <section id="section-2" class="scroll-mt-24 mb-16">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 flex items-center gap-3">
                <span class="text-brand">02.</span> How We Use Your Information
            </h2>
            <p class="text-[#b9b29d] leading-7 mb-6">
                We use the information we collect primarily to facilitate your car rental booking and ensure the security of our fleet. Specifically, your data helps us:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-5 rounded-lg bg-[#0a0a0a] border-l-2 border-brand">
                    <h4 class="text-white font-bold mb-2">Booking Processing</h4>
                    <p class="text-sm text-[#888]">Confirming your reservation and preparing your vehicle.</p>
                </div>
                <div class="p-5 rounded-lg bg-[#0a0a0a] border-l-2 border-brand">
                    <h4 class="text-white font-bold mb-2">Fraud Prevention</h4>
                    <p class="text-sm text-[#888]">Verifying identity to prevent theft and unauthorized usage.</p>
                </div>
                <div class="p-5 rounded-lg bg-[#0a0a0a] border-l-2 border-brand">
                    <h4 class="text-white font-bold mb-2">Legal Compliance</h4>
                    <p class="text-sm text-[#888]">Adhering to Lebanese traffic and transport regulations.</p>
                </div>
                <div class="p-5 rounded-lg bg-[#0a0a0a] border-l-2 border-brand">
                    <h4 class="text-white font-bold mb-2">Customer Support</h4>
                    <p class="text-sm text-[#888]">Resolving issues regarding your rental or billing.</p>
                </div>
            </div>
        </section>
        <div class="w-full h-px bg-[#2a2a2a] my-12"></div>
        <section id="section-3" class="scroll-mt-24 mb-16">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 flex items-center gap-3">
                <span class="text-brand">03.</span> Data Sharing &amp; Third Parties
            </h2>
            <div class="bg-[#0a0a0a] rounded-xl p-6 border border-[#2a2a2a]">
                <p class="text-[#b9b29d] leading-7 mb-4">
                    We do not sell your personal data. However, we may share necessary information with trusted third parties to provide our services:
                </p>
                <ul class="space-y-3">
                    <li class="flex items-start gap-3 text-[#dcd7c9]">
                        <span class="material-symbols-outlined text-brand text-sm mt-1">arrow_forward_ios</span>
                        <span><strong class="text-white">Insurance Providers:</strong> To process claims and ensure vehicle coverage during your rental period.</span>
                    </li>
                    <li class="flex items-start gap-3 text-[#dcd7c9]">
                        <span class="material-symbols-outlined text-brand text-sm mt-1">arrow_forward_ios</span>
                        <span><strong class="text-white">Payment Processors:</strong> To securely handle transaction data.</span>
                    </li>
                    <li class="flex items-start gap-3 text-[#dcd7c9]">
                        <span class="material-symbols-outlined text-brand text-sm mt-1">arrow_forward_ios</span>
                        <span><strong class="text-white">Law Enforcement:</strong> If required by Lebanese law in the event of traffic violations or criminal investigations.</span>
                    </li>
                </ul>
            </div>
        </section>
        <div class="w-full h-px bg-[#2a2a2a] my-12"></div>
        <section id="section-4" class="scroll-mt-24 mb-16">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 flex items-center gap-3">
                <span class="text-brand">04.</span> Data Security
            </h2>
            <div class="relative overflow-hidden rounded-xl bg-[#0a0a0a] border border-[#2a2a2a] p-8">
                <div class="absolute -right-6 -bottom-6 opacity-[0.03]">
                    <span class="material-symbols-outlined text-[200px]">lock_person</span>
                </div>
                <p class="text-[#b9b29d] leading-7 mb-6 relative z-10">
                    We employ industry-standard security measures to protect your data from unauthorized access, alteration, or disclosure.
                </p>
                <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 relative z-10">
                    <li class="flex flex-col gap-2 p-4 rounded bg-[#121212] border border-[#222]">
                        <span class="material-symbols-outlined text-green-500 text-2xl">check_circle</span>
                        <span class="text-sm font-bold text-white">SSL Encryption</span>
                        <span class="text-xs text-[#666]">256-bit secure transfer</span>
                    </li>
                    <li class="flex flex-col gap-2 p-4 rounded bg-[#121212] border border-[#222]">
                        <span class="material-symbols-outlined text-green-500 text-2xl">database</span>
                        <span class="text-sm font-bold text-white">Secure Storage</span>
                        <span class="text-xs text-[#666]">Restricted database access</span>
                    </li>
                    <li class="flex flex-col gap-2 p-4 rounded bg-[#121212] border border-[#222]">
                        <span class="material-symbols-outlined text-green-500 text-2xl">shield</span>
                        <span class="text-sm font-bold text-white">Regular Audits</span>
                        <span class="text-xs text-[#666]">System vulnerability checks</span>
                    </li>
                </ul>
            </div>
        </section>
        <div class="w-full h-px bg-[#2a2a2a] my-12"></div>
        <section id="section-5" class="scroll-mt-24">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 flex items-center gap-3">
                <span class="text-brand">05.</span> Your Rights
            </h2>
            <div class="flex flex-col md:flex-row gap-6 items-start">
                <div class="flex-1">
                    <p class="text-[#b9b29d] leading-7 mb-4">
                        You have the right to access, correct, or delete your personal data held by us. If you wish to exercise these rights, please contact our support team. Note that we may be required to retain certain data for legal or accounting purposes for a specific period.
                    </p>
                </div>
                <div class="shrink-0">
                    <button class="bg-brand text-black px-8 py-4 rounded-lg font-bold text-sm hover:bg-white transition-colors flex items-center gap-2 shadow-lg shadow-brand/10">
                        <span class="material-symbols-outlined">mail</span>
                        Contact Privacy Officer
                    </button>
                </div>
            </div>
        </section>
    </div>
</main>
