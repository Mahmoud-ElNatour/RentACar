</script>

<style>
    /* Custom Scrollbar for sidebars if needed */
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #16181a; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #262626; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #d4af37; }

    /* Dual Slider Styles */
    .thumb-styled {
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
        pointer-events: none;
    }
    .thumb-styled::-webkit-slider-thumb {
        pointer-events: auto;
        -webkit-appearance: none;
        height: 18px;
        width: 18px;
        border-radius: 50%;
        background: #d4af37; /* Gold */
        cursor: grab;
        border: 2px solid #000; /* Contrast ring */
        margin-top: -6px; /* Center vert on track h-2 (8px) -> 18px thumb needs -5px offset relative to top? or center. */
        box-shadow: 0 0 5px rgba(0,0,0,0.5);
    }
    .thumb-styled::-moz-range-thumb {
        pointer-events: auto;
        border: 2px solid #000;
        height: 18px;
        width: 18px;
        border-radius: 50%;
        background: #d4af37;
        cursor: grab;
