                                 $@(Model.FilterMinPrice?.ToString("0") ?? "0") - $@(Model.FilterMaxPrice?.ToString("0") ?? "2000")
                             </span>
                         </div>

                         <div class="relative h-2 bg-[#262626] rounded-full">
                             <!-- Active Track -->
                             <div id="sliderTrack" class="absolute h-full bg-gold rounded-full" style="left: 0%; right: 0%;"></div>

                             <!-- Thumbs (Range Inputs) -->
                             <input type="range" name="minPrice" id="minPriceRange" min="0" max="2000" step="50" value="@(Model.FilterMinPrice ?? 0)"
                                    class="thumb-styled absolute w-full h-full inset-0 z-20" />

                             <input type="range" name="maxPrice" id="maxPriceRange" min="0" max="2000" step="50" value="@(Model.FilterMaxPrice ?? 2000)"
                                    class="thumb-styled absolute w-full h-full inset-0 z-20" />
                         </div>
                    </div>

                    <div class="pt-4 border-t border-white/10 flex gap-3">
                        <a href="/Browse" class="flex-1 py-3 rounded-xl border border-[#262626] text-gray-400 text-sm font-bold hover:text-white hover:border-gray-500 transition-colors text-center">
                            Reset
                        </a>
                        <button type="submit" class="flex-[2] bg-gold hover:bg-[#b5952f] text-black py-3 rounded-xl font-bold shadow-lg shadow-gold/10 transition-all hover:scale-105 active:scale-95">
                            Update Results
                        </button>
                    </div>
                </form>
             </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="flex-1 w-full">
            
            <!-- Result Bar -->
            <div class="flex flex-col sm:flex-row justify-between items-end sm:items-center gap-4 mb-8">
                <div>
                     <h1 class="text-3xl md:text-4xl font-black tracking-tight mb-2 hidden md:block">
                        Browse Cars
                    </h1>
                    <p class="text-gray-400">
                        Showing <span class="text-white font-bold">@Model.Cars.Count()</span> available cars
                    </p>
                </div>
                <!-- Sort -->
                <div class="flex items-center gap-2">
                     <select onchange="updateSort(this.value)" class="bg-[#16181a] border border-[#262626] rounded-lg py-2 pl-3 pr-8 text-sm text-white focus:border-gold focus:ring-0 cursor-pointer">
                         <!option value="" @(string.IsNullOrEmpty(Model.SortOrder) ? "selected" : "")>Recommended</!option>
                         <!option value="price_asc" @(Model.SortOrder == "price_asc" ? "selected" : "")>Price: Low to High</!option>
                         <!option value="price_desc" @(Model.SortOrder == "price_desc" ? "selected" : "")>Price: High to Low</!option>
                     </select>
                </div>
            </div>

            <!-- CAR GRID (3 Cols) -->
            @if(!Model.Cars.Any())
            {
                <div class="flex flex-col items-center justify-center py-20 text-center border-2 border-dashed border-[#262626] rounded-3xl">
                     <div class="w-20 h-20 rounded-full bg-[#16181a] flex items-center justify-center mb-4">
                         <span class="material-symbols-outlined text-4xl text-gray-600">no_crash</span>
                     </div>
                     <h3 class="text-xl font-bold text-white mb-2">No cars available</h3>
                     <p class="text-gray-400 max-w-sm mb-6">Try adjusting your dates or category filters.</p>
                     <a href="/Browse" class="text-gold font-bold hover:underline">Clear all filters</a>
                </div>
            }
            else
            {
                <div id="carGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <partial name="_CarGridItems" model="Model.Cars" />
                </div>
                
                @if(Model.HasMore)
                {
                    <div class="mt-12 text-center" id="loadMoreContainer">
                        <button id="loadMoreBtn" onclick="loadMoreCars()" 
                                class="bg-[#16181a] border border-[#262626] text-white px-8 py-3 rounded-xl font-bold hover:bg-[#262626] hover:border-gold/50 transition-all flex items-center gap-2 mx-auto">
                            <span>Show More Cars</span>
                            <span class="material-symbols-outlined text-gold" id="loadBtnIcon">expand_more</span>
                            <span class="w-4 h-4 border-2 border-gold border-t-transparent rounded-full animate-spin hidden" id="loadBtnSpinner"></span>
                        </button>
                    </div>
                }
            }
        </main>
    </div>
</div>

<script>
    function toggleFilters() {
        const sidebar = document.getElementById('filtersSidebar');
        sidebar.classList.toggle('-translate-x-full');
    }

    function updateSort(val) {
        document.getElementById('hSortOrder').value = val;
        document.getElementById('filterForm').submit();
    }

    // --- Pagination Logic ---
    let currPage = @Model.CurrentPage;
    const totalPages = @Model.TotalPages;
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    
    async function loadMoreCars() {
        if(currPage >= totalPages) return;
        
        const btn = loadMoreBtn;
        const icon = document.getElementById('loadBtnIcon');
        const spinner = document.getElementById('loadBtnSpinner');
        
        // Loading State
        btn.disabled = true;
        icon.classList.add('hidden');
        spinner.classList.remove('hidden');
        
        try {
            const nextPage = currPage + 1;
            const params = new URLSearchParams(window.location.search);
            params.set('page', nextPage);
            
            const res = await fetch(`/Browse/LoadMore?${params.toString()}`);
            if(res.ok) {
                const html = await res.text();
                // Append
                document.getElementById('carGrid').insertAdjacentHTML('beforeend', html);
                currPage = nextPage;
                
                if(currPage >= totalPages) {
                    document.getElementById('loadMoreContainer').remove();
                }
            }
        } catch(err) {
            console.error(err);
        } finally {
            if(document.contains(btn)) {
                btn.disabled = false;
                icon.classList.remove('hidden');
                spinner.classList.add('hidden');
            }
        }
    }

    // --- Custom Calendar Logic ---
    let currDate = new Date();
    let selStart = document.getElementById('hStartDate').value ? new Date(document.getElementById('hStartDate').value) : null;
    let selEnd = document.getElementById('hEndDate').value ? new Date(document.getElementById('hEndDate').value) : null;
    
    // Handle Timezone offset manually for Date inputs to match local/UTC
    function toISODate(d) {
        if(!d) return '';
        return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function renderCalendar() {
        const year = currDate.getFullYear();
        const month = currDate.getMonth();
        
        document.getElementById('calMonthYear').innerText = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(currDate);
        
        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const daysInMonth = lastDay.getDate();
        const startDay = firstDay.getDay(); // 0 is Sunday
        
        const grid = document.getElementById('calGrid');
        grid.innerHTML = '';
        
        // Empty cells for start padding
        for(let i=0; i<startDay; i++) {
            grid.innerHTML += '<div></div>';
        }
        
        const today = new Date();
        today.setHours(0,0,0,0);

        for(let i=1; i<=daysInMonth; i++) {
            const date = new Date(year, month, i);
            const isPast = date < today;
            
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.innerText = i;
            btn.className = 'w-8 h-8 rounded-lg flex items-center justify-center transition-all text-gray-300 hover:bg-white/10 mx-auto';
            
            if(isPast) {
                btn.classList.add('opacity-30', 'cursor-not-allowed');
                btn.disabled = true;
            } else {
                btn.onclick = () => selectDate(date);
            }

            // Highlighting
            if(selStart && date.getTime() === selStart.getTime()) btn.classList.add('bg-gold', 'text-black', 'font-bold');
            else if(selEnd && date.getTime() === selEnd.getTime()) btn.classList.add('bg-gold', 'text-black', 'font-bold');
            else if(selStart && selEnd && date > selStart && date < selEnd) btn.classList.add('bg-gold/20', 'text-gold');
            
            grid.appendChild(btn);
        }
        
        updateSummary();
    }

    function changeMonth(dir) {
        currDate.setMonth(currDate.getMonth() + dir);
        renderCalendar();
    }

    function selectDate(date) {
        // Reset if both selected or picking before start
        if(selStart && selEnd) {
            selStart = date;
            selEnd = null;
        } else if (!selStart) {
            selStart = date;
        } else if (date < selStart) {
            selStart = date;
        } else if (date.getTime() === selStart.getTime()) {
             // do nothing or deselect? Keep start.
        } else {
            selEnd = date;
        }
        
        renderCalendar();
    }
    
    function updateSummary() {
        const sInput = document.getElementById('hStartDate');
        const eInput = document.getElementById('hEndDate');
        const txt = document.getElementById('periodText');
        const countBadge = document.getElementById('daysCount');
        
        if(selStart) sInput.value = toISODate(selStart);
        if(selEnd) eInput.value = toISODate(selEnd);
        else if(!selStart) { sInput.value = ''; eInput.value = ''; }
        
        if(selStart && selEnd) {
             const diff = Math.ceil((selEnd - selStart) / (1000 * 60 * 60 * 24));
             const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
             txt.innerText = `${fmt.format(selStart)} - ${fmt.format(selEnd)}`;
             countBadge.innerText = `${diff} DAYS`;
             countBadge.classList.remove('hidden');
        } else if(selStart) {
             const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
             txt.innerText = `${fmt.format(selStart)} - Select End Date`;
             countBadge.classList.add('hidden');
        } else {
            txt.innerText = 'Select rental dates';
            countBadge.classList.add('hidden');
        }
    }

    // --- Dual Slider Logic ---
    function initDualSlider() {
        const minInput = document.getElementById('minPriceRange');
        const maxInput = document.getElementById('maxPriceRange');
        const track = document.getElementById('sliderTrack');
        const label = document.getElementById('priceLabel');
        const maxLimit = 2000;

        function updateSlider() {
            let minVal = parseInt(minInput.value);
            let maxVal = parseInt(maxInput.value);

            // Enforce gap
            if (maxVal - minVal < 50) {
                if (this === minInput) minInput.value = maxVal - 50;
                else maxInput.value = minVal + 50;
            }
            
            // Re-read after enforcement
            minVal = parseInt(minInput.value);
            maxVal = parseInt(maxInput.value);

            // Visually order z-index
            if(minVal > maxLimit - 100) minInput.style.zIndex = 20; // prevent blocking
            
            // Update Track
            const minPercent = (minVal / maxLimit) * 100;
            const maxPercent = (maxVal / maxLimit) * 100;
            track.style.left = minPercent + "%";
            track.style.width = (maxPercent - minPercent) + "%";
            
            // Update Label
            label.innerText = `$${minVal} - $${maxVal}`;
        }

        minInput.addEventListener('input', updateSlider);
        maxInput.addEventListener('input', updateSlider);
        
        // Initial call
        updateSlider();
    }

    // Init
    renderCalendar();
    initDualSlider();
</script>

