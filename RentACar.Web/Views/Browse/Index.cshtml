             <div class="bg-[#16181a] border border-[#262626] md:rounded-2xl p-6 shadow-2xl h-full md:h-auto">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold flex items-center gap-2">
                        <span class="material-symbols-outlined text-gold">tune</span> Filters
