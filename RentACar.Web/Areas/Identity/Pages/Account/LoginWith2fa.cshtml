@page
@model LoginWith2faModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Two-factor authentication";
    ViewData["BodyClass"] = "bg-background-dark";
}

<div class="flex items-center justify-center min-h-[calc(100vh-300px)] py-16 px-4">
    <div class="w-full max-w-md space-y-8 bg-[#171717] p-10 rounded-2xl shadow-xl border border-white/5">
        <div class="text-center">
            <div class="flex justify-center mb-6">
                <div class="h-20 w-20 rounded-full bg-gold/10 flex items-center justify-center border border-gold/20">
                    <span class="material-symbols-outlined text-gold text-5xl">security</span>
                </div>
            </div>
            <h1 class="text-3xl font-bold text-white mb-2">
                @if (Model.MfaProvider == "Email") { <text>Check Your Email</text> } else { <text>Authenticator App</text> }
            </h1>
            <p class="text-gray-400">
                @if (Model.MfaProvider == "Email") { <text>We sent a verification code to your email.</text> } else { <text>Enter the code from your authenticator app.</text> }
            </p>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-mfaProvider="@Model.MfaProvider" class="space-y-6">
            <input asp-for="RememberMe" type="hidden" />
            <input type="hidden" name="mfaProvider" value="@Model.MfaProvider" />
            
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm text-center bg-red-500/10 p-2 rounded border border-red-500/20" role="alert"></div>
            
            <div class="space-y-2">
                <label asp-for="Input.TwoFactorCode" class="block text-sm font-medium text-gray-300">Verification Code</label>
                <input asp-for="Input.TwoFactorCode" class="block w-full bg-[#1a1a1a] border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-all text-center text-2xl tracking-widest font-mono" autocomplete="off" placeholder="000000" />
                <span asp-validation-for="Input.TwoFactorCode" class="text-red-400 text-xs"></span>
            </div>

            <div class="flex items-center">
                <label asp-for="Input.RememberMachine" class="inline-flex items-center cursor-pointer">
                    <input asp-for="Input.RememberMachine" type="checkbox" class="w-4 h-4 rounded border-gray-600 bg-[#1a1a1a] text-gold focus:ring-gold focus:ring-offset-0" />
                    <span class="ml-2 text-sm text-gray-400">Remember this machine</span>
                </label>
            </div>

            <button type="submit" class="w-full inline-flex items-center justify-center px-6 py-3.5 border border-transparent text-base font-bold rounded-lg text-black bg-gold hover:bg-gold-hover transition-all duration-300 shadow-lg">
                Verify
            </button>
        </form>

        @if (Model.ShowMethodSwitcher)
        {
            <div class="mt-4 text-center">
                @if (Model.MfaProvider == "Authenticator")
                {
                    <a asp-page="./LoginWith2fa" asp-route-mfaProvider="Email" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" class="text-sm text-gold hover:text-white transition-colors underline decoration-gold/50 underline-offset-4">
                        Try another way: Send Email Code
                    </a>
                }
                else
                {
                    <a asp-page="./LoginWith2fa" asp-route-mfaProvider="Authenticator" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" class="text-sm text-gold hover:text-white transition-colors underline decoration-gold/50 underline-offset-4">
                        Try another way: Use Authenticator App
                    </a>
                }
            </div>
        }
        
        <div class="mt-6 text-center">
            <p class="text-sm text-gray-400">
                Don't have access to your device?
                <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-gold hover:text-white transition-colors font-semibold ml-1 underline decoration-gold decoration-1 underline-offset-4">Log in with a recovery code</a>.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
