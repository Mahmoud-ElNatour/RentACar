@page
@model AccessDeniedModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Access Denied";
    ViewData["BodyClass"] = "bg-background-dark";
}

<div class="flex items-center justify-center min-h-[calc(100vh-300px)] py-16 px-4">
    <div class="w-full max-w-md space-y-8 bg-[#171717] p-10 rounded-2xl shadow-xl border border-white/5 text-center">
        <div class="flex justify-center">
            <div class="h-20 w-20 rounded-full bg-red-500/10 flex items-center justify-center border border-red-500/20">
                <span class="material-symbols-outlined text-red-500 text-5xl">block</span>
            </div>
        </div>
        
        <div class="space-y-4">
             <h1 class="text-3xl font-bold text-white">@ViewData["Title"]</h1>
             <p class="text-gray-400 text-lg">You do not have permission to access this resource.</p>
        </div>

        <div class="mt-8">
             <a asp-area="" asp-controller="Home" asp-action="Index" class="inline-flex w-full items-center justify-center px-6 py-3.5 border border-transparent text-base font-bold rounded-lg text-black bg-gold hover:bg-gold-hover transition-all duration-300 shadow-lg">
                Return Home
            </a>
        </div>
    </div>
</div>
