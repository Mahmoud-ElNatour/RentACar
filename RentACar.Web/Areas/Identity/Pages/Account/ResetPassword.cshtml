@page
@model ResetPasswordModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reset password";
    ViewData["BodyClass"] = "bg-background-dark";
}

<div class="flex items-center justify-center min-h-[calc(100vh-300px)] py-16 px-4">
    <div class="w-full max-w-md space-y-8 bg-[#171717] p-10 rounded-2xl shadow-xl border border-white/5">
        @if (Model.IsTokenValid)
        {
            <div class="text-center">
                <div class="flex justify-center mb-6">
                    <div class="h-20 w-20 rounded-full bg-gold/10 flex items-center justify-center border border-gold/20">
                        <span class="material-symbols-outlined text-gold text-5xl">lock_reset</span>
                    </div>
                </div>
                <h1 class="text-3xl font-bold text-white mb-2">@ViewData["Title"]</h1>
                <p class="text-gray-400">Enter your email and new password to reset your account.</p>
            </div>

            <form method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm text-center bg-red-500/10 p-2 rounded border border-red-500/20" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                
                <div class="space-y-2">
                    <label asp-for="Input.Email" class="block text-sm font-medium text-gray-300">Email Address</label>
                    <input asp-for="Input.Email" class="block w-full bg-[#1a1a1a]/50 border border-white/5 rounded-lg px-4 py-3 text-gray-400 cursor-not-allowed focus:outline-none" autocomplete="username" aria-required="true" placeholder="name@example.com" readonly />
                    <span asp-validation-for="Input.Email" class="text-red-400 text-xs"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Input.Password" class="block text-sm font-medium text-gray-300">New Password</label>
                    <input asp-for="Input.Password" class="block w-full bg-[#1a1a1a] border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-all" autocomplete="new-password" aria-required="true" placeholder="Enter new password" />
                    <span asp-validation-for="Input.Password" class="text-red-400 text-xs"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-300">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" class="block w-full bg-[#1a1a1a] border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-all" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-400 text-xs"></span>
                </div>

