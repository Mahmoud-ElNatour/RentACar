@page
@model EnableAuthenticatorModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Configure Authenticator";
    ViewData["BodyClass"] = "bg-background-dark";
}

<div class="flex items-center justify-center min-h-[calc(100vh-300px)] py-16 px-4">
    <div class="w-full max-w-2xl space-y-8 bg-[#171717] p-10 rounded-2xl shadow-xl border border-white/5">
        
        <div class="text-center">
            <div class="flex justify-center mb-6">
                <div class="h-20 w-20 rounded-full bg-gold/10 flex items-center justify-center border border-gold/20">
                    <span class="material-symbols-outlined text-gold text-5xl">qr_code_scanner</span>
                </div>
            </div>
            <h1 class="text-3xl font-bold text-white mb-2">Configure Authenticator</h1>
            <p class="text-gray-400 max-w-md mx-auto">Follow the steps below to set up your authenticator app.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <!-- Step 1: Scan QR -->
            <div class="bg-black/30 rounded-xl p-6 border border-white/5 text-center">
                <div class="inline-block bg-white p-2 rounded-lg mb-4">
                    <div id="qrCode" data-url="@Model.AuthenticatorUri"></div>
                </div>
                <div class="text-sm text-gray-400 mb-4">
                    <p class="mb-2">Scan this QR code with your authenticator app.</p>
                    <p class="text-xs text-gray-500">Can't scan? Use this key:</p>
                    <code class="block mt-2 bg-black/50 p-2 rounded border border-white/10 text-gold font-mono text-xs break-all">@Model.SharedKey</code>
                </div>
            </div>

            <!-- Step 2: Verify -->
            <div>
                <h3 class="text-white font-bold text-lg mb-4">Verify Setup</h3>
                <form id="send-code" method="post" class="space-y-6">
                     <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm text-center bg-red-500/10 p-2 rounded border border-red-500/20" role="alert"></div>
                    
                    <div class="space-y-2">
                        <label asp-for="Input.Code" class="block text-sm font-medium text-gray-300">Verification Code</label>
                        <input asp-for="Input.Code" class="block w-full bg-[#1a1a1a] border border-white/10 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-all text-center text-2xl tracking-widest font-mono" autocomplete="off" placeholder="000000" />
                        <span asp-validation-for="Input.Code" class="text-red-400 text-xs"></span>
                    </div>

                    <button type="submit" class="w-full inline-flex items-center justify-center px-6 py-3.5 border border-transparent text-base font-bold rounded-lg text-black bg-gold hover:bg-gold-hover transition-all duration-300 shadow-lg">
                        Verify & Enable
                    </button>
                </form>
            </div>
        </div>

        <div class="text-center pt-6 border-t border-white/5">
             <a asp-page="./Index" class="text-gray-400 hover:text-white transition-colors text-sm font-medium flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                Back to Settings
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcode.min.js"></script> <!-- Ensure this lib exists or include CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script type="text/javascript">
        new QRCode(document.getElementById("qrCode"), {
            text: "@Html.Raw(Model.AuthenticatorUri)",
            width: 150,
            height: 150,
            colorDark : "#000000",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.H
        });
    </script>
}
