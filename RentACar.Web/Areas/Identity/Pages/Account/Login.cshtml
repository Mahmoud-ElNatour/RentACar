@page
@model LoginModel

@{
    ViewData["Title"] = "Premium Login";
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>LBRentDrive | @ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#edbc1d",
                        "background-light": "#f8f8f6",
                        "background-dark": "#0a0c0e", // Ultra-luxury deep black
                        "brand-dark": "#221e10",
                    },
                    fontFamily: {
                        "display": ["Plus Jakarta Sans", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
    <style>
        :root {
            --primary-bg: #141414;
            --secondary-bg: #1e1e1e;
            --accent-yellow: #ffcc00;
            --text-light: #f5f5f5;
            --text-muted: #aaa;
            --border-color: #333;
            --shadow-color: rgba(0, 0, 0, 0.5);
        }

        body {
            font-family: "Plus Jakarta Sans", sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .luxury-gradient {
            background: linear-gradient(to bottom, rgba(10, 12, 14, 0.4), rgba(10, 12, 14, 0.9));
        }
        
        /* Ensure validation errors are visible */
        .text-danger {
            color: #ef4444;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }

        /* --- Notification Toast Styles (Ported from site.css) --- */
        .notification-container {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            z-index: 2050;
            pointer-events: none;
        }

        .notification-toast {
            min-width: 280px;
            max-width: 360px;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            background: rgba(30, 30, 30, 0.95); /* Dark background */
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
            padding: 0.9rem 1rem 0.9rem 1.1rem;
            color: var(--text-light);
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            pointer-events: auto;
            position: relative;
            overflow: hidden;
            font-family: system-ui, -apple-system, sans-serif;
        }

        .notification-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .notification-toast.hiding {
            opacity: 0;
            transform: translateY(-10px);
        }

        .notification-toast .notification-icon {
            font-size: 1.5rem;
            margin-top: 0.1rem;
        }

        .notification-toast .notification-content {
            flex: 1;
        }

        .notification-toast .notification-title {
            font-weight: 600;
            margin-bottom: 0.15rem;
        }

        .notification-toast .notification-message {
            font-size: 0.95rem;
            color: rgba(245, 245, 245, 0.85);
        }

        .notification-toast .notification-close {
            background: transparent;
            border: none;
            color: rgba(245, 245, 245, 0.6);
            cursor: pointer;
            font-size: 1.25rem;
            line-height: 1;
        }

        /* Toast Colors */
        .notification-toast.notification-success { border-left: 4px solid #4ade80; }
        .notification-toast.notification-success .notification-icon { color: #4ade80; }

        .notification-toast.notification-error { border-left: 4px solid #f87171; }
        .notification-toast.notification-error .notification-icon { color: #f87171; }

        .notification-toast.notification-warning { border-left: 4px solid #facc15; }
        .notification-toast.notification-warning .notification-icon { color: #facc15; }

        .notification-toast.notification-info { border-left: 4px solid #60a5fa; }
        .notification-toast.notification-info .notification-icon { color: #60a5fa; }

        /* Hide the Bootstrap Modal by default so 'Please Confirm' doesn't show statically */
        /* Bootstrap JS will toggle this to 'display: block' when needed */
        .modal {
            display: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark min-h-screen flex items-stretch">
    <!-- Split Screen Layout Container -->
    <main class="flex w-full min-h-screen">
        <!-- Left Section: Visual & Branding (60% width on desktop) -->
        <section class="hidden lg:flex relative w-[60%] flex-col justify-between p-12 overflow-hidden bg-brand-dark">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 bg-cover bg-center z-0" data-alt="Sleek black luxury sports car in moody lighting" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAnJp39nhlFijmwfjWCSTAKDOV-NWmwx7SEx_VaPxtP9bVdjsS3_McSM7LNdGY68mWahYpQ45SGX4Whzx-wyLqwyhs8WC03bZ1-LSMawhFncfrWSyp75jesKREJ85uvWSEhPHcSaAXA0vJGl62BgoaK-Z8YmmkX33ReQ5kXswOr6SDpHDF1CAwYFIwonYoP-PqolCOd9iyvUmd-rFcMc0bHNp4_Lo3I3H41SJTck4IvryWG2GL0o-7v7RZXh6IDJlZotoEqbsWSr6Uq');">
            </div>
            <div class="absolute inset-0 luxury-gradient z-10"></div>
            <!-- Content Layer -->
            <div class="relative z-20 flex flex-col h-full justify-between">
                <!-- Top: Branding -->
                <div class="flex items-center gap-3 text-white">
                    <div class="size-10 bg-primary flex items-center justify-center rounded-lg">
                        <span class="material-symbols-outlined text-background-dark text-2xl" data-icon="directions_car">directions_car</span>
                    </div>
                    <h2 class="text-2xl font-extrabold tracking-tight">LBRentDrive</h2>
                </div>
                <!-- Middle: Hero Text & Features -->
                <div class="max-w-xl">
                    <h1 class="text-white text-6xl xl:text-7xl font-extrabold leading-[1.1] mb-8">
                        Rent. Drive. <br />
                        <span class="text-primary italic">Enjoy.</span>
                    </h1>
                    <div class="space-y-5">
                        <div class="flex items-center gap-4 group">
                            <div class="h-6 w-6 rounded-full border border-primary/50 flex items-center justify-center bg-primary/10">
                                <span class="material-symbols-outlined text-primary text-sm" data-icon="check">check</span>
                            </div>
                            <p class="text-white/90 text-lg font-medium">Instant confirmation</p>
                        </div>
                        <div class="flex items-center gap-4 group">
                            <div class="h-6 w-6 rounded-full border border-primary/50 flex items-center justify-center bg-primary/10">
                                <span class="material-symbols-outlined text-primary text-sm" data-icon="check">check</span>
                            </div>
                            <p class="text-white/90 text-lg font-medium">24/7 premium support</p>
                        </div>
                        <div class="flex items-center gap-4 group">
                            <div class="h-6 w-6 rounded-full border border-primary/50 flex items-center justify-center bg-primary/10">
                                <span class="material-symbols-outlined text-primary text-sm" data-icon="check">check</span>
                            </div>
                            <p class="text-white/90 text-lg font-medium">Best price guarantee</p>
                        </div>
                    </div>
                </div>
                <!-- Bottom: Stats Row -->
                <div class="flex items-center gap-12 pt-10 border-t border-white/10">
                    <div class="flex flex-col">
                        <span class="text-primary text-3xl font-bold">50K+</span>
                        <span class="text-white/60 text-sm font-medium uppercase tracking-wider">Customers</span>
                    </div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div class="flex flex-col">
                        <span class="text-primary text-3xl font-bold">4.9/5</span>
                        <span class="text-white/60 text-sm font-medium uppercase tracking-wider">Rating</span>
                    </div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div class="flex flex-col">
                        <span class="text-primary text-3xl font-bold">500+</span>
                        <span class="text-white/60 text-sm font-medium uppercase tracking-wider">Vehicles</span>
                    </div>
                </div>
            </div>
        </section>
        <!-- Right Section: Authentication (40% width on desktop, 100% on mobile) -->
        <section class="flex-1 flex flex-col justify-center items-center px-8 sm:px-16 xl:px-24 py-12 bg-background-light dark:bg-background-dark">
            <div class="w-full max-w-md">
                <!-- Mobile Branding (Hidden on Desktop) -->
                <div class="lg:hidden flex items-center justify-center gap-3 text-white mb-12">
                    <div class="size-8 bg-primary flex items-center justify-center rounded-lg">
                        <span class="material-symbols-outlined text-background-dark text-xl" data-icon="directions_car">directions_car</span>
                    </div>
                    <h2 class="text-xl font-bold dark:text-white text-background-dark">LBRentDrive</h2>
                </div>
                <!-- Form Header -->
                <div class="mb-10 text-left">
                    <h2 class="text-3xl font-extrabold text-background-dark dark:text-white mb-2">Welcome Back</h2>
                    <p class="text-neutral-500 dark:text-neutral-400">Please enter your details to access your account.</p>
                </div>
                
                @await Html.PartialAsync("_PopupNotifications")
                
                <!-- Login Form -->
                <form id="account" method="post" class="space-y-6">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors text-danger" role="alert"></div>
                    
                    <!-- Email Address -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-background-dark dark:text-white uppercase tracking-wider" asp-for="Input.Email">
                            Email Address
                        </label>
                        <input asp-for="Input.Email" class="w-full bg-transparent border-neutral-300 dark:border-neutral-800 rounded-lg px-4 py-3 text-background-dark dark:text-white focus:ring-primary focus:border-primary placeholder:text-neutral-500 transition-colors" placeholder="name@luxury-drive.com" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <!-- Password -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <label class="block text-sm font-semibold text-background-dark dark:text-white uppercase tracking-wider" asp-for="Input.Password">
                                Password
                            </label>
                            <a class="text-sm font-bold text-primary hover:underline transition-all" asp-page="./ForgotPassword">Forgot Password?</a>
                        </div>
                        <div class="relative">
                            <input asp-for="Input.Password" class="w-full bg-transparent border-neutral-300 dark:border-neutral-800 rounded-lg px-4 py-3 text-background-dark dark:text-white focus:ring-primary focus:border-primary placeholder:text-neutral-500 transition-colors" placeholder="••••••••" autocomplete="current-password" aria-required="true" id="password_input" />
                            <button class="absolute right-4 top-1/2 -translate-y-1/2 text-neutral-500 hover:text-white" type="button" onclick="togglePassword()">
                                <span class="material-symbols-outlined text-xl" data-icon="visibility" id="password_icon">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <!-- Remember Me -->
                    <div class="flex items-center gap-3">
                        <input asp-for="Input.RememberMe" class="h-4 w-4 rounded border-neutral-300 dark:border-neutral-800 bg-transparent text-primary focus:ring-primary focus:ring-offset-0 transition-all cursor-pointer" />
                        <label class="text-sm text-neutral-600 dark:text-neutral-400 cursor-pointer" asp-for="Input.RememberMe">Remember me for 30 days</label>
                    </div>
                    <!-- Submit Button -->
                    <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-background-dark font-bold py-4 rounded-lg transition-all active:scale-[0.98] shadow-lg shadow-primary/10">
                        Sign In
                    </button>
                </form>
                <!-- Divider -->
                <div class="relative my-10">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-neutral-300 dark:border-neutral-800"></div>
                    </div>
                    <div class="relative flex justify-center text-xs uppercase">
                        <span class="bg-background-light dark:bg-background-dark px-4 text-neutral-500 font-bold tracking-widest">Or continue with</span>
                    </div>
                </div>
                <!-- Social Login Buttons (Static for now as requested) -->
                <!-- Social Login Buttons -->
                @if (Model.ExternalLogins != null && Model.ExternalLogins.Count > 0)
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="grid grid-cols-2 gap-4">
                        @foreach (var provider in Model.ExternalLogins)
                        {
                            <button type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account"
                                    class="flex items-center justify-center gap-3 bg-transparent border border-neutral-300 dark:border-neutral-800 py-3 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-all group">
                                @if (provider.Name == "Google")
                                {
                                    <svg class="h-5 w-5" viewBox="0 0 24 24">
                                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.26.81-.58z" fill="#FBBC05"></path>
                                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z" fill="#EA4335"></path>
                                    </svg>
                                }
                                else if (provider.Name == "Facebook")
                                {
                                    <svg class="h-6 w-6 text-[#1877F2] fill-current" viewBox="0 0 24 24">
                                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                                    </svg>
                                }
                                <span class="text-sm font-bold text-background-dark dark:text-white">@provider.DisplayName</span>
                            </button>
                        }
                    </form>
                }
                <!-- Footer Link -->
                <p class="mt-10 text-center text-neutral-600 dark:text-neutral-400">
                    Don't have an account? 
                    <a class="text-primary font-bold hover:underline" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign Up for Free</a>
                </p>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    @if (TempData["LoginError"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof showPopup === 'function') {
                    showPopup('@Html.Raw(TempData["LoginError"])', 'error');
                }
            });
        </script>
    }
    <script>
        function togglePassword() {
            var input = document.getElementById("password_input");
            var icon = document.getElementById("password_icon");
            if (input.type === "password") {
                input.type = "text";
                icon.textContent = "visibility_off";
                icon.setAttribute("data-icon", "visibility_off");
            } else {
                input.type = "password";
                icon.textContent = "visibility";
                icon.setAttribute("data-icon", "visibility");
            }
        }
    </script>
</body>

</html>
