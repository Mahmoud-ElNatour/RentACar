@page
@model LoginModel

@{
    ViewData["Title"] = "LuxeDrive - Premium Login";
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;family=Inter:wght@300;400;500;600&amp;family=Manrope:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
                primary: "#D4AF37", // Elegant Gold
                "background-light": "#F8FAFC",
                "background-dark": "#0B0E14",
                "card-dark": "#161B22",
                "input-dark": "#0D1117",

                // Colors required by _Footer and _Navbar partials (synced with _Layout)
                "gold": "#d4af35",
                "gold-light": "#fce186",
                "gold-hover": "#d9a60c",
                "border-dark": "#2a2d30",
                "surface-dark": "#16181a",
                "footer-bg": "#0a0a0a",
                "footer-surface": "#171717",
                "footer-border": "#f2b90d33",
            },
            fontFamily: {
              display: ["Playfair Display", "serif"],
              body: ["Inter", "sans-serif"],
              sans: ["Inter", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "12px",
            },
             boxShadow: {
                "glow": "0 0 20px rgba(212, 175, 55, 0.15)"
            },
          },
        },
      };
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Hide Validation Summary in favor of Popups */
        .validation-summary-errors { display: none !important; }
        [asp-validation-summary] { display: none !important; }

        .luxury-text {
            font-family: 'Playfair Display', serif;
        }

        .glow-button {
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
        }

        .divider-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, #30363d, transparent);
        }

        /* Ensure screen reader text is hidden */
        .visually-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            white-space: nowrap !important;
            border: 0 !important;
        }

        /* Notification Toast Styles */
        .notification-container {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            z-index: 10000; /* Extremely high z-index */
            pointer-events: none;
        }

        .notification-toast {
            min-width: 300px;
            max-width: 400px;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            background: rgba(30, 30, 30, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            padding: 1rem;
            color: #ffffff;
            opacity: 0;
            transform: translateY(-20px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            pointer-events: auto;
            position: relative;
            backdrop-filter: blur(10px);
        }

        .notification-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .notification-toast.hiding {
            opacity: 0;
            transform: translateY(-20px);
        }

        .notification-wrapper {
            display: flex;
            gap: 12px;
            width: 100%;
        }

        .notification-icon {
            font-size: 1.25rem;
            margin-top: 2px;
        }

        .notification-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .notification-title {
            font-weight: 600;
            font-size: 0.95rem;
            line-height: 1.3;
        }

        .notification-message {
            font-size: 0.85rem;
            color: #d1d5db;
            line-height: 1.4;
        }

        .notification-close {
            background: none;
            border: none;
            color: #9ca3af;
            cursor: pointer;
            padding: 4px;
            margin: -4px -4px 0 0;
            transition: color 0.2s;
        }

        .notification-close:hover {
            color: #ffffff;
        }

        /* Type variants */
        .notification-success { border-left: 4px solid #10b981; }
        .notification-success .notification-icon { color: #10b981; }

        .notification-error { border-left: 4px solid #ef4444; }
        .notification-error .notification-icon { color: #ef4444; }

        .notification-warning { border-left: 4px solid #f59e0b; }
        .notification-warning .notification-icon { color: #f59e0b; }

        .notification-info { border-left: 4px solid #3b82f6; }
        .notification-info .notification-icon { color: #3b82f6; }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark min-h-screen">
    <partial name="_LoginPopupNotifications" />
    
    <div class="flex min-h-screen w-full">
        <!-- Left Section (Image) -->
        <div class="hidden lg:flex lg:w-1/2 relative flex-col justify-between p-12 overflow-hidden border-r border-primary/30">
            <div class="absolute inset-0 z-0">
                <img alt="Luxury car on a mountain road at night" class="w-full h-full object-cover" src="~/img/categories/car.jpg" />
                <div class="absolute inset-0 bg-black/50"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30"></div>
            </div>
            <div class="relative z-10 flex items-center gap-4">
                <a asp-controller="Home" asp-action="Index" class="group flex items-center justify-center w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/10 transition-all duration-300">
                    <span class="material-icons-outlined text-white group-hover:-translate-x-1 transition-transform">arrow_back</span>
                </a>
                <h1 class="text-primary luxury-text text-3xl font-bold tracking-tight">LB Drive</h1>
            </div>
            <div class="relative z-10 max-w-lg">
                <div class="w-16 h-1 bg-primary mb-8"></div>
                <p class="luxury-text text-white text-5xl leading-tight mb-4">
                    "Drive your dreams, arrive in style."
                </p>
                <p class="text-gray-400 text-lg font-light tracking-wide italic">
                    — Where elegance meets the open road
                </p>
            </div>
        </div>
        
        <!-- Right Section (Form) -->
        <div class="w-full lg:w-1/2 flex items-center justify-center p-6 bg-background-light dark:bg-background-dark relative">
             <!-- Mobile Back Button removed from absolute position -->

            <div class="w-full max-w-md">
                <div class="lg:hidden text-center mb-10">
                    <h1 class="text-primary luxury-text text-4xl font-bold"></h1>
                </div>
                
                <div class="bg-white dark:bg-card-dark p-8 rounded-3xl shadow-2xl border border-gray-200 dark:border-gray-800 my-10">
                    <header class="flex items-center justify-center gap-4 mb-10">
                        <!-- Mobile Back Button (Integrated) -->
                        <a asp-controller="Home" asp-action="Index" class="lg:hidden group flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300">
                             <span class="material-icons-outlined text-gray-600 dark:text-gray-300 group-hover:-translate-x-1 transition-transform">arrow_back</span>
                        </a>
                        <h2 class="text-primary luxury-text text-4xl font-bold">Sign In</h2>
                    </header>
                    
                    <form id="account" method="post" class="space-y-6">
                        <!-- Validation Summary removed to prevent duplicate text with popups -->

                        <!-- Username/Email -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" asp-for="Input.Email">Username</label>
                            <div class="relative group">
                                <span class="material-icons-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors">person</span>
                                <input asp-for="Input.Email" class="w-full pl-12 pr-4 py-4 bg-gray-50 dark:bg-input-dark border border-gray-200 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-600 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="Enter your username" autocomplete="username" aria-required="true" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 block"></span>
                        </div>
                        
                        <!-- Password -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" asp-for="Input.Password">Password</label>
                            <div class="relative group">
                                <span class="material-icons-outlined absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-primary transition-colors">lock</span>
                                <input asp-for="Input.Password" id="password-input" class="w-full pl-12 pr-12 py-4 bg-gray-50 dark:bg-input-dark border border-gray-200 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-600 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="Enter your password" autocomplete="current-password" aria-required="true" />
                                <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" type="button" onclick="togglePassword()">
                                    <span class="material-icons-outlined text-[20px]" id="password-icon">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1 block"></span>
                            
                            <div class="text-right mt-3">
                                <a class="text-sm text-primary hover:text-yellow-600 font-medium transition-colors" asp-page="./ForgotPassword">Forgot password?</a>
                            </div>
                        </div>

                        <button class="w-full py-4 bg-primary text-background-dark font-bold rounded-xl glow-button hover:bg-yellow-500 transition-all duration-300 transform active:scale-[0.98]" type="submit">
                            Sign In
                        </button>
                    </form>
                    
                    <div class="relative flex items-center justify-center my-10">
                        <div class="flex-grow border-t border-gray-200 dark:border-gray-800"></div>
                        <span class="mx-4 text-[10px] font-bold tracking-[0.2em] text-gray-400 uppercase">Or continue with</span>
                        <div class="flex-grow border-t border-gray-200 dark:border-gray-800"></div>
                    </div>
                    
                    @if (Model.ExternalLogins != null && Model.ExternalLogins.Count > 0)
                    {
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="grid grid-cols-2 gap-4">
                            @foreach (var provider in Model.ExternalLogins)
                            {
                                <button type="submit" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account"
                                        class="flex items-center justify-center gap-3 py-3 px-4 bg-gray-50 dark:bg-input-dark border border-gray-200 dark:border-gray-800 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">
                                    @if (provider.Name == "Google")
                                    {
                                        <svg class="w-5 h-5" viewBox="0 0 24 24">
                                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path>
                                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                                        </svg>
                                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Google</span>
                                    }
                                    else if (provider.Name == "Facebook")
                                    {
                                        <svg class="w-5 h-5" fill="#1877F2" viewBox="0 0 24 24">
                                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                                        </svg>
                                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Facebook</span>
                                    }
                                    else
                                    {
                                        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">@provider.DisplayName</span>
                                    }
                                </button>
                            }
                        </form>
                    }
                    
                    <div class="mt-12 text-center">
                        <p class="text-gray-500 dark:text-gray-400 text-sm">
                            Don't have an account? 
                            <a class="text-primary hover:text-yellow-600 font-semibold ml-1 transition-colors" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create account</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="fixed bottom-6 right-6 z-50">
        <button class="p-3 bg-white dark:bg-card-dark text-gray-800 dark:text-white rounded-full shadow-lg border border-gray-200 dark:border-gray-800 hover:scale-110 transition-transform" onclick="document.documentElement.classList.toggle('dark')">
            <span class="material-icons-outlined block dark:hidden">dark_mode</span>
            <span class="material-icons-outlined hidden dark:block">light_mode</span>
        </button>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword() {
            var input = document.getElementById("password-input");
            var icon = document.getElementById("password-icon");
            if (input.type === "password") {
                input.type = "text";
                icon.textContent = "visibility_off";
            } else {
                input.type = "password";
                icon.textContent = "visibility";
            }
        }

        $(document).ready(function () {
            var loginError = '@TempData["LoginError"]';
            if (loginError) {
                showPopup(loginError, 'error');
            }
            
            var genericError = '@TempData["Error"]';
            if (genericError) {
                showPopup(genericError, 'error');
            }
            
            var successMessage = '@TempData["Success"]';
            if (successMessage) {
                showPopup(successMessage, 'success');
            }
        });
    </script>
</body>
</html>
