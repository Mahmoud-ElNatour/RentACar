@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Password Reset Link Sent";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarRental</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login-style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
    @await Html.PartialAsync("_PopupNotifications")
    <div class="container1">
        <div class="login-container text-center">
            <div class="logo-text">
                <i class="fas fa-car-side"></i>
                <div>CarRental</div>
            </div>

            <h2>Check Your Email</h2>
            <p style="color: var(--text-secondary);">
                We just sent a link to reset your password. Please check your inbox and follow the instructions.
            </p>

            <i class="fa-solid fa-envelope-open fa-3x" style="color: var(--accent-gold); margin: 15px 0;"></i>

            <a class="login-btn w-100" asp-page="./Login">Back to Login</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
