    <partial name="_ValidationScriptsPartial" />

     <script>
         // Client-side Validation Logic
        function validateEmail(email) {
            const re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/; // Simple check for @@ and .
            return re.test(email);
        }

        const emailInput = document.getElementById('Input_Email');
        const emailError = document.getElementById('email-error');

        emailInput.addEventListener('blur', function() {
            if (!validateEmail(this.value) && this.value.length > 0) {
                emailError.classList.remove('hidden');
                // Also trigger popup if desired, but text below input is better for specific field
            } else {
                emailError.classList.add('hidden');
            }
        });
        
        emailInput.addEventListener('input', function() {
             if (validateEmail(this.value)) {
                emailError.classList.add('hidden');
             }
        });

        function validateForm() {
            const email = document.getElementById('Input_Email').value;
            const password = document.getElementById('Input_Password').value;
            const confirmPassword = document.getElementById('Input_ConfirmPassword').value;

            if (!validateEmail(email)) {
                showPopup("Please enter a valid email address containing '@@' and '.'", 'error');
                emailError.classList.remove('hidden');
                return false;
            }

            // Strong Password Validation
            // Min 8 chars, 1 Uppercase, 1 Lowercase, 1 Number, 1 Special Char
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
            if (!passwordRegex.test(password)) {
                 showPopup("Password must be at least 8 characters long and contain at least one uppercase letter, one lowercase letter, one number, and one special character.", 'error');
                 return false;
            }

            if (password !== confirmPassword) {
                showPopup("Passwords do not match.", 'error');
                return false;
            }

            return true;
        }

        $(document).ready(function () {
             // Show any errors passed via TempData
            var error = '@Html.Raw(TempData["Error"])'; 
            if (error) {
                 showPopup(error, 'error');
            }
             // Show model state errors (including Duplicate Email error from backend)
             @if (!ViewData.ModelState.IsValid)
             {
                 foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                 {
                    <text>showPopup("@Html.Raw(modelError.ErrorMessage)", 'error');</text>
                 }
             }
        });
    </script>
