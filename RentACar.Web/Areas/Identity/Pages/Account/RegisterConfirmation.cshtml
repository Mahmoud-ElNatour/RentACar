@page
@model RegisterConfirmationModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Confirm your email";
    ViewData["BodyClass"] = "bg-background-dark";
}

<div class="flex items-center justify-center min-h-[calc(100vh-300px)] py-16 px-4">
    <div class="w-full max-w-md space-y-8 bg-[#171717] p-10 rounded-2xl shadow-xl border border-white/5 text-center">
        <div class="flex justify-center">
            <div class="h-20 w-20 rounded-full bg-gold/10 flex items-center justify-center border border-gold/20">
                <span class="material-symbols-outlined text-gold text-5xl">mail</span>
            </div>
        </div>
        
        <div class="space-y-4">
             <h1 class="text-3xl font-bold text-white">Check Your Inbox</h1>
             <p class="text-gray-400 text-lg">
                We've sent a confirmation link to <br/>
                <span class="text-white font-medium">@Model.Email</span>
            </p>
             <p class="text-sm text-gray-400 mt-4">
                 Did not receive the email? <a asp-page="./ResendEmailConfirmation" asp-route-email="@Model.Email" class="text-gold hover:text-gold-hover hover:underline font-semibold">Resend it</a>
             </p>
        </div>

        <div class="mt-8 border-t border-white/5 pt-6">
             <div class="text-center">
                <a asp-page="./Login" class="inline-flex w-full items-center justify-center px-6 py-3.5 border border-transparent text-base font-bold rounded-lg text-black bg-gold hover:bg-gold-hover transition-all duration-300 shadow-lg">
                    Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
