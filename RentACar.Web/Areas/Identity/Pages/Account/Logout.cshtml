@page
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model LogoutModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Log out";
    ViewData["BodyClass"] = "bg-background-dark";
}

<div class="flex items-center justify-center min-h-[calc(100vh-300px)] py-16 px-4">
    <div class="w-full max-w-md space-y-8 bg-[#171717] p-10 rounded-2xl shadow-xl border border-white/5 text-center">
        <div class="flex justify-center">
            <div class="h-20 w-20 rounded-full bg-gold/10 flex items-center justify-center border border-gold/20">
                <span class="material-symbols-outlined text-gold text-5xl">logout</span>
            </div>
        </div>
        
        <div class="space-y-4">
             @{
                if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form class="space-y-6" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <h1 class="text-3xl font-bold text-white">Ready to Leave?</h1>
                        <p class="text-gray-400 text-lg">Select "Logout" below if you are ready to end your current session.</p>
                        <button type="submit" class="w-full inline-flex items-center justify-center px-6 py-3.5 border border-transparent text-base font-bold rounded-lg text-black bg-gold hover:bg-gold-hover transition-all duration-300 shadow-lg cursor-pointer">Logout</button>
                    </form>
                }
                else
                {
                    <h1 class="text-3xl font-bold text-white">Signed Out</h1>
                    <p class="text-gray-400 text-lg">You have successfully logged out.</p>
                    <div class="mt-8">
                         <a asp-page="./Login" class="inline-flex w-full items-center justify-center px-6 py-3.5 border border-transparent text-base font-bold rounded-lg text-black bg-gold hover:bg-gold-hover transition-all duration-300 shadow-lg">
                            Sign In Again
                        </a>
                    </div>
                }
            }
        </div>
    </div>
</div>
