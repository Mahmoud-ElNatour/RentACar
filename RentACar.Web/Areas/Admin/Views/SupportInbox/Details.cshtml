@using RentACar.Application.DTOs.Support
@using RentACar.Core.Constants
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@model SupportConversationDetailsDto

@{
    ViewData["Title"] = "Ticket #" + Model.ConversationId;
    Layout = "_Layout";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var displayName = User.Identity?.Name;
    var isAdmin = User.IsInRole("Admin");
    var canReply = Model.AssignedEmployeeId == currentUserId || isAdmin;
}

@section Styles {
    <style>
        .glass-panel {
            background: rgba(20, 20, 20, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .chat-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .chat-scroll::-webkit-scrollbar-track {
            background: #000000;
        }
        .chat-scroll::-webkit-scrollbar-thumb {
            background: #2d2d2d;
            border-radius: 10px;
        }
        .chat-scroll::-webkit-scrollbar-thumb:hover {
            background: #d4af37;
        }
        .active-ticket {
            background: rgba(212, 175, 55, 0.1);
            border-color: rgba(212, 175, 55, 0.3);
        }
    </style>
}

<main class="flex flex-col lg:flex-row h-auto lg:h-[calc(100vh-50px)] lg:overflow-hidden bg-black">
    <!-- Left Sidebar: Customer & Booking Info -->
    <aside class="w-full lg:w-[280px] glass-panel flex flex-col shrink-0 border-b lg:border-b-0 lg:border-r border-white/5 order-2 lg:order-1 h-auto lg:h-full lg:overflow-y-auto">
        <div class="p-8 border-b border-white/5">
            <div class="flex gap-4 items-center mb-8">
                <div class="size-14 rounded-full border-2 border-primary p-0.5 overflow-hidden flex items-center justify-center bg-slate-800">
                    <span class="text-white font-bold text-xl">@Model.CustomerName?.Substring(0, 1).ToUpper()</span>
                </div>
                <div>
                    <h3 class="text-white font-bold text-lg">@Model.CustomerName</h3>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
                        <p class="text-primary text-[10px] font-black tracking-[0.2em] uppercase">@(Model.IsVerified ? "Platinum Elite" : "Standard Client")</p>
                    </div>
                </div>
            </div>
            <div class="space-y-6">
                <div>
                    <p class="text-white/40 text-[10px] uppercase font-black tracking-widest mb-1">Customer ID</p>
                    <p class="text-white text-sm font-medium">#LBR-@Model.RealCustomerId</p>
                </div>
                <div>
                    <p class="text-white/40 text-[10px] uppercase font-black tracking-widest mb-1">Contact</p>
                    <p class="text-white text-sm font-medium">@Model.CustomerPhone</p>
                    <p class="text-white/60 text-xs mt-0.5">@Model.CustomerEmail</p>
                </div>
                <div>
                    <p class="text-white/40 text-[10px] uppercase font-black tracking-widest mb-1">Verification</p>
                    @if (Model.IsVerified)
                    {
                        <div class="flex items-center gap-2 text-green-400 text-sm font-bold">
                            <span class="material-symbols-outlined text-lg">verified_user</span>
                            <span>Verified</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2 text-yellow-500/80 text-sm font-bold">
                            <span class="material-symbols-outlined text-lg">pending</span>
                            <span>Pending Verification</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="p-8 pb-4">
            <h4 class="text-white text-[10px] font-black uppercase tracking-widest mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-base">directions_car</span>
                Booking Information
            </h4>
            @if (Model.ActiveBooking != null)
            {
                <div class="bg-white/5 rounded-xl p-5 border border-white/10 hover:border-primary/30 transition-all cursor-default group">
                    <p class="text-white font-bold text-sm group-hover:text-primary transition-colors">@Model.ActiveBooking.CarName</p>
                    <p class="text-white/40 text-[11px] mt-1 font-mono uppercase">PLATE: @Model.ActiveBooking.PlateNumber</p>
                    <div class="mt-4 pt-4 border-t border-white/5 space-y-3">
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-white/40">Pickup</span>
                            <span class="text-white font-medium">@Model.ActiveBooking.PickupDate.ToString("MMM dd, h:mm tt")</span>
                        </div>
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-white/40">Return</span>
                            <span class="text-white font-medium">@Model.ActiveBooking.ReturnDate.ToString("MMM dd, h:mm tt")</span>
                        </div>
                    </div>
                </div>

                <nav class="mt-6 space-y-2">
                    <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-white/60 hover:text-white hover:bg-white/5 transition-all" 
                       href="/Booking?search=@Model.ActiveBooking.BookingId">
                        <span class="material-symbols-outlined text-xl">payments</span>
                        <span class="text-sm font-medium">Booking & Payments</span>
                    </a>
                </nav>
            }
            else
            {
                <p class="text-white/40 text-xs italic">No active or previous rental found</p>
            }

            <nav class="mt-4 space-y-2 border-b border-white/5 pb-8">
                <a class="flex items-center gap-3 px-4 py-3 rounded-xl bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 transition-all" 
                   href="@Url.Action("Index", "SupportInbox", new { area = "Admin", searchQuery = Model.CustomerEmail, mode = "history" })">
                    <span class="material-symbols-outlined text-xl">history</span>
                    <span class="text-sm font-bold">Customer Ticket History</span>
                </a>
            </nav>
        </div>

    </aside>

    <!-- Center: Chat Interface -->
    <section class="flex-1 flex flex-col bg-black relative border-r-0 lg:border-r border-white/5 order-1 lg:order-2 h-[70vh] lg:h-auto">
        <div class="px-8 py-3 border-b border-white/5 flex items-center justify-between bg-black/50 backdrop-blur-xl z-10 sticky top-0 lg:hidden">
            <a href="@Url.Action("Index", "SupportInbox")" class="flex items-center gap-2 text-white/60 hover:text-white transition-colors">
                <span class="material-symbols-outlined">arrow_back</span>
                <span class="text-sm font-bold">Back</span>
            </a>
        </div>

        <div id="chatMessages" class="flex-1 overflow-y-auto chat-scroll p-4 md:p-8 space-y-8">
            @foreach (var msg in Model.Messages)
            {
                var isMe = msg.SenderUserId == currentUserId;
                var isNote = msg.IsInternalNote;

                if (isNote)
                {
                    <div class="flex justify-center">
                        <div class="bg-primary/5 border border-primary/30 rounded-2xl p-6 max-w-[95%] sm:max-w-[85%] w-full shadow-[0_0_20px_rgba(212,175,55,0.05)]">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">security</span>
                                    <span class="text-primary text-[10px] font-black uppercase tracking-[0.2em]">Restricted Internal Log</span>
                                </div>
                                <span class="text-primary/40 text-[10px]">@msg.SenderDisplayName?.ToUpper() • @msg.CreatedAt.ToLocalTime().ToString("t")</span>
                            </div>
                            <p class="text-primary/90 text-sm leading-relaxed font-medium italic">"@msg.MessageText"</p>
                        </div>
                    </div>
                }
                else if (msg.SenderRole == SenderRole.Customer)
                {
                    <div class="flex items-start gap-4">
                        <div class="size-10 rounded-full ring-2 ring-white/10 shrink-0 overflow-hidden flex items-center justify-center bg-slate-800">
                             <span class="text-white font-bold">@msg.SenderDisplayName?.Substring(0, 1).ToUpper()</span>
                        </div>
                        <div class="max-w-[75%]">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-white font-bold text-xs uppercase tracking-tight">@msg.SenderDisplayName</span>
                                <span class="text-white/30 text-[10px]">@msg.CreatedAt.ToLocalTime().ToString("t")</span>
                            </div>
                            <div class="glass-panel text-white p-5 rounded-2xl rounded-tl-none border border-white/10 shadow-xl">
                                <p class="text-sm leading-relaxed text-white/90">@msg.MessageText</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-start gap-4 flex-row-reverse">
                        <div class="size-10 rounded-full bg-primary flex items-center justify-center text-black font-black shrink-0 ring-4 ring-primary/10">@msg.SenderDisplayName?.Substring(0, 1).ToUpper()</div>
                        <div class="max-w-[75%] flex flex-col items-end">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-white/30 text-[10px]">@msg.CreatedAt.ToLocalTime().ToString("t")</span>
                                <span class="text-primary font-bold text-xs uppercase tracking-tight">@msg.SenderDisplayName</span>
                            </div>
                            <div class="bg-primary text-black p-5 rounded-2xl rounded-tr-none shadow-[0_8px_30px_rgba(212,175,55,0.1)]">
                                <p class="text-sm font-bold leading-relaxed">@msg.MessageText</p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="p-6 bg-black border-t border-white/5">
            @if (Model.Status == SupportStatus.Resolved || Model.Status == SupportStatus.Closed)
            {
                <div class="bg-white/5 rounded-2xl p-6 border border-white/10 flex flex-col items-center gap-3 text-center">
                    <div class="size-12 rounded-full bg-slate-800 flex items-center justify-center text-white/40 border border-white/10">
                        <span class="material-symbols-outlined">lock</span>
                    </div>
                    <div>
                        <p class="text-white text-sm font-bold">Conversation Read-Only</p>
                        <p class="text-white/40 text-[11px] mt-1">This ticket has been @Model.Status.ToLower(). You can no longer send messages to the customer.</p>
                    </div>
                </div>
            }
            else if (canReply)
            {
                <div class="flex flex-col gap-2">
                    <div class="flex gap-2 mb-2">
                        <button id="toggleNote" class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/60 text-[11px] font-bold hover:bg-white/10 hover:text-white flex items-center gap-2 transition-all">
                            <span class="material-symbols-outlined text-base">security</span>
                            Internal Note Mode: <span id="modeStatus">OFF</span>
                        </button>
                    </div>
                    <div class="flex gap-4">
                        <div id="inputContainer" class="flex-1 bg-white/5 rounded-2xl border border-white/10 focus-within:border-primary/50 focus-within:ring-1 focus-within:ring-primary/50 transition-all flex items-center px-6 py-1">
                            <input id="messageInput" class="bg-transparent border-none focus:ring-0 text-white flex-1 text-sm py-3" placeholder="Write a response..." type="text" />
                            <button id="sendBtn" class="text-primary hover:scale-110 active:scale-95 transition-all">
                                <span class="material-symbols-outlined text-2xl">send</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white/5 rounded-2xl p-6 border border-white/10 flex items-center gap-4">
                    <span class="material-symbols-outlined text-primary">lock</span>
                    <div>
                        <p class="text-white text-sm font-bold">Reply restricted</p>
                        <p class="text-white/40 text-xs">Only the assigned agent can reply to this conversation. Since you are not assigned, you can only view the chat history.</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Right Sidebar: Management Console -->
    <aside class="w-full lg:w-[300px] glass-panel flex flex-col p-8 shrink-0 border-t lg:border-t-0 bg-zinc-950 order-3 lg:order-3 h-auto lg:h-full lg:overflow-y-auto">
        <h3 class="text-white text-[11px] font-black mb-6 uppercase tracking-[0.2em] border-b border-white/5 pb-4">Management Console</h3>
        
        <!-- Ticket Overview -->
        <div class="mb-8 space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-primary font-mono font-bold text-xs">#@Model.ConversationId</span>
                    @{
                        var statusColor = Model.Status == SupportStatus.Open ? "bg-red-500/10 text-red-500 border-red-500/20" : 
                                         Model.Status == SupportStatus.Closed ? "bg-slate-500/10 text-slate-500 border-slate-500/20" :
                                         "bg-primary/10 text-primary border-primary/20";
                    }
                    <span class="px-2 py-0.5 rounded @statusColor text-[10px] font-black uppercase tracking-widest border">@Model.Status</span>
                </div>
                <h2 class="text-white font-bold text-lg leading-snug">@Model.Subject</h2>
                <p class="text-white/40 text-xs mt-1">Created @Model.CreatedAt.ToLocalTime().ToString("g")</p>
            </div>
        </div>

        <div class="space-y-8">
            <div class="space-y-3">
                <p class="text-white/40 text-[10px] font-black uppercase tracking-widest mb-1">Ownership</p>
                <div class="flex items-center gap-3 p-4 bg-white/5 rounded-xl border border-white/10">
                    <div class="size-8 rounded-full bg-primary flex items-center justify-center text-black font-black text-xs">
                        @(Model.AssignedEmployeeName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <p class="text-white text-sm font-bold">@Model.AssignedEmployeeName</p>
                </div>
            </div>
            
            @* Re-assignment restricted to assigned employee or admin *@
            @if (canReply && Model.Status != SupportStatus.Resolved && Model.Status != SupportStatus.Closed)
            {
                <div class="space-y-3 pt-6 border-t border-white/5">
                    <label class="text-white/40 text-[10px] font-black uppercase tracking-widest">Re-assign Ticket</label>
                    <div class="relative">
                        <input id="staffSearch" class="w-full bg-white/5 border border-white/10 rounded-xl text-white text-sm py-3.5 px-5 focus:ring-primary focus:border-primary font-bold placeholder:text-white/20" placeholder="Search staff..." autocomplete="off" />
                        <div id="staffSuggestions" class="absolute left-0 right-0 top-full mt-2 bg-slate-900 border border-white/10 rounded-xl overflow-hidden hidden z-50 shadow-2xl">
                            <!-- suggestions -->
                        </div>
                    </div>
                    
                    <div id="reassignAction" class="hidden space-y-3 mt-4 animate-in fade-in slide-in-from-top-2 duration-300">
                        <div class="p-4 bg-primary/5 border border-primary/20 rounded-xl">
                            <p class="text-white/40 text-[10px] uppercase font-black mb-2">New Assignee</p>
                            <p id="selectedStaffName" class="text-primary text-sm font-bold"></p>
                        </div>
                        <textarea id="reassignNote" class="w-full bg-white/5 border border-white/10 rounded-xl text-white text-sm p-4 focus:ring-primary focus:border-primary resize-none min-h-[100px]" placeholder="Add a note for the new assignee..."></textarea>
                        <button type="button" onclick="showReassignModal()" class="w-full bg-primary text-black text-[11px] font-black py-4 rounded-xl transition-all uppercase tracking-widest shadow-[0_0_20px_rgba(212,175,55,0.2)]">Confirm Transfer</button>
                    </div>
                </div>
            }

            @if (Model.Status != SupportStatus.Closed && Model.Status != SupportStatus.Resolved && (Model.AssignedEmployeeId == currentUserId || isAdmin))
            {
                <div class="pt-8 border-t border-white/5">
                    <form action="@Url.Action("UpdateStatus", "SupportInbox", new { area = "Admin" })" method="post">
                        <input type="hidden" name="ConversationId" value="@Model.ConversationId" />
                        <input type="hidden" name="NewStatus" value="@SupportStatus.Resolved" />
                        <button type="submit" class="w-full bg-primary text-black text-[11px] font-black py-4 rounded-xl flex items-center justify-center gap-2 transition-all uppercase tracking-widest shadow-[0_0_30px_rgba(212,175,55,0.1)]">
                            <span class="material-symbols-outlined text-xl">check_circle</span>
                            Mark as Resolved
                        </button>
                    </form>
                </div>
            }

            <div class="pt-10 border-t border-white/5">
                <h4 class="text-white text-[10px] font-black uppercase tracking-widest mb-4 flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-base">chat_bubble</span>
                        My Active Tickets
                    </span>
                    <span class="text-primary/60">@Model.MyActiveConversations.Count</span>
                </h4>
                <div class="space-y-3">
                    @foreach(var active in Model.MyActiveConversations)
                    {
                        <a href="@Url.Action("Details", new { id = active.ConversationId })" 
                           class="group relative z-10 flex items-center gap-3 p-3 rounded-xl @(active.ConversationId == Model.ConversationId ? "active-ticket border-primary/30 ring-1 ring-primary/20" : "bg-white/5 border border-white/5 hover:border-white/20") cursor-pointer transition-all no-underline">
                            <div class="size-8 rounded-full bg-slate-800 border border-white/10 flex items-center justify-center shrink-0">
                                <span class="text-white text-[10px] font-bold">@active.CustomerName?.Substring(0, 1).ToUpper()</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between mb-0.5">
                                    <p class="text-white text-[11px] font-bold truncate">@active.CustomerName</p>
                                    <p class="text-[9px] text-primary font-bold">#@active.ConversationId</p>
                                </div>
                                <div class="flex items-center justify-between">
                                    <p class="text-white/40 group-hover:text-white/60 text-[10px] truncate">@active.LastMessageSnippet</p>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </aside>

    <!-- Confirmation Modal -->
    <div id="reassignModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-6">
        <div class="w-full max-w-sm glass-panel rounded-3xl p-8 border border-white/10 animate-in zoom-in-95 duration-200">
            <div class="size-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-3xl text-primary">swap_horiz</span>
            </div>
            <h4 class="text-white text-xl font-black text-center mb-2">Transfer Ticket?</h4>
            <p class="text-white/40 text-sm text-center mb-8 px-4">Are you sure you want to reassign this issue? You will lose reply permissions until it's assigned back to you.</p>
            
            <form id="reassignForm" asp-action="Reassign" method="post" class="space-y-3">
                <input type="hidden" name="conversationId" value="@Model.ConversationId" />
                <input type="hidden" name="targetEmployeeId" id="modalTargetId" />
                <input type="hidden" name="note" id="modalNote" />
                <button type="submit" class="w-full bg-primary text-black font-black py-4 rounded-xl shadow-[0_0_40px_rgba(212,175,55,0.2)] hover:scale-[1.02] active:scale-[0.98] transition-all">YES, REASSIGN</button>
                <button type="button" onclick="hideReassignModal()" class="w-full bg-white/5 text-white/40 font-bold py-4 rounded-xl hover:text-white transition-all">CANCEL</button>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const conversationId = @Model.ConversationId;
        const currentUserId = "@currentUserId";
        let internalNoteMode = false;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/supportChatHub")
            .withAutomaticReconnect()
            .build();

        async function start() {
            try {
                await connection.start();
                console.log("SignalR Connected.");
                await connection.invoke("JoinConversation", conversationId);
            } catch (err) {
                console.log(err);
                setTimeout(start, 5000);
            }
        };

        connection.on("ReceiveMessage", function (message) {
            appendMessage(message);
            scrollToBottom();
        });

        start();

        function appendMessage(msg) {
            const chatMessages = document.getElementById('chatMessages');
            const time = new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            let html = "";

            if (msg.isInternalNote) {
                html = `
                    <div class="flex justify-center">
                        <div class="bg-primary/5 border border-primary/30 rounded-2xl p-6 max-w-[85%] w-full shadow-[0_0_20px_rgba(212,175,55,0.05)]">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-base">security</span>
                                    <span class="text-primary text-[10px] font-black uppercase tracking-[0.2em]">Restricted Internal Log</span>
                                </div>
                                <span class="text-primary/40 text-[10px]">${msg.senderDisplayName?.toUpperCase()} • ${time}</span>
                            </div>
                            <p class="text-primary/90 text-sm leading-relaxed font-medium italic">"${msg.messageText}"</p>
                        </div>
                    </div>`;
            } else if (msg.senderRole === "Customer") {
                html = `
                    <div class="flex items-start gap-4">
                        <div class="size-10 rounded-full ring-2 ring-white/10 shrink-0 overflow-hidden flex items-center justify-center bg-slate-800">
                             <span class="text-white font-bold">${msg.senderDisplayName[0].toUpperCase()}</span>
                        </div>
                        <div class="max-w-[75%]">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-white font-bold text-xs uppercase tracking-tight">${msg.senderDisplayName}</span>
                                <span class="text-white/30 text-[10px]">${time}</span>
                            </div>
                            <div class="glass-panel text-white p-5 rounded-2xl rounded-tl-none border border-white/10 shadow-xl">
                                <p class="text-sm leading-relaxed text-white/90">${msg.messageText}</p>
                            </div>
                        </div>
                    </div>`;
            } else {
                const isMe = msg.senderUserId === currentUserId;
                html = `
                    <div class="flex items-start gap-4 ${isMe ? 'flex-row-reverse' : ''}">
                        <div class="size-10 rounded-full bg-primary flex items-center justify-center text-black font-black shrink-0 ring-4 ring-primary/10">${msg.senderDisplayName[0].toUpperCase()}</div>
                        <div class="max-w-[75%] flex flex-col ${isMe ? 'items-end' : 'items-start'}">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-white/30 text-[10px]">${time}</span>
                                <span class="text-primary font-bold text-xs uppercase tracking-tight">${msg.senderDisplayName}</span>
                            </div>
                            <div class="bg-primary text-black p-5 rounded-2xl ${isMe ? 'rounded-tr-none' : 'rounded-tl-none'} shadow-[0_8px_30px_rgba(212,175,55,0.1)]">
                                <p class="text-sm font-bold leading-relaxed">${msg.messageText}</p>
                            </div>
                        </div>
                    </div>`;
            }

            chatMessages.insertAdjacentHTML('beforeend', html);
        }

        const toggleNoteBtn = document.getElementById('toggleNote');
        if (toggleNoteBtn) {
            toggleNoteBtn.addEventListener('click', function() {
                internalNoteMode = !internalNoteMode;
                this.classList.toggle('bg-primary/20');
                this.classList.toggle('text-primary');
                document.getElementById('modeStatus').innerText = internalNoteMode ? "ON" : "OFF";
                document.getElementById('inputContainer').classList.toggle('border-primary');
                document.getElementById('messageInput').placeholder = internalNoteMode ? "Write an internal note..." : "Write a response...";
            });
        }

        const sendBtn = document.getElementById('sendBtn');
        const messageInput = document.getElementById('messageInput');
        if (sendBtn) sendBtn.addEventListener('click', sendMessage);
        if (messageInput) messageInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });

        function sendMessage() {
            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            if (!text) return;

            if (internalNoteMode) {
                connection.invoke("SendInternalNote", conversationId, text).catch(err => console.error(err));
            } else {
                connection.invoke("SendMessage", conversationId, text, null).catch(err => console.error(err));
            }
            input.value = "";
        }

        function scrollToBottom() {
            const chatMessages = document.getElementById('chatMessages');
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        scrollToBottom();

        // --- Reassignment Logic ---
        const staffSearch = document.getElementById('staffSearch');
        const staffSuggestions = document.getElementById('staffSuggestions');
        const reassignAction = document.getElementById('reassignAction');
        const selectedStaffName = document.getElementById('selectedStaffName');
        let selectedStaffId = null;

        if (staffSearch) {
            staffSearch.addEventListener('input', async (e) => {
                const term = e.target.value.trim();
                if (term.length < 2) {
                    staffSuggestions.classList.add('hidden');
                    return;
                }

                const response = await fetch(`/Admin/SupportInbox/SearchStaff?term=${term}`);
                const data = await response.json();

                if (data.length > 0) {
                    staffSuggestions.innerHTML = data.map(s => `
                        <div class="p-4 hover:bg-primary hover:text-black cursor-pointer transition-all border-b border-white/5 last:border-none group" onclick="selectStaff('${s.id}', '${s.text}')">
                            <p class="font-bold text-sm">${s.text}</p>
                        </div>
                    `).join('');
                    staffSuggestions.classList.remove('hidden');
                } else {
                    staffSuggestions.classList.add('hidden');
                }
            });

            // Close suggestions on click outside
            document.addEventListener('click', (e) => {
                if (!staffSearch.contains(e.target) && !staffSuggestions.contains(e.target)) {
                    staffSuggestions.classList.add('hidden');
                }
            });
        }

        window.selectStaff = (id, name) => {
            selectedStaffId = id;
            selectedStaffName.innerText = name;
            staffSearch.value = name;
            staffSuggestions.classList.add('hidden');
            reassignAction.classList.remove('hidden');
        };

        window.showReassignModal = () => {
            document.getElementById('modalTargetId').value = selectedStaffId;
            document.getElementById('modalNote').value = document.getElementById('reassignNote').value;
            document.getElementById('reassignModal').classList.remove('hidden');
        };

        window.hideReassignModal = () => {
            document.getElementById('reassignModal').classList.add('hidden');
        };
    </script>
}
