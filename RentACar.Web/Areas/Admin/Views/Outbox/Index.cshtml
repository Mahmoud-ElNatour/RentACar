@model RentACar.Web.Areas.Admin.ViewModels.EmailServices.EmailLogListVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Email Logs &amp; Outbox - Standalone View</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#f2b90d",
                        "background-dark": "#050505",
                        "surface-dark": "#121214",
                        "border-dark": "#2a2618",
                    },
                    fontFamily: {
                        "display": ["Manrope"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style type="text/tailwindcss">
        @@layer base {
            body {
                @@apply bg-background-dark text-white font-display antialiased;
            }
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        .glass-row {
            background: rgba(20, 20, 20, 0.4);
            backdrop-filter: blur(8px);
            transition: all 0.3s ease;
        }
        .glass-row:hover {
            background: rgba(212, 175, 53, 0.05);
            backdrop-filter: blur(12px);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #000000;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #f2b90d;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #d4af35;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start overflow-x-hidden custom-scrollbar">
<div class="w-full max-w-7xl px-8 py-12">
<a href="/EmailServices/EmailServicesHub" class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors mb-8 inline-block">
    <span class="material-symbols-outlined text-sm">arrow_back</span>
    <span class="text-xs font-bold uppercase tracking-widest">Back to Hub</span>
</a>

<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
<div class="flex flex-col gap-2">
<div class="flex items-center gap-3 mb-2">
<div class="size-10 flex items-center justify-center bg-primary/10 rounded-xl border border-primary/20">
<span class="material-symbols-outlined text-primary text-2xl">mail</span>
</div>
<span class="text-primary font-bold tracking-[0.2em] text-xs uppercase">Communication Hub</span>
</div>
<h1 class="text-5xl font-extrabold tracking-tighter text-white">Email Logs <span class="text-primary">&amp;</span> Outbox</h1>
<p class="text-gray-400 max-w-2xl text-lg font-light leading-relaxed">
                    Monitor outgoing system communications, booking confirmations, and automated invoices with real-time delivery status and sender verification.
                </p>
</div>
<div class="flex gap-4">
<a href="@Url.Action("Export", new { status = Model.Status, type = Model.EmailType, search = Model.SearchTerm, fromDate = Model.FromDate, toDate = Model.ToDate })" class="flex items-center gap-2 px-6 py-3 bg-surface-dark border border-border-dark hover:border-primary/50 text-gray-300 hover:text-white rounded-xl text-sm font-bold transition-all">
<span class="material-symbols-outlined text-[20px]">download</span>
                    Export CSV
                </a>
@if(Model.Logs.Any(l => l.Status == "Failed"))
{
    <form asp-action="RetryAll" method="post" onsubmit="return confirm('Retry ALL failed?');">
    <button type="submit" class="flex items-center gap-2 px-7 py-3 bg-primary text-background-dark hover:bg-white rounded-xl text-sm font-black transition-all shadow-xl shadow-primary/10 uppercase tracking-wider">
    <span class="material-symbols-outlined text-[20px] font-bold">refresh</span>
                        Bulk Retry Failed
    </button>
    </form>
}
</div>
</div>
<div class="flex items-center justify-between border-b border-border-dark mb-4">
<div class="flex gap-8">
<a class="flex items-center gap-2 px-1 py-4 border-b-2 @(string.IsNullOrEmpty(Model.Status) ? "border-primary text-primary" : "border-transparent text-gray-500 hover:text-white") relative transition-all" href="@Url.Action("Index", new { status = "" })">
<span class="text-sm font-bold tracking-widest uppercase">All Logs</span>
<span class="bg-primary/20 text-[10px] px-2 py-0.5 rounded-full font-bold">@Model.TotalCount</span>
</a>
<a class="flex items-center gap-2 px-1 py-4 border-b-2 @(Model.Status == "Sent" ? "border-primary text-primary" : "border-transparent text-gray-500 hover:text-white") transition-all" href="@Url.Action("Index", new { status = "Sent" })">
<span class="text-sm font-bold tracking-widest uppercase">Sent</span>
</a>
<a class="flex items-center gap-2 px-1 py-4 border-b-2 @(Model.Status == "Failed" ? "border-primary text-primary" : "border-transparent text-gray-500 hover:text-white") transition-all" href="@Url.Action("Index", new { status = "Failed" })">
<span class="text-sm font-bold tracking-widest uppercase">Failed</span>
</a>
<a class="flex items-center gap-2 px-1 py-4 border-b-2 @(Model.Status == "Queued" ? "border-primary text-primary" : "border-transparent text-gray-500 hover:text-white") transition-all" href="@Url.Action("Index", new { status = "Queued" })">
<span class="text-sm font-bold tracking-widest uppercase">Queued</span>
</a>
</div>
<div class="flex items-center gap-4 pb-2">
<div class="flex items-center bg-surface-dark border border-border-dark rounded-lg px-3 py-1.5 gap-2 cursor-pointer hover:border-gray-500 transition-colors">
<span class="material-symbols-outlined text-[18px] text-primary">calendar_today</span>
<span class="text-xs font-semibold text-gray-300">Last 30 Days</span>
</div>
</div>
</div>
<form method="get" class="relative w-full mb-8 group">
    @if(!string.IsNullOrEmpty(Model.Status)) { <input type="hidden" name="status" value="@Model.Status" /> }
<div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
<span class="material-symbols-outlined text-primary text-2xl">search</span>
</div>
<input name="search" value="@Model.SearchTerm" class="w-full bg-surface-dark/40 border-2 border-primary/50 focus:border-primary rounded-2xl py-5 pl-14 pr-6 text-white text-lg placeholder:text-gray-600 focus:ring-4 focus:ring-primary/10 transition-all outline-none" placeholder="Search logs by recipient, subject, or type..." type="text"/>
</form>
<div class="bg-surface-dark/20 border border-border-dark rounded-2xl overflow-hidden shadow-2xl">
<div class="overflow-x-auto custom-scrollbar">
<table class="w-full text-left border-collapse min-w-[1000px]">
<thead>
<tr class="bg-surface-dark/80 border-b border-border-dark text-[10px] uppercase tracking-[0.2em] text-gray-500 font-black">
<th class="px-6 py-5">Created At</th>
<th class="px-6 py-5">Type</th>
<th class="px-6 py-5">Sender</th>
<th class="px-6 py-5">Recipient</th>
<th class="px-6 py-5">Subject</th>
<th class="px-6 py-5">Status</th>
<th class="px-6 py-5 text-right">Actions</th>
</tr>
</thead>
<tbody class="divide-y divide-border-dark/30">
@foreach(var log in Model.Logs) {
<tr class="glass-row group">
<td class="px-6 py-5">
<div class="flex flex-col">
<span class="text-sm font-bold text-gray-200">@log.CreatedAt.ToString("MMM dd, yyyy")</span>
<span class="text-[10px] text-gray-500 font-medium">@log.CreatedAt.ToString("HH:mm:ss tt")</span>
</div>
</td>
<td class="px-6 py-5">
<span class="px-2.5 py-1 bg-blue-500/10 text-blue-400 text-[10px] font-black rounded-md uppercase tracking-wider border border-blue-500/20">@log.EmailType</span>
</td>
<td class="px-6 py-5">
@if (log.CreatedByUser != null) {
  <span class="px-2 py-0.5 bg-blue-500/20 text-blue-400 text-[10px] font-black rounded border border-blue-500/30 tracking-widest uppercase">@log.CreatedByUser.UserName</span>
} else {
  <span class="px-2 py-0.5 bg-primary/20 text-primary text-[10px] font-black rounded border border-primary/30 tracking-widest uppercase">System</span>
}
</td>
<td class="px-6 py-5">
<div class="flex items-center gap-2">
<span class="text-sm text-white/90 truncate max-w-[200px]" title="@log.RecipientsRaw">@log.RecipientsRaw</span>
</div>
</td>
<td class="px-6 py-5">
<p class="text-sm text-gray-400 truncate max-w-[180px]" title="@log.Subject">@log.Subject</p>
</td>
<td class="px-6 py-5">
@if (log.Status == "Sent") {
    <div class="flex items-center gap-2 text-green-400">
    <span class="size-1.5 bg-green-400 rounded-full shadow-[0_0_8px_rgba(74,222,128,0.6)]"></span>
    <span class="text-[11px] font-black uppercase tracking-widest">Sent</span>
    </div>
} else if (log.Status == "Failed") {
    <div class="flex items-center gap-2 text-red-500">
    <span class="size-1.5 bg-red-500 rounded-full shadow-[0_0_8px_rgba(239,68,68,0.6)]"></span>
    <span class="text-[11px] font-black uppercase tracking-widest">Failed</span>
    </div>
} else {
    <div class="flex items-center gap-2 text-blue-400">
    <span class="size-1.5 bg-blue-400 rounded-full shadow-[0_0_8px_rgba(96,165,250,0.6)]"></span>
    <span class="text-[11px] font-black uppercase tracking-widest">@log.Status</span>
    </div>
}
</td>
<td class="px-6 py-5 text-right">
<div class="flex justify-end gap-3">
<button class="text-primary hover:text-white transition-colors" title="View Details" onclick="viewLogDetails(@log.Id)">
<span class="material-symbols-outlined text-[22px]">visibility</span>
</button>
@if(log.Status == "Failed") {
    <form asp-action="Retry" asp-route-id="@log.Id" method="post" style="display:inline;" onsubmit="return confirm('Retry?');">
        @Html.AntiForgeryToken()
        <button type="submit" class="text-primary hover:text-white transition-colors" title="Retry">
        <span class="material-symbols-outlined text-[22px]">refresh</span>
        </button>
    </form>
}

</div>
</td>
</tr>
}
</tbody>
</table>
</div>
<div class="px-8 py-5 bg-surface-dark border-t border-border-dark flex items-center justify-between text-sm">
<p class="text-gray-500 font-medium">Showing <span class="text-white font-bold">@((Model.Page - 1) * 20 + 1)-@Math.Min(Model.Page * 20, Model.TotalCount)</span> of <span class="text-primary font-bold">@Model.TotalCount</span> email logs</p>
<div class="flex items-center gap-3">
    @if (Model.Page > 1) {
        <a href="@Url.Action("Index", new { page = Model.Page - 1, status = Model.Status, search = Model.SearchTerm })" class="w-10 h-10 flex items-center justify-center bg-black/50 border border-border-dark text-gray-500 rounded-xl hover:text-primary hover:border-primary transition-all">
        <span class="material-symbols-outlined">chevron_left</span>
        </a>
    }
<div class="flex gap-2">
<button class="w-10 h-10 bg-primary text-black font-black rounded-xl shadow-lg shadow-primary/20">@Model.Page</button>
</div>
    @if (Model.Page < Model.TotalPages) {
        <a href="@Url.Action("Index", new { page = Model.Page + 1, status = Model.Status, search = Model.SearchTerm })" class="w-10 h-10 flex items-center justify-center bg-black/50 border border-border-dark text-gray-500 rounded-xl hover:text-primary hover:border-primary transition-all">
        <span class="material-symbols-outlined">chevron_right</span>
        </a>
    }
</div>
</div>
</div>
<div class="mt-8 flex justify-center items-center gap-8 text-[10px] text-gray-600 uppercase tracking-[0.3em] font-black">
<span>Server Status: Online</span>
<div class="size-1.5 bg-primary rounded-full"></div>
<span>Auto-refresh: Active</span>
<div class="size-1.5 bg-primary rounded-full"></div>
<span>Retention Policy: 90 Days</span>
</div>
</div>

<!-- Scripts for Modal (Need simple standard modal or keeping logic?) -->
<!-- For now we keep viewLogDetails logic if we want, but I stripped the placeholder div used by prev logic. I should add it back or ensure it works. -->
<!-- Adding modal placeholder -->
<div class="fixed inset-0 z-50 hidden" id="logDetailsModal" aria-hidden="true">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeLogDetails()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="bg-surface-dark border border-border-dark rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto pointer-events-auto" id="logDetailsContent">
        </div>
    </div>
</div>

<script>
    function viewLogDetails(id) {
        fetch('/Admin/Outbox/Details/' + id)
            .then(r => r.text())
            .then(html => {
                document.getElementById('logDetailsContent').innerHTML = html;
                document.getElementById('logDetailsModal').classList.remove('hidden');
            });
    }
    function closeLogDetails() {
         document.getElementById('logDetailsModal').classList.add('hidden');
    }
</script>



</body></html>
